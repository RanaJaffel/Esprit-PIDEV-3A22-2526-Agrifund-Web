{# templates/emails/verification.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vérification Email - AgriFund</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 20px;
            line-height: 1.6;
        }
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        }
        .email-header {
            background: linear-gradient(135deg, #089647 0%, #076A39 100%);
            padding: 40px 30px;
            text-align: center;
            color: white;
        }
        .logo {
            font-size: 48px;
            margin-bottom: 10px;
        }
        .brand-name {
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 5px;
            letter-spacing: 1px;
        }
        .tagline {
            font-size: 14px;
            opacity: 0.9;
        }
        .email-body {
            padding: 40px 30px;
        }
        .greeting {
            font-size: 22px;
            color: #2d3748;
            margin-bottom: 20px;
            font-weight: 600;
        }
        .message {
            color: #4a5568;
            margin-bottom: 15px;
            font-size: 15px;
        }
        .highlight-box {
            background: linear-gradient(135deg, #f0f9f4 0%, #e6f7ed 100%);
            border-left: 4px solid #089647;
            padding: 20px;
            margin: 25px 0;
            border-radius: 8px;
        }
        .highlight-box p {
            margin: 0;
            color: #2d3748;
            font-weight: 600;
        }
        .button-container {
            text-align: center;
            margin: 35px 0;
        }
        .verify-button {
            display: inline-block;
            background: linear-gradient(135deg, #089647 0%, #076A39 100%);
            color: white !important;
            padding: 16px 40px;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 700;
            font-size: 16px;
            box-shadow: 0 8px 20px rgba(8, 150, 71, 0.3);
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .verify-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(8, 150, 71, 0.4);
        }
        .alternative-link {
            background: #f7fafc;
            padding: 20px;
            border-radius: 8px;
            margin: 25px 0;
            border: 1px dashed #cbd5e0;
        }
        .alternative-link p {
            margin-bottom: 10px;
            color: #4a5568;
            font-size: 13px;
        }
        .link-text {
            word-break: break-all;
            color: #089647;
            font-size: 12px;
            font-family: monospace;
            background: white;
            padding: 10px;
            border-radius: 4px;
        }
        .info-box {
            background: #fff5f5;
            border-left: 4px solid #fc8181;
            padding: 15px 20px;
            margin: 25px 0;
            border-radius: 8px;
        }
        .info-box p {
            margin: 0;
            color: #742a2a;
            font-size: 14px;
        }
        .info-icon {
            display: inline-block;
            margin-right: 8px;
            font-size: 18px;
        }
        .features {
            margin: 30px 0;
        }
        .feature-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 15px;
            padding: 12px;
            background: #f7fafc;
            border-radius: 8px;
        }
        .feature-icon {
            font-size: 24px;
            margin-right: 15px;
            flex-shrink: 0;
        }
        .feature-text {
            color: #4a5568;
            font-size: 14px;
        }
        .feature-text strong {
            color: #2d3748;
            display: block;
            margin-bottom: 3px;
        }
        .email-footer {
            background: #f7fafc;
            padding: 30px;
            text-align: center;
            border-top: 1px solid #e2e8f0;
        }
        .footer-text {
            color: #718096;
            font-size: 13px;
            margin-bottom: 10px;
        }
        .social-links {
            margin: 20px 0 10px;
        }
        .social-links a {
            display: inline-block;
            margin: 0 8px;
            color: #089647;
            text-decoration: none;
            font-size: 24px;
        }
        .copyright {
            color: #a0aec0;
            font-size: 12px;
            margin-top: 15px;
        }
        @media only screen and (max-width: 600px) {
            .email-body {
                padding: 30px 20px;
            }
            .email-header {
                padding: 30px 20px;
            }
            .greeting {
                font-size: 20px;
            }
            .verify-button {
                padding: 14px 30px;
                font-size: 14px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Header -->
        <div class="email-header">
            <div class="logo">
                {% if userType == 'Agriculteur' %}
                    🌾
                {% else %}
                    🏦
                {% endif %}
            </div>
            <div class="brand-name">AgriFund</div>
            <div class="tagline">Plateforme de Financement Agricole</div>
        </div>

        <!-- Body -->
        <div class="email-body">
            <h1 class="greeting">
                Bonjour {{ utilisateur.prenom }} {{ utilisateur.nom }} ! 👋
            </h1>

            <p class="message">
                Bienvenue sur <strong>AgriFund</strong>, la plateforme qui connecte 
                {% if userType == 'Agriculteur' %}
                    les agriculteurs aux opportunités de financement.
                {% else %}
                    les institutions financières aux projets agricoles.
                {% endif %}
            </p>

            <p class="message">
                Nous sommes ravis de vous compter parmi nous en tant que <strong>{{ userType }}</strong> !
            </p>

            <div class="highlight-box">
                <p>
                    ✅ Pour finaliser votre inscription et accéder à votre compte, 
                    veuillez vérifier votre adresse email en cliquant sur le bouton ci-dessous.
                </p>
            </div>

            <!-- Verify Button -->
            <div class="button-container">
                <a href="{{ verificationUrl }}" class="verify-button">
                    ✉️ Vérifier mon email
                </a>
            </div>

            <!-- Alternative Link -->
            <div class="alternative-link">
                <p><strong>Le bouton ne fonctionne pas ?</strong></p>
                <p>Copiez et collez ce lien dans votre navigateur :</p>
                <div class="link-text">{{ verificationUrl }}</div>
            </div>

            <!-- Important Info -->
            <div class="info-box">
                <p>
                    <span class="info-icon">⚠️</span>
                    <strong>Important :</strong> Ce lien expire le {{ expiresAt|date('d/m/Y à H:i') }} 
                    (dans 24 heures).
                </p>
            </div>

            <!-- Features -->
            <div class="features">
                <h3 style="color: #2d3748; margin-bottom: 20px; font-size: 18px;">
                    Ce qui vous attend sur AgriFund :
                </h3>

                {% if userType == 'Agriculteur' %}
                    <div class="feature-item">
                        <div class="feature-icon">📊</div>
                        <div class="feature-text">
                            <strong>Tableau de bord personnalisé</strong>
                            Suivez vos demandes de financement et gérez votre exploitation
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">💰</div>
                        <div class="feature-text">
                            <strong>Accès aux financements</strong>
                            Connectez-vous avec nos banques partenaires certifiées
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">🌤️</div>
                        <div class="feature-text">
                            <strong>Prévisions météo</strong>
                            Planifiez vos activités agricoles avec précision
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">👥</div>
                        <div class="feature-text">
                            <strong>Communauté active</strong>
                            Échangez avec d'autres agriculteurs et experts
                        </div>
                    </div>
                {% else %}
                    <div class="feature-item">
                        <div class="feature-icon">🤝</div>
                        <div class="feature-text">
                            <strong>Agriculteurs qualifiés</strong>
                            Accédez à des profils vérifiés et fiables
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">📈</div>
                        <div class="feature-text">
                            <strong>Analyse de risque</strong>
                            Données détaillées pour une prise de décision éclairée
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">📋</div>
                        <div class="feature-text">
                            <strong>Gestion optimisée</strong>
                            Suivi automatisé des demandes et des dossiers
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">🔒</div>
                        <div class="feature-text">
                            <strong>Sécurité renforcée</strong>
                            Conformité garantie et données protégées
                        </div>
                    </div>
                {% endif %}
            </div>

            <p class="message" style="margin-top: 30px;">
                Si vous n'avez pas créé de compte sur AgriFund, ignorez simplement cet email.
            </p>

            <p class="message" style="margin-top: 20px; font-weight: 600; color: #2d3748;">
                Besoin d'aide ? Notre équipe support est disponible 24/7 à 
                <a href="mailto:support@agrifund.com" style="color: #089647;">support@agrifund.com</a>
            </p>
        </div>

        <!-- Footer -->
        <div class="email-footer">
            <p class="footer-text">
                Cet email a été envoyé par <strong>AgriFund</strong>
            </p>
            <p class="footer-text">
                Plateforme de financement agricole de confiance
            </p>

            <div class="social-links">
                <a href="#" title="Facebook">📘</a>
                <a href="#" title="Twitter">🐦</a>
                <a href="#" title="LinkedIn">💼</a>
                <a href="#" title="Instagram">📷</a>
            </div>

            <p class="copyright">
                © {{ "now"|date('Y') }} AgriFund. Tous droits réservés.<br>
                Avenue Habib Bourguiba, Tunis, Tunisie
            </p>
        </div>
    </div>
</body>
</html>