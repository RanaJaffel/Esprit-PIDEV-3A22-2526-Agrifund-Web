{% extends 'base.html.twig' %}
{% form_theme generateForm 'bootstrap_5_layout.html.twig' %}

{% block title %}Relevés hebdomadaires — Projet {{ idproject }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('ui/releve-hebdo-agri-pro.css') }}">
{% endblock %}

{% block hide_preloader %}{% endblock %}

{# =========================
   Data Chart.js
   ========================= #}
{% set chartLabels = [] %}
{% set chartTemp = [] %}
{% set chartHum = [] %}

{% for h in (items|default([]))|reverse %}
  {% set chartLabels = chartLabels|merge([ h.dateDebut|date('Y-m-d') ~ ' → ' ~ h.dateFin|date('Y-m-d') ]) %}
  {% set chartTemp = chartTemp|merge([ h.tempMoyenne ?? 0 ]) %}
  {% set chartHum = chartHum|merge([ h.humiditeMoyenne ?? 0 ]) %}
{% endfor %}

{# KPI #}
{% set total = items|length %}
{% set normalCount = 0 %}
{% set alertCount = 0 %}
{% for x in items|default([]) %}
  {% set c = x.conditionDominante ?? 'NORMAL' %}
  {% if c == 'NORMAL' %}
    {% set normalCount = normalCount + 1 %}
  {% else %}
    {% set alertCount = alertCount + 1 %}
  {% endif %}
{% endfor %}

{% set latest = items|default([])|first %}

{% block body %}
<div class="iot-page releve-hebdo-agri-pro">
  <div class="container-fluid py-4">

    {# HERO #}
    <div class="iot-hero hero-agri reveal mb-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <h2 class="iot-hero-title mb-0">
            <i class="fas fa-calendar-week me-2"></i>
            Relevé hebdomadaire — Projet #{{ idproject }}
          </h2>
          <div class="iot-hero-sub">
            Synthèse 7 jours <b>AI Ready</b> (temp/humidité/condition/nb mesures) — utilisée par le Module 5.
          </div>
        </div>
        <div class="d-flex gap-2">
          <a class="btn btn-light btn-iot" href="{{ path('agriculteur_releve_hebdo_home') }}">
            <i class="fas fa-layer-group me-2"></i> Projets
          </a>
          <a class="btn btn-outline-light btn-iot" href="{{ path('agriculteur_releve_terrain', {idproject: idproject}) }}">
            <i class="fas fa-wave-square me-2"></i> Données brutes
          </a>
        </div>
      </div>
    </div>

    {{ include('_partials/_flashes.html.twig') }}

    {# KPI #}
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-3 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">Relevés disponibles</div>
          <div class="fs-2 fw-bold" data-countup="{{ total }}">0</div>
          <div class="text-muted small">historique</div>
        </div></div>
      </div>
      <div class="col-12 col-md-3 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">NORMAL</div>
          <div class="fs-2 fw-bold text-success" data-countup="{{ normalCount }}">0</div>
          <div class="text-muted small">semaines stables</div>
        </div></div>
      </div>
      <div class="col-12 col-md-3 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">Alertes</div>
          <div class="fs-2 fw-bold text-danger" data-countup="{{ alertCount }}">0</div>
          <div class="text-muted small">condition ≠ NORMAL</div>
        </div></div>
      </div>
      <div class="col-12 col-md-3 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">AI Ready</div>
          <div class="fw-bold">Features</div>
          <div class="text-muted small">Temp/Humidité + Condition + Nb mesures</div>
        </div></div>
      </div>
    </div>

    <div class="row g-3">

      {# LEFT: generate + donut + latest #}
      <div class="col-12 col-xl-4">

        <div class="panel reveal mb-3">
          <div class="panel-h">
            <span><i class="fas fa-sync-alt text-success me-2"></i> Générer</span>
            <span class="text-muted small">7 jours</span>
          </div>
          <div class="panel-b">
            {{ form_start(generateForm) }}
              {{ form_row(generateForm.weekStart) }}
              <button class="btn btn-success btn-iot w-100">Générer synthèse 7 jours</button>
            {{ form_end(generateForm) }}
            <div class="text-muted small mt-2">
              Calcul depuis <b>rapport_journalier</b> (stable et IA-friendly).
            </div>
          </div>
        </div>

        <div class="chart-wrap reveal mb-3">
          <div class="chart-head">
            <span><i class="fas fa-bullseye me-2"></i> NORMAL vs ALERTES</span>
            <span class="text-muted small">qualité terrain</span>
          </div>
          <div class="chart-body">
            <canvas id="donutHebdo" height="160"></canvas>
            <div class="d-flex flex-wrap gap-2 mt-3">
              <span class="chip"><span class="dot ok"></span> NORMAL: {{ normalCount }}</span>
              <span class="chip"><span class="dot bad"></span> ALERTES: {{ alertCount }}</span>
            </div>
          </div>
        </div>

        <div class="panel reveal">
          <div class="panel-h">
            <span><i class="fas fa-brain text-primary me-2"></i> Dernière semaine</span>
            <span class="text-muted small">insight</span>
          </div>
          <div class="panel-b">
            {% if latest %}
              {% set c = latest.conditionDominante ?? 'NORMAL' %}
              <div class="text-muted small">{{ latest.dateDebut|date('d/m/Y') }} → {{ latest.dateFin|date('d/m/Y') }}</div>
              <div class="mt-2">
                <span class="chip">
                  <span class="{{ c == 'NORMAL' ? 'dot ok' : 'dot bad' }}"></span>
                  {{ c }}
                </span>
              </div>

              <div class="mt-3">
                <div class="metric-pill"><span>Temp moyenne</span><b>{{ latest.tempMoyenne }} °C</b></div>
                <div class="metric-pill mt-2"><span>Humidité sol</span><b>{{ latest.humiditeMoyenne }} %</b></div>
                <div class="metric-pill mt-2"><span>Mesures</span><b>{{ latest.nbMesuresTotal }}</b></div>
              </div>
            {% else %}
              <div class="text-muted">Aucune donnée. Génère un relevé.</div>
            {% endif %}
          </div>
        </div>

      </div>

      {# RIGHT: chart + timeline cards #}
      <div class="col-12 col-xl-8">

        <div class="chart-wrap reveal mb-3">
          <div class="chart-head">
            <span><i class="fas fa-chart-line text-success me-2"></i> Tendances</span>
            <span class="text-muted small">Temp & Humidité</span>
          </div>
          <div class="chart-body">
            {% if items|length > 0 %}
              <canvas id="chartHebdoAgri" height="120"></canvas>
            {% else %}
              <div class="alert alert-light border mb-0">
                Aucun relevé hebdomadaire. Clique sur <b>Générer</b>.
              </div>
            {% endif %}
          </div>
        </div>

        <div class="panel reveal">
          <div class="panel-h">
            <span><i class="fas fa-layer-group me-2"></i> Timeline hebdomadaire</span>
            <span class="text-muted small">cards premium</span>
          </div>
          <div class="panel-b">
            <div class="hebdo-timeline">
              {% for h in items %}
                {% set cond = h.conditionDominante ?? 'NORMAL' %}
                {% set isOk = (cond == 'NORMAL') %}
                <div class="hebdo-card">
                  <div class="hebdo-inner">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                      <div>
                        <div class="fw-bold">Semaine</div>
                        <div class="text-muted small">{{ h.dateDebut|date('d/m/Y') }} → {{ h.dateFin|date('d/m/Y') }}</div>
                      </div>
                      <span class="chip">
                        <span class="{{ isOk ? 'dot ok' : 'dot bad' }}"></span>
                        {{ cond }}
                      </span>
                    </div>

                    <div class="hebdo-metrics">
                      <div class="metric-pill"><span>Temp moyenne</span><b>{{ h.tempMoyenne }} °C</b></div>
                      <div class="metric-pill"><span>Humidité sol</span><b>{{ h.humiditeMoyenne }} %</b></div>
                      <div class="metric-pill"><span>Mesures</span><b>{{ h.nbMesuresTotal }}</b></div>
                      <div class="metric-pill"><span>Généré</span><b>{{ h.dateGeneration ? h.dateGeneration|date('d/m H:i') : '-' }}</b></div>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="text-center text-muted py-4">Aucun relevé hebdomadaire disponible.</div>
              {% endfor %}
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script defer src="{{ asset('ui/releve-hebdo-agri-pro.js') }}"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <script>
    // Line chart
    const can = document.getElementById('chartHebdoAgri');
    if (can) {
      const labels = {{ chartLabels|json_encode|raw }};
      const temp = {{ chartTemp|json_encode|raw }};
      const hum = {{ chartHum|json_encode|raw }};

      new Chart(can, {
        type: 'line',
        data: {
          labels,
          datasets: [
            { label: 'Temp moyenne (°C)', data: temp, borderWidth: 2, tension: 0.25, pointRadius: 2 },
            { label: 'Humidité sol moyenne (%)', data: hum, borderWidth: 2, tension: 0.25, pointRadius: 2 }
          ]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
      });
    }

    // Donut NORMAL vs ALERTES
    const donut = document.getElementById('donutHebdo');
    if (donut) {
      new Chart(donut, {
        type: 'doughnut',
        data: {
          labels: ['NORMAL', 'ALERTES'],
          datasets: [{
            data: [{{ normalCount }}, {{ alertCount }}],
            backgroundColor: ['#089647', '#ef4444'],
            borderWidth: 0
          }]
        },
        options: { plugins: { legend: { position: 'bottom' } }, cutout: '70%' }
      });
    }
  </script>
{% endblock %}