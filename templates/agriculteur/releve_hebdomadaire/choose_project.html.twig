{% extends 'base.html.twig' %}

{% block title %}Relevés hebdomadaires — Choisir projet{% endblock %}

{% block body %}
<div class="container py-4">

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h3 class="mb-1">Relevés hebdomadaires</h3>
      <div class="text-muted">Sélectionne un projet pour consulter / générer la synthèse 7 jours (AI Ready).</div>
    </div>
    <a class="btn btn-outline-secondary" href="{{ path('agriculteur_dashboard') }}">Retour</a>
  </div>

  {{ include('_partials/_flashes.html.twig') }}

  <div class="row g-3">
    {% for pid in projects %}
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-4 d-flex align-items-center justify-content-center"
                   style="width:48px;height:48px;background:linear-gradient(135deg,#B2D944,#089647);color:#fff;">
                <i class="fas fa-calendar-week"></i>
              </div>
              <div class="flex-grow-1">
                <div class="fw-semibold">Projet #{{ pid }}</div>
                <div class="text-muted small">Synthèse 7 jours (temp/humidité + condition)</div>
              </div>
            </div>

            <div class="d-grid mt-3">
              <a class="btn btn-success"
                 href="{{ path('agriculteur_releve_hebdo', {idproject: pid}) }}">
                Ouvrir
              </a>
            </div>
          </div>
        </div>
      </div>
    {% else %}
      <div class="col-12">
        <div class="alert alert-light border mb-0">
          Aucun projet disponible.
        </div>
      </div>
    {% endfor %}
  </div>

</div>
{% endblock %}