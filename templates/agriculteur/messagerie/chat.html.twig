{% extends 'base.html.twig' %}

{% block title %}Conversation{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('agriculteur') }}
    {{ encore_entry_link_tags('messagerie-style') }}
    <style>
        .chat-header { background: linear-gradient(135deg, #089647, #b2d944); }
        .message-sent .message-bubble { background: #5a9e2f; }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'components/_sidebar_agriculteur.html.twig' %}
    <div class="main-content p-0">
        <div class="chat-container">

            <div class="chat-header">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <a href="{{ path('agriculteur_messagerie_index') }}" class="text-white text-decoration-none">
                            <i class="fas fa-arrow-left fa-lg"></i>
                        </a>
                        <div class="d-flex align-items-center gap-2">
                            {% if other_user %}
                                {% if other_user.photo %}
                                    <img src="{{ asset(other_user.photo) }}" alt=""
                                         style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,0.5);">
                                {% elseif other_user.banque and other_user.banque.logo %}
                                    <img src="{{ asset(other_user.banque.logo) }}" alt=""
                                         style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,0.5);">
                                {% else %}
                                    <div style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;">
                                        <i class="fas fa-user text-white"></i>
                                    </div>
                                {% endif %}
                                <div>
                                    <div class="fw-bold text-white">
                                        {% if other_user.banque %}{{ other_user.nom }}
                                        {% else %}{{ other_user.nomComplet }}{% endif %}
                                    </div>
                                    <small class="text-white opacity-75">
                                        {% if other_user.admin %}Administrateur
                                        {% elseif other_user.banque %}Banque{% if other_user.banque.codebanque %} · {{ other_user.banque.codebanque }}{% endif %}
                                        {% endif %}
                                    </small>
                                </div>
                            {% else %}
                                <div class="fw-bold text-white">Conversation #{{ conversation.id }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <small class="text-white opacity-75">{{ messages|length }} message(s)</small>
                </div>
            </div>

            <div class="messages-area" id="messagesArea">
                {% for message in messages %}
                    {% if not message.estSupprime %}
                    <div class="message {{ message.expediteur.id == current_user.id ? 'message-sent' : 'message-received' }}"
                         data-message-id="{{ message.id }}">
                        <div class="message-bubble">
                            <div class="message-content">
                                {% if message.expediteur.id != current_user.id %}
                                    <div class="sender-name">
                                        {% if message.expediteur.banque %}{{ message.expediteur.nom }}
                                        {% else %}{{ message.expediteur.nomComplet }}{% endif %}
                                    </div>
                                {% endif %}
                                <div class="message-text">{{ message.contenu|nl2br }}</div>
                                {% if message.piecesJointes|length > 0 %}
                                    <div class="message-attachments">
                                        {% for pj in message.piecesJointes %}
                                            {% if pj.typeFichier == 'image' %}
                                                <div class="mt-1">
                                                    <a href="{{ asset(pj.cheminFichier) }}" target="_blank">
                                                        <img src="{{ asset(pj.cheminFichier) }}"
                                                             alt="{{ pj.nomOriginal }}"
                                                             style="max-width:200px;max-height:200px;border-radius:8px;display:block;">
                                                    </a>
                                                </div>
                                            {% else %}
                                                <div class="mt-1">
                                                    <a href="{{ asset(pj.cheminFichier) }}" target="_blank" download
                                                       class="d-inline-flex align-items-center gap-1 p-2 bg-white rounded border text-decoration-none text-dark">
                                                        <i class="fas fa-file text-primary"></i>
                                                        <span>{{ pj.nomOriginal }}</span>
                                                        <small class="text-muted">({{ pj.tailleFormatee }})</small>
                                                    </a>
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                            <div class="message-footer">
                                <small class="message-time">
                                    {{ message.dateEnvoi|date('d/m/Y H:i') }}
                                    {% if message.isModifie %}
                                        <i class="fas fa-pencil-alt ms-1" style="font-size:0.65rem;" title="Modifié"></i>
                                    {% endif %}
                                    {% if message.expediteur.id == current_user.id %}
                                        {% if message.estLu %}
                                            <i class="fas fa-check-double text-white ms-1" title="Lu"></i>
                                        {% else %}
                                            <i class="fas fa-check ms-1 opacity-75" title="Envoyé"></i>
                                        {% endif %}
                                    {% endif %}
                                </small>
                                {% if message.expediteur.id == current_user.id %}
                                    <div class="message-actions">
                                        <button class="btn btn-sm btn-link p-0 text-white-50"
                                                onclick="openEditModal({{ message.id }}, this)" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-link p-0 text-danger"
                                                onclick="confirmDelete({{ message.id }})" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    {% endif %}
                {% endfor %}
            </div>

            <div class="message-input-area">
                <div id="filePreview" class="mb-2 d-flex flex-wrap gap-1"></div>
                <form id="messageForm">
                    <div class="d-flex align-items-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" id="attachButton">
                            <i class="fas fa-paperclip"></i>
                        </button>
                        <input type="file" id="fileInput" name="files[]" multiple
                               accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" style="display:none;">
                        <textarea class="form-control" id="messageInput"
                                  placeholder="Tapez votre message..." rows="1"
                                  style="border-radius:25px;resize:none;"></textarea>
                        <button type="submit" class="btn btn-success" id="sendButton">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editMessageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="fas fa-edit me-2 text-success"></i>Modifier le message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <textarea class="form-control" id="editMessageContent" rows="4"></textarea>
                <input type="hidden" id="editMessageId">
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-success" onclick="saveEditedMessage()">
                    <i class="fas fa-save me-1"></i>Enregistrer
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    {{ encore_entry_script_tags('messagerie') }}
    <script>
        window.MESSAGERIE_CURRENT_USER_ID = {{ current_user.id }};
        window.MESSAGERIE_SEND_ROUTE      = '{{ path('agriculteur_messagerie_send', {conversationId: conversation.id}) }}';
        window.MESSAGERIE_GET_ROUTE       = '{{ path('agriculteur_messagerie_get_messages', {id: conversation.id}) }}';
        window.MESSAGERIE_EDIT_ROUTE      = '/agriculteur/messagerie/message/';
        window.MESSAGERIE_DELETE_ROUTE    = '/agriculteur/messagerie/message/';
        window.MESSAGERIE_CSRF_TOKEN      = '{{ csrf_token('delete_message') }}';

        document.addEventListener('DOMContentLoaded', function () {
            scrollToBottom();
            initSendMessage(window.MESSAGERIE_SEND_ROUTE, window.MESSAGERIE_CURRENT_USER_ID);
            initRefresh(window.MESSAGERIE_GET_ROUTE, window.MESSAGERIE_CURRENT_USER_ID);
        });
    </script>
{% endblock %}