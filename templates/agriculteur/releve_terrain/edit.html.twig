{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Modifier une mesure manuelle{% endblock %}

{% block stylesheets %}
  {{ encore_entry_link_tags('sidebar') }}
  {{ parent() }}

  <link rel="stylesheet" href="{{ asset('ui/releve-terrain-pages-pro.css') }}">

  <style>
    .dashboard-container { display: flex; min-height: 100vh; }

    .main-content {
      flex: 1;
      margin-left: 280px;
      transition: margin-left 0.3s ease;
    }

    @media (max-width: 991.98px) {
      .main-content { margin-left: 0; }
    }
  </style>
{% endblock %}

{% block hide_preloader %}{% endblock %}

{% block body %}
<div class="dashboard-container">

  {% include 'components/_sidebar_agriculteur.html.twig' %}

  <div class="main-content">
    <div class="iot-page releve-terrain-agri-pro releve-terrain-pages-pro">
      <div class="container py-4">

    <div class="iot-hero hero-agri reveal mb-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <h2 class="iot-hero-title mb-0"><i class="fas fa-pen me-2"></i> Modifier une mesure</h2>
          <div class="iot-hero-sub">Relevé #{{ releve.idReleve }} — Projet #{{ releve.idproject }} (MANUEL uniquement)</div>
        </div>
        <a class="btn btn-light btn-iot" href="{{ path('agriculteur_releve_terrain', {idproject: releve.idproject}) }}">
          <i class="fas fa-arrow-left me-2"></i> Retour
        </a>
      </div>
    </div>

    {{ include('_partials/_flashes.html.twig') }}

    <div class="form-panel reveal">
      <div class="form-head">
        <span><i class="fas fa-sliders me-2 text-warning"></i> Mise à jour</span>
        <span class="text-muted small">EDIT</span>
      </div>

      <div class="form-body">
        {{ form_start(form) }}
          <div class="row g-3">
            <div class="col-md-6">{{ form_row(form.idCapteur) }}</div>
            <div class="col-md-6">{{ form_row(form.typeMesure) }}</div>
            <div class="col-md-4">{{ form_row(form.valeurMesuree) }}</div>
            <div class="col-md-4">{{ form_row(form.unite) }}</div>
            <div class="col-md-4">{{ form_row(form.dateHeure) }}</div>

            {% if form.qualite is defined %}
              <div class="col-md-4">{{ form_row(form.qualite) }}</div>
            {% endif %}
            {% if form.note is defined %}
              <div class="col-12">{{ form_row(form.note) }}</div>
            {% endif %}

            <div class="col-12 d-grid">
              <button class="btn btn-warning btn-iot btn-lg">Mettre à jour</button>
            </div>
          </div>
        {{ form_end(form) }}
      </div>
    </div>

  </div>
</div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
{% block javascripts %}
  {{ encore_entry_script_tags('sidebar') }}
  {{ parent() }}
{% endblock %}
