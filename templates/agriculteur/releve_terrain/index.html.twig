{% extends 'base.html.twig' %}

{% block title %}Relevés terrain - Projet {{ idproject }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('ui/releve-terrain-agri-pro.css') }}">
{% endblock %}

{% block hide_preloader %}{% endblock %}

{# ===== KPI counts ===== #}
{% set total = mesures|length %}
{% set lastDate = total > 0 ? mesures[0].dateHeure : null %}
{% set ok = 0 %}
{% set suspects = 0 %}
{% set erreurs = 0 %}
{% for m in mesures|default([]) %}
  {% set q = m.qualite ?? 'OK' %}
  {% if q == 'OK' %}{% set ok = ok + 1 %}{% endif %}
  {% if q == 'SUSPECT' %}{% set suspects = suspects + 1 %}{% endif %}
  {% if q == 'ERREUR_CAPTEUR' %}{% set erreurs = erreurs + 1 %}{% endif %}
{% endfor %}

{# Types présents pour le graphe #}
{% set graphTypes = [] %}
{% for m in mesures|default([]) %}
  {% if m.typeMesure not in graphTypes %}
    {% set graphTypes = graphTypes|merge([m.typeMesure]) %}
  {% endif %}
{% endfor %}

{# Payload par type => labels+values (pour graphe dynamique sans reload) #}
{% set chartPayload = [] %}
{% for t in graphTypes %}
  {% set labels = [] %}
  {% set values = [] %}
  {% set unit = '' %}
  {% for m in (mesures|default([]))|reverse %}
    {% if m.typeMesure == t %}
      {% set labels = labels|merge([ m.dateHeure|date('d/m H:i') ]) %}
      {% set values = values|merge([ m.valeurMesuree ]) %}
      {% if unit == '' %}{% set unit = m.unite %}{% endif %}
    {% endif %}
  {% endfor %}
  {% set chartPayload = chartPayload|merge([{
    'type': t,
    'labels': labels,
    'values': values,
    'unit': unit
  }]) %}
{% endfor %}

{% block body %}
<div class="iot-page releve-terrain-agri-pro">
  <div class="container-fluid py-4">

    {# HERO #}
    <div class="iot-hero hero-agri reveal mb-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <h2 class="iot-hero-title mb-0">
            <i class="fas fa-wave-square me-2"></i>
            Relevés terrain
          </h2>
          <div class="iot-hero-sub">Projet #{{ idproject }} — Brut + annotations (SIMULATEUR verrouillé).</div>
        </div>

        {# ✅ ACTIONS + EXPORT PDF #}
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <span class="iot-pill">
            <span class="iot-dot"></span>
            <span class="fw-semibold">Live</span>
            <span class="opacity-75 small">15 min</span>
          </span>

          <a class="btn btn-light btn-iot" href="{{ path('agriculteur_releve_terrain_new', {idproject: idproject}) }}">
            <i class="fas fa-plus me-2"></i> Mesure manuelle
          </a>

          <a class="btn btn-outline-light btn-iot" href="{{ path('agriculteur_releve_terrain', {idproject: idproject}) }}">
            Reset
          </a>

          {# ✅ Export PDF Relevés (7 derniers jours + type filtre courant) #}
          <a class="btn btn-danger btn-iot"
             href="{{ path('pdf_releves_terrain', {
               idproject: idproject,
               from: ('now'|date_modify('-7 day'))|date('Y-m-d'),
               to: 'now'|date('Y-m-d'),
               type: typeMesure|default(''),
               qualite: ''
             }) }}"
             target="_blank">
            <i class="fas fa-file-pdf me-2"></i> Export PDF
          </a>
        </div>
      </div>
    </div>

    {{ include('_partials/_flashes.html.twig') }}

    {# KPI #}
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-3 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">Mesures affichées</div>
          <div class="fs-2 fw-bold" data-countup="{{ total }}">0</div>
          <div class="text-muted small">selon filtres</div>
        </div></div>
      </div>
      <div class="col-12 col-md-3 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">Dernière mesure</div>
          <div class="fs-6 fw-bold">
            {% if lastDate %}{{ lastDate|date('d/m/Y H:i') }}{% else %}—{% endif %}
          </div>
          <div class="text-muted small">horodatage</div>
        </div></div>
      </div>
      <div class="col-12 col-md-3 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">Suspects</div>
          <div class="fs-2 fw-bold text-warning" data-countup="{{ suspects }}">0</div>
          <div class="text-muted small">à vérifier</div>
        </div></div>
      </div>
      <div class="col-12 col-md-3 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">Erreurs capteur</div>
          <div class="fs-2 fw-bold text-danger" data-countup="{{ erreurs }}">0</div>
          <div class="text-muted small">exclues des rapports</div>
        </div></div>
      </div>
    </div>

    {# TOOLBAR #}
    <div class="iot-toolbar reveal p-3 mb-3">
      <form method="get" class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
          <label class="form-label">Type (filtre)</label>
          <select name="type" class="form-select toolbar-input">
            <option value="">Tous les types</option>
            {% for t in types %}
              <option value="{{ t }}" {{ (t == typeMesure) ? 'selected' : '' }}>{{ t }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="col-12 col-md-5">
          <label class="form-label">Recherche (timeline)</label>
          <input id="mesureSearch" class="form-control toolbar-input"
                 placeholder="ex: capteur 5, TEMPERATURE, SIMULATEUR, OK...">
          <div class="text-muted small mt-1">Filtre instantané sans rechargement</div>
        </div>

        <div class="col-12 col-md-3 text-md-end">
          <button class="btn btn-dark btn-iot w-100">Appliquer</button>
        </div>
      </form>
    </div>

    {# === le reste de ta page (graph + timeline) inchangé === #}

    <div class="row g-3">
      <div class="col-12 col-xl-8 reveal">
        <div class="chart-wrap">
          <div class="chart-head">
            <span><i class="fas fa-chart-line text-success me-2"></i> Aperçu graphique</span>
            <div class="d-flex gap-2 align-items-center">
              <span class="text-muted small">Type :</span>
              <select id="chartTypeSelect" class="form-select form-select-sm" style="width:260px">
                {% for t in graphTypes %}
                  <option value="{{ t }}">{{ t }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="chart-body">
            {% if graphTypes|length > 0 %}
              <canvas id="chartReleveAgri" height="120"></canvas>
              <div class="text-muted small mt-2">Points: <span id="chartCount">—</span></div>
            {% else %}
              <div class="alert alert-light border mb-0">Aucune donnée pour le graphe.</div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-4 reveal">
        <div class="chart-wrap">
          <div class="chart-head">
            <span><i class="fas fa-bullseye me-2"></i> Qualité</span>
            <span class="text-muted small">OK / SUSPECT / ERREUR</span>
          </div>
          <div class="chart-body">
            <canvas id="chartQualiteAgri" height="160"></canvas>
            <div class="d-flex flex-wrap gap-2 mt-3">
              <span class="chip"><span class="dot ok"></span> OK: {{ ok }}</span>
              <span class="chip"><span class="dot warn"></span> SUSPECT: {{ suspects }}</span>
              <span class="chip"><span class="dot bad"></span> ERREUR: {{ erreurs }}</span>
            </div>
          </div>
        </div>
      </div>

      {# Timeline #}
      <div class="col-12 reveal">
        <div class="panel">
          <div class="panel-h">
            <span><i class="fas fa-layer-group me-2"></i> Timeline des mesures</span>
            <span class="text-muted small">actions intégrées</span>
          </div>
          <div class="panel-b">
            <div class="rt-timeline">
              {% for mesure in mesures %}
                {% set q = mesure.qualite ?? 'OK' %}
                {% set dot = 'dot ok' %}
                {% if q == 'SUSPECT' %}{% set dot = 'dot warn' %}{% endif %}
                {% if q == 'ERREUR_CAPTEUR' %}{% set dot = 'dot bad' %}{% endif %}

                <div class="rt-card"
                     data-item="mesure"
                     data-blob="#{{ mesure.idReleve }} {{ mesure.typeMesure }} {{ mesure.sourceDonnee }} {{ q }} {{ mesure.idCapteur }} {{ mesure.idproject }}">
                  <div class="rt-inner">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                      <div>
                        <div class="fw-bold">Capteur #{{ mesure.idCapteur }} · {{ mesure.typeMesure }}</div>
                        <div class="text-muted small">{{ mesure.dateHeure|date('d/m/Y H:i') }}</div>
                      </div>
                      <span class="chip">
                        <span class="{{ dot }}"></span>
                        {{ q }}
                      </span>
                    </div>

                    <div class="rt-metrics">
                      <div class="metric-pill"><span>Valeur</span><b>{{ mesure.valeurMesuree }} {{ mesure.unite }}</b></div>
                      <div class="metric-pill"><span>Source</span><b>{{ mesure.sourceDonnee }}</b></div>
                    </div>

                    {% if mesure.note %}
                      <div class="rt-note">
                        <i class="fas fa-comment-dots me-1"></i>
                        {{ mesure.note }}
                      </div>
                    {% endif %}

                    <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
                      <a class="btn btn-outline-primary btn-iot"
                         href="{{ path('agriculteur_releve_terrain_annoter', {id: mesure.idReleve}) }}">
                        <i class="fas fa-pen-to-square me-1"></i> Annoter
                      </a>

                      {% if mesure.sourceDonnee == 'MANUEL' %}
                        <a class="btn btn-outline-warning btn-iot"
                           href="{{ path('agriculteur_releve_terrain_edit', {id: mesure.idReleve}) }}">
                          <i class="fas fa-pen me-1"></i> Modifier
                        </a>

                        <form method="post"
                              action="{{ path('agriculteur_releve_terrain_delete', {id: mesure.idReleve}) }}"
                              onsubmit="return confirm('Supprimer cette mesure manuelle ?');">
                          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ mesure.idReleve) }}">
                          <button class="btn btn-outline-danger btn-iot">
                            <i class="fas fa-trash me-1"></i> Supprimer
                          </button>
                        </form>
                      {% else %}
                        <span class="text-muted small align-self-center">Verrouillé (simulateur)</span>
                      {% endif %}
                    </div>

                  </div>
                </div>
              {% else %}
                <div class="text-center text-muted py-4">Aucune mesure trouvée pour ce projet.</div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script defer src="{{ asset('ui/releve-terrain-agri-pro.js') }}"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <script>
    const payload = {{ chartPayload|json_encode|raw }};

    function buildGradient(ctx){
      const g = ctx.createLinearGradient(0,0,0,220);
      g.addColorStop(0, 'rgba(8,150,71,.28)');
      g.addColorStop(1, 'rgba(8,150,71,0)');
      return g;
    }

    const canvasMain = document.getElementById('chartReleveAgri');
    let mainChart = null;

    function renderMain(type){
      const item = payload.find(p => p.type === type);
      if(!item) return;

      document.getElementById('chartCount').textContent = item.values.length;

      const ctx = canvasMain.getContext('2d');
      const fill = buildGradient(ctx);

      if(mainChart) mainChart.destroy();

      mainChart = new Chart(canvasMain, {
        type: 'line',
        data: {
          labels: item.labels,
          datasets: [{
            label: item.type + (item.unit ? (' ('+item.unit+')') : ''),
            data: item.values,
            borderColor: '#089647',
            backgroundColor: fill,
            fill: true,
            borderWidth: 2,
            tension: 0.25,
            pointRadius: 2
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { position: 'bottom' } }
        }
      });
    }

    const select = document.getElementById('chartTypeSelect');
    if(canvasMain && select && payload.length > 0){
      renderMain(select.value);
      select.addEventListener('change', () => renderMain(select.value));
    }

    const donut = document.getElementById('chartQualiteAgri');
    if(donut){
      new Chart(donut, {
        type: 'doughnut',
        data: {
          labels: ['OK', 'SUSPECT', 'ERREUR_CAPTEUR'],
          datasets: [{
            data: [{{ ok }}, {{ suspects }}, {{ erreurs }}],
            backgroundColor: ['#089647', '#f59e0b', '#ef4444'],
            borderWidth: 0
          }]
        },
        options: {
          plugins: { legend: { position: 'bottom' } },
          cutout: '70%'
        }
      });
    }
  </script>
{% endblock %}