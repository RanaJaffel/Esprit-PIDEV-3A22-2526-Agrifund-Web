{% extends 'base.html.twig' %}
{% form_theme generateForm 'bootstrap_5_layout.html.twig' %}

{# ========================= Variables Chart.js ========================= #}
{% set labels = [] %}
{% set moyennes = [] %}
{% set mins = [] %}
{% set maxs = [] %}

{% for r in rapports|default([]) %}
    {% set labels   = labels|merge([ r.typeMesure ~ ' (#' ~ r.idCapteur ~ ')' ]) %}
    {% set moyennes = moyennes|merge([ r.moyenne ]) %}
    {% set mins     = mins|merge([ r.min ]) %}
    {% set maxs     = maxs|merge([ r.max ]) %}
{% endfor %}

{% block title %}Rapport journalier — Projet {{ idproject }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('ui/rapport-journalier-pro.css') }}">
{% endblock %}

{% block hide_preloader %}{% endblock %}

{% block body %}
<div class="iot-page rapport-journalier-pro">
  <div class="container-fluid py-4">

    {# ── HERO ── #}
    <div class="iot-hero hero-agri reveal mb-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <h2 class="iot-hero-title mb-0">
            <i class="fas fa-calendar-day me-2"></i>
            Rapport journalier — Projet #{{ idproject }}
          </h2>
          <div class="iot-hero-sub">
            Synthèse quotidienne par type de mesure &amp; capteur — Date : <b>{{ date|date('d/m/Y') }}</b>
          </div>
        </div>

        {# ✅ ACTIONS + EXPORT PDF #}
        <div class="d-flex gap-2 flex-wrap">
          <a class="btn btn-light btn-iot" href="{{ path('agriculteur_rapport_journalier_home') }}">
            <i class="fas fa-layer-group me-2"></i> Projets
          </a>

          <a class="btn btn-outline-light btn-iot"
             href="{{ path('agriculteur_releve_terrain', {idproject: idproject}) }}">
            <i class="fas fa-wave-square me-2"></i> Données brutes
          </a>

          {# ✅ Export PDF du rapport affiché (date courante) #}
          <a class="btn btn-danger btn-iot"
             href="{{ path('pdf_rapport_journalier', {idproject: idproject, date: date|date('Y-m-d')}) }}"
             target="_blank">
            <i class="fas fa-file-pdf me-2"></i> Export PDF
          </a>
        </div>
      </div>
    </div>

    {{ include('_partials/_flashes.html.twig') }}

    {# ── KPI ── #}
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-4 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">Lignes du rapport</div>
          <div class="fs-2 fw-bold" data-countup="{{ stats.total }}">0</div>
          <div class="text-muted small">type × capteur</div>
        </div></div>
      </div>
      <div class="col-12 col-md-4 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">Alertes</div>
          <div class="fs-2 fw-bold text-danger" data-countup="{{ stats.alerts }}">0</div>
          <div class="text-muted small">Condition ≠ NORMAL</div>
        </div></div>
      </div>
      <div class="col-12 col-md-4 reveal">
        <div class="panel kpi-pro"><div class="panel-b">
          <div class="text-muted small">Types détectés</div>
          <div class="fs-2 fw-bold text-success" data-countup="{{ stats.types }}">0</div>
          <div class="text-muted small">Sur le projet</div>
        </div></div>
      </div>
    </div>

    <div class="row g-3">

      {# ── COL GAUCHE ── #}
      <div class="col-12 col-xl-4">

        {# Générer #}
        <div class="panel reveal mb-3">
          <div class="panel-h">
            <span><i class="fas fa-sync-alt text-success me-2"></i> Générer / Regénérer</span>
            <span class="text-muted small">par date</span>
          </div>
          <div class="panel-b">
            {{ form_start(generateForm) }}
              {{ form_row(generateForm.date) }}
              <button class="btn btn-success btn-iot w-100">Générer le rapport</button>
            {{ form_end(generateForm) }}
            <div class="text-muted small mt-2">
              Calcul depuis <b>releve_terrain</b> (données brutes).
            </div>
          </div>
        </div>

        {# Filtrer #}
        <div class="panel reveal mb-3">
          <div class="panel-h">
            <span><i class="fas fa-filter me-2"></i> Filtrer l'affichage</span>
          </div>
          <div class="panel-b">
            <form method="get">
              <div class="mb-3">
                <label class="form-label">Date</label>
                <input type="date" class="form-control" name="date" value="{{ date|date('Y-m-d') }}">
              </div>
              <div class="mb-3">
                <label class="form-label">Type de mesure</label>
                <select name="type" class="form-select">
                  <option value="">Tous</option>
                  {% for t in types %}
                    <option value="{{ t }}" {{ t == typeMesure ? 'selected' : '' }}>{{ t }}</option>
                  {% endfor %}
                </select>
              </div>
              <button class="btn btn-dark btn-iot w-100">Appliquer</button>
            </form>
          </div>
        </div>

        {# Donut NORMAL vs ALERTES #}
        <div class="chart-wrap reveal">
          <div class="chart-head">
            <span><i class="fas fa-bullseye me-2"></i> NORMAL vs Alertes</span>
            <span class="text-muted small">qualité terrain</span>
          </div>
          <div class="chart-body">
            <canvas id="donutJournalier" height="160"></canvas>
            <div class="d-flex flex-wrap gap-2 mt-3">
              <span class="chip">
                <span class="dot ok"></span>
                NORMAL : {{ stats.total - stats.alerts }}
              </span>
              <span class="chip">
                <span class="dot bad"></span>
                Alertes : {{ stats.alerts }}
              </span>
            </div>
          </div>
        </div>

      </div>

      {# ── COL DROITE ── #}
      <div class="col-12 col-xl-8">

        {# Graphe bar #}
        <div class="chart-wrap reveal mb-3">
          <div class="chart-head">
            <span><i class="fas fa-chart-column text-success me-2"></i> Vue synthétique</span>
            <span class="text-muted small">Moyenne / Min / Max</span>
          </div>
          <div class="chart-body">
            {% if rapports|length > 0 %}
              <canvas id="chartRapport" height="110"></canvas>
            {% else %}
              <div class="alert alert-light border mb-0">
                Aucun rapport pour cette date. Clique sur <b>Générer</b>.
              </div>
            {% endif %}
          </div>
        </div>

        {# Tableau / cards rapport #}
        <div class="panel reveal">
          <div class="panel-h">
            <span><i class="fas fa-layer-group me-2"></i> Détails du rapport</span>
            <span class="text-muted small">par capteur</span>
          </div>
          <div class="panel-b p-0">
            <div class="rapport-timeline">
              {% for r in rapports %}
                {% set cond  = r.conditionDominante %}
                {% set isOk  = (cond == 'NORMAL') %}
                <div class="rapport-card">
                  <div class="rapport-inner">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                      <div>
                        <div class="fw-bold">{{ r.typeMesure }}</div>
                        <div class="text-muted small">Capteur #{{ r.idCapteur }}</div>
                      </div>
                      <span class="chip">
                        <span class="{{ isOk ? 'dot ok' : 'dot bad' }}"></span>
                        {{ cond }}
                      </span>
                    </div>
                    <div class="rapport-metrics">
                      <div class="metric-pill"><span>Moyenne</span><b>{{ r.moyenne }}</b></div>
                      <div class="metric-pill"><span>Min</span><b>{{ r.min }}</b></div>
                      <div class="metric-pill"><span>Max</span><b>{{ r.max }}</b></div>
                      <div class="metric-pill"><span>Nb mesures</span><b>{{ r.nbMesures }}</b></div>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="text-center text-muted py-4 px-3">
                  Aucun rapport disponible. Clique sur <b>Générer</b>.
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script defer src="{{ asset('ui/rapport-journalier-pro.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

{% if rapports|length > 0 %}
<script>
  const canvas = document.getElementById('chartRapport');
  if (canvas) {
    new Chart(canvas, {
      type: 'bar',
      data: {
        labels: {{ labels|json_encode|raw }},
        datasets: [
          { label: 'Moyenne', data: {{ moyennes|json_encode|raw }}, borderWidth: 1 },
          { label: 'Min',     data: {{ mins|json_encode|raw }},     borderWidth: 1 },
          { label: 'Max',     data: {{ maxs|json_encode|raw }},     borderWidth: 1 }
        ]
      },
      options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
    });
  }
</script>
{% endif %}

<script>
  const donut = document.getElementById('donutJournalier');
  if (donut) {
    new Chart(donut, {
      type: 'doughnut',
      data: {
        labels: ['NORMAL', 'ALERTES'],
        datasets: [{
          data: [{{ stats.total - stats.alerts }}, {{ stats.alerts }}],
          backgroundColor: ['#089647', '#ef4444'],
          borderWidth: 0
        }]
      },
      options: { plugins: { legend: { position: 'bottom' } }, cutout: '70%' }
    });
  }
</script>
{% endblock %}
