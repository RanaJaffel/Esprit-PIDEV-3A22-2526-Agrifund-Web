{% extends 'base.html.twig' %}

{% block title %}Rapports journaliers{% endblock %}
{% block stylesheets %}
  {{ encore_entry_link_tags('sidebar') }}
  {{ parent() }}

  <style>
    .dashboard-container { display: flex; min-height: 100vh; }

    .main-content {
      flex: 1;
      margin-left: 280px;
      transition: margin-left 0.3s ease;
    }

    @media (max-width: 991.98px) {
      .main-content { margin-left: 0; }
    }
  </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
  {% include 'components/_sidebar_agriculteur.html.twig' %}
  <div class="main-content">
    <div class="container py-4">

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h3 class="mb-1">Rapports journaliers</h3>
      <div class="text-muted">Sélectionne un projet pour consulter / générer le rapport.</div>
    </div>
    <a class="btn btn-outline-secondary" href="{{ path('agriculteur_dashboard') }}">Retour</a>
  </div>

  {{ include('_partials/_flashes.html.twig') }}

  <div class="row g-3">
    {% for pid in projects %}
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="rounded-4 d-flex align-items-center justify-content-center"
                   style="width:48px;height:48px;background:linear-gradient(135deg,#B2D944,#089647);color:#fff;">
                <i class="fas fa-seedling"></i>
              </div>
              <div class="flex-grow-1">
                <div class="fw-semibold">Projet #{{ pid }}</div>
                <div class="text-muted small">Résumé quotidien (moy/min/max + alertes)</div>
              </div>
            </div>

            <div class="d-grid">
              <a class="btn btn-success"
                 href="{{ path('agriculteur_rapport_journalier', {idproject: pid}) }}">
                Ouvrir les rapports
              </a>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

    </div>
  </div>
</div>
{% endblock %}
{% block javascripts %}
  {{ encore_entry_script_tags('sidebar') }}
  {{ parent() }}
{% endblock %}
