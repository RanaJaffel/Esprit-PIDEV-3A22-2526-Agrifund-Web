{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('agriculteur') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --gris: #848A86;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --jaune-fonce: #c9a020;
            --vert-clair: #B2D944;
            --olive: #9A951F;
            --vert-olive-fonce: #476C1A;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
        }

        .dashboard-container { display: flex; min-height: 100vh; }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 0;
            background: transparent;
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 991.98px) {
            .main-content { margin-left: 0; }
        }

        .main-content > .d-flex.justify-content-between:first-of-type {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 50%, var(--vert-tres-fonce) 100%);
            padding: 28px 35px;
            margin: 0 0 30px 0;
            position: relative;
            overflow: hidden;
        }

        .main-content > .d-flex.justify-content-between:first-of-type::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 10 L35 25 L50 25 L38 35 L42 50 L30 40 L18 50 L22 35 L10 25 L25 25 Z' fill='%23B2D944' fill-opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .main-content > .d-flex.justify-content-between:first-of-type::after {
            content: '';
            position: absolute;
            top: -50%; right: -10%;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(178, 217, 68, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .main-content > .d-flex.justify-content-between:first-of-type h1 {
            color: white !important;
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .main-content > .d-flex.justify-content-between:first-of-type h1 i {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            box-shadow: 0 8px 20px rgba(71, 108, 26, 0.35);
            margin-right: 0 !important;
        }

        .main-content > .d-flex.justify-content-between:first-of-type .btn-secondary {
            background: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
            color: white !important;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .main-content > .d-flex.justify-content-between:first-of-type .btn-secondary:hover {
            background: rgba(239, 68, 68, 0.8) !important;
            border-color: rgba(239, 68, 68, 0.8) !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.3);
        }

        .main-content > .row {
            margin-left: 35px;
            margin-right: 35px;
        }

        @media (max-width: 768px) {
            .main-content > .row {
                margin-left: 20px;
                margin-right: 20px;
            }
        }

        .dashboard-section {
            background: white;
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.6s ease-out forwards;
            opacity: 0;
        }

        .dashboard-section::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair), var(--jaune-moutarde), var(--vert-vif));
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--vert-tres-fonce);
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(71, 108, 26, 0.1);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 0.95rem;
            box-shadow: 0 4px 12px rgba(71, 108, 26, 0.25);
        }

        .form-label {
            font-weight: 600;
            color: var(--vert-tres-fonce);
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .form-control,
        .form-select {
            border: 2px solid #e8ecef;
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: #fafbfc;
            color: var(--vert-tres-fonce);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--vert-olive-fonce);
            box-shadow: 0 0 0 4px rgba(71, 108, 26, 0.12);
            background: white;
            outline: none;
        }

        .form-control:hover,
        .form-select:hover {
            border-color: var(--vert-clair);
        }

        input[type="file"].form-control {
            padding: 14px 18px;
            cursor: pointer;
            background: linear-gradient(135deg, #fafbfc 0%, #f5f7f5 100%);
            border: 2px dashed #d1d5db;
        }

        input[type="file"].form-control:hover {
            border-color: var(--vert-clair);
            background: linear-gradient(135deg, #f5f8f2 0%, #ebf0e3 100%);
        }

        input[type="file"].form-control::-webkit-file-upload-button {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            margin-right: 15px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        input[type="file"].form-control::-webkit-file-upload-button:hover {
            background: linear-gradient(135deg, var(--vert-foret) 0%, var(--vert-tres-fonce) 100%);
        }

        .img-thumbnail {
            border: 4px solid var(--vert-clair) !important;
            border-radius: 16px !important;
            padding: 5px;
            background: white;
            box-shadow: 0 8px 25px rgba(178, 217, 68, 0.2);
            transition: all 0.4s ease;
        }

        .img-thumbnail:hover {
            transform: scale(1.05) rotate(2deg);
            box-shadow: 0 12px 35px rgba(178, 217, 68, 0.3);
        }

        hr.my-4 {
            border: none;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--vert-clair), var(--vert-olive-fonce), var(--vert-clair), transparent);
            margin: 35px 0;
            opacity: 0.3;
        }

        .alert-info {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(79, 70, 229, 0.08) 100%);
            border: none;
            border-left: 5px solid #6366f1;
            border-radius: 14px;
            padding: 18px 24px;
            color: #4338ca;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 25px;
        }

        .alert-info i {
            font-size: 1.2rem;
            color: #6366f1;
        }

        .d-grid.gap-2 {
            gap: 15px !important;
            margin-top: 10px;
        }

        .d-grid .btn-success.btn-lg {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%) !important;
            border: none !important;
            border-radius: 14px;
            padding: 18px 32px;
            font-weight: 700;
            font-size: 1.05rem;
            box-shadow: 0 8px 30px rgba(8, 150, 71, 0.3);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            position: relative;
            overflow: hidden;
            color: white;
        }

        .d-grid .btn-success.btn-lg:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 40px rgba(8, 150, 71, 0.4);
        }

        .d-grid .btn-outline-secondary {
            border: 2px solid var(--gris) !important;
            color: var(--gris) !important;
            background: transparent !important;
            border-radius: 14px;
            padding: 16px 28px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .d-grid .btn-outline-secondary:hover {
            background: var(--gris) !important;
            color: white !important;
            transform: translateY(-2px);
        }

        .row > .col-md-6:first-child {
            border-right: 1px solid rgba(71, 108, 26, 0.08);
            padding-right: 30px;
        }

        .row > .col-md-6:last-child {
            padding-left: 30px;
        }

        @media (max-width: 768px) {
            .row > .col-md-6:first-child {
                border-right: none;
                border-bottom: 1px solid rgba(71, 108, 26, 0.08);
                padding-right: 15px;
                padding-bottom: 30px;
                margin-bottom: 30px;
            }

            .row > .col-md-6:last-child {
                padding-left: 15px;
            }

            .main-content > .d-flex.justify-content-between:first-of-type {
                padding: 20px;
                flex-direction: column;
                gap: 15px;
                align-items: flex-start !important;
            }

            .main-content > .d-flex.justify-content-between:first-of-type h1 {
                font-size: 1.4rem;
            }

            .dashboard-section {
                padding: 25px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {% include 'components/_sidebar_agriculteur.html.twig' %}
        
        <div class="main-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="mb-0">
                    <i class="fas fa-user-edit me-2"></i>Modifier mon Profil
                </h1>
                <a href="{{ path('agriculteur_profile_show') }}" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Annuler
                </a>
            </div>
            
            {% include 'components/_flash_messages.html.twig' %}
            
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="dashboard-section">
                        {{ form_start(form) }}
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-4">
                                        <h5 class="section-title">
                                            <i class="fas fa-user"></i>
                                            Informations Personnelles
                                        </h5>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.nom) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.prenom) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.email) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.tel) }}
                                        </div>
                                    </div>
                                    
                                    <div class="mb-4">
                                        <h5 class="section-title">
                                            <i class="fas fa-camera"></i>
                                            Photo de Profil
                                        </h5>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.photoFile) }}
                                            
                                            {% if utilisateur.photo %}
                                                <div class="mt-3" style="padding: 15px; background: linear-gradient(135deg, #f8faf5 0%, #f0f4e8 100%); border-radius: 12px; border: 2px dashed rgba(71, 108, 26, 0.15);">
                                                    <p class="text-muted mb-2" style="font-weight: 600; color: #476C1A !important; font-size: 0.85rem;">
                                                        <i class="fas fa-image me-1"></i>Photo actuelle:
                                                    </p>
                                                    <img src="{{ asset(utilisateur.photo) }}" 
                                                         alt="Photo actuelle" 
                                                         class="img-thumbnail"
                                                         style="max-width: 180px;">
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="mb-4">
                                        <h5 class="section-title">
                                            <i class="fas fa-tractor"></i>
                                            Informations de l'Exploitation
                                        </h5>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.agriculteur.adresseferme) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.agriculteur.superficieferme) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.agriculteur.typeCulture) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <div class="mb-4">
                                <h5 class="section-title">
                                    <i class="fas fa-lock"></i>
                                    Changer le Mot de Passe
                                </h5>
                                
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle"></i>
                                    <span>Laissez ces champs vides si vous ne souhaitez pas changer votre mot de passe.</span>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        {{ form_row(form.plainPassword.first) }}
                                    </div>
                                    
                                    <div class="col-md-6 mb-3">
                                        {{ form_row(form.plainPassword.second) }}
                                    </div>
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="fas fa-save"></i>Enregistrer les Modifications
                                </button>
                                <a href="{{ path('agriculteur_profile_show') }}" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Annuler et retourner
                                </a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile sidebar toggle
            const mobileSidebarToggle = document.getElementById('mobileSidebarToggle');
            if (mobileSidebarToggle) {
                mobileSidebarToggle.addEventListener('click', function() {
                    const sidebar = document.getElementById('sidebar');
                    const overlay = document.getElementById('sidebarOverlay');
                    if (sidebar) {
                        sidebar.classList.add('show');
                        if (overlay) overlay.classList.add('active');
                        document.body.style.overflow = 'hidden';
                    }
                });
            }

            // Preview image before upload
            const fileInput = document.querySelector('input[type="file"]');
            if (fileInput) {
                fileInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file && file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            let preview = document.querySelector('.img-thumbnail');
                            if (preview) {
                                preview.src = e.target.result;
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>
{% endblock %}