{% extends 'base.html.twig' %}
{% block title %}{{ ressource.nomressource }}{% endblock %}

{% block body %}
    {% include 'components/_sidebar_agriculteur.html.twig' %}

    <main class="agriculteur-main" style="margin-left: 280px; min-height: 100vh; padding: 30px; background: #f5f7f5;">

        <!-- Mobile toggle button -->
        <button class="btn d-lg-none mb-3" id="mobileSidebarToggle"
                style="background: #089647; color: white; border-radius: 10px;">
            <i class="fas fa-bars"></i>
        </button>

        <div class="page-header mb-4 p-4 rounded-3 d-flex justify-content-between align-items-center"
             style="background: linear-gradient(135deg, #095032 0%, #076A39 50%, #089647 100%); color: white;">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item">
                            <a href="{{ path('agriculteur_ressource_project_index') }}" class="text-white-50 text-decoration-none">
                                Mes Ressources
                            </a>
                        </li>
                        <li class="breadcrumb-item active text-white">{{ ressource.nomressource }}</li>
                    </ol>
                </nav>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-box-seam me-2"></i>{{ ressource.nomressource }}
                    <span class="badge ms-2" style="background:#A5D6A7;color:#1B5E20;font-size:.7em">AGRICULTEUR</span>
                </h2>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('agriculteur_ressource_project_edit', {id: ressource.idressource}) }}"
                   class="btn btn-warning fw-semibold" style="border-radius: 10px;">
                    <i class="bi bi-pencil me-1"></i> Modifier
                </a>
                <a href="{{ path('agriculteur_ressource_project_index') }}"
                   class="btn btn-light" style="border-radius: 10px;">
                    <i class="bi bi-arrow-left me-1"></i> Mes Ressources
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header py-3"
                         style="background: #E8F5E9; border-bottom: 2px solid #A5D6A7;">
                        <h5 class="mb-0 fw-semibold" style="color: #1B5E20;">
                            <i class="bi bi-info-circle me-2"></i>Détails de la Ressource
                        </h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless mb-0">
                            <tr>
                                <th class="text-muted w-40">Nom</th>
                                <td class="fw-semibold">{{ ressource.nomressource }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Type</th>
                                <td><span class="badge bg-info">{{ ressource.typeressource }}</span></td>
                            </tr>
                            <tr>
                                <th class="text-muted">Quantité</th>
                                <td>{{ ressource.quantite }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Coût Unitaire</th>
                                <td class="text-success fw-semibold">
                                    {{ ressource.cout|number_format(2, ',', ' ') }} TND
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted">💵 Coût Total</th>
                                <td class="fw-bold" style="color: #1B5E20;">
                                    {{ (ressource.cout * ressource.quantite)|number_format(2, ',', ' ') }} TND
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted">Fournisseur</th>
                                <td>{{ ressource.fournisseur ?? '—' }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Statut</th>
                                <td><span class="badge bg-secondary">{{ ressource.statut }}</span></td>
                            </tr>
                            <tr>
                                <th class="text-muted">Date Ajout</th>
                                <td>{{ ressource.dateajout|date('d/m/Y') }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Projet</th>
                                <td>{{ ressource.project.nomproject }}</td>
                            </tr>
                        </table>
                    </div>
                    <div class="card-footer bg-transparent d-flex justify-content-end">
                        <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="bi bi-trash me-1"></i> Supprimer
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmer la suppression</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Supprimer <strong>{{ ressource.nomressource }}</strong> ?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form method="POST"
                          action="{{ path('agriculteur_ressource_project_delete', {id: ressource.idressource}) }}">
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('delete_ressource_' ~ ressource.idressource) }}">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

{% endblock %}