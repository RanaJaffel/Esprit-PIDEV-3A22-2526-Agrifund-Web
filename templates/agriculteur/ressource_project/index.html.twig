{% extends 'base.html.twig' %}
{% block title %}Mes Ressources{% endblock %}
{% block hide_preloader %}true{% endblock %}

{% block body %}
{% include 'components/_sidebar_agriculteur.html.twig' %}

<style>
    * { box-sizing: border-box; }

    .agri-main {
        margin-left: 280px;
        min-height: 100vh;
        background: #f4f6f4;
        padding: 2rem 2.5rem;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }
    @media (max-width: 991px) {
        .agri-main { margin-left: 0; padding: 1rem; }
    }

    /* ── Page header ── */
    .page-header {
        background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 100%);
        border-radius: 16px;
        padding: 2rem 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px rgba(27,94,32,.35);
    }
    .page-header h2 {
        color: #fff;
        font-size: 1.8rem;
        font-weight: 700;
        margin: 0 0 .25rem;
        letter-spacing: .5px;
    }
    .page-header p {
        color: rgba(255,255,255,.75);
        font-size: .95rem;
        margin: 0;
    }
    .btn-pdf {
        background: linear-gradient(135deg, #F9A825, #F57F17);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .65rem 1.4rem;
        font-weight: 700;
        font-size: .95rem;
        text-decoration: none;
        box-shadow: 0 3px 10px rgba(0,0,0,.25);
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .btn-pdf:hover { opacity: .9; color: #fff; }

    /* ── Toolbar ── */
    .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }
    .toolbar-left {
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
        flex: 1;
    }
    .search-wrap {
        position: relative;
        flex-grow: 1;
        max-width: 360px;
    }
    .search-wrap i {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #aaa;
        pointer-events: none;
    }
    .search-wrap input {
        width: 100%;
        padding: .5rem .9rem .5rem 2.5rem;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        height: 42px;
        font-size: .92rem;
        font-family: inherit;
        outline: none;
        background: #fff;
    }
    .search-wrap input:focus { border-color: #2E7D32; }
    .filter-select {
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        height: 42px;
        padding: 0 .8rem;
        color: #444;
        font-weight: 500;
        font-size: .9rem;
        background: #fff;
        cursor: pointer;
        font-family: inherit;
        outline: none;
    }
    .filter-select:focus { border-color: #2E7D32; }
    .btn-filter {
        height: 42px;
        padding: 0 1.2rem;
        border: none;
        border-radius: 10px;
        background: #2E7D32;
        color: #fff;
        font-weight: 600;
        font-size: .9rem;
        cursor: pointer;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: background .15s;
    }
    .btn-filter:hover { background: #1B5E20; }
    .btn-new {
        height: 42px;
        padding: 0 1.3rem;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #43A047, #2E7D32);
        color: #fff;
        font-weight: 700;
        font-size: .92rem;
        cursor: pointer;
        font-family: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        box-shadow: 0 2px 8px rgba(46,125,50,.3);
        white-space: nowrap;
        transition: opacity .15s;
    }
    .btn-new:hover { opacity: .9; color: #fff; }

    /* ── Resource cards grid ── */
    .resource-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
    }
    .resource-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 14px rgba(0,0,0,.08);
        overflow: hidden;
        transition: transform .2s, box-shadow .2s;
        display: flex;
        flex-direction: column;
    }
    .resource-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 28px rgba(0,0,0,.14);
    }
    .card-accent { height: 5px; }
    .card-body-inner { padding: 1.2rem 1.4rem; flex: 1; }
    .card-footer-inner {
        padding: .6rem 1.4rem 1rem;
        display: flex;
        gap: .5rem;
        border-top: 1px solid #f0f0f0;
    }

    .info-tiles {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .5rem;
        margin-bottom: .5rem;
    }
    .info-tile {
        background: #F5F5F5;
        border-radius: 10px;
        padding: .55rem .8rem;
    }
    .info-tile-label {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #999;
    }
    .info-tile-value {
        font-weight: 700;
        font-size: 1.05rem;
        color: #1B5E20;
    }
    .info-tile-total {
        background: #E8F5E9;
        border-radius: 10px;
        padding: .55rem .8rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: .5rem;
    }

    /* ── Action buttons ── */
    .btn-voir {
        flex: 1;
        background: #E8F5E9;
        color: #2E7D32;
        border: none;
        border-radius: 8px;
        padding: .45rem .6rem;
        font-weight: 600;
        font-size: .82rem;
        text-decoration: none;
        text-align: center;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .3rem;
        transition: background .15s;
    }
    .btn-voir:hover { background: #C8E6C9; color: #1B5E20; }
    .btn-edit {
        flex: 1;
        background: #FFF8E1;
        color: #F57F17;
        border: none;
        border-radius: 8px;
        padding: .45rem .6rem;
        font-weight: 600;
        font-size: .82rem;
        text-decoration: none;
        text-align: center;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .3rem;
        transition: background .15s;
    }
    .btn-edit:hover { background: #FFE082; color: #E65100; }
    .btn-del {
        background: #FFEBEE;
        color: #C62828;
        border: none;
        border-radius: 8px;
        padding: .45rem .7rem;
        font-weight: 600;
        font-size: .82rem;
        cursor: pointer;
        transition: background .15s;
        display: inline-flex;
        align-items: center;
    }
    .btn-del:hover { background: #FFCDD2; }

    /* ── Empty state ── */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,.07);
    }
    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 1.5rem;
    }
    .pagination {
        gap: .35rem;
        flex-wrap: wrap;
    }
    .pagination .page-link {
        border: none;
        border-radius: 8px;
        color: #2E7D32;
        font-weight: 700;
        box-shadow: 0 1px 5px rgba(0,0,0,.08);
    }
    .pagination .page-item.active .page-link {
        background: #2E7D32;
        color: #fff;
    }
    .pagination .page-item.disabled .page-link {
        color: #aaa;
        box-shadow: none;
    }
</style>

<main class="agri-main">

    {# ── Page Header ── #}
    <div class="page-header">
        <div>
            <div style="font-size:2rem; margin-bottom:.3rem;">🎁</div>
            <h2>Mes Ressources</h2>
            <p>Gérez les ressources de vos projets agricoles</p>
        </div>
        <a href="{{ path('agriculteur_ressource_project_export_pdf') }}" class="btn-pdf">
            📄 Exporter PDF
        </a>
    </div>

    {# ── Toolbar ── #}
    <div class="toolbar">
        <form method="GET" action="{{ path('agriculteur_ressource_project_index') }}" class="toolbar-left">
            <input type="hidden" name="page" value="1">

            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="{{ search ?? '' }}"
                       placeholder="Rechercher par nom..."
                       oninput="clearTimeout(this._t);this._t=setTimeout(()=>this.form.submit(),400)">
            </div>

            <select name="type" class="filter-select" onchange="this.form.submit()">
                <option value="">Tous les types</option>
                <option value="equipement" {% if (type ?? '') == 'equipement' %}selected{% endif %}>🚜 Équipement</option>
                <option value="materiaux"  {% if (type ?? '') == 'materiaux'  %}selected{% endif %}>⚙️ Matériaux</option>
                <option value="service"    {% if (type ?? '') == 'service'    %}selected{% endif %}>🔧 Service</option>
            </select>

            <select name="statut" class="filter-select" onchange="this.form.submit()">
                <option value="">Tous les statuts</option>
                <option value="prevu" {% if (statutFilter ?? '') == 'prevu' %}selected{% endif %}>Prevu</option>
                <option value="achete" {% if (statutFilter ?? '') == 'achete' %}selected{% endif %}>Achete</option>
            </select>

            <select name="project" class="filter-select" onchange="this.form.submit()">
                <option value="">Tous les projets</option>
                {% for project in projects %}
                    <option value="{{ project.idproject }}" {% if (projectFilter ?? 0) == project.idproject %}selected{% endif %}>
                        {{ project.nomproject }}
                    </option>
                {% endfor %}
            </select>

            <button type="submit" class="btn-filter">
                <i class="bi bi-funnel"></i> Filtrer
            </button>
        </form>

        <a href="{{ path('agriculteur_ressource_project_new') }}" class="btn-new">
            <i class="bi bi-plus-lg"></i> Nouvelle Ressource
        </a>
    </div>

    {# ── Resource Cards ── #}
    {% if ressources is empty %}
        <div class="empty-state">
            <div style="font-size:4rem;">📦</div>
            <p style="margin-top:1rem; color:#888; font-size:1.1rem;">Aucune ressource trouvée.</p>
            <a href="{{ path('agriculteur_ressource_project_new') }}" class="btn-new" style="margin-top:1rem; display:inline-flex;">
                <i class="bi bi-plus-lg"></i> Ajouter une ressource
            </a>
        </div>
    {% else %}
        <div class="resource-grid">
            {% for r in ressources %}
            <div class="resource-card">

                <div class="card-accent" style="background:
                    {% if r.typeressource == 'equipement' %}linear-gradient(to right,#FF9800,#FFB74D)
                    {% elseif r.typeressource == 'materiaux' %}linear-gradient(to right,#2196F3,#64B5F6)
                    {% else %}linear-gradient(to right,#9C27B0,#CE93D8){% endif %};"></div>

                <div class="card-body-inner">

                    {# Title + badges #}
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:.9rem; gap:.5rem;">
                        <div>
                            <div style="font-weight:700; color:#1B5E20; font-size:1.05rem; margin-bottom:.3rem;">
                                {{ r.nomressource }}
                            </div>
                            <span style="display:inline-block; border-radius:8px; padding:3px 9px; font-size:.74rem; font-weight:600;
                                background:{% if r.typeressource == 'equipement' %}#FFF3E0{% elseif r.typeressource == 'materiaux' %}#E3F2FD{% else %}#F3E5F5{% endif %};
                                color:{% if r.typeressource == 'equipement' %}#E65100{% elseif r.typeressource == 'materiaux' %}#1565C0{% else %}#6A1B9A{% endif %};">
                                {% if r.typeressource == 'equipement' %}🚜{% elseif r.typeressource == 'materiaux' %}⚙️{% else %}🔧{% endif %}
                                {{ r.typeressource|capitalize }}
                            </span>
                        </div>
                        <span style="flex-shrink:0; border-radius:20px; padding:4px 12px; font-size:.76rem; font-weight:600;
                            background:{% if r.statut in ['achete','Disponible'] %}#E8F5E9{% elseif r.statut in ['prevu','En commande'] %}#FFF8E1{% else %}#FFEBEE{% endif %};
                            color:{% if r.statut in ['achete','Disponible'] %}#2E7D32{% elseif r.statut in ['prevu','En commande'] %}#F57F17{% else %}#C62828{% endif %};">
                            {{ r.statut }}
                        </span>
                    </div>

                    {# Metrics #}
                    <div class="info-tiles">
                        <div class="info-tile">
                            <div class="info-tile-label">Quantité</div>
                            <div class="info-tile-value">{{ r.quantite }}</div>
                        </div>
                        <div class="info-tile">
                            <div class="info-tile-label">Coût Unit.</div>
                            <div class="info-tile-value" style="color:#2E7D32; font-size:.95rem;">{{ r.cout|number_format(2, ',', ' ') }} TND</div>
                        </div>
                    </div>
                    <div class="info-tile-total">
                        <span style="font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.4px; color:#555;">💵 Coût Total</span>
                        <span style="font-weight:700; font-size:1.1rem; color:#1B5E20;">{{ (r.cout * r.quantite)|number_format(2, ',', ' ') }} TND</span>
                    </div>

                    {# Project + supplier #}
                    <div style="margin-top:.75rem; font-size:.82rem; color:#777;">
                        <i class="bi bi-kanban" style="color:#2E7D32; margin-right:4px;"></i>
                        <span style="color:#2E7D32; font-weight:600;">{{ r.project.nomproject }}</span>
                    </div>
                    {% if r.fournisseur %}
                    <div style="margin-top:.3rem; font-size:.82rem; color:#777;">
                        <i class="bi bi-building" style="margin-right:4px;"></i>{{ r.fournisseur }}
                    </div>
                    {% endif %}
                    <div style="margin-top:.3rem; font-size:.82rem; color:#777;">
                        <i class="bi bi-calendar3" style="margin-right:4px;"></i>{{ r.dateajout|date('d/m/Y') }}
                    </div>
                </div>

                {# Footer actions #}
                <div class="card-footer-inner">
                    <a href="{{ path('agriculteur_ressource_project_show', {id: r.idressource}) }}" class="btn-voir">
                        <i class="bi bi-eye"></i> Voir
                    </a>
                    <a href="{{ path('agriculteur_ressource_project_edit', {id: r.idressource}) }}" class="btn-edit">
                        <i class="bi bi-pencil"></i> Modifier
                    </a>
                    <form method="POST"
                          action="{{ path('agriculteur_ressource_project_delete', {id: r.idressource}) }}"
                          onsubmit="return confirm('Supprimer « {{ r.nomressource|e('js') }} » ?');"
                          style="margin:0;">
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('delete_ressource_' ~ r.idressource) }}">
                        <button type="submit" class="btn-del">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>

        {% if ressources.getPaginationData is defined %}
            <div class="pagination-wrap">
                {{ knp_pagination_render(ressources) }}
            </div>
        {% endif %}
    {% endif %}

</main>

{% endblock %}
