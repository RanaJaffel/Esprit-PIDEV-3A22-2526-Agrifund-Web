{% extends 'base.html.twig' %}

{% block title %}Mes Ressources{% endblock %}

{% block body %}

{% include 'components/_sidebar_agriculteur.html.twig' %}

<div style="margin-left:280px; padding:20px;">

{# ── HEADER ── #}
<div style="background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 100%);
            border-radius: 16px; padding: 2rem;
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 2rem;">
    <h2 class="text-white">🎁 Mes Ressources</h2>

    <a href="{{ path('agriculteur_ressource_project_export_pdf') }}"
       class="btn btn-warning">
        Exporter PDF
    </a>
</div>

{# ── TOOLBAR ── #}
<div class="d-flex justify-content-between align-items-center mb-4">

    <form method="GET" action="{{ path('agriculteur_ressource_project_index') }}"
          class="d-flex gap-2 w-75">

        <input type="text" name="search" value="{{ search ?? '' }}"
               class="form-control" placeholder="Rechercher...">

        <select name="type" class="form-select">
            <option value="">Tous</option>
            <option value="equipement">Équipement</option>
            <option value="materiaux">Matériaux</option>
            <option value="service">Service</option>
        </select>

        <button class="btn btn-secondary">Filtrer</button>
    </form>

    <a href="{{ path('agriculteur_ressource_project_new') }}"
       class="btn btn-success">
        + Nouvelle Ressource
    </a>

</div>

{# ── LIST ── #}

{% if ressources is empty %}
    <div class="alert alert-info text-center">
        Aucune ressource trouvée.
    </div>
{% else %}

<div class="row">

{% for r in ressources %}
    <div class="col-md-4 mb-3">

        <div class="card shadow-sm h-100">
            <div class="card-body">

                <h5>{{ r.nomressource }}</h5>

                <span class="badge bg-success">
                    {{ r.typeressource }}
                </span>

                <hr>

                <p><b>Quantité:</b> {{ r.quantite }}</p>
                <p><b>Coût:</b> {{ r.cout }} TND</p>

                <p>
                    <b>Projet:</b>
                    {{ r.project.nomproject }}
                </p>

                <div class="d-flex gap-2 mt-3">

                    <a href="{{ path('agriculteur_ressource_project_show', {id: r.idressource}) }}"
                       class="btn btn-primary btn-sm">Voir</a>

                    <a href="{{ path('agriculteur_ressource_project_edit', {id: r.idressource}) }}"
                       class="btn btn-warning btn-sm">Modifier</a>

                    <form method="POST"
                          action="{{ path('agriculteur_ressource_project_delete', {id: r.idressource}) }}">
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('delete_ressource_' ~ r.idressource) }}">
                        <button class="btn btn-danger btn-sm">Supprimer</button>
                    </form>

                </div>

            </div>
        </div>

    </div>
{% endfor %}

</div>

{% endif %}

</div>

{% endblock %}

{% block javascripts %}{% endblock %}