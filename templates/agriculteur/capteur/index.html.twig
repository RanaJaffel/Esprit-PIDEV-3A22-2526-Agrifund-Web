{% extends 'base.html.twig' %}
{% block title %}Mes Capteurs IoT{% endblock %}

{% block stylesheets %}
  {{ encore_entry_link_tags('sidebar') }}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('ui/capteur-agri-pro.css') }}">
  <style>
    .dashboard-container { display: flex; min-height: 100vh; }
    .main-content {
      flex: 1;
      margin-left: 280px;
      padding: 0;
      background: transparent;
      transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; } }
  </style>
{% endblock %}

{% block hide_preloader %}{% endblock %}

{% block body %}
<div class="dashboard-container">
  {% include 'components/_sidebar_agriculteur.html.twig' %}

  <div class="main-content iot-page capteur-agri-pro">
    <div class="container-fluid py-4">

      <div class="iot-hero hero-agri reveal mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div>
            <h2 class="iot-hero-title mb-0">
              <i class="fas fa-satellite-dish me-2"></i>
              Mes Capteurs IoT
            </h2>
            <div class="iot-hero-sub">
              Gérez vos capteurs de surveillance terrain (simulateur / manuel).
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="iot-pill">
              <span class="iot-dot"></span>
              <span class="fw-semibold">Live</span>
              <span class="opacity-75 small">15 min</span>
            </span>

            <a href="{{ path('capteur_new') }}" class="btn btn-light btn-iot">
              <i class="fas fa-plus me-2"></i> Ajouter un capteur
            </a>
          </div>
        </div>
      </div>

      {# FLASH #}
      {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show reveal">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      {% endfor %}
      {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show reveal">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      {% endfor %}

      {# KPI #}
      <div class="row g-3 mb-4">
        <div class="col-12 col-md-3 reveal">
          <div class="iot-card kpi-pro">
            <div class="iot-card-body">
              <div class="kpi-label"><i class="fas fa-microchip me-1"></i>Total</div>
              <div class="kpi-value" data-countup="{{ capteurs|length }}">0</div>
              <div class="kpi-sub">capteurs enregistrés</div>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-3 reveal">
          <div class="iot-card kpi-pro">
            <div class="iot-card-body">
              <div class="kpi-label"><i class="fas fa-circle-check me-1"></i>Actifs</div>
              <div class="kpi-value text-success" data-countup="{{ nbActifs }}">0</div>
              <div class="kpi-sub">en fonctionnement</div>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-3 reveal">
          <div class="iot-card kpi-pro">
            <div class="iot-card-body">
              <div class="kpi-label"><i class="fas fa-triangle-exclamation me-1"></i>Inactifs</div>
              <div class="kpi-value text-danger" data-countup="{{ nbInactifs }}">0</div>
              <div class="kpi-sub">à surveiller</div>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-3 reveal">
          <div class="iot-card kpi-pro">
            <div class="iot-card-body">
              <div class="kpi-label"><i class="fas fa-seedling me-1"></i>Projets</div>
              <div class="kpi-value text-primary" data-countup="{{ nbProjets }}">0</div>
              <div class="kpi-sub">surveillés</div>
            </div>
          </div>
        </div>
      </div>

      {# TOOLBAR #}
      <div class="iot-toolbar reveal p-3 mb-3">
        <div class="row g-2 align-items-center">
          <div class="col-12 col-lg-6">
            <div class="input-group">
              <span class="input-group-text bg-white border-0" style="border-radius:14px 0 0 14px;">
                <i class="fas fa-magnifying-glass"></i>
              </span>
              <input id="capteurSearch" class="form-control toolbar-input border-0"
                     placeholder="Rechercher (ID, type, localisation, modèle, projet...)">
            </div>
          </div>

          <div class="col-6 col-lg-3">
            <select id="capteurFilterStatus" class="form-select toolbar-input">
              <option value="">Tous statuts</option>
              <option value="ACTIF">ACTIF</option>
              <option value="INACTIF">INACTIF</option>
              <option value="EN_PANNE">EN_PANNE</option>
            </select>
          </div>

          <div class="col-6 col-lg-2">
            <select id="capteurFilterType" class="form-select toolbar-input">
              <option value="">Tous types</option>
              <option value="TEMPERATURE">TEMPERATURE</option>
              <option value="HUMIDITE_SOL">HUMIDITE_SOL</option>
              <option value="PH_SOL">PH_SOL</option>
              <option value="PLUVIOMETRIE">PLUVIOMETRIE</option>
              <option value="LUMINOSITE">LUMINOSITE</option>
              <option value="VENT">VENT</option>
            </select>
          </div>

          <div class="col-12 col-lg-1 d-grid">
            <button id="capteurReset" class="btn btn-outline-dark btn-iot">Reset</button>
          </div>
        </div>
      </div>

      {# GRID cards #}
      <div class="row g-3">
        {% for capteur in capteurs %}
          {% set dotClass = 'dot bad' %}
          {% if capteur.statut == 'ACTIF' %}{% set dotClass = 'dot active' %}{% endif %}

          <div class="col-12 col-md-6 col-xl-4 reveal">
            <div class="sensor-card"
                 data-item="capteur"
                 data-status="{{ capteur.statut }}"
                 data-type="{{ capteur.typeCapteur }}"
                 data-blob="#{{ capteur.idCapteur }} {{ capteur.typeCapteur }} {{ capteur.localisation }} {{ capteur.modele }} {{ capteur.idproject }}">
              <div class="sensor-inner">
                <div class="d-flex justify-content-between align-items-start gap-2">
                  <div class="d-flex gap-3">
                    <div class="sensor-ic">
                      <i class="fas fa-satellite-dish"></i>
                    </div>
                    <div>
                      <div class="fw-bold">Capteur #{{ capteur.idCapteur }}</div>
                      <div class="text-muted small">{{ capteur.typeCapteur }} · {{ capteur.localisation }}</div>
                    </div>
                  </div>

                  <span class="chip">
                    <span class="{{ dotClass }}"></span>
                    {{ capteur.statut }}
                  </span>
                </div>

                <div class="mt-3 d-grid gap-2">
                  <div class="d-flex justify-content-between small text-muted">
                    <span>Projet</span><span class="fw-semibold text-dark">#{{ capteur.idproject ?? '-' }}</span>
                  </div>
                  <div class="d-flex justify-content-between small text-muted">
                    <span>Modèle</span><span class="fw-semibold text-dark">{{ capteur.modele }}</span>
                  </div>
                  <div class="d-flex justify-content-between small text-muted">
                    <span>Installé</span><span class="fw-semibold text-dark">{{ capteur.dateInstallation ? capteur.dateInstallation|date('d/m/Y H:i') : '-' }}</span>
                  </div>
                </div>

                <div class="sensor-actions mt-3 d-flex gap-2">
                  <a href="{{ path('capteur_dashboard', {idproject: capteur.idproject}) }}"
                     class="btn btn-outline-dark btn-sm btn-iot w-100">
                    <i class="fas fa-chart-area me-1"></i> Dashboard
                  </a>

                  <a href="{{ path('capteur_edit', {id: capteur.idCapteur}) }}"
                     class="btn btn-outline-warning btn-sm btn-iot" title="Modifier">
                    <i class="fas fa-pen"></i>
                  </a>

                  <form method="post"
                        action="{{ path('capteur_delete', {id: capteur.idCapteur}) }}"
                        onsubmit="return confirm('Supprimer ce capteur ?');"
                        class="m-0">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ capteur.idCapteur) }}">
                    <button class="btn btn-outline-danger btn-sm btn-iot" title="Supprimer">
                      <i class="fas fa-trash"></i>
                    </button>
                  </form>
                </div>

              </div>
            </div>
          </div>

        {% else %}
          <div class="col-12 reveal">
            <div class="iot-card">
              <div class="iot-card-body text-center py-5">
                <div class="display-6 mb-2">📭</div>
                <h5 class="mb-1">Aucun capteur enregistré</h5>
                <div class="text-muted mb-3">Ajoute ton premier capteur pour commencer la surveillance IoT.</div>
                <a href="{{ path('capteur_new') }}" class="btn btn-success btn-iot">
                  <i class="fas fa-plus me-2"></i> Ajouter mon premier capteur
                </a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ encore_entry_script_tags('sidebar') }}
  {{ parent() }}
  <script defer src="{{ asset('ui/capteur-agri-pro.js') }}"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const mobileSidebarToggle = document.getElementById('mobileSidebarToggle');
      if (mobileSidebarToggle) {
        mobileSidebarToggle.addEventListener('click', function() {
          const sidebar = document.getElementById('sidebar');
          const overlay = document.getElementById('sidebarOverlay');
          if (sidebar) {
            sidebar.classList.add('show');
            if (overlay) overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
          }
        });
      }
    });
  </script>
{% endblock %}
