{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block title %}Modifier Capteur{% endblock %}
{% block hide_preloader %}{% endblock %}

{% block stylesheets %}
  {{ encore_entry_link_tags('sidebar') }}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('ui/capteur-agri-pro.css') }}">
  <style>
    .dashboard-container { display: flex; min-height: 100vh; }
    .main-content {
      flex: 1;
      margin-left: 280px;
      padding: 0;
      background: transparent;
      transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; } }
  </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
  {% include 'components/_sidebar_agriculteur.html.twig' %}

  <div class="main-content iot-page capteur-agri-pro">
    <div class="container py-4">

      <div class="iot-hero hero-agri reveal mb-4">
        <h2 class="iot-hero-title mb-0"><i class="fas fa-pen me-2"></i>Modifier Capteur #{{ capteur.idCapteur }}</h2>
        <div class="iot-hero-sub">{{ capteur.typeCapteur }} — {{ capteur.localisation }}</div>
      </div>

      {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      {% endfor %}
      {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      {% endfor %}

      <div class="iot-card reveal">
        <div class="iot-card-header">Mise à jour</div>
        <div class="iot-card-body">
          {{ form_start(form) }}
            <div class="row g-3">
              <div class="col-md-6">{{ form_row(form.typeCapteur) }}</div>
              <div class="col-md-6">{{ form_row(form.statut) }}</div>
              <div class="col-md-6">{{ form_row(form.modele) }}</div>
              <div class="col-md-6">{{ form_row(form.localisation) }}</div>

              <div class="col-12 d-flex gap-2 mt-2">
                {{ form_widget(form.enregistrer, {'attr': {'class': 'btn btn-warning btn-iot w-100'}}) }}
                <a href="{{ path('capteur_index') }}" class="btn btn-outline-secondary btn-iot w-100">Annuler</a>
              </div>
            </div>
          {{ form_end(form) }}
        </div>
      </div>

    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ encore_entry_script_tags('sidebar') }}
  {{ parent() }}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const mobileSidebarToggle = document.getElementById('mobileSidebarToggle');
      if (mobileSidebarToggle) {
        mobileSidebarToggle.addEventListener('click', function() {
          const sidebar = document.getElementById('sidebar');
          const overlay = document.getElementById('sidebarOverlay');
          if (sidebar) {
            sidebar.classList.add('show');
            if (overlay) overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
          }
        });
      }
    });
  </script>
{% endblock %}
