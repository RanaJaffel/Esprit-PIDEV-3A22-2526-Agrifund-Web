<form method="post" action="{{ path('app_capteur_delete', {'idCapteur': capteur.idCapteur}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ capteur.idCapteur) }}">
    <button class="btn">Delete</button>
</form>
