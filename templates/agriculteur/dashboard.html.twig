{% extends 'base.html.twig' %}

{% block title %}Tableau de bord Agriculteur{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('agriculteur') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --gris: #848A86;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --jaune-fonce: #c9a020;
            --vert-clair: #B2D944;
            --olive: #9A951F;
            --vert-olive-fonce: #476C1A;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
        }

        /* ==========================================
           LAYOUT
        ========================================== */
        .dashboard-container { display: flex; min-height: 100vh; }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 0;
            background: transparent;
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 991.98px) {
            .main-content { margin-left: 0; }
        }

        /* ==========================================
           WELCOME BANNER / HEADER
        ========================================== */
        .welcome-banner {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 50%, var(--vert-tres-fonce) 100%);
            padding: 40px 35px;
            margin: 0 0 30px 0;
            position: relative;
            overflow: hidden;
        }

        .welcome-banner::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M40 10 Q50 25 40 40 Q30 25 40 10' fill='%23B2D944' fill-opacity='0.04'/%3E%3Cpath d='M40 40 L40 60' stroke='%23B2D944' stroke-opacity='0.04' stroke-width='2'/%3E%3Cpath d='M20 50 Q30 40 40 50 Q50 40 60 50' fill='none' stroke='%23B2D944' stroke-opacity='0.03' stroke-width='1'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .welcome-banner::after {
            content: '';
            position: absolute;
            top: -50%; right: -10%;
            width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(178, 217, 68, 0.12) 0%, transparent 70%);
            pointer-events: none;
            animation: float 8s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-20px, 20px) scale(1.1); }
        }

        .welcome-banner h1 {
            color: white !important;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 12px;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 15px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .welcome-banner h1 i {
            width: 55px;
            height: 55px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 8px 25px rgba(71, 108, 26, 0.4);
        }

        .welcome-banner p {
            color: rgba(255, 255, 255, 0.9) !important;
            font-size: 1.1rem;
            margin: 0;
            position: relative;
            z-index: 1;
            max-width: 600px;
        }

        .welcome-banner .btn-mobile-toggle {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            color: white !important;
            border-radius: 12px;
            width: 44px; height: 44px;
            z-index: 2;
        }

        /* ==========================================
           CONTENT AREA
        ========================================== */
        .main-content > *:not(.welcome-banner):not(script) {
            margin-left: 35px;
            margin-right: 35px;
        }

        @media (max-width: 768px) {
            .main-content > *:not(.welcome-banner):not(script) {
                margin-left: 20px;
                margin-right: 20px;
            }
        }

        /* ==========================================
           STATUS ALERTS
        ========================================== */
        .status-alert {
            padding: 24px 28px;
            border-radius: 16px;
            margin-bottom: 25px;
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.5s ease-out forwards;
        }

        .status-alert::before {
            content: '';
            position: absolute;
            top: 0; right: 0;
            width: 150px; height: 150px;
            border-radius: 50%;
            opacity: 0.1;
            transform: translate(30%, -30%);
        }

        .status-alert.pending {
            background: linear-gradient(135deg, rgba(225, 179, 35, 0.1) 0%, rgba(225, 179, 35, 0.05) 100%);
            border-left: 5px solid var(--jaune-moutarde);
            box-shadow: 0 4px 20px rgba(225, 179, 35, 0.1);
        }

        .status-alert.pending::before {
            background: var(--jaune-moutarde);
        }

        .status-alert.active {
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.1) 0%, rgba(178, 217, 68, 0.05) 100%);
            border-left: 5px solid var(--vert-vif);
            box-shadow: 0 4px 20px rgba(8, 150, 71, 0.1);
        }

        .status-alert.active::before {
            background: var(--vert-vif);
        }

        .status-alert.rejected {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(239, 68, 68, 0.05) 100%);
            border-left: 5px solid #ef4444;
            box-shadow: 0 4px 20px rgba(239, 68, 68, 0.1);
        }

        .status-alert.rejected::before {
            background: #ef4444;
        }

        .status-alert h5 {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .status-alert.pending h5 { color: var(--jaune-fonce); }
        .status-alert.active h5 { color: var(--vert-fonce); }
        .status-alert.rejected h5 { color: #dc2626; }

        .status-alert h5 i {
            font-size: 1.2rem;
        }

        .status-alert p {
            margin: 0;
            color: var(--gris);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        /* ==========================================
           STAT CARDS
        ========================================== */
        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(0, 0, 0, 0.04);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-align: center;
            animation: fadeInUp 0.5s ease-out forwards;
            opacity: 0;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            transition: height 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        }

        .stat-card:hover::before { height: 6px; }

        .col-md-3:nth-child(1) .stat-card::before {
            background: linear-gradient(90deg, var(--vert-clair), var(--vert-olive-fonce));
        }
        .col-md-3:nth-child(2) .stat-card::before {
            background: linear-gradient(90deg, var(--vert-vif), var(--vert-fonce));
        }
        .col-md-3:nth-child(3) .stat-card::before {
            background: linear-gradient(90deg, var(--jaune-moutarde), var(--jaune-fonce));
        }
        .col-md-3:nth-child(4) .stat-card::before {
            background: linear-gradient(90deg, #ef4444, #f87171);
        }

        .col-md-3:nth-child(1) .stat-card { animation-delay: 0.1s; }
        .col-md-3:nth-child(2) .stat-card { animation-delay: 0.15s; }
        .col-md-3:nth-child(3) .stat-card { animation-delay: 0.2s; }
        .col-md-3:nth-child(4) .stat-card { animation-delay: 0.25s; }

        .stat-card .icon {
            width: 65px;
            height: 65px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            font-size: 1.6rem;
            transition: all 0.3s ease;
        }

        .stat-card:hover .icon {
            transform: scale(1.1) rotate(-5deg);
        }

        .stat-value {
            font-size: 2.8rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 10px;
            letter-spacing: -1px;
            transition: all 0.3s ease;
        }

        .stat-card:hover .stat-value {
            transform: scale(1.05);
        }

        .col-md-3:nth-child(1) .stat-value {
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-value.text-success {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%) !important;
            -webkit-background-clip: text !important;
            -webkit-text-fill-color: transparent !important;
            background-clip: text !important;
        }

        .stat-value.text-warning {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, var(--jaune-fonce) 100%) !important;
            -webkit-background-clip: text !important;
            -webkit-text-fill-color: transparent !important;
            background-clip: text !important;
        }

        .col-md-3:nth-child(4) .stat-value {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--gris);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Watermark icons */
        .stat-card::after {
            position: absolute;
            bottom: 10px; right: 15px;
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            font-size: 3.5rem;
            opacity: 0.05;
            transition: opacity 0.3s ease;
        }

        .stat-card:hover::after { opacity: 0.1; }

        .col-md-3:nth-child(1) .stat-card::after { content: '\f15b'; }
        .col-md-3:nth-child(2) .stat-card::after { content: '\f00c'; }
        .col-md-3:nth-child(3) .stat-card::after { content: '\f017'; }
        .col-md-3:nth-child(4) .stat-card::after { content: '\f0e0'; }

        /* ==========================================
           DASHBOARD SECTIONS
        ========================================== */
        .dashboard-section {
            background: white;
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.6s ease-out forwards;
            opacity: 0;
            animation-delay: 0.3s;
        }

        .dashboard-section::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair), var(--jaune-moutarde));
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .section-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--vert-tres-fonce);
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(71, 108, 26, 0.1);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
            box-shadow: 0 4px 15px rgba(71, 108, 26, 0.25);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(71, 108, 26, 0.1);
        }

        .section-header .section-title {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        /* ==========================================
           INFO TABLE
        ========================================== */
        .table-borderless {
            margin: 0;
        }

        .table-borderless tr {
            border-bottom: 1px solid rgba(0, 0, 0, 0.04);
            transition: all 0.3s ease;
        }

        .table-borderless tr:last-child {
            border-bottom: none;
        }

        .table-borderless tr:hover {
            background: linear-gradient(90deg, rgba(71, 108, 26, 0.04) 0%, rgba(178, 217, 68, 0.02) 100%);
            transform: translateX(5px);
        }

        .table-borderless th {
            font-weight: 600;
            color: var(--gris);
            font-size: 0.9rem;
            padding: 14px 15px 14px 0;
            vertical-align: middle;
        }

        .table-borderless td {
            color: var(--vert-tres-fonce);
            font-size: 0.95rem;
            padding: 14px 0;
            vertical-align: middle;
        }

        .table-borderless td strong {
            color: var(--vert-olive-fonce);
            font-weight: 700;
        }

        /* HR Divider */
        hr {
            border: none;
            height: 2px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair), transparent);
            margin: 25px 0;
            opacity: 0.2;
        }

        /* ==========================================
           BADGES
        ========================================== */
        .badge {
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .badge.bg-success {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%) !important;
            color: white;
            box-shadow: 0 3px 10px rgba(8, 150, 71, 0.2);
        }

        .badge.bg-warning {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, var(--jaune-fonce) 100%) !important;
            color: white;
            box-shadow: 0 3px 10px rgba(225, 179, 35, 0.2);
        }

        .badge.bg-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
            color: white;
            box-shadow: 0 3px 10px rgba(239, 68, 68, 0.2);
        }

        .badge.bg-info {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
            color: white;
            box-shadow: 0 3px 10px rgba(99, 102, 241, 0.2);
        }

        .badge.bg-secondary {
            background: linear-gradient(135deg, var(--gris) 0%, #6b7280 100%) !important;
            color: white;
        }

        /* ==========================================
           BUTTONS
        ========================================== */
        .btn {
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            position: relative;
            overflow: hidden;
        }

        .btn-success {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%) !important;
            border: none !important;
            color: white;
            box-shadow: 0 6px 20px rgba(8, 150, 71, 0.25);
        }

        .btn-success:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(8, 150, 71, 0.35);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%) !important;
            border: none !important;
            color: white;
            box-shadow: 0 6px 20px rgba(71, 108, 26, 0.25);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(71, 108, 26, 0.35);
        }

        .btn-outline-primary {
            border: 2px solid var(--vert-olive-fonce) !important;
            color: var(--vert-olive-fonce) !important;
            background: transparent !important;
        }

        .btn-outline-primary:hover {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%) !important;
            border-color: var(--vert-olive-fonce) !important;
            color: white !important;
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(71, 108, 26, 0.3);
        }

        .btn-outline-secondary {
            border: 2px solid var(--gris) !important;
            color: var(--gris) !important;
            background: transparent !important;
        }

        .btn-outline-secondary:hover {
            background: var(--gris) !important;
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(132, 138, 134, 0.25);
        }

        .btn-outline-success {
            border: 2px solid var(--vert-vif) !important;
            color: var(--vert-vif) !important;
            background: transparent !important;
        }

        .btn-outline-success:hover {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%) !important;
            border-color: var(--vert-vif) !important;
            color: white !important;
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(8, 150, 71, 0.3);
        }

        .btn-lg {
            padding: 14px 24px;
            font-size: 1rem;
        }

        .btn-sm {
            padding: 8px 14px;
            font-size: 0.85rem;
            border-radius: 10px;
        }

        .d-grid.gap-3 {
            gap: 15px !important;
        }

        /* Button shine effect */
        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .btn:hover::before {
            left: 100%;
        }

        /* ==========================================
           TABLE CUSTOM
        ========================================== */
        .table-custom {
            margin: 0;
            border-collapse: collapse;
            width: 100%;
        }

        .table-custom thead {
            background: linear-gradient(90deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
        }

        .table-custom thead th {
            color: white !important;
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 14px 16px;
            border: none !important;
            position: relative;
            white-space: nowrap;
        }

        .table-custom thead th:not(:last-child)::after {
            content: '';
            position: absolute;
            right: 0; top: 50%;
            transform: translateY(-50%);
            width: 1px; height: 20px;
            background: rgba(255, 255, 255, 0.15);
        }

        .table-custom tbody tr {
            transition: all 0.3s ease;
            border-bottom: 1px solid rgba(0, 0, 0, 0.04);
        }

        .table-custom tbody tr:last-child { border-bottom: none; }

        .table-custom tbody tr:hover {
            background: linear-gradient(90deg, rgba(71, 108, 26, 0.05) 0%, rgba(178, 217, 68, 0.03) 100%);
            transform: scale(1.002);
        }

        .table-custom tbody td {
            padding: 14px 16px;
            vertical-align: middle;
            color: var(--vert-tres-fonce);
            font-size: 0.9rem;
            border: none !important;
        }

        /* Row animations */
        .table-custom tbody tr {
            opacity: 0;
            animation: fadeInRow 0.4s ease-out forwards;
        }

        .table-custom tbody tr:nth-child(1) { animation-delay: 0.1s; }
        .table-custom tbody tr:nth-child(2) { animation-delay: 0.15s; }
        .table-custom tbody tr:nth-child(3) { animation-delay: 0.2s; }
        .table-custom tbody tr:nth-child(4) { animation-delay: 0.25s; }
        .table-custom tbody tr:nth-child(5) { animation-delay: 0.3s; }

        @keyframes fadeInRow {
            from { opacity: 0; transform: translateX(-10px); }
            to { opacity: 1; transform: translateX(0); }
        }

        /* ==========================================
           EMPTY STATE
        ========================================== */
        .text-center.text-muted.py-5 {
            padding: 60px 20px !important;
        }

        .text-center.text-muted.py-5 i {
            color: var(--vert-clair);
            opacity: 0.35;
        }

        .text-center.text-muted.py-5 h5 {
            color: var(--vert-tres-fonce);
            font-weight: 600;
            margin-bottom: 10px;
        }

        .text-center.text-muted.py-5 p {
            color: var(--gris);
        }

        /* ==========================================
           FLASH MESSAGES
        ========================================== */
        .alert {
            border-radius: 14px;
            border: none;
            padding: 16px 24px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .alert-success {
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.1) 0%, rgba(178, 217, 68, 0.1) 100%);
            color: var(--vert-fonce);
            border-left: 4px solid var(--vert-vif);
        }

        .alert-danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
            color: #b91c1c;
            border-left: 4px solid #ef4444;
        }

        .alert-warning {
            background: linear-gradient(135deg, rgba(225, 179, 35, 0.15) 0%, rgba(225, 179, 35, 0.1) 100%);
            color: #92750d;
            border-left: 4px solid var(--jaune-moutarde);
        }

        /* ==========================================
           WATERMARKS
        ========================================== */
        .col-md-6:nth-child(1) .dashboard-section::after {
            content: '\f722';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute;
            bottom: 20px;
            right: 25px;
            font-size: 5rem;
            color: var(--vert-olive-fonce);
            opacity: 0.03;
            pointer-events: none;
        }

        .col-md-6:nth-child(2) .dashboard-section::after {
            content: '\f0e7';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute;
            bottom: 20px;
            right: 25px;
            font-size: 5rem;
            color: var(--vert-olive-fonce);
            opacity: 0.03;
            pointer-events: none;
        }

        .col-12 .dashboard-section::after {
            content: '\f15b';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute;
            bottom: 20px;
            right: 30px;
            font-size: 6rem;
            color: var(--vert-olive-fonce);
            opacity: 0.03;
            pointer-events: none;
        }

        /* ==========================================
           RESPONSIVE
        ========================================== */
        @media (max-width: 768px) {
            .welcome-banner {
                padding: 30px 20px;
            }

            .welcome-banner h1 {
                font-size: 1.5rem;
            }

            .welcome-banner h1 i {
                width: 45px;
                height: 45px;
                font-size: 1.2rem;
            }

            .welcome-banner p {
                font-size: 0.95rem;
            }

            .stat-card {
                padding: 20px;
                margin-bottom: 15px;
            }

            .stat-value {
                font-size: 2.2rem;
            }

            .dashboard-section {
                padding: 20px;
            }

            .section-header {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start;
            }

            .table-custom thead th,
            .table-custom tbody td {
                padding: 12px 10px;
                font-size: 0.8rem;
            }
        }

        /* ==========================================
           ANIMATIONS
        ========================================== */
        .col-md-6:nth-child(1) .dashboard-section { animation-delay: 0.35s; }
        .col-md-6:nth-child(2) .dashboard-section { animation-delay: 0.4s; }
        .col-12 .dashboard-section { animation-delay: 0.45s; }

        /* ==========================================
           CUSTOM SCROLLBAR
        ========================================== */
        .main-content::-webkit-scrollbar { width: 8px; }
        .main-content::-webkit-scrollbar-track { background: #f1f1f1; }
        .main-content::-webkit-scrollbar-thumb {
            background: var(--vert-olive-fonce);
            border-radius: 4px;
        }
        .main-content::-webkit-scrollbar-thumb:hover {
            background: var(--vert-foret);
        }

        /* ==========================================
           HOVER MICRO-INTERACTIONS
        ========================================== */
        .dashboard-section {
            transition: all 0.3s ease;
        }

        .dashboard-section:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {% include 'components/_sidebar_agriculteur.html.twig' %}
        
        <div class="main-content">
            {# Welcome Banner #}
            <div class="welcome-banner">
                <button class="btn btn-mobile-toggle d-md-none" id="mobileSidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <h1>
                    <i class="fas fa-tractor"></i>
                    Bienvenue, {{ app.user.prenom }} !
                </h1>
                <p>
                    Gérez votre exploitation agricole et vos documents en toute simplicité.
                </p>
            </div>
            
            {% include 'components/_flash_messages.html.twig' %}
            
            {# Status Alert #}
            {% set status = compte_statut.status %}
            {% if status == 'en_attente' %}
                <div class="status-alert pending">
                    <h5>
                        <i class="fas fa-clock"></i>
                        Votre compte est en attente de vérification
                    </h5>
                    <p>
                        Un administrateur examine actuellement votre demande. Vous recevrez une notification une fois votre compte validé.
                    </p>
                </div>
            {% elseif status == 'actif' %}
                <div class="status-alert active">
                    <h5>
                        <i class="fas fa-check-circle"></i>
                        Votre compte est actif et vérifié
                    </h5>
                    <p>
                        Vous avez accès à toutes les fonctionnalités de la plateforme.
                    </p>
                </div>
            {% elseif status == 'refuse' %}
                <div class="status-alert rejected">
                    <h5>
                        <i class="fas fa-times-circle"></i>
                        Votre compte a été refusé
                    </h5>
                    <p>
                        Veuillez contacter l'administration pour plus d'informations.
                    </p>
                </div>
            {% endif %}
            
            {# Statistics #}
            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="icon" style="background: rgba(178, 217, 68, 0.2); color: var(--vert-clair);">
                            <i class="fas fa-file-alt"></i>
                        </div>
                        <div class="stat-value">{{ documents_stats.total }}</div>
                        <div class="stat-label">Total Documents</div>
                    </div>
                </div>
                
                <div class="col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="icon" style="background: rgba(8, 150, 71, 0.2); color: var(--vert-vif);">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-value text-success">{{ documents_stats.valides }}</div>
                        <div class="stat-label">Documents Validés</div>
                    </div>
                </div>
                
                <div class="col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="icon" style="background: rgba(225, 179, 35, 0.2); color: var(--jaune-moutarde);">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="stat-value text-warning">{{ documents_stats.en_attente }}</div>
                        <div class="stat-label">En Attente</div>
                    </div>
                </div>
                
                <div class="col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="icon" style="background: rgba(239, 68, 68, 0.2); color: #ef4444;">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="stat-value">{{ messages_non_lus }}</div>
                        <div class="stat-label">Messages Non Lus</div>
                    </div>
                </div>
            </div>
            
            <div class="row">
                {# Informations de l'exploitation #}
                <div class="col-md-6 mb-4">
                    <div class="dashboard-section">
                        <h5 class="section-title">
                            <i class="fas fa-tractor"></i>
                            Mon Exploitation
                        </h5>
                        
                        <table class="table table-borderless">
                            <tr>
                                <th width="40%">Adresse:</th>
                                <td>{{ agriculteur.adresseferme ?? 'Non renseignée' }}</td>
                            </tr>
                            <tr>
                                <th>Superficie:</th>
                                <td>
                                    {% if agriculteur.superficieferme %}
                                        <strong>{{ agriculteur.superficieferme }} hectares</strong>
                                    {% else %}
                                        Non renseignée
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>Type de culture:</th>
                                <td>
                                    {% if agriculteur.typeCulture %}
                                        <span class="badge bg-success">
                                            <i class="fas fa-seedling me-1"></i>{{ agriculteur.typeCulture }}
                                        </span>
                                    {% else %}
                                        Non renseigné
                                    {% endif %}
                                </td>
                            </tr>
                        </table>
                        
                        <hr>
                        
                        <a href="{{ path('agriculteur_profile_edit') }}" class="btn btn-outline-primary w-100">
                            <i class="fas fa-edit"></i>Modifier mes informations
                        </a>
                    </div>
                </div>
                
                {# Quick Actions #}
                <div class="col-md-6 mb-4">
                    <div class="dashboard-section">
                        <h5 class="section-title">
                            <i class="fas fa-bolt"></i>
                            Actions Rapides
                        </h5>
                        
                        <div class="d-grid gap-3">
                            <a href="{{ path('agriculteur_documents_add') }}" class="btn btn-success btn-lg">
                                <i class="fas fa-upload"></i>Ajouter un Document
                            </a>
                            
                            <a href="{{ path('agriculteur_messagerie_new') }}" class="btn btn-primary btn-lg">
                                <i class="fas fa-envelope"></i>Nouveau Message
                            </a>
                            
                            <a href="{{ path('agriculteur_documents_index') }}" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-folder"></i>Mes Documents
                            </a>
                            
                            <a href="{{ path('agriculteur_messagerie_index') }}" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-comments"></i>Messagerie
                                {% if messages_non_lus > 0 %}
                                    <span class="badge bg-danger ms-2">{{ messages_non_lus }}</span>
                                {% endif %}
                            </a>
                        </div>
                    </div>
                </div>
                
                {# Documents récents #}
                <div class="col-12">
                    <div class="dashboard-section">
                        <div class="section-header">
                            <h5 class="section-title">
                                <i class="fas fa-file-alt"></i>
                                Documents Récents
                            </h5>
                            <a href="{{ path('agriculteur_documents_index') }}" class="btn btn-sm btn-outline-primary">
                                Voir tous
                                <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                        
                        {% if documents_recents|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-custom">
                                <thead>
                                    <tr>
                                        <th>Document</th>
                                        <th>Type</th>
                                        <th>Date d'envoi</th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for document in documents_recents %}
                                    <tr>
                                        <td>
                                            <i class="fas fa-file-alt me-2" style="color: var(--vert-olive-fonce);"></i>
                                            {{ document.nom }}
                                        </td>
                                        <td>
                                            <span class="badge bg-info">{{ document.typeDocument }}</span>
                                        </td>
                                        <td>{{ document.dateUpload|date('d/m/Y H:i') }}</td>
                                        <td>
                                            <span class="badge bg-{{ document.statutBadgeClass }}">
                                                {% if document.statut == 'valide' %}
                                                    <i class="fas fa-check me-1"></i>
                                                {% elseif document.statut == 'rejete' %}
                                                    <i class="fas fa-times me-1"></i>
                                                {% else %}
                                                    <i class="fas fa-clock me-1"></i>
                                                {% endif %}
                                                {{ document.statut }}
                                            </span>
                                        </td>
                                        <td>
                                            <a href="{{ path('agriculteur_documents_download', {id: document.id}) }}" 
                                               class="btn btn-sm btn-outline-success"
                                               target="_blank"
                                               title="Télécharger">
                                                <i class="fas fa-download"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% else %}
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-file-alt fa-5x mb-3 d-block"></i>
                            <h5>Aucun document</h5>
                            <p>Commencez par ajouter votre premier document.</p>
                            <a href="{{ path('agriculteur_documents_add') }}" class="btn btn-primary mt-3">
                                <i class="fas fa-plus me-2"></i>Ajouter un document
                            </a>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile sidebar toggle
            const mobileSidebarToggle = document.getElementById('mobileSidebarToggle');
            if (mobileSidebarToggle) {
                mobileSidebarToggle.addEventListener('click', function() {
                    const sidebar = document.getElementById('sidebar');
                    const overlay = document.getElementById('sidebarOverlay');
                    if (sidebar) {
                        sidebar.classList.add('show');
                        if (overlay) overlay.classList.add('active');
                        document.body.style.overflow = 'hidden';
                    }
                });
            }

            // Counter animation
            function animateValue(el, start, end, duration) {
                let startTimestamp = null;
                const step = (timestamp) => {
                    if (!startTimestamp) startTimestamp = timestamp;
                    const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                    el.textContent = Math.floor(progress * (end - start) + start);
                    if (progress < 1) {
                        window.requestAnimationFrame(step);
                    }
                };
                window.requestAnimationFrame(step);
            }

            // Animate stat values
            document.querySelectorAll('.stat-value').forEach(function(el) {
                const value = parseInt(el.textContent);
                if (!isNaN(value) && value > 0) {
                    el.textContent = '0';
                    setTimeout(() => animateValue(el, 0, value, 1000), 500);
                }
            });

            // Stat card hover effects
            document.querySelectorAll('.stat-card').forEach(function(card) {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-8px) scale(1.02)';
                });
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0) scale(1)';
                });
            });

            // Button ripple effect
            document.querySelectorAll('.btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const ripple = document.createElement('span');
                    const rect = this.getBoundingClientRect();
                    ripple.style.cssText = `
                        position: absolute;
                        background: rgba(255,255,255,0.3);
                        border-radius: 50%;
                        width: 100px;
                        height: 100px;
                        left: ${e.clientX - rect.left - 50}px;
                        top: ${e.clientY - rect.top - 50}px;
                        transform: scale(0);
                        animation: btnRipple 0.6s ease-out;
                        pointer-events: none;
                    `;
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });
        });
    </script>
    <style>
        @keyframes btnRipple {
            to { transform: scale(4); opacity: 0; }
        }
    </style>
{% endblock %}