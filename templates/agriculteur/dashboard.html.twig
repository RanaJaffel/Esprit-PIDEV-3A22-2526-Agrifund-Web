{# templates/agriculteur/dashboard.html.twig #}
{% extends 'agriculteur/base.html.twig' %}

{% block title %}AgriFund - Tableau de bord Agriculteur{% endblock %}

{% block stylesheets %}
<style>
    /* Status Dashboard Specific Styles */
    .status-banner {
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-tres-fonce) 100%);
        border-radius: 20px;
        padding: 35px;
        color: white;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

    .status-banner::after {
        content: '\f1da';
        font-family: 'Font Awesome 5 Free';
        font-weight: 900;
        position: absolute;
        right: -20px;
        bottom: -20px;
        font-size: 10rem;
        opacity: 0.05;
        transform: rotate(-15deg);
    }

    .status-badge-large {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 18px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 100px;
        font-size: 0.8rem;
        font-weight: 600;
        backdrop-filter: blur(5px);
        margin-bottom: 15px;
    }

    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--vert-clair);
        box-shadow: 0 0 10px var(--vert-clair);
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-mini-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        border: 1px solid rgba(0, 0, 0, 0.02);
    }

    .stat-mini-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .bg-soft-success { background: #f0fdf4; color: var(--vert-vif); }
    .bg-soft-warning { background: #fffbeb; color: var(--jaune-moutarde); }
    .bg-soft-danger { background: #fef2f2; color: #ef4444; }
    .bg-soft-info { background: #f0f9ff; color: #0ea5e9; }

    .stat-mini-info .value {
        font-size: 1.25rem;
        font-weight: 800;
        display: block;
        line-height: 1;
        margin-bottom: 2px;
    }

    .stat-mini-info .label {
        font-size: 0.72rem;
        color: var(--gris);
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 30px;
    }

    .content-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        border: 1px solid rgba(0, 0, 0, 0.02);
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .card-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--vert-tres-fonce);
        margin: 0;
    }

    .recent-table th {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--gris);
        font-weight: 700;
        border: none;
        padding-bottom: 12px;
    }

    .recent-table td {
        vertical-align: middle;
        padding: 12px 0;
        font-size: 0.9rem;
        border-top: 1px solid #f8fafc;
    }

    @media (max-width: 1200px) {
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        .dashboard-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 576px) {
        .stats-row { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block body %}
    <!-- Welcome Status -->
    <div class="status-banner">
        <div class="status-badge-large">
            <span class="status-dot"></span>
            Compte {{ compte_statut.verifie ? 'Vérifié' : 'En cours de vérification' }}
        </div>
        <h1>Bonjour, {{ agriculteur.utilisateur.prenom }} !</h1>
        <p class="mb-0 opacity-75">Bienvenue dans votre espace AgriFund. Suivez vos dossiers et découvrez nos nouveaux produits financiers.</p>
    </div>

    <!-- Quick Stats -->
    <div class="stats-row">
        <div class="stat-mini-card">
            <div class="stat-mini-icon bg-soft-info">
                <i class="fas fa-file-alt"></i>
            </div>
            <div class="stat-mini-info">
                <span class="value">{{ documents_stats.total }}</span>
                <span class="label">Documents</span>
            </div>
        </div>
        <div class="stat-mini-card">
            <div class="stat-mini-icon bg-soft-success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-mini-info">
                <span class="value">{{ documents_stats.valides }}</span>
                <span class="label">Validés</span>
            </div>
        </div>
        <div class="stat-mini-card">
            <div class="stat-mini-icon bg-soft-warning">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-mini-info">
                <span class="value">{{ documents_stats.en_attente }}</span>
                <span class="label">En attente</span>
            </div>
        </div>
        <div class="stat-mini-card">
            <div class="stat-mini-icon bg-soft-danger">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-mini-info">
                <span class="value">{{ documents_stats.rejetes }}</span>
                <span class="label">Rejetés</span>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <!-- Recent Documents -->
        <div class="content-card">
            <div class="card-header-flex">
                <h3 class="card-title">Derniers Documents</h3>
                <a href="{{ path('agriculteur_documents_index') }}" class="btn btn-sm btn-outline-success">Tout voir</a>
            </div>
            <div class="table-responsive">
                <table class="table recent-table">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Date</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for doc in documents_recents %}
                            <tr>
                                <td class="fw-bold">{{ doc.nom }}</td>
                                <td>{{ doc.dateUpload|date('d/m/Y') }}</td>
                                <td>
                                    <span class="badge {% if doc.statut == 'valide' %}bg-success{% elseif doc.statut == 'en_attente' %}bg-warning{% else %}bg-danger{% endif %}">
                                        {{ doc.statut|capitalize }}
                                    </span>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">Aucun document déposé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Quick Actions / Sidebar -->
        <div class="content-card">
            <h3 class="card-title mb-4">Actions Rapides</h3>
            <div class="d-grid gap-3">
                <a href="{{ path('agriculteur_documents_add') }}" class="btn btn-success py-3">
                    <i class="fas fa-plus-circle me-2"></i> Déposer un document
                </a>
                <a href="{{ path('agriculteur_produits') }}" class="btn btn-primary py-3">
                    <i class="fas fa-search me-2"></i> Prospecter des produits
                </a>
                <a href="{{ path('agriculteur_messagerie_new') }}" class="btn btn-outline-primary py-3">
                    <i class="fas fa-paper-plane me-2"></i> Contacter un conseiller
                </a>
            </div>
            
            <hr class="my-4">
            
            <div class="text-center p-3 bg-light rounded-4">
                <i class="fas fa-info-circle text-success mb-2"></i>
                <p class="small text-muted mb-0">Besoin d'aide ? Consultez notre guide d'utilisation ou contactez le support.</p>
            </div>
        </div>
    </div>
{% endblock %}