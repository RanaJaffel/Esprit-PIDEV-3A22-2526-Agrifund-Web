{% extends 'base.html.twig' %}

{% block title %}Mes Projets Agricoles{% endblock %}

{% block body %}

{% include 'components/_sidebar_agriculteur.html.twig' %}

<div style="margin-left:280px; padding:20px;">

<div style="background:linear-gradient(135deg,#1B4D1F 0%,#2E7D32 100%);
            border-radius:14px; padding:1.5rem 2rem;
            display:flex; align-items:center; justify-content:space-between;
            margin-bottom:1.8rem;">
    <h2 class="text-white mb-0">🌿 Gestion des Projets Agricoles</h2>

```
<a href="{{ path('agriculteur_project_agricole_export_pdf') }}"
   class="btn btn-warning">
    Exporter PDF
</a>
```

</div>

<div class="d-flex justify-content-between align-items-center mb-4">

```
<input type="text" id="searchInput"
       placeholder="Rechercher..."
       class="form-control w-25"
       oninput="applyFilters()">

<select id="statutFilter" onchange="applyFilters()" class="form-select w-25">
    <option value="">Tous</option>
    <option value="en cours">En cours</option>
    <option value="accepte">Accepté</option>
    <option value="refuse">Refusé</option>
</select>

<a href="{{ path('agriculteur_project_agricole_new') }}"
   class="btn btn-success">
    + Nouveau Projet
</a>
```

</div>

{% if projects is empty %} <div class="alert alert-info text-center">
Aucun projet trouvé. </div>
{% else %}

<div class="row" id="projectsGrid">

{% for project in projects %} <div class="col-md-4 project-card-col"
      data-name="{{ project.nomproject|lower }}"
      data-statut="{{ project.statut|lower }}">

```
    <div class="card mb-3 shadow-sm">
        <div class="card-body">

            <h5 class="card-title">{{ project.nomproject }}</h5>

            <p class="text-muted">ID: {{ project.idproject }}</p>

            <span class="badge bg-success">
                {{ project.statut }}
            </span>

            <hr>

            <p><b>Surface:</b> {{ project.surface }} Ha</p>
            <p><b>Budget:</b> {{ project.budgetdemande }} DT</p>
            <p><b>Date:</b> {{ project.datesoumission|date('Y-m-d') }}</p>

            <div class="d-flex gap-2 mt-3">
                <a href="{{ path('agriculteur_project_agricole_show', {id: project.idproject}) }}"
                   class="btn btn-primary btn-sm">Voir</a>

                <a href="{{ path('agriculteur_project_agricole_edit', {id: project.idproject}) }}"
                   class="btn btn-warning btn-sm">Modifier</a>

                <form method="POST"
                      action="{{ path('agriculteur_project_agricole_delete', {id: project.idproject}) }}"
                      onsubmit="return confirm('Supprimer ce projet ?');">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('delete_project_' ~ project.idproject) }}">
                    <button class="btn btn-danger btn-sm">Supprimer</button>
                </form>
            </div>

        </div>
    </div>

</div>
```

{% endfor %}

</div>

{% endif %}

</div>

{% endblock %}

{% block javascripts %}

<script>
function applyFilters() {
    const query = document.getElementById('searchInput').value.toLowerCase();
    const statut = document.getElementById('statutFilter').value.toLowerCase();
    const cards = document.querySelectorAll('.project-card-col');

    cards.forEach(card => {
        const name = card.dataset.name;
        const st = card.dataset.statut;

        const show =
            name.includes(query) &&
            (statut === '' || st === statut);

        card.style.display = show ? '' : 'none';
    });
}
</script>

{% endblock %}
