{% extends 'base.html.twig' %}

{% block title %}Mes Projets Agricoles{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <style>
        .card {
            border-radius: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border: none;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }
        .card-title {
            color: #1B4D1F;
            font-weight: 700;
        }
        .badge {
            font-size: 0.85rem;
            padding: 6px 12px;
            border-radius: 20px;
        }
        .btn {
            border-radius: 8px;
            font-weight: 600;
        }
        .form-control, .form-select {
            border-radius: 8px;
            border: 2px solid #dee2e6;
        }
        .form-control:focus, .form-select:focus {
            border-color: #2E7D32;
            box-shadow: 0 0 0 0.2rem rgba(46,125,50,0.25);
        }
        .main-content {
            margin-left: 280px;
            padding: 20px;
        }
        .header-banner {
            background: linear-gradient(135deg, #1B4D1F 0%, #2E7D32 100%);
            border-radius: 14px;
            padding: 1.5rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.8rem;
        }
    </style>
{% endblock %}

{% block body %}

    {% include 'components/_sidebar_agriculteur.html.twig' %}

    <div class="main-content">

        {# ── Header Banner ── #}
        <div class="header-banner">
            <h2 class="text-white mb-0">🌿 Gestion des Projets Agricoles</h2>
            <a href="{{ path('agriculteur_project_agricole_export_pdf') }}"
               class="btn btn-warning">
                <i class="fas fa-file-pdf"></i> Exporter PDF
            </a>
        </div>

        {# ── Search / Filter / New Button ── #}
        <div class="d-flex justify-content-between align-items-center mb-4 gap-3">

            <input type="text"
                   id="searchInput"
                   placeholder="🔍 Rechercher..."
                   class="form-control"
                   style="max-width: 250px;"
                   oninput="applyFilters()">

            <select id="statutFilter"
                    onchange="applyFilters()"
                    class="form-select"
                    style="max-width: 200px;">
                <option value="">Tous les statuts</option>
                <option value="en cours">En cours</option>
                <option value="accepte">Accepté</option>
                <option value="refuse">Refusé</option>
            </select>

            <a href="{{ path('agriculteur_project_agricole_new') }}"
               class="btn btn-success">
                + Nouveau Projet
            </a>
        </div>

        {# ── Projects Grid ── #}
        {% if projects is empty %}
            <div class="alert alert-info text-center py-5">
                <h4>📭 Aucun projet trouvé.</h4>
                <p>Commencez par créer votre premier projet agricole.</p>
            </div>
        {% else %}
            <div class="row g-4" id="projectsGrid">

                {% for project in projects %}
                    <div class="col-lg-4 col-md-6 project-card-col"
                         data-name="{{ project.nomproject|lower }}"
                         data-statut="{{ project.statut|lower }}">

                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">

                                <h5 class="card-title mb-2">
                                    {{ project.nomproject }}
                                </h5>

                                <p class="text-muted mb-2" style="font-size:0.85rem;">
                                    ID: {{ project.idproject }}
                                </p>

                                {% set statutColor = {
                                    'en cours': 'warning',
                                    'accepte': 'success',
                                    'refuse': 'danger'
                                } %}

                                <span class="badge bg-{{ statutColor[project.statut|lower] | default('secondary') }} mb-3"
                                      style="width:fit-content;">
                                    {{ project.statut }}
                                </span>

                                <hr>

                                <p class="mb-1">
                                    <strong>🌾 Surface:</strong> {{ project.surface }} Ha
                                </p>
                                <p class="mb-1">
                                    <strong>💰 Budget:</strong> {{ project.budgetdemande }} DT
                                </p>
                                <p class="mb-1">
                                    <strong>📅 Date:</strong>
                                    {{ project.datesoumission|date('Y-m-d') }}
                                </p>

                                {# Push buttons to bottom #}
                                <div class="d-flex gap-2 mt-auto pt-3">
                                    <a href="{{ path('agriculteur_project_agricole_show', {id: project.idproject}) }}"
                                       class="btn btn-primary btn-sm flex-fill">
                                        👁 Voir
                                    </a>
                                    <a href="{{ path('agriculteur_project_agricole_edit', {id: project.idproject}) }}"
                                       class="btn btn-warning btn-sm flex-fill">
                                        ✏️ Modifier
                                    </a>
                                    <form method="POST"
                                          action="{{ path('agriculteur_project_agricole_delete', {id: project.idproject}) }}"
                                          onsubmit="return confirm('Supprimer ce projet ?');"
                                          class="flex-fill">
                                        <input type="hidden"
                                               name="_token"
                                               value="{{ csrf_token('delete_project_' ~ project.idproject) }}">
                                        <button class="btn btn-danger btn-sm w-100">
                                            🗑 Supprimer
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </div>

                    </div>
                {% endfor %}

            </div>
        {% endif %}

    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function applyFilters() {
            const query  = document.getElementById('searchInput').value.toLowerCase();
            const statut = document.getElementById('statutFilter').value.toLowerCase();
            const cards  = document.querySelectorAll('.project-card-col');

            cards.forEach(card => {
                const name = card.dataset.name;
                const st   = card.dataset.statut;

                const show =
                    name.includes(query) &&
                    (statut === '' || st === statut);

                card.style.display = show ? '' : 'none';
            });
        }
    </script>
{% endblock %}