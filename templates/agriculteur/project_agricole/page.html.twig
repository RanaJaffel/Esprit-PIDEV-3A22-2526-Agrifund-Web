        <div class="stat-item">
            <div class="stat-value">500+</div>
            <div class="stat-label">Projets soumis</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">85%</div>
            <div class="stat-label">Taux d'approbation</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">2.4M</div>
            <div class="stat-label">TND financés</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">320+</div>
            <div class="stat-label">Agriculteurs actifs</div>
        </div>
    </div>

    {# ══════════════════════════════════════
       WHY AGRIFUND
    ══════════════════════════════════════ #}
    <div class="content-section">
        <h2 class="section-title">Pourquoi choisir AgriFund ?</h2>
        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrap">💰</div>
                    <h4>Accès au financement</h4>
                    <p>
                        Obtenez des financements adaptés grâce à un score
                        de crédit basé sur vos données agricoles réelles.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrap">🤖</div>
                    <h4>Analyse intelligente</h4>
                    <p>
                        Notre IA analyse vos données pour vous fournir
                        des indicateurs financiers précis et personnalisés.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrap">🔗</div>
                    <h4>Transparence blockchain</h4>
                    <p>
                        Vos données sont sécurisées et entièrement traçables
                        grâce à la technologie blockchain.
                    </p>
                </div>
            </div>

        </div>
    </div>

    {# ══════════════════════════════════════
       HOW IT WORKS
    ══════════════════════════════════════ #}
    <div class="steps-section">
        <h2 class="section-title">Comment ça marche ?</h2>
        <div class="row g-4 justify-content-center">

            <div class="col-6 col-md-3">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h6>Créer</h6>
                    <p>Soumettez votre projet agricole en quelques minutes</p>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h6>Documenter</h6>
                    <p>Ajoutez vos ressources et données financières</p>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h6>Analyser</h6>
                    <p>Recevez un score IA et un rapport personnalisé</p>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="step-card">
                    <div class="step-number">4</div>
                    <h6>Financer</h6>
                    <p>Obtenez le financement adapté à votre projet</p>
                </div>
            </div>

        </div>
    </div>

    {# ══════════════════════════════════════
       CTA
    ══════════════════════════════════════ #}
    <div class="cta-section">
        <div class="cta-box">
            <h2>Prêt à commencer ?</h2>
            <p>
                Rejoignez des centaines d'agriculteurs qui font confiance
                à AgriFund pour financer et développer leurs projets.
            </p>
            <div class="cta-actions">
                <a href="{{ path('agriculteur_project_agricole_new') }}"
                   class="btn-cta-primary">
                    <i class="bi bi-plus-circle-fill"></i>
                    Créer un Projet
                </a>
                <a href="{{ path('agriculteur_project_agricole_index') }}"
                   class="btn-cta-secondary">
                    <i class="bi bi-folder2-open"></i>
                    Mes Projets
                </a>
            </div>
        </div>
    </div>

</div>{# end main-content-wrapper #}

{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const sidebar = document.getElementById('sidebar');
    const wrapper = document.querySelector('.main-content-wrapper');

    if (sidebar && wrapper) {
        new MutationObserver(function () {
            wrapper.style.marginLeft =
                sidebar.classList.contains('collapsed') ? '80px' : '280px';
        }).observe(sidebar, { attributes: true, attributeFilter: ['class'] });

        if (sidebar.classList.contains('collapsed')) {
            wrapper.style.marginLeft = '80px';
        }
    }
});
</script>
{% endblock %}