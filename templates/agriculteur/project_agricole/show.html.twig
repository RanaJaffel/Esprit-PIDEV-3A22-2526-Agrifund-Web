{% extends 'base.html.twig' %}

{% block title %}{{ project.nomproject }}{% endblock %}
{% block body_class %}agriculteur-page{% endblock %}
{% block hide_preloader %}true{% endblock %}

{% block stylesheets %}
<style>
:root {
    --green-dark:  #1B5E20;
    --green-mid:   #2E7D32;
    --green-light: #4CAF50;
    --green-pale:  #E8F5E9;
}

/* FIX layout */
.main-content-wrapper {
    margin-left: 280px;
    padding: 30px;
    min-height: 100vh;
    overflow-x: hidden; /* prevents map overflow */
}

@media (max-width: 991.98px) {
    .main-content-wrapper {
        margin-left: 0;
        padding: 70px 15px 20px;
    }
}

/* MAP STYLE */
#project-map {
    width: 100%;
    height: 400px;
    border-radius: 16px;
    border: 2px solid #c8e6c9;
    margin-top: 20px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
}
</style>
{% endblock %}

{% block body %}

<button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
    <i class="fas fa-bars"></i>
</button>

{% include 'components/_sidebar_agriculteur.html.twig' %}

<div class="main-content-wrapper">

    <div class="page-header">
        <h2 class="fw-bold">
            <i class="bi bi-kanban me-2"></i>
            {{ project.nomproject }}
        </h2>
    </div>

    <div class="row g-4">

        {# ── DETAILS ── #}
        <div class="col-lg-5">
            <div class="card card-agri">
                <div class="card-body">
                    <table class="detail-table">
                        <tr>
                            <th>Nom</th>
                            <td>{{ project.nomproject }}</td>
                        </tr>
                        <tr>
                            <th>Surface</th>
                            <td>{{ project.surface }} ha</td>
                        </tr>
                        <tr>
                            <th>Budget</th>
                            <td>{{ project.budgetdemande }} TND</td>
                        </tr>
                        <tr>
                            <th>Date</th>
                            <td>{{ project.datesoumission|date('d/m/Y') }}</td>
                        </tr>
                        {% if project.latitude is not null and project.longitude is not null %}
                        <tr>
                            <th>📍 Localisation</th>
                            <td>
                                {{ project.latitude }},
                                {{ project.longitude }}
                            </td>
                        </tr>
                        {% endif %}
                    </table>
                </div>
            </div>
        </div>

        {# ── RESOURCES ── #}
        <div class="col-lg-7">
            <div class="card card-agri">
                <div class="card-body">
                    {% if project.ressources is empty %}
                        <p>Aucune ressource</p>
                    {% else %}
                        {% for ressource in project.ressources %}
                            <p>{{ ressource.nomressource }}</p>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>

    </div>

    {# FULL WIDTH MAP #}
    {% if project.latitude is not null and project.longitude is not null %}
    <div class="row">
        <div class="col-12">
            <div id="project-map"></div>
        </div>
    </div>
    {% endif %}

</div>

{% endblock %}

{% block javascripts %}

<script>
function initProjectMap() {

    const lat = {{ project.latitude is not null ? project.latitude|json_encode|raw : 'null' }};
    const lng = {{ project.longitude is not null ? project.longitude|json_encode|raw : 'null' }};

    if (lat === null || lng === null) return;

    const hasGoogle = !!(window.google && window.google.maps);

    if (hasGoogle) {
        const map = new google.maps.Map(document.getElementById("project-map"), {
            center: { lat: lat, lng: lng },
            zoom: 13,
            mapTypeId: google.maps.MapTypeId.ROADMAP
        });

        new google.maps.Marker({
            position: { lat: lat, lng: lng },
            map: map,
            title: "Projet Agricole",
            animation: google.maps.Animation.DROP
        });
        return;
    }
    const mapDiv = document.getElementById('project-map');
    if (mapDiv) {
        mapDiv.innerHTML = '<div class="alert alert-warning m-3 mb-0"><strong>Google Maps non configure.</strong> Ajoutez une vraie valeur a <code>GOOGLE_MAPS_API_KEY</code> dans <code>.env</code>, puis rechargez la page.</div>';
    }
}
</script>

{% set has_google_maps_key = google_maps_api_key is defined and google_maps_api_key is not empty and google_maps_api_key != 'your_google_maps_api_key_here' %}
{% if has_google_maps_key %}
<script
    src="https://maps.googleapis.com/maps/api/js?key={{ google_maps_api_key }}&callback=initProjectMap&loading=async"
    async
    defer>
</script>
{% else %}
<script>
window.addEventListener('load', function () {
    if (typeof window.initProjectMap === 'function') {
        window.initProjectMap();
    }
});
</script>
{% endif %}

{% endblock %}
