                    <a href="{{ path('app_locale', {locale: 'ar'}) }}"
                       class="{{ app.session.get('_locale', 'fr') == 'ar' ? 'active' : '' }}"
                       lang="ar" hreflang="ar" aria-label="Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©">AR</a>
                </nav>

                <a href="{{ path('app_login') }}" class="btn-nav-login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    {{ 'login'|trans }}
