<style>
    /* ========================================
       NAVBAR MODERNE - AgriFund (Marketing)
    ======================================== */
    
    #header {
        background: transparent;
        transition: all 0.4s ease;
        padding: 30px 0;
        position: fixed;
        width: 100%;
        top: 0;
        z-index: 1000;
    }

    #header.scrolled {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        padding: 15px 0;
    }

    /* Logo */
    .logo-brand {
        font-family: 'Marcellus', serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: white;
        text-decoration: none;
    }
    
    #header.scrolled .logo-brand {
        color: var(--nature-green);
    }

    #header.scrolled .nav-link {
        color: var(--deep-forest);
    }

    /* Navigation horizontal */
    .nav-link {
        color: white;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 10px 20px;
        transition: all 0.3s;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .nav-link:hover {
        color: var(--harvest-gold) !important;
    }

    .btn-cta-nav {
        background: var(--nature-green);
        color: white !important;
        padding: 12px 30px;
        border-radius: 100px;
        box-shadow: 0 10px 20px rgba(46, 125, 50, 0.2);
    }

    .btn-cta-nav:hover {
        background: var(--meadow-green);
        transform: translateY(-2px);
    }

    @media (max-width: 992px) {
        #header { background: white; padding: 15px 0; }
        .nav-link { color: var(--deep-forest); }
        .logo-brand { color: var(--nature-green); }
    }
</style>

<header id="header">
    <div class="container d-flex align-items-center justify-content-between">
        <a href="{{ path('app_home') }}" class="logo-brand">
            AgriFund<span style="color: var(--harvest-gold);">.</span>
        </a>

        <div class="d-none d-lg-flex align-items-center">
            <a href="{{ path('app_home') }}" class="nav-link">Accueil</a>
            <a href="{{ path('app_products') }}" class="nav-link">Marketplace</a>
            <a href="{{ path('app_offers') }}" class="nav-link">Offres</a>
            <a href="{{ path('app_about') }}" class="nav-link">À Propos</a>
            
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('agriculteur_dashboard') }}" class="nav-link btn-cta-nav ms-4">Mon Portail</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="nav-link ms-4">Connexion</a>
                <a href="{{ path('app_register_agriculteur') }}" class="nav-link btn-cta-nav ms-3">S'inscrire</a>
            {% endif %}
        </div>

        <button class="d-lg-none btn border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNav">
            <i class="fas fa-bars fa-2x"></i>
        </button>
    </div>
</header>