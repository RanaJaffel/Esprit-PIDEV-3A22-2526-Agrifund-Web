{% extends 'base.html.twig' %}

{% block title %}Détails agriculteur{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --gris: #848A86;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --vert-clair: #B2D944;
            --olive: #9A951F;
            --vert-olive-fonce: #476C1A;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 0;
            background: transparent;
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 991.98px) {
            .main-content {
                margin-left: 0;
            }
        }

        /* ==========================================
           HEADER
        ========================================== */
        .page-header {
            background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-foret) 50%, var(--vert-tres-fonce) 100%);
            padding: 28px 35px;
            margin: 0 0 30px 0;
            position: relative;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M40 10 L45 25 L40 40 L35 25 Z' fill='%23B2D944' fill-opacity='0.06'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .page-header::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(178, 217, 68, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .page-header h1 {
            color: white !important;
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .page-header h1 i {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--olive) 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            box-shadow: 0 8px 20px rgba(178, 217, 68, 0.35);
        }

        .header-actions {
            display: flex;
            gap: 12px;
            position: relative;
            z-index: 1;
        }

        .btn-pdf {
            background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
            border: 2px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            box-shadow: 0 6px 20px rgba(22, 163, 74, 0.35);
        }

        .btn-pdf:hover {
            background: linear-gradient(135deg, #15803d 0%, #166534 100%);
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(22, 163, 74, 0.45);
            color: white;
        }

        .btn-pdf i {
            font-size: 1rem;
        }

        .btn-back {
            background: rgba(255, 255, 255, 0.15);
            border: 2px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .btn-back:hover {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.5);
            transform: translateX(-5px);
            color: white;
        }

        /* ==========================================
           CONTENT AREA
        ========================================== */
        .content-area {
            padding: 0 35px 35px 35px;
        }

        @media (max-width: 768px) {
            .content-area {
                padding: 0 20px 20px 20px;
            }
        }

        /* ==========================================
           DASHBOARD SECTIONS
        ========================================== */
        .dashboard-section {
            background: white;
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
            height: 100%;
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease-out forwards;
            opacity: 0;
        }

        .dashboard-section:hover {
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            transform: translateY(-3px);
        }

        .dashboard-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
        }

        .section-info-perso::before {
            background: linear-gradient(90deg, var(--vert-vif), var(--vert-clair));
        }

        .section-info-agri::before {
            background: linear-gradient(90deg, var(--vert-clair), var(--olive));
        }

        .section-documents::before {
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-foret));
        }

        .section-info-perso::after {
            content: '👤';
            position: absolute;
            bottom: 20px;
            right: 20px;
            font-size: 3rem;
            opacity: 0.06;
        }

        .section-info-agri::after {
            content: '🚜';
            position: absolute;
            bottom: 20px;
            right: 20px;
            font-size: 3rem;
            opacity: 0.06;
        }

        .section-documents::after {
            content: '📄';
            position: absolute;
            bottom: 20px;
            right: 20px;
            font-size: 3rem;
            opacity: 0.06;
        }

        .section-delay-1 { animation-delay: 0.1s; }
        .section-delay-2 { animation-delay: 0.2s; }
        .section-delay-3 { animation-delay: 0.3s; }

        /* ==========================================
           SECTION TITLES
        ========================================== */
        .section-title {
            color: var(--vert-tres-fonce);
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(0, 0, 0, 0.05);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .icon-perso {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            color: white;
            box-shadow: 0 6px 15px rgba(8, 150, 71, 0.25);
        }

        .icon-agri {
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--olive) 100%);
            color: white;
            box-shadow: 0 6px 15px rgba(178, 217, 68, 0.25);
        }

        .icon-docs {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
            color: white;
            box-shadow: 0 6px 15px rgba(71, 108, 26, 0.25);
        }

        /* ==========================================
           PROFILE IMAGE
        ========================================== */
        .profile-img-wrapper {
            position: relative;
            padding: 20px 0;
            text-align: center;
            margin-bottom: 20px;
        }

        .profile-img-wrapper img {
            width: 160px;
            height: 160px;
            border-radius: 24px;
            object-fit: cover;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
            border: 5px solid white;
            transition: all 0.4s ease;
        }

        .profile-img-wrapper img:hover {
            transform: scale(1.05) rotate(-2deg);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
        }

        .profile-img-wrapper .fa-user-circle {
            font-size: 8rem;
            color: var(--vert-clair);
            opacity: 0.6;
        }

        .profile-img-wrapper::after {
            content: '';
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 20px;
            background: radial-gradient(ellipse, rgba(0, 0, 0, 0.1) 0%, transparent 70%);
            border-radius: 50%;
        }

        /* ==========================================
           INFO TABLES
        ========================================== */
        .table-borderless {
            margin: 0;
        }

        .table-borderless tr {
            transition: all 0.3s ease;
        }

        .table-borderless tr:hover {
            background: linear-gradient(90deg, rgba(178, 217, 68, 0.06) 0%, rgba(8, 150, 71, 0.04) 100%);
            border-radius: 10px;
            transform: translateX(5px);
        }

        .table-borderless th {
            color: var(--gris);
            font-weight: 600;
            font-size: 0.85rem;
            padding: 14px 15px;
            vertical-align: middle;
            border: none !important;
        }

        .table-borderless td {
            color: var(--vert-tres-fonce);
            font-size: 0.95rem;
            padding: 14px 15px;
            vertical-align: middle;
            border: none !important;
        }

        .table-borderless td strong {
            color: var(--vert-fonce);
            font-weight: 700;
        }

        /* ==========================================
           BADGES
        ========================================== */
        .badge {
            padding: 8px 16px;
            border-radius: 25px;
            font-size: 0.78rem;
            font-weight: 600;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge.bg-success {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%) !important;
            color: white;
            box-shadow: 0 4px 12px rgba(8, 150, 71, 0.25);
        }

        .badge.bg-warning {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, #c9a020 100%) !important;
            color: white;
            box-shadow: 0 4px 12px rgba(225, 179, 35, 0.25);
        }

        .badge.bg-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
            color: white;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
        }

        .badge.bg-secondary {
            background: linear-gradient(135deg, var(--gris) 0%, #6b7280 100%) !important;
            color: white;
        }

        .badge.bg-info {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
            color: white;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
        }

        /* ==========================================
           ACTION BUTTONS
        ========================================== */
        .actions-header {
            color: var(--vert-tres-fonce);
            font-weight: 700;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding: 12px 16px;
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.05) 0%, rgba(178, 217, 68, 0.05) 100%);
            border-radius: 12px;
            border-left: 4px solid var(--vert-vif);
        }

        .actions-header i {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 0.8rem;
        }

        .btn-approve {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            border: none;
            border-radius: 14px;
            padding: 16px 25px;
            font-weight: 600;
            font-size: 0.95rem;
            color: white;
            box-shadow: 0 8px 25px rgba(8, 150, 71, 0.3);
            transition: all 0.4s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
            width: 100%;
            cursor: pointer;
        }

        .btn-approve::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .btn-approve:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(8, 150, 71, 0.4);
        }

        .btn-approve:hover::before {
            left: 100%;
        }

        .btn-reject {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            border: none;
            border-radius: 14px;
            padding: 16px 25px;
            font-weight: 600;
            font-size: 0.95rem;
            color: white;
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.3);
            transition: all 0.4s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
            width: 100%;
            cursor: pointer;
        }

        .btn-reject::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .btn-reject:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(239, 68, 68, 0.4);
        }

        .btn-reject:hover::before {
            left: 100%;
        }

        /* ==========================================
           DOCUMENTS TABLE
        ========================================== */
        .table-custom {
            margin: 0;
            border-collapse: collapse;
            width: 100%;
        }

        .table-custom thead {
            background: linear-gradient(90deg, var(--vert-fonce) 0%, var(--vert-foret) 100%);
        }

        .table-custom thead th {
            color: white !important;
            font-weight: 600;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 16px 18px;
            border: none !important;
        }

        .table-custom tbody tr {
            transition: all 0.3s ease;
            border-bottom: 1px solid rgba(0, 0, 0, 0.04);
            opacity: 0;
            animation: fadeInRow 0.4s ease-out forwards;
        }

        .table-custom tbody tr:nth-child(1) { animation-delay: 0.4s; }
        .table-custom tbody tr:nth-child(2) { animation-delay: 0.45s; }
        .table-custom tbody tr:nth-child(3) { animation-delay: 0.5s; }
        .table-custom tbody tr:nth-child(4) { animation-delay: 0.55s; }
        .table-custom tbody tr:nth-child(5) { animation-delay: 0.6s; }

        .table-custom tbody tr:last-child {
            border-bottom: none;
        }

        .table-custom tbody tr:hover {
            background: linear-gradient(90deg, rgba(178, 217, 68, 0.06) 0%, rgba(8, 150, 71, 0.04) 100%);
        }

        .table-custom tbody td {
            padding: 16px 18px;
            vertical-align: middle;
            color: var(--vert-tres-fonce);
            font-size: 0.9rem;
            border: none !important;
        }

        .btn-outline-primary {
            border: 2px solid var(--vert-vif);
            color: var(--vert-vif);
            background: transparent;
            border-radius: 10px;
            padding: 8px 16px;
            font-weight: 600;
            font-size: 0.82rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }

        .btn-outline-primary:hover {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            border-color: var(--vert-vif);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(8, 150, 71, 0.3);
        }

        /* ==========================================
           EMPTY STATE
        ========================================== */
        .empty-state {
            padding: 50px 20px;
            text-align: center;
            color: var(--gris);
        }

        .empty-state i {
            color: var(--vert-clair);
            opacity: 0.4;
            margin-bottom: 15px;
            display: block;
        }

        /* ==========================================
           FLASH MESSAGES
        ========================================== */
        .alert {
            border-radius: 14px;
            border: none;
            padding: 16px 24px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .alert-success {
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.1) 0%, rgba(178, 217, 68, 0.1) 100%);
            color: var(--vert-fonce);
            border-left: 4px solid var(--vert-vif);
        }

        .alert-danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
            color: #b91c1c;
            border-left: 4px solid #ef4444;
        }

        .alert-warning {
            background: linear-gradient(135deg, rgba(225, 179, 35, 0.15) 0%, rgba(225, 179, 35, 0.1) 100%);
            color: #92750d;
            border-left: 4px solid var(--jaune-moutarde);
        }

        /* ==========================================
           ANIMATIONS
        ========================================== */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(25px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInRow {
            from { opacity: 0; transform: translateX(-10px); }
            to { opacity: 1; transform: translateX(0); }
        }

        /* ==========================================
           RESPONSIVE
        ========================================== */
        @media (max-width: 768px) {
            .page-header {
                padding: 20px;
                flex-direction: column;
                gap: 15px;
            }

            .page-header h1 {
                font-size: 1.4rem;
            }

            .header-actions {
                flex-direction: column;
                width: 100%;
            }

            .btn-pdf, .btn-back {
                justify-content: center;
            }

            .dashboard-section {
                padding: 25px 20px;
                border-radius: 18px;
                margin-bottom: 20px;
                height: auto;
            }

            .profile-img-wrapper img {
                width: 120px;
                height: 120px;
            }

            .table-borderless th,
            .table-borderless td {
                padding: 10px 12px;
                font-size: 0.85rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {% include 'components/_sidebar_admin.html.twig' %}

        <div class="main-content">

            {# HEADER #}
            <div class="page-header d-flex justify-content-between align-items-center">
                <h1 class="mb-0">
                    <i class="fas fa-tractor"></i>
                    Détails de l'agriculteur
                </h1>
                <div class="header-actions">
                    <a href="{{ path('admin_agriculteurs_pdf', {id: agriculteur.id}) }}"
                       class="btn-pdf">
                        <i class="fas fa-file-pdf"></i>Télécharger PDF
                    </a>
                    <a href="{{ path('admin_agriculteurs_index') }}" class="btn-back">
                        <i class="fas fa-arrow-left"></i>Retour
                    </a>
                </div>
            </div>

            {# FLASH MESSAGES #}
            <div class="content-area" style="padding-bottom: 0; padding-top: 0;">
                {% include 'components/_flash_messages.html.twig' %}
            </div>

            {# CONTENT #}
            <div class="content-area">
                <div class="row">

                    {# Informations personnelles #}
                    <div class="col-md-6 mb-4">
                        <div class="dashboard-section section-info-perso section-delay-1">
                            <h5 class="section-title">
                                <i class="fas fa-user icon-perso"></i>
                                Informations personnelles
                            </h5>

                            <div class="profile-img-wrapper">
                                {% if agriculteur.utilisateur.photo %}
                                    <img src="{{ asset(agriculteur.utilisateur.photo) }}"
                                         alt="{{ agriculteur.utilisateur.nomComplet }}">
                                {% else %}
                                    <i class="fas fa-user-circle"></i>
                                {% endif %}
                            </div>

                            <table class="table table-borderless">
                                <tr>
                                    <th width="40%">Nom complet :</th>
                                    <td><strong>{{ agriculteur.utilisateur.nomComplet }}</strong></td>
                                </tr>
                                <tr>
                                    <th>Email :</th>
                                    <td>{{ agriculteur.utilisateur.email }}</td>
                                </tr>
                                <tr>
                                    <th>Téléphone :</th>
                                    <td>{{ agriculteur.utilisateur.tel ?? 'N/A' }}</td>
                                </tr>
                                <tr>
                                    <th>Inscription :</th>
                                    <td>{{ agriculteur.utilisateur.dateInscrit|date('d/m/Y H:i') }}</td>
                                </tr>
                                <tr>
                                    <th>Dernière connexion :</th>
                                    <td>{{ agriculteur.utilisateur.derniereConnexion|date('d/m/Y H:i') }}</td>
                                </tr>
                                <tr>
                                    <th>Statut connexion :</th>
                                    <td>
                                        {% if agriculteur.utilisateur.estEnLigne %}
                                            <span class="badge bg-success">
                                                <i class="fas fa-circle" style="font-size: 0.5rem;"></i>En ligne
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-circle" style="font-size: 0.5rem;"></i>Hors ligne
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    {# Informations agricoles #}
                    <div class="col-md-6 mb-4">
                        <div class="dashboard-section section-info-agri section-delay-2">
                            <h5 class="section-title">
                                <i class="fas fa-tractor icon-agri"></i>
                                Informations agricoles
                            </h5>

                            <table class="table table-borderless">
                                <tr>
                                    <th width="40%">Adresse ferme :</th>
                                    <td>{{ agriculteur.adresseferme ?? 'N/A' }}</td>
                                </tr>
                                <tr>
                                    <th>Superficie :</th>
                                    <td>
                                        {% if agriculteur.superficieferme %}
                                            <strong>{{ agriculteur.superficieferme }} hectares</strong>
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Type de culture :</th>
                                    <td>
                                        {% if agriculteur.typeCulture %}
                                            <span class="badge bg-success">
                                                <i class="fas fa-seedling"></i>{{ agriculteur.typeCulture }}
                                            </span>
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Statut compte :</th>
                                    <td>
                                        {% if agriculteur.statuscompte == 'actif' %}
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i>Actif
                                            </span>
                                        {% elseif agriculteur.statuscompte == 'en_attente' %}
                                            <span class="badge bg-warning">
                                                <i class="fas fa-clock"></i>En attente
                                            </span>
                                        {% elseif agriculteur.statuscompte == 'refuse' %}
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times-circle"></i>Refusé
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary">{{ agriculteur.statuscompte }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Compte vérifié :</th>
                                    <td>
                                        {% if agriculteur.compteverifie %}
                                            <span class="badge bg-success">
                                                <i class="fas fa-shield-alt"></i>Oui
                                            </span>
                                        {% else %}
                                            <span class="badge bg-warning">
                                                <i class="fas fa-exclamation-triangle"></i>Non
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            </table>

                            {# Actions de vérification #}
                            {% if agriculteur.statuscompte == 'en_attente' %}
                            <div class="mt-4">
                                <div class="actions-header">
                                    <i class="fas fa-bolt"></i>
                                    Actions de vérification
                                </div>
                                <div class="d-grid gap-3">
                                    <form method="post" action="{{ path('admin_agriculteurs_verify', {id: agriculteur.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('verify' ~ agriculteur.id) }}">
                                        <input type="hidden" name="action" value="approve">
                                        <button type="submit" class="btn-approve">
                                            <i class="fas fa-check"></i>Approuver le compte
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('admin_agriculteurs_verify', {id: agriculteur.id}) }}" style="margin-top: 12px;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('verify' ~ agriculteur.id) }}">
                                        <input type="hidden" name="action" value="reject">
                                        <button type="submit" class="btn-reject">
                                            <i class="fas fa-times"></i>Refuser le compte
                                        </button>
                                    </form>
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Documents #}
                    <div class="col-12">
                        <div class="dashboard-section section-documents section-delay-3">
                            <h5 class="section-title">
                                <i class="fas fa-file-alt icon-docs"></i>
                                Documents
                            </h5>

                            {% set documents = agriculteur.utilisateur.documents %}

                            {% if documents|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table-custom">
                                        <thead>
                                            <tr>
                                                <th>Nom</th>
                                                <th>Type</th>
                                                <th>Date d'envoi</th>
                                                <th>Statut</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for document in documents %}
                                            <tr>
                                                <td><strong>{{ document.nom }}</strong></td>
                                                <td><span class="badge bg-info">{{ document.typeDocument }}</span></td>
                                                <td>{{ document.dateUpload|date('d/m/Y H:i') }}</td>
                                                <td>
                                                    <span class="badge bg-{{ document.statutBadgeClass }}">
                                                        {{ document.statut }}
                                                    </span>
                                                </td>
                                                <td>
                                                    <a href="{{ path('admin_documents_review', {id: document.id}) }}"
                                                       class="btn-outline-primary">
                                                        <i class="fas fa-eye"></i>Voir
                                                    </a>
                                                </td>
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="empty-state">
                                    <i class="fas fa-file-alt fa-3x"></i>
                                    <p class="mb-0">Aucun document envoyé</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Ripple effect
            document.querySelectorAll('.btn-approve, .btn-reject').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    const ripple = document.createElement('span');
                    const rect = this.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    ripple.style.cssText = `
                        position:absolute;
                        width:${size}px;height:${size}px;
                        left:${e.clientX - rect.left - size / 2}px;
                        top:${e.clientY - rect.top - size / 2}px;
                        background:rgba(255,255,255,.3);
                        border-radius:50%;transform:scale(0);
                        animation:ripple .6s ease-out;pointer-events:none;
                    `;
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

        });

        const s = document.createElement('style');
        s.textContent = '@keyframes ripple{to{transform:scale(4);opacity:0;}}';
        document.head.appendChild(s);
    </script>
{% endblock %}