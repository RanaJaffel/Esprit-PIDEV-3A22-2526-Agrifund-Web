{% extends 'base.html.twig' %}
{% block title %}Décision #{{ decision.idDecision }}{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        :root { --vert-vif: #089647; --vert-fonce: #076A39; --vert-foret: #095032; --vert-tres-fonce: #133D03; --vert-clair: #B2D944; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%); min-height: 100vh; }
        .dashboard-container { display: flex; min-height: 100vh; }
        .main-content { flex: 1; margin-left: 280px; padding: 0; background: transparent; transition: margin-left 0.4s; }
        @media (max-width: 991.98px) { .main-content { margin-left: 0; } }
        .page-header { padding: 28px 35px; position: relative; overflow: hidden; }
        .show-card { background: white; border-radius: 20px; box-shadow: 0 8px 40px rgba(0,0,0,0.08); overflow: hidden; }
        .show-card-header { padding: 28px; display: flex; align-items: center; justify-content: space-between; }
        .show-card-header.approuve { background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-bottom: 2px solid #22c55e; }
        .show-card-header.refuse { background: linear-gradient(135deg, #fef2f2, #fee2e2); border-bottom: 2px solid #ef4444; }
        .show-card-header.attente { background: linear-gradient(135deg, #fffbeb, #fef3c7); border-bottom: 2px solid #f59e0b; }
        .show-card-body { padding: 32px; }
        .info-section { background: #f8faf5; border-radius: 16px; padding: 20px; margin-bottom: 20px; border-left: 4px solid #22c55e; }
        .info-section-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; color: #6b7280; font-weight: 700; margin-bottom: 8px; }
        .info-section-value { font-size: 1rem; font-weight: 600; color: #1f2937; }
        .eval-card { background: linear-gradient(135deg, #f0fdf4, #dcfce7); border: 1px solid #bbf7d0; border-radius: 16px; padding: 20px; margin-bottom: 20px; }
        .badge-big { padding: 10px 24px; border-radius: 25px; font-size: 1rem; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; }
        .badge-big.approuve { background: #22c55e; color: white; }
        .badge-big.refuse { background: #ef4444; color: white; }
        .badge-big.attente { background: #f59e0b; color: white; }
        .btn-action-lg { padding: 14px 24px; border-radius: 14px; font-weight: 700; font-size: 0.95rem; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s; border: none; cursor: pointer; }
        .btn-edit-lg { background: linear-gradient(135deg, #d97706, #f59e0b); color: white; box-shadow: 0 4px 15px rgba(217,119,6,0.3); }
        .btn-edit-lg:hover { transform: translateY(-2px); color: white; }
        .btn-delete-lg { background: linear-gradient(135deg, #dc2626, #ef4444); color: white; box-shadow: 0 4px 15px rgba(220,38,38,0.3); }
        .btn-delete-lg:hover { transform: translateY(-2px); color: white; }
        .btn-back { background: rgba(255,255,255,0.15); color: white; border: 2px solid rgba(255,255,255,0.3); border-radius: 12px; padding: 10px 20px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s; }
        .btn-back:hover { background: rgba(255,255,255,0.25); color: white; }
        .page-header-bg { background: linear-gradient(135deg, #0a3d1f 0%, #1a5c35 100%); }
        .main-content > *:not(.page-header):not(script) { padding-left: 35px; padding-right: 35px; }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'components/_sidebar_admin.html.twig' %}
    <div class="main-content">

        <div class="page-header page-header-bg">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="text-white fw-bold mb-1" style="font-size:1.6rem;">👁️ Décision #{{ decision.idDecision }}</h2>
                    <p class="mb-0" style="color:rgba(255,255,255,0.65); font-size:0.85rem;">Détails de la décision financière</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-light d-md-none" id="mobileSidebarToggle"><i class="fas fa-bars"></i></button>
                    <a href="{{ path('admin_decision_index') }}" class="btn-back">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
        </div>

        <div class="py-4">
            <div class="row justify-content-center">
                <div class="col-xl-8 col-lg-10">
                    <div class="show-card">

                        <div class="show-card-header {{ decision.statut == 'approuve' ? 'approuve' : (decision.statut == 'refuse' ? 'refuse' : 'attente') }}">
                            <div>
                                <div style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px; color:#6b7280; margin-bottom:8px;">Statut actuel</div>
                                {% if decision.statut == 'approuve' %}
                                    <span class="badge-big approuve"><i class="fas fa-check-circle"></i> Approuvé</span>
                                {% elseif decision.statut == 'refuse' %}
                                    <span class="badge-big refuse"><i class="fas fa-times-circle"></i> Refusé</span>
                                {% else %}
                                    <span class="badge-big attente"><i class="fas fa-clock"></i> En attente</span>
                                {% endif %}
                            </div>
                            <div style="font-size:3rem; opacity:0.3;">⚖️</div>
                        </div>

                        <div class="show-card-body">

                            {% if decision.evaluation %}
                            <div class="eval-card">
                                <div style="font-size:0.72rem; text-transform:uppercase; letter-spacing:1px; color:#6b7280; font-weight:700; margin-bottom:10px;">🔍 Évaluation liée</div>
                                <div style="font-size:1.1rem; font-weight:700; color:#15803d;">Évaluation #{{ decision.evaluation.idEvaluation }}</div>
                                <div class="row mt-2">
                                    <div class="col-4">
                                        <small style="color:#6b7280;">Niveau de risque</small>
                                        <div style="font-weight:600;">{{ decision.evaluation.niveauRisque }}</div>
                                    </div>
                                    <div class="col-4">
                                        <small style="color:#6b7280;">Score global</small>
                                        <div style="font-weight:600;">{{ decision.evaluation.scoreGlobal }}</div>
                                    </div>
                                    <div class="col-4">
                                        <small style="color:#6b7280;">Fiabilité</small>
                                        <div style="font-weight:600;">{{ decision.evaluation.fiabiliteDonnees }}</div>
                                    </div>
                                </div>
                            </div>
                            {% endif %}

                            <div class="info-section">
                                <div class="info-section-label">📅 Date de décision</div>
                                <div class="info-section-value">{{ decision.dateDecision|date('d/m/Y à H:i') }}</div>
                            </div>

                            <div class="info-section" style="border-left-color:#3b82f6;">
                                <div class="info-section-label">📝 Justification</div>
                                <div class="info-section-value" style="font-weight:400; line-height:1.7;">{{ decision.justification }}</div>
                            </div>

                            <div class="d-flex gap-3 mt-4 flex-wrap">
                                <a href="{{ path('admin_decision_edit', {id: decision.idDecision}) }}" class="btn-action-lg btn-edit-lg">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('admin_decision_delete', {id: decision.idDecision}) }}"
                                      onsubmit="return confirm('Supprimer définitivement cette décision ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ decision.idDecision) }}">
                                    <button type="submit" class="btn-action-lg btn-delete-lg">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.getElementById('mobileSidebarToggle')?.addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('show');
        });
    </script>
{% endblock %}