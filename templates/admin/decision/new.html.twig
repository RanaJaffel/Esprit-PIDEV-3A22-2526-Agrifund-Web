{% extends 'base.html.twig' %}
{% block title %}Nouvelle Décision{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        :root { 
            --vert-vif: #089647; 
            --vert-fonce: #076A39; 
            --vert-foret: #095032; 
            --vert-tres-fonce: #133D03; 
            --vert-clair: #B2D944; 
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%); 
            min-height: 100vh; 
        }
        .dashboard-container { display: flex; min-height: 100vh; }
        .main-content { flex: 1; margin-left: 280px; padding: 0; background: transparent; transition: margin-left 0.4s; }
        @media (max-width: 991.98px) { .main-content { margin-left: 0; } }

        .page-header { 
            background: linear-gradient(135deg, #0a3d1f 0%, #1a5c35 100%); 
            padding: 28px 35px; 
            position: relative; 
            overflow: hidden; 
        }
        .page-header::after { 
            content: '⚖️'; 
            position: absolute; 
            right: 30px; 
            top: 50%; 
            transform: translateY(-50%); 
            font-size: 60px; 
            opacity: 0.1; 
        }

        .form-card { 
            background: white; 
            border-radius: 20px; 
            box-shadow: 0 8px 40px rgba(0,0,0,0.08); 
            overflow: hidden; 
            border: 1px solid #f0f0f0; 
        }
        .form-card-header { 
            background: linear-gradient(135deg, #f0fdf4, #dcfce7); 
            padding: 20px 28px; 
            border-bottom: 1px solid #bbf7d0; 
        }
        .form-card-body { padding: 32px; }

        .field-group { margin-bottom: 24px; }
        .field-label { 
            display: block; 
            font-size: 0.85rem; 
            font-weight: 700; 
            color: #0a3d1f; 
            text-transform: uppercase; 
            letter-spacing: 0.5px; 
            margin-bottom: 8px; 
        }
        .field-input { 
            width: 100%; 
            border: 2px solid #e5e7eb; 
            border-radius: 14px; 
            padding: 14px 18px; 
            font-size: 0.95rem; 
            transition: all 0.3s; 
            background: #fafafa; 
            color: #374151; 
        }
        .field-input:focus { 
            border-color: #16a34a; 
            background: white; 
            box-shadow: 0 0 0 4px rgba(22,163,74,0.1); 
            outline: none; 
        }
        .field-hint { font-size: 0.75rem; color: #9ca3af; margin-top: 6px; }
        .divider { height: 1px; background: linear-gradient(90deg, transparent, #e5e7eb, transparent); margin: 28px 0; }

        .btn-submit { 
            background: linear-gradient(135deg, #16a34a, #22c55e); 
            color: white; 
            border: none; 
            border-radius: 14px; 
            padding: 16px 32px; 
            font-size: 1rem; 
            font-weight: 700; 
            cursor: pointer; 
            width: 100%; 
            transition: all 0.3s; 
            box-shadow: 0 4px 20px rgba(22,163,74,0.3); 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            gap: 10px; 
        }
        .btn-submit:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 8px 30px rgba(22,163,74,0.4); 
        }
        .btn-back { 
            background: rgba(255,255,255,0.15); 
            color: white; 
            border: 2px solid rgba(255,255,255,0.3); 
            border-radius: 12px; 
            padding: 10px 20px; 
            font-weight: 600; 
            text-decoration: none; 
            display: inline-flex; 
            align-items: center; 
            gap: 8px; 
            transition: all 0.3s; 
        }
        .btn-back:hover { background: rgba(255,255,255,0.25); color: white; }

        /* ======= CHATBOT FLOTTANT ======= */
        #chatWidget {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 9999;
            font-family: 'Segoe UI', sans-serif;
        }
        #chatToggle {
            width: 62px;
            height: 62px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            background: linear-gradient(135deg, #16a34a, #22c55e);
            box-shadow: 0 4px 24px rgba(22,163,74,0.55);
            font-size: 1.7rem;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.3s, box-shadow 0.3s;
            margin-left: auto;
        }
        #chatToggle:hover { transform: scale(1.1); box-shadow: 0 8px 32px rgba(22,163,74,0.65); }
        #chatWindow {
            display: none;
            position: absolute;
            bottom: 75px;
            right: 0;
            width: 370px;
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 16px 50px rgba(0,0,0,0.18);
            background: white;
            animation: slideUp 0.3s ease;
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        #chatHeader {
            background: linear-gradient(135deg, #0a3d1f, #16a34a);
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        #chatMessages {
            height: 300px;
            overflow-y: auto;
            padding: 16px;
            background: #f8fafc;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        #chatMessages::-webkit-scrollbar { width: 5px; }
        #chatMessages::-webkit-scrollbar-thumb { background: #bbf7d0; border-radius: 10px; }
        .msg-bot {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 16px 16px 16px 4px;
            padding: 11px 15px;
            font-size: 0.86rem;
            color: #1a3d1f;
            max-width: 88%;
            align-self: flex-start;
            line-height: 1.5;
        }
        .msg-user {
            background: linear-gradient(135deg, #16a34a, #22c55e);
            color: white;
            border-radius: 16px 16px 4px 16px;
            padding: 11px 15px;
            font-size: 0.86rem;
            max-width: 88%;
            align-self: flex-end;
            line-height: 1.5;
        }
        .msg-typing {
            color: #6b7280;
            font-style: italic;
            font-size: 0.8rem;
            align-self: flex-start;
            padding: 6px 10px;
        }
        #chatInputArea {
            display: flex;
            padding: 12px;
            background: white;
            border-top: 1px solid #e5e7eb;
            gap: 8px;
        }
        #chatInput {
            flex: 1;
            padding: 10px 14px;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            font-size: 0.88rem;
            outline: none;
            transition: border 0.2s;
        }
        #chatInput:focus { border-color: #16a34a; }
        #chatSendBtn {
            background: linear-gradient(135deg, #16a34a, #22c55e);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 0 18px;
            cursor: pointer;
            font-size: 1.15rem;
            transition: transform 0.2s;
        }
        #chatSendBtn:hover { transform: scale(1.08); }
        #chatCloseBtn {
            background: rgba(255,255,255,0.15);
            border: none;
            color: white;
            border-radius: 8px;
            padding: 4px 11px;
            cursor: pointer;
            font-size: 1rem;
            transition: background 0.2s;
        }
        #chatCloseBtn:hover { background: rgba(255,255,255,0.3); }
        .chat-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: #ef4444;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            display: none;
        }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'components/_sidebar_admin.html.twig' %}
    <div class="main-content">

        <div class="page-header">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="text-white fw-bold mb-1" style="font-size:1.6rem;">➕ Nouvelle Décision</h2>
                    <p class="mb-0" style="color:rgba(255,255,255,0.65); font-size:0.85rem;">Créez une nouvelle décision financière</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-light d-md-none" id="mobileSidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <a href="{{ path('admin_decision_index') }}" class="btn-back">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
        </div>

        <div class="py-4">
            <div class="row justify-content-center">
                <div class="col-xl-7 col-lg-9">
                    <div class="form-card">
                        <div class="form-card-header">
                            <div class="d-flex align-items-center gap-2">
                                <span style="font-size:1.2rem;">📋</span>
                                <span style="font-weight:700; color:#15803d;">Informations de la décision</span>
                            </div>
                        </div>
                        <div class="form-card-body">
                            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                            <div class="field-group">
                                <label class="field-label">🔍 Évaluation liée</label>
                                {{ form_widget(form.evaluation, {'attr': {'class': 'field-input'}}) }}
                                {{ form_errors(form.evaluation) }}
                                <div class="field-hint">Choisissez l'évaluation de risque associée</div>
                            </div>
                            <div class="divider"></div>

                            <div class="field-group">
                                <label class="field-label">⚖️ Type de Décision</label>
                                {{ form_widget(form.statut, {'attr': {'class': 'field-input'}}) }}
                                {{ form_errors(form.statut) }}
                                <div class="field-hint">Sélectionnez le type de décision</div>
                            </div>
                            <div class="divider"></div>

                            <div class="field-group">
                                <label class="field-label">📝 Justification</label>
                                {{ form_widget(form.justification, {'attr': {'class': 'field-input', 'rows': 5, 'placeholder': 'Expliquez la raison de cette décision...'}}) }}
                                {{ form_errors(form.justification) }}
                            </div>
                            <div class="divider"></div>

                            <div class="field-group">
                                <label class="field-label">📅 Date de décision</label>
                                {{ form_widget(form.dateDecision, {'attr': {'class': 'field-input'}}) }}
                                {{ form_errors(form.dateDecision) }}
                            </div>

                            <button type="submit" class="btn-submit">
                                <i class="fas fa-save"></i> Enregistrer la décision
                            </button>

                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# ======= CHATBOT WIDGET FLOTTANT ======= #}
<div id="chatWidget">
    <div style="position:relative;">
        <span class="chat-badge" id="chatBadge">1</span>
        <button id="chatToggle" onclick="toggleChat()" title="Expert Agricole IA">🌱</button>
    </div>

    <div id="chatWindow">
        <div id="chatHeader">
            <div style="display:flex; align-items:center; gap:12px;">
                <span style="font-size:1.5rem;">🌱</span>
                <div>
                    <div style="color:white; font-weight:700; font-size:0.95rem; line-height:1.2;">Expert Agricole IA</div>
                    <div style="color:rgba(255,255,255,0.65); font-size:0.72rem;">Analyse vos projets en temps réel</div>
                </div>
            </div>
            <button id="chatCloseBtn" onclick="toggleChat()">✕</button>
        </div>

        <div id="chatMessages"></div>

        <div id="chatInputArea">
            <input type="text" id="chatInput" placeholder="Posez votre question...">
            <button id="chatSendBtn" onclick="sendMessage()">➤</button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.getElementById('mobileSidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('show');
        });

        // ======= CHATBOT LOGIC =======
        let currentEval = null;
        let chatOpen    = false;

        function toggleChat() {
            chatOpen = !chatOpen;
            const win = document.getElementById('chatWindow');
            win.style.display = chatOpen ? 'block' : 'none';
            document.getElementById('chatToggle').style.transform = chatOpen ? 'scale(0.92)' : 'scale(1)';
            document.getElementById('chatBadge').style.display = 'none';

            if (chatOpen && document.getElementById('chatMessages').children.length === 0) {
                addMessage('bot', '👋 Bonjour ! Sélectionnez une <strong>évaluation</strong> dans le formulaire ci-dessus, puis posez-moi vos questions agricoles. Je suis là pour vous aider ! 🌱');
            }
            if (chatOpen) document.getElementById('chatInput').focus();
        }

        function addMessage(type, html) {
            const container = document.getElementById('chatMessages');
            const div = document.createElement('div');
            div.className = type === 'bot' ? 'msg-bot' : (type === 'user' ? 'msg-user' : 'msg-typing');
            div.innerHTML = html;
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
            return div;
        }

        // Détecte la sélection d'une évaluation dans le formulaire
        document.addEventListener('change', function (e) {
            if (e.target.name && e.target.name.includes('[evaluation]')) {
                const evalId = e.target.value;
                if (!evalId) return;

                const url = '{{ path("admin_decision_get_evaluation", {id: 0}) }}'.replace('/0', '/' + evalId);

                fetch(url)
                    .then(r => {
                        if (!r.ok) throw new Error('HTTP ' + r.status);
                        return r.json();
                    })
                    .then(data => {
                        currentEval = data;

                        // Ouvre le chat automatiquement
                        if (!chatOpen) toggleChat();
                        else document.getElementById('chatBadge').style.display = 'flex';

                        addMessage('bot',
                            `✅ <strong>Évaluation #${data.id} chargée !</strong><br>` +
                            `📊 Niveau de risque : <strong>${data.niveauRisque}</strong><br>` +
                            `🎯 Score global : <strong>${data.scoreGlobal}/100</strong><br>` +
                            `📝 ${data.recommandation ?? 'Aucune recommandation disponible.'}<br><br>` +
                            `Posez-moi vos questions sur ce projet ! 🌿`
                        );
                    })
                    .catch(err => {
                        console.error('Erreur chargement évaluation:', err);
                        if (!chatOpen) toggleChat();
                        addMessage('bot', '❌ Impossible de charger cette évaluation. Vérifiez votre connexion.');
                    });
            }
        });

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const text  = input.value.trim();
            if (!text) return;

            if (!currentEval) {
                if (!chatOpen) toggleChat();
                addMessage('bot', '⚠️ Veuillez d\'abord <strong>sélectionner une évaluation</strong> dans le formulaire.');
                return;
            }

            addMessage('user', text);
            input.value = '';

            const typingDiv = addMessage('typing', '💬 Analyse en cours...');

            fetch('{{ path("admin_decision_chat") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text, evaluation: currentEval })
            })
            .then(r => r.json())
            .then(data => {
                typingDiv.remove();
                addMessage('bot', data.reply);
            })
            .catch(() => {
                typingDiv.remove();
                addMessage('bot', '❌ Erreur de connexion. Réessayez dans un instant.');
            });
        }

        document.getElementById('chatInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') sendMessage();
        });
    </script>
{% endblock %}
