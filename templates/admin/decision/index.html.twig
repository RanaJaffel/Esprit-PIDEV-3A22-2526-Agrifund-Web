{% extends 'base.html.twig' %}
{% block title %}Décisions Financières{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --vert-clair: #B2D944;
            --olive: #9A951F;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%); min-height: 100vh; }
        .dashboard-container { display: flex; min-height: 100vh; }
        .main-content { flex: 1; margin-left: 280px; padding: 0; background: transparent; transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        @media (max-width: 991.98px) { .main-content { margin-left: 0; } }

        .decision-header { background: linear-gradient(135deg, #0a3d1f 0%, #1a5c35 50%, #2d8a50 100%); padding: 28px 35px; position: relative; overflow: hidden; }
        .decision-header::before { content: '⚖️'; position: absolute; right: 30px; top: 50%; transform: translateY(-50%); font-size: 80px; opacity: 0.1; }

        .stat-card { background: white; border-radius: 16px; padding: 20px 24px; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.06); transition: all 0.3s ease; border-left: 4px solid transparent; }
        .stat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 30px rgba(0,0,0,0.12); }
        .stat-card.total { border-left-color: #2d8a50; }
        .stat-card.approuve { border-left-color: #22c55e; }
        .stat-card.refuse { border-left-color: #ef4444; }

        .stat-icon { width: 50px; height: 50px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
        .stat-number { font-size: 2rem; font-weight: 800; line-height: 1; }
        .stat-label { font-size: 0.8rem; color: #6b7280; font-weight: 500; margin-top: 4px; }

        .search-filter-bar { background: white; border-radius: 16px; padding: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); margin-bottom: 24px; }
        .search-input { border: 2px solid #e5e7eb; border-radius: 12px; padding: 12px 16px 12px 44px; font-size: 0.9rem; transition: all 0.3s; width: 100%; }
        .search-input:focus { border-color: #2d8a50; box-shadow: 0 0 0 4px rgba(45,138,80,0.1); outline: none; }
        .search-wrapper { position: relative; }
        .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #9ca3af; }

        .filter-select { border: 2px solid #e5e7eb; border-radius: 12px; padding: 12px 16px; font-size: 0.9rem; transition: all 0.3s; cursor: pointer; }
        .filter-select:focus { border-color: #2d8a50; outline: none; }

        .decision-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 20px; }
        .decision-card { background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.06); transition: all 0.3s ease; border: 1px solid #f0f0f0; }
        .decision-card:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(0,0,0,0.12); }

        .decision-card-header { background: linear-gradient(135deg, #0a3d1f, #1a5c35); padding: 18px 20px; display: flex; justify-content: space-between; align-items: center; }
        .decision-card-header .title { color: white; font-weight: 700; font-size: 1rem; }

        .badge-statut { padding: 6px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
        .badge-approuve { background: #22c55e; color: white; }
        .badge-refuse { background: #ef4444; color: white; }

        .decision-card-body { padding: 20px; }
        .eval-badge { background: linear-gradient(135deg, #f0fdf4, #dcfce7); border: 1px solid #bbf7d0; border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; }
        .eval-label { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 1px; color: #6b7280; font-weight: 600; }
        .eval-value { font-size: 1rem; font-weight: 700; color: #15803d; }

        .info-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px; }
        .info-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; color: #9ca3af; font-weight: 600; }
        .info-value { font-size: 0.88rem; color: #374151; font-weight: 500; }
        .info-value.truncate { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

        .decision-card-footer { padding: 14px 20px; background: #fafafa; border-top: 1px solid #f0f0f0; display: flex; gap: 8px; }
        .btn-action { flex: 1; padding: 8px; border-radius: 10px; border: none; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s; text-align: center; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 5px; }
        .btn-view { background: #eff6ff; color: #3b82f6; }
        .btn-view:hover { background: #3b82f6; color: white; }
        .btn-edit { background: #fffbeb; color: #d97706; }
        .btn-edit:hover { background: #d97706; color: white; }
        .btn-delete { background: #fef2f2; color: #ef4444; }
        .btn-delete:hover { background: #ef4444; color: white; }

        .btn-new { background: linear-gradient(135deg, #22c55e, #16a34a); color: white; border: none; border-radius: 14px; padding: 12px 24px; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: all 0.3s; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(34,197,94,0.3); }
        .btn-new:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(34,197,94,0.4); color: white; }

        .main-content > *:not(.decision-header):not(script) { padding-left: 35px; padding-right: 35px; }
        @media (max-width: 768px) { .main-content > *:not(.decision-header):not(script) { padding-left: 20px; padding-right: 20px; } }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'components/_sidebar_admin.html.twig' %}
    <div class="main-content">
        <div class="decision-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-white fw-bold mb-1" style="font-size:1.8rem;">⚖️ Décisions Financières</h2>
                    <p class="mb-0" style="color:rgba(255,255,255,0.65); font-size:0.9rem;">Gérez toutes les décisions financières</p>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-outline-light d-md-none" id="mobileSidebarToggle"><i class="fas fa-bars"></i></button>
                    <a href="{{ path('admin_decision_new') }}" class="btn-new">
                        <i class="fas fa-plus"></i> Nouvelle Décision
                    </a>
                </div>
            </div>
        </div>

        <div class="py-4">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
                    <i class="fas fa-check-circle me-2"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {# STATS - Sans "En attente" #}
            {% set total = decisions|length %}
            {% set approuves = decisions|filter(d => d.statut == 'approuve')|length %}
            {% set refuses = decisions|filter(d => d.statut == 'refuse')|length %}

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4">
                    <div class="stat-card total">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon" style="background:#f0fdf4;">⚖️</div>
                            <div><div class="stat-number" style="color:#0a3d1f;">{{ total }}</div><div class="stat-label">Total décisions</div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="stat-card approuve">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon" style="background:#f0fdf4;">✅</div>
                            <div><div class="stat-number" style="color:#16a34a;">{{ approuves }}</div><div class="stat-label">Approuvées</div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="stat-card refuse">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon" style="background:#fef2f2;">❌</div>
                            <div><div class="stat-number" style="color:#dc2626;">{{ refuses }}</div><div class="stat-label">Refusées</div></div>
                        </div>
                    </div>
                </div>
            </div>

            {# PROGRESS BAR - Sans En attente #}
            {% if total > 0 %}
            <div class="search-filter-bar mb-4">
                <div style="font-size:0.85rem; font-weight:700; color:#374151; margin-bottom:10px;">📊 Répartition des décisions</div>
                <div class="progress-bar-custom">
                    <div style="display:flex; height:100%;">
                        <div style="width:{{ (approuves/total*100)|round }}%; background:#22c55e; border-radius:4px 0 0 4px;"></div>
                        <div style="width:{{ (refuses/total*100)|round }}%; background:#ef4444; border-radius:0 4px 4px 0;"></div>
                    </div>
                </div>
                <div class="d-flex gap-4 mt-2" style="font-size:0.78rem;">
                    <span><span style="color:#22c55e;">●</span> Approuvées ({{ approuves }})</span>
                    <span><span style="color:#ef4444;">●</span> Refusées ({{ refuses }})</span>
                </div>
            </div>
            {% endif %}

            {# SEARCH & FILTER #}
            <div class="search-filter-bar">
                <div class="row g-3 align-items-center">
                    <div class="col-md-6">
                        <div class="search-wrapper">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text" class="search-input" id="searchInput" placeholder="Rechercher par justification, statut...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="filter-select w-100" id="sortSelect">
                            <option value="">— Trier par —</option>
                            <option value="date-desc">Date (récent)</option>
                            <option value="date-asc">Date (ancien)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="filter-select w-100" id="filterSelect">
                            <option value="">— Filtrer par statut —</option>
                            <option value="approuve">Approuvé</option>
                            <option value="refuse">Refusé</option>
                        </select>
                    </div>
                </div>
            </div>

            {# CARDS #}
            {% if decisions is empty %}
                <div class="text-center py-5">
                    <div style="font-size:4rem; opacity:0.3;">⚖️</div>
                    <h4 class="text-muted mt-3">Aucune décision trouvée</h4>
                    <a href="{{ path('admin_decision_new') }}" class="btn-new mt-3">
                        <i class="fas fa-plus"></i> Créer une décision
                    </a>
                </div>
            {% else %}
                <div class="decision-grid mt-4" id="decisionGrid">
                    {% for decision in decisions %}
                    <div class="decision-card"
                         data-statut="{{ decision.statut }}"
                         data-justification="{{ decision.justification|lower }}"
                         data-date="{{ decision.dateDecision|date('Y-m-d') }}">
                        <div class="decision-card-header">
                            <div class="title"><i class="fas fa-gavel me-2"></i>Décision #{{ decision.idDecision }}</div>
                            {% if decision.statut == 'approuve' %}
                                <span class="badge-statut badge-approuve">✓ Approuvé</span>
                            {% else %}
                                <span class="badge-statut badge-refuse">✗ Refusé</span>
                            {% endif %}
                        </div>
                        <div class="decision-card-body">
                            {% if decision.evaluation %}
                            <div class="eval-badge">
                                <div class="eval-label">Évaluation liée</div>
                                <div class="eval-value">Évaluation #{{ decision.evaluation.idEvaluation }}</div>
                                <small style="color:#6b7280;">Risque: {{ decision.evaluation.niveauRisque }} — Score: {{ decision.evaluation.scoreGlobal }}</small>
                            </div>
                            {% endif %}
                            <div class="info-row">
                                <span style="font-size:1rem;">📝</span>
                                <div>
                                    <div class="info-label">Justification</div>
                                    <div class="info-value truncate">{{ decision.justification }}</div>
                                </div>
                            </div>
                            <div class="info-row">
                                <span style="font-size:1rem;">📅</span>
                                <div>
                                    <div class="info-label">Date de décision</div>
                                    <div class="info-value">{{ decision.dateDecision|date('d/m/Y') }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="decision-card-footer">
    <a href="{{ path('admin_decision_show', {id: decision.idDecision}) }}" 
       class="btn-action btn-view">
        <i class="fas fa-eye"></i> Voir
    </a>
    
    <a href="{{ path('admin_decision_edit', {idDecision: decision.idDecision}) }}" 
       class="btn-action btn-edit">
        <i class="fas fa-edit"></i> Modifier
    </a>
    
    <form method="post" 
          action="{{ path('admin_decision_delete', {id: decision.idDecision}) }}" 
          onsubmit="return confirm('Supprimer cette décision ?')">
        
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ decision.idDecision) }}">
        
        <button type="submit" class="btn-action btn-delete w-100">
            <i class="fas fa-trash"></i> Supprimer
        </button>
    </form>
</div>
                    </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.getElementById('mobileSidebarToggle')?.addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('show');
        });

        const searchInput = document.getElementById('searchInput');
        const filterSelect = document.getElementById('filterSelect');
        const sortSelect = document.getElementById('sortSelect');
        const grid = document.getElementById('decisionGrid');

        function filterCards() {
            if (!grid) return;
            const search = searchInput.value.toLowerCase().trim();
            const filter = filterSelect.value.trim();
            const cards = [...grid.querySelectorAll('.decision-card')];

            cards.forEach(card => {
                const justif = (card.dataset.justification || '').toLowerCase().trim();
                const statut = (card.dataset.statut || '').toLowerCase().trim();
                const matchSearch = !search || justif.includes(search) || statut.includes(search);
                const matchFilter = !filter || statut === filter;
                card.style.display = (matchSearch && matchFilter) ? '' : 'none';
            });

            if (sortSelect.value === 'date-desc') {
                cards.sort((a, b) => b.dataset.date.localeCompare(a.dataset.date));
                cards.forEach(card => grid.appendChild(card));
            } else if (sortSelect.value === 'date-asc') {
                cards.sort((a, b) => a.dataset.date.localeCompare(b.dataset.date));
                cards.forEach(card => grid.appendChild(card));
            }
        }

        searchInput?.addEventListener('input', filterCards);
        filterSelect?.addEventListener('change', filterCards);
        sortSelect?.addEventListener('change', filterCards);
    </script>
{% endblock %}