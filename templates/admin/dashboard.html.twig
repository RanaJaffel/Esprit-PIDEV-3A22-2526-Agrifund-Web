{% extends "base.html.twig" %}

{% block title %}Admin Dashboard - AgriFund{% endblock %}

{% block content %}
<div class="admin-dashboard">
    <div class="dashboard-header" style="background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); padding: 40px 20px; color: white; margin-bottom: 40px; border-bottom: 4px solid #F4C430;">
        <div class="container">
            <h1 style="margin: 0; font-size: 32px; font-weight: bold;">🏦 Admin Dashboard</h1>
            <p style="margin: 10px 0 0 0; font-size: 16px; opacity: 0.9;">Welcome to AgriFund Administration Panel</p>
        </div>
    </div>

    <div class="container" style="margin-bottom: 60px;">
        <!-- Statistics Cards -->
        <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 40px;">
            
            <!-- Total Products Card -->
            <div class="stat-card" style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,.08); border-left: 4px solid #1B7E4C;">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <p style="margin: 0 0 5px 0; color: #666; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Total Products</p>
                        <h3 style="margin: 0; color: #1B7E4C; font-size: 32px; font-weight: bold;">{{ totalProducts }}</h3>
                    </div>
                    <div style="font-size: 48px;">📦</div>
                </div>
            </div>

            <!-- Total Offers Card -->
            <div class="stat-card" style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,.08); border-left: 4px solid #0D5C3F;">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <p style="margin: 0 0 5px 0; color: #666; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Total Offers</p>
                        <h3 style="margin: 0; color: #0D5C3F; font-size: 32px; font-weight: bold;">{{ totalOffers }}</h3>
                    </div>
                    <div style="font-size: 48px;">🎁</div>
                </div>
            </div>

            <!-- Active Offers Card -->
            <div class="stat-card" style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,.08); border-left: 4px solid #F4C430;">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <p style="margin: 0 0 5px 0; color: #666; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Active Offers</p>
                        <h3 style="margin: 0; color: #F4C430; font-size: 32px; font-weight: bold;">{{ activeOffers }}</h3>
                    </div>
                    <div style="font-size: 48px;">✅</div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="quick-actions" style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,.08);">
            <h2 style="margin: 0 0 20px 0; color: #1B7E4C; font-size: 20px;">Quick Actions</h2>
            
            <div class="actions-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                
                <!-- Manage Products -->
                <a href="{{ path('admin_produit_index') }}" style="display: block; padding: 20px; background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); color: white; text-decoration: none; border-radius: 6px; text-align: center; transition: transform 0.3s, box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 16px rgba(27,126,76,.2)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(0,0,0,.1)'">
                    <div style="font-size: 28px; margin-bottom: 10px;">📦</div>
                    <h3 style="margin: 0; font-size: 16px; font-weight: 600;">Manage Products</h3>
                    <p style="margin: 5px 0 0 0; font-size: 13px; opacity: 0.9;">View & Edit Products</p>
                </a>

                <!-- Manage Offers -->
                <a href="{{ path('admin_offre_index') }}" style="display: block; padding: 20px; background: linear-gradient(135deg, #0D5C3F 0%, #1B7E4C 100%); color: white; text-decoration: none; border-radius: 6px; text-align: center; transition: transform 0.3s, box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 16px rgba(13,92,63,.2)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(0,0,0,.1)'">
                    <div style="font-size: 28px; margin-bottom: 10px;">🎁</div>
                    <h3 style="margin: 0; font-size: 16px; font-weight: 600;">Manage Offers</h3>
                    <p style="margin: 5px 0 0 0; font-size: 13px; opacity: 0.9;">View & Edit Offers</p>
                </a>

                <!-- Create Product -->
                <a href="{{ path('admin_produit_new') }}" style="display: block; padding: 20px; background: linear-gradient(135deg, #F4C430 0%, #E8B820 100%); color: #333; text-decoration: none; border-radius: 6px; text-align: center; transition: transform 0.3s, box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 16px rgba(244,196,48,.2)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(0,0,0,.1)'">
                    <div style="font-size: 28px; margin-bottom: 10px;">➕</div>
                    <h3 style="margin: 0; font-size: 16px; font-weight: 600;">New Product</h3>
                    <p style="margin: 5px 0 0 0; font-size: 13px; opacity: 0.8;">Create Financial Product</p>
                </a>

                <!-- Create Offer -->
                <a href="{{ path('admin_offre_new') }}" style="display: block; padding: 20px; background: linear-gradient(135deg, #E8B820 0%, #F4C430 100%); color: #333; text-decoration: none; border-radius: 6px; text-align: center; transition: transform 0.3s, box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 16px rgba(232,184,32,.2)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(0,0,0,.1)'">
                    <div style="font-size: 28px; margin-bottom: 10px;">🎉</div>
                    <h3 style="margin: 0; font-size: 16px; font-weight: 600;">New Offer</h3>
                    <p style="margin: 5px 0 0 0; font-size: 13px; opacity: 0.8;">Create Special Offer</p>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        min-height: 85vh;
    }
    
    @media (max-width: 768px) {
        .dashboard-header h1 {
            font-size: 24px !important;
        }
        
        .stats-grid {
            grid-template-columns: 1fr !important;
        }
        
        .actions-grid {
            grid-template-columns: 1fr !important;
        }
    }
</style>
{% endblock %}
