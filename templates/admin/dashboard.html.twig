{% extends 'base.html.twig' %}

{% block title %}Tableau de bord Admin{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --gris: #848A86;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --vert-clair: #B2D944;
            --olive: #9A951F;
            --vert-olive-fonce: #476C1A;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
        }

        /* ==========================================
           LAYOUT PRINCIPAL
        ========================================== */
        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 0;
            background: transparent;
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 991.98px) {
            .main-content {
                margin-left: 0;
            }
        }

        /* ==========================================
           HEADER SECTION
        ========================================== */
        .main-content > .d-flex.justify-content-between {
            background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-foret) 50%, var(--vert-tres-fonce) 100%);
            padding: 28px 35px;
            margin: 0;
            position: relative;
            overflow: hidden;
        }

        .main-content > .d-flex.justify-content-between::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M40 10 L45 25 L40 40 L35 25 Z' fill='%23B2D944' fill-opacity='0.06'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .main-content > .d-flex.justify-content-between h1 {
            color: white !important;
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        }

        .main-content > .d-flex.justify-content-between h1 i {
            color: var(--vert-clair);
            margin-right: 12px;
        }

        #mobileSidebarToggle {
            background: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            color: white !important;
            border-radius: 12px;
            width: 44px;
            height: 44px;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
        }

        #mobileSidebarToggle:hover {
            background: rgba(255, 255, 255, 0.25) !important;
            transform: scale(1.05);
        }

        /* ==========================================
           CONTENT WRAPPER
        ========================================== */
        .main-content > *:not(.d-flex.justify-content-between):not(script) {
            padding-left: 35px;
            padding-right: 35px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin: 30px 35px;
            padding: 0 !important;
        }

        @media (max-width: 1400px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: 1fr;
                margin: 20px;
            }
        }

        /* ==========================================
           STAT CARDS
        ========================================== */
        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            transform: translate(40%, -40%);
            transition: all 0.4s ease;
            z-index: 0;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .stat-card:hover::before {
            transform: translate(35%, -35%) scale(1.1);
        }

        /* Card Colors */
        .stat-card.users::before {
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.12) 0%, rgba(178, 217, 68, 0.08) 100%);
        }

        .stat-card.agriculteurs::before {
            background: linear-gradient(135deg, rgba(178, 217, 68, 0.15) 0%, rgba(154, 149, 31, 0.08) 100%);
        }

        .stat-card.banques::before {
            background: linear-gradient(135deg, rgba(225, 179, 35, 0.15) 0%, rgba(225, 179, 35, 0.05) 100%);
        }

        .stat-card.documents::before {
            background: linear-gradient(135deg, rgba(71, 108, 26, 0.12) 0%, rgba(9, 80, 50, 0.08) 100%);
        }

        .stat-card .icon {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
            transition: all 0.3s ease;
        }

        .stat-card:hover .icon {
            transform: scale(1.1) rotate(-5deg);
        }

        .stat-card.users .icon {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            color: white;
            box-shadow: 0 10px 25px rgba(8, 150, 71, 0.3);
        }

        .stat-card.agriculteurs .icon {
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--olive) 100%);
            color: white;
            box-shadow: 0 10px 25px rgba(178, 217, 68, 0.3);
        }

        .stat-card.banques .icon {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, #c9a020 100%);
            color: white;
            box-shadow: 0 10px 25px rgba(225, 179, 35, 0.3);
        }

        .stat-card.documents .icon {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
            color: white;
            box-shadow: 0 10px 25px rgba(71, 108, 26, 0.3);
        }

        .stat-value {
            font-size: 2.8rem;
            font-weight: 800;
            color: var(--vert-tres-fonce);
            margin-bottom: 8px;
            line-height: 1;
            letter-spacing: -1px;
            position: relative;
            z-index: 1;
        }

        .stat-label {
            color: var(--gris);
            font-size: 0.95rem;
            font-weight: 500;
            position: relative;
            z-index: 1;
        }

        .stat-card .quick-stats {
            display: flex;
            gap: 20px;
            margin-top: 20px !important;
            padding-top: 18px;
            border-top: 1px solid rgba(0, 0, 0, 0.06);
            position: relative;
            z-index: 1;
        }

        .stat-card .quick-stats > div {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .stat-card .quick-stats small {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--gris) !important;
        }

        .stat-card .quick-stats strong {
            font-size: 1.15rem;
            font-weight: 700;
        }

        .stat-card .quick-stats .text-success {
            color: var(--vert-vif) !important;
        }

        .stat-card .quick-stats .text-warning {
            color: var(--jaune-moutarde) !important;
        }

        /* ==========================================
           DASHBOARD SECTIONS
        ========================================== */
        .dashboard-section {
            background: white;
            border-radius: 20px;
            padding: 0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            margin: 0 35px 30px 35px;
            border: 1px solid rgba(0, 0, 0, 0.04);
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .dashboard-section:hover {
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px 28px;
            margin-bottom: 0;
            background: linear-gradient(90deg, rgba(8, 150, 71, 0.04) 0%, transparent 100%);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .section-title {
            color: var(--vert-tres-fonce);
            margin: 0;
            font-size: 1.15rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            margin-right: 0 !important;
        }

        .section-title i.fa-file-alt {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
            color: white;
        }

        .section-title i.fa-tractor {
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--olive) 100%);
            color: white;
        }

        .section-title i.fa-university {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, #c9a020 100%);
            color: white;
        }

        .section-title i.fa-user-plus {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            color: white;
        }

        .badge-pending {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, #c9a020 100%);
            color: white;
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 0.85rem;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(225, 179, 35, 0.3);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .badge-pending::before {
            content: '';
            width: 8px;
            height: 8px;
            background: white;
            border-radius: 50%;
            animation: pulse-dot 2s infinite;
        }

        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(0.8); }
        }

        /* ==========================================
           TABLES
        ========================================== */
        .table-responsive {
            padding: 0;
        }

        .table-custom,
        .table {
            margin: 0;
            border-collapse: collapse;
        }

        .table-custom thead,
        .table thead {
            background: linear-gradient(90deg, var(--vert-fonce) 0%, var(--vert-foret) 100%);
        }

        .table-custom thead th,
        .table thead th {
            color: white !important;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 16px 20px;
            border: none !important;
        }

        .table-custom tbody tr,
        .table tbody tr {
            transition: all 0.3s ease;
            border-bottom: 1px solid rgba(0, 0, 0, 0.04);
        }

        .table-custom tbody tr:last-child,
        .table tbody tr:last-child {
            border-bottom: none;
        }

        .table-custom tbody tr:hover,
        .table tbody tr:hover {
            background: linear-gradient(90deg, rgba(8, 150, 71, 0.04) 0%, rgba(178, 217, 68, 0.03) 100%);
        }

        .table-custom tbody td,
        .table tbody td {
            padding: 18px 20px;
            vertical-align: middle;
            color: var(--vert-tres-fonce);
            font-size: 0.9rem;
            border: none !important;
        }

        .table-custom tbody td strong,
        .table tbody td strong {
            font-weight: 600;
            color: var(--vert-tres-fonce);
        }

        .table-custom tbody td small,
        .table tbody td small {
            color: var(--gris);
        }

        .table-custom tbody td code,
        .table tbody td code {
            background: rgba(225, 179, 35, 0.12);
            color: #b8960d;
            padding: 6px 14px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        /* ==========================================
           BADGES
        ========================================== */
        .badge {
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            border: none;
        }

        .badge.bg-info {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
            color: white;
        }

        .badge.bg-success {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%) !important;
            color: white;
        }

        .badge.bg-warning {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, #c9a020 100%) !important;
            color: white;
        }

        .badge.bg-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
            color: white;
        }

        /* ==========================================
           BUTTONS
        ========================================== */
        .btn-sm.btn-primary {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            border: none;
            padding: 10px 18px;
            border-radius: 10px;
            font-size: 0.82rem;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(8, 150, 71, 0.25);
            transition: all 0.3s ease;
        }

        .btn-sm.btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(8, 150, 71, 0.35);
        }

        .btn-outline-primary,
        .btn-outline-success,
        .btn-outline-warning {
            border-width: 2px;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-outline-primary {
            border-color: var(--vert-vif);
            color: var(--vert-vif);
        }

        .btn-outline-primary:hover {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            border-color: var(--vert-vif);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(8, 150, 71, 0.25);
        }

        .btn-outline-success {
            border-color: var(--vert-clair);
            color: var(--olive);
        }

        .btn-outline-success:hover {
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--olive) 100%);
            border-color: var(--vert-clair);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(178, 217, 68, 0.25);
        }

        .btn-outline-warning {
            border-color: var(--jaune-moutarde);
            color: #b8960d;
        }

        .btn-outline-warning:hover {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, #c9a020 100%);
            border-color: var(--jaune-moutarde);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(225, 179, 35, 0.25);
        }

        /* ==========================================
           SECTION FOOTER
        ========================================== */
        .dashboard-section .text-center.mt-3 {
            padding: 20px 28px;
            background: linear-gradient(90deg, rgba(0, 0, 0, 0.01) 0%, rgba(0, 0, 0, 0.03) 100%);
            border-top: 1px solid rgba(0, 0, 0, 0.04);
            margin-top: 0 !important;
        }

        .dashboard-section .text-center.mt-3 a {
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .dashboard-section .text-center.mt-3 a i {
            transition: transform 0.3s ease;
        }

        .dashboard-section .text-center.mt-3 a:hover i {
            transform: translateX(5px);
        }

        /* ==========================================
           USER CELLS
        ========================================== */
        .table td .rounded-circle,
        .table td .fa-user-circle {
            width: 40px;
            height: 40px;
            border-radius: 12px !important;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
        }

        .table td .fa-user-circle {
            font-size: 2.2rem;
            color: var(--vert-vif);
        }

        /* ==========================================
           FLASH MESSAGES
        ========================================== */
        .alert {
            border-radius: 14px;
            border: none;
            padding: 16px 24px;
            margin: 20px 35px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .alert-success {
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.1) 0%, rgba(178, 217, 68, 0.1) 100%);
            color: var(--vert-fonce);
        }

        .alert-warning {
            background: linear-gradient(135deg, rgba(225, 179, 35, 0.15) 0%, rgba(225, 179, 35, 0.1) 100%);
            color: #92750d;
        }

        .alert-danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
            color: #b91c1c;
        }

        /* ==========================================
           ANIMATIONS
        ========================================== */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .stat-card {
            animation: fadeInUp 0.6s ease-out forwards;
        }

        .stat-card:nth-child(1) { animation-delay: 0.1s; }
        .stat-card:nth-child(2) { animation-delay: 0.2s; }
        .stat-card:nth-child(3) { animation-delay: 0.3s; }
        .stat-card:nth-child(4) { animation-delay: 0.4s; }

        .dashboard-section {
            animation: fadeInUp 0.6s ease-out forwards;
            animation-delay: 0.3s;
            opacity: 0;
        }

        /* ==========================================
           SCROLLBAR
        ========================================== */
        .main-content::-webkit-scrollbar {
            width: 8px;
        }

        .main-content::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .main-content::-webkit-scrollbar-thumb {
            background: var(--vert-vif);
            border-radius: 4px;
        }

        .main-content::-webkit-scrollbar-thumb:hover {
            background: var(--vert-fonce);
        }

        /* ==========================================
           RESPONSIVE
        ========================================== */
        @media (max-width: 768px) {
            .main-content > .d-flex.justify-content-between {
                padding: 20px;
            }

            .main-content > .d-flex.justify-content-between h1 {
                font-size: 1.4rem;
            }

            .stats-grid {
                margin: 20px;
                gap: 16px;
            }

            .stat-card {
                padding: 22px;
            }

            .stat-value {
                font-size: 2.2rem;
            }

            .dashboard-section {
                margin: 0 20px 20px 20px;
                border-radius: 16px;
            }

            .section-header {
                padding: 18px 20px;
                flex-direction: column;
                gap: 12px;
                align-items: flex-start;
            }

            .table-custom thead th,
            .table thead th,
            .table-custom tbody td,
            .table tbody td {
                padding: 14px 16px;
            }

            .section-title {
                font-size: 1rem;
            }

            .badge-pending {
                padding: 8px 16px;
                font-size: 0.8rem;
            }
        }

        /* ==========================================
           DARK OVERLAY FOR MOBILE SIDEBAR
        ========================================== */
        .sidebar-overlay.active {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 999;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {% include 'components/_sidebar_admin.html.twig' %}
        
        <div class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="fas fa-chart-line me-2"></i>Tableau de bord
        </h1>
        <button class="btn btn-outline-primary d-md-none" id="mobileSidebarToggle">
            <i class="fas fa-bars"></i>
        </button>
    </div>
    {% include 'components/_flash_messages.html.twig' %}
    {% block content %}{% endblock %}
            
            {# Statistiques principales #}
            <div class="stats-grid">
                <div class="stat-card users">
                    <div class="icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-value">{{ stats_utilisateurs.total }}</div>
                    <div class="stat-label">Total Utilisateurs</div>
                    <div class="quick-stats mt-3">
                        <div>
                            <small class="text-muted">Admins:</small>
                            <strong class="ms-2">{{ stats_utilisateurs.admins }}</strong>
                        </div>
                    </div>
                </div>
                
                <div class="stat-card agriculteurs">
                    <div class="icon">
                        <i class="fas fa-tractor"></i>
                    </div>
                    <div class="stat-value">{{ stats_agriculteurs.total }}</div>
                    <div class="stat-label">Agriculteurs</div>
                    <div class="quick-stats mt-3">
                        <div>
                            <small class="text-muted">Actifs:</small>
                            <strong class="text-success ms-2">{{ stats_agriculteurs.actifs }}</strong>
                        </div>
                        <div>
                            <small class="text-muted">En attente:</small>
                            <strong class="text-warning ms-2">{{ stats_agriculteurs.en_attente }}</strong>
                        </div>
                    </div>
                </div>
                
                <div class="stat-card banques">
                    <div class="icon">
                        <i class="fas fa-university"></i>
                    </div>
                    <div class="stat-value">{{ stats_banques.total }}</div>
                    <div class="stat-label">Banques</div>
                    <div class="quick-stats mt-3">
                        <div>
                            <small class="text-muted">Actives:</small>
                            <strong class="text-success ms-2">{{ stats_banques.actives }}</strong>
                        </div>
                        <div>
                            <small class="text-muted">En attente:</small>
                            <strong class="text-warning ms-2">{{ stats_banques.en_attente }}</strong>
                        </div>
                    </div>
                </div>
                
                <div class="stat-card documents">
                    <div class="icon">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div class="stat-value">{{ stats_documents.total }}</div>
                    <div class="stat-label">Documents</div>
                    <div class="quick-stats mt-3">
                        <div>
                            <small class="text-muted">Validés:</small>
                            <strong class="text-success ms-2">{{ stats_documents.statuts.valide }}</strong>
                        </div>
                        <div>
                            <small class="text-muted">En attente:</small>
                            <strong class="text-warning ms-2">{{ stats_documents.statuts.en_attente }}</strong>
                        </div>
                    </div>
                </div>
            </div>
            
            {# Documents en attente #}
            {% if documents_en_attente|length > 0 %}
            <div class="dashboard-section">
                <div class="section-header">
                    <h5 class="section-title">
                        <i class="fas fa-file-alt me-2"></i>Documents en attente de validation
                    </h5>
                    <span class="badge-pending">{{ documents_en_attente|length }} en attente</span>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Utilisateur</th>
                                <th>Document</th>
                                <th>Type</th>
                                <th>Date d'envoi</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for document in documents_en_attente|slice(0, 5) %}
                            <tr>
                                <td>
                                    <strong>{{ document.utilisateur.nomComplet }}</strong>
                                    <br>
                                    <small class="text-muted">{{ document.utilisateur.email }}</small>
                                </td>
                                <td>{{ document.nom }}</td>
                                <td>
                                    <span class="badge bg-info">{{ document.typeDocument }}</span>
                                </td>
                                <td>{{ document.dateUpload|date('d/m/Y H:i') }}</td>
                                <td>
                                    <a href="{{ path('admin_documents_review', {id: document.id}) }}" 
                                       class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> Examiner
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                {% if documents_en_attente|length > 5 %}
                <div class="text-center mt-3">
                    <a href="{{ path('admin_documents_index', {statut: 'en_attente'}) }}" 
                       class="btn btn-outline-primary">
                        Voir tous les documents en attente
                        <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
                {% endif %}
            </div>
            {% endif %}
            
            {# Agriculteurs en attente #}
            {% if agriculteurs_en_attente|length > 0 %}
            <div class="dashboard-section">
                <div class="section-header">
                    <h5 class="section-title">
                        <i class="fas fa-tractor me-2"></i>Agriculteurs en attente de vérification
                    </h5>
                    <span class="badge-pending">{{ agriculteurs_en_attente|length }} en attente</span>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Email</th>
                                <th>Type de culture</th>
                                <th>Date d'inscription</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for agriculteur in agriculteurs_en_attente|slice(0, 5) %}
                            <tr>
                                <td><strong>{{ agriculteur.utilisateur.nomComplet }}</strong></td>
                                <td>{{ agriculteur.utilisateur.email }}</td>
                                <td>
                                    <span class="badge bg-success">{{ agriculteur.typeCulture ?? 'N/A' }}</span>
                                </td>
                                <td>{{ agriculteur.utilisateur.dateInscrit|date('d/m/Y') }}</td>
                                <td>
                                    <a href="{{ path('admin_agriculteurs_show', {id: agriculteur.id}) }}" 
                                       class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                {% if agriculteurs_en_attente|length > 5 %}
                <div class="text-center mt-3">
                    <a href="{{ path('admin_agriculteurs_index', {status: 'en_attente'}) }}" 
                       class="btn btn-outline-success">
                        Voir tous les agriculteurs en attente
                        <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
                {% endif %}
            </div>
            {% endif %}
            
            {# Banques en attente #}
            {% if banques_en_attente|length > 0 %}
            <div class="dashboard-section">
                <div class="section-header">
                    <h5 class="section-title">
                        <i class="fas fa-university me-2"></i>Banques en attente de vérification
                    </h5>
                    <span class="badge-pending">{{ banques_en_attente|length }} en attente</span>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Code banque</th>
                                <th>Email</th>
                                <th>Date d'inscription</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for banque in banques_en_attente|slice(0, 5) %}
                            <tr>
                                <td><strong>{{ banque.utilisateur.nom }}</strong></td>
                                <td><code>{{ banque.codebanque }}</code></td>
                                <td>{{ banque.utilisateur.email }}</td>
                                <td>{{ banque.utilisateur.dateInscrit|date('d/m/Y') }}</td>
                                <td>
                                    <a href="{{ path('admin_banques_show', {id: banque.id}) }}" 
                                       class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                {% if banques_en_attente|length > 5 %}
                <div class="text-center mt-3">
                    <a href="{{ path('admin_banques_index', {status: 'en_attente'}) }}" 
                       class="btn btn-outline-warning">
                        Voir toutes les banques en attente
                        <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
                {% endif %}
            </div>
            {% endif %}
            
            {# Utilisateurs récents #}
            <div class="dashboard-section">
                <div class="section-header">
                    <h5 class="section-title">
                        <i class="fas fa-user-plus me-2"></i>Inscriptions récentes
                    </h5>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Email</th>
                                <th>Type</th>
                                <th>Date d'inscription</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for utilisateur in utilisateurs_recents %}
                            <tr>
                                <td>
                                    {% if utilisateur.photo %}
                                        <img src="{{ asset(utilisateur.photo) }}" 
                                             alt="{{ utilisateur.nomComplet }}" 
                                             class="rounded-circle me-2" 
                                             style="width: 32px; height: 32px; object-fit: cover;">
                                    {% else %}
                                        <i class="fas fa-user-circle me-2"></i>
                                    {% endif %}
                                    <strong>{{ utilisateur.nomComplet }}</strong>
                                </td>
                                <td>{{ utilisateur.email }}</td>
                                <td>
                                    {% if utilisateur.admin %}
                                        <span class="badge bg-danger">Admin</span>
                                    {% elseif utilisateur.agriculteur %}
                                        <span class="badge bg-success">Agriculteur</span>
                                    {% elseif utilisateur.banque %}
                                        <span class="badge bg-warning">Banque</span>
                                    {% endif %}
                                </td>
                                <td>{{ utilisateur.dateInscrit|date('d/m/Y H:i') }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        // Mobile sidebar toggle
        document.getElementById('mobileSidebarToggle')?.addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('show');
        });
        
        // Auto-refresh unread messages count
        setInterval(function() {
            fetch('{{ path('admin_messagerie_unread_count') }}')
                .then(response => response.json())
                .then(data => {
                    const badge = document.getElementById('unread-messages-badge');
                    if (data.count > 0) {
                        badge.textContent = data.count;
                        badge.style.display = 'inline-block';
                    } else {
                        badge.style.display = 'none';
                    }
                });
        }, 30000); // Refresh every 30 seconds
    </script>
{% endblock %}