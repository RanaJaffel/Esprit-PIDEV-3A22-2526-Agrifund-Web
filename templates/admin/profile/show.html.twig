{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --gris: #848A86;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --jaune-fonce: #c9a020;
            --vert-clair: #B2D944;
            --olive: #9A951F;
            --vert-olive-fonce: #476C1A;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
        }

        /* ==========================================
           LAYOUT
        ========================================== */
        .dashboard-container { display: flex; min-height: 100vh; }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 0;
            background: transparent;
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 991.98px) {
            .main-content { margin-left: 0; }
        }

        /* ==========================================
           HEADER
        ========================================== */
        .main-content > .d-flex.justify-content-between:first-of-type {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 50%, var(--vert-tres-fonce) 100%);
            padding: 28px 35px;
            margin: 0 0 30px 0;
            position: relative;
            overflow: hidden;
        }

        .main-content > .d-flex.justify-content-between:first-of-type::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='30' cy='30' r='15' fill='none' stroke='%23B2D944' stroke-opacity='0.05' stroke-width='2'/%3E%3Ccircle cx='30' cy='30' r='8' fill='%23B2D944' fill-opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .main-content > .d-flex.justify-content-between:first-of-type::after {
            content: '';
            position: absolute;
            top: -50%; right: -10%;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(178, 217, 68, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .main-content > .d-flex.justify-content-between:first-of-type h1 {
            color: white !important;
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .main-content > .d-flex.justify-content-between:first-of-type h1 i {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            box-shadow: 0 8px 20px rgba(71, 108, 26, 0.35);
            margin-right: 0 !important;
        }

        /* Header Edit Button */
        .main-content > .d-flex.justify-content-between:first-of-type .btn-primary {
            background: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
            color: white !important;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .main-content > .d-flex.justify-content-between:first-of-type .btn-primary:hover {
            background: rgba(255, 255, 255, 0.25) !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        /* ==========================================
           CONTENT AREA
        ========================================== */
        .main-content > .row {
            margin-left: 35px;
            margin-right: 35px;
        }

        @media (max-width: 768px) {
            .main-content > .row {
                margin-left: 20px;
                margin-right: 20px;
            }
        }

        /* ==========================================
           DASHBOARD SECTIONS
        ========================================== */
        .dashboard-section {
            background: white;
            border-radius: 20px;
            padding: 32px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.6s ease-out forwards;
            opacity: 0;
        }

        .dashboard-section::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair), var(--jaune-moutarde));
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .col-md-4 .dashboard-section {
            animation-delay: 0.1s;
        }

        .col-md-8 .dashboard-section {
            animation-delay: 0.2s;
        }

        /* ==========================================
           PROFILE CARD (Left Column)
        ========================================== */
        .col-md-4 .dashboard-section {
            text-align: center;
            padding-top: 40px;
        }

        /* Profile Photo Container */
        .col-md-4 .dashboard-section .mb-4:first-child {
            position: relative;
            display: inline-block;
        }

        .col-md-4 .dashboard-section .rounded-circle {
            width: 180px !important;
            height: 180px !important;
            object-fit: cover;
            border: 5px solid var(--vert-vif) !important;
            box-shadow: 0 10px 40px rgba(8, 150, 71, 0.25);
            transition: all 0.4s ease;
        }

        .col-md-4 .dashboard-section .rounded-circle:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 50px rgba(8, 150, 71, 0.35);
            border-color: var(--vert-clair) !important;
        }

        /* Default User Icon */
        .col-md-4 .dashboard-section .fa-user-circle {
            color: var(--vert-olive-fonce) !important;
            opacity: 0.3;
            transition: all 0.3s ease;
        }

        .col-md-4 .dashboard-section:hover .fa-user-circle {
            opacity: 0.5;
            transform: scale(1.05);
        }

        /* Profile Name */
        .col-md-4 .dashboard-section h3 {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--vert-tres-fonce);
            margin-bottom: 8px;
        }

        /* Profile Email */
        .col-md-4 .dashboard-section > p.text-muted {
            color: var(--gris) !important;
            font-size: 0.95rem;
        }

        /* Admin Badge */
        .col-md-4 .dashboard-section .badge.bg-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 0.85rem;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .col-md-4 .dashboard-section .badge.bg-danger i {
            font-size: 0.9rem;
        }

        /* Online Status Badges */
        .col-md-4 .dashboard-section .mt-4 .badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .col-md-4 .dashboard-section .badge.bg-success {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%) !important;
            box-shadow: 0 4px 12px rgba(8, 150, 71, 0.25);
            animation: pulse-online 2s infinite;
        }

        @keyframes pulse-online {
            0%, 100% { box-shadow: 0 4px 12px rgba(8, 150, 71, 0.25); }
            50% { box-shadow: 0 4px 20px rgba(8, 150, 71, 0.45); }
        }

        .col-md-4 .dashboard-section .badge.bg-secondary {
            background: linear-gradient(135deg, var(--gris) 0%, #6b7280 100%) !important;
        }

        /* Profile Card Watermark */
        .col-md-4 .dashboard-section::after {
            content: '\f007';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute;
            bottom: 15px;
            right: 20px;
            font-size: 6rem;
            color: var(--vert-olive-fonce);
            opacity: 0.03;
            pointer-events: none;
        }

        /* ==========================================
           INFO SECTION (Right Column)
        ========================================== */
        .section-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--vert-tres-fonce);
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(71, 108, 26, 0.1);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
            box-shadow: 0 4px 15px rgba(71, 108, 26, 0.25);
        }

        /* Info Table */
        .table-borderless {
            margin: 0;
        }

        .table-borderless tr {
            border-bottom: 1px solid rgba(0, 0, 0, 0.04);
            transition: all 0.3s ease;
        }

        .table-borderless tr:last-child {
            border-bottom: none;
        }

        .table-borderless tr:hover {
            background: linear-gradient(90deg, rgba(71, 108, 26, 0.04) 0%, rgba(178, 217, 68, 0.02) 100%);
            transform: translateX(5px);
        }

        .table-borderless th {
            font-weight: 600;
            color: var(--gris);
            font-size: 0.9rem;
            padding: 16px 15px 16px 0;
            vertical-align: middle;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            position: relative;
        }

        .table-borderless th::before {
            content: '';
            position: absolute;
            left: -15px;
            top: 50%;
            transform: translateY(-50%);
            width: 4px;
            height: 0;
            background: linear-gradient(180deg, var(--vert-olive-fonce), var(--vert-clair));
            border-radius: 2px;
            transition: height 0.3s ease;
        }

        .table-borderless tr:hover th::before {
            height: 20px;
        }

        .table-borderless td {
            color: var(--vert-tres-fonce);
            font-size: 1rem;
            padding: 16px 0;
            vertical-align: middle;
        }

        .table-borderless td strong {
            color: var(--vert-olive-fonce);
            font-weight: 700;
        }

        /* HR Divider */
        hr.my-4 {
            border: none;
            height: 2px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair), transparent);
            margin: 30px 0;
            opacity: 0.2;
        }

        /* ==========================================
           ACTION BUTTONS
        ========================================== */
        .d-grid.gap-2 {
            gap: 15px !important;
        }

        .d-grid .btn-primary.btn-lg {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%) !important;
            border: none !important;
            border-radius: 14px;
            padding: 16px 28px;
            font-weight: 600;
            font-size: 1rem;
            box-shadow: 0 8px 25px rgba(71, 108, 26, 0.25);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
        }

        .d-grid .btn-primary.btn-lg::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .d-grid .btn-primary.btn-lg:hover::before {
            left: 100%;
        }

        .d-grid .btn-primary.btn-lg:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(71, 108, 26, 0.35);
        }

        .d-grid .btn-primary.btn-lg i {
            font-size: 1.1rem;
        }

        .d-grid .btn-outline-secondary {
            border: 2px solid var(--gris) !important;
            color: var(--gris) !important;
            background: transparent !important;
            border-radius: 14px;
            padding: 14px 28px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .d-grid .btn-outline-secondary:hover {
            background: var(--gris) !important;
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(132, 138, 134, 0.25);
        }

        /* Info Card Watermark */
        .col-md-8 .dashboard-section::after {
            content: '\f2bb';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute;
            bottom: 20px;
            right: 25px;
            font-size: 6rem;
            color: var(--vert-olive-fonce);
            opacity: 0.03;
            pointer-events: none;
        }

        /* ==========================================
           FLASH MESSAGES
        ========================================== */
        .alert {
            border-radius: 14px;
            border: none;
            padding: 16px 24px;
            margin: 0 35px 20px 35px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .alert-success {
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.1) 0%, rgba(178, 217, 68, 0.1) 100%);
            color: var(--vert-fonce);
            border-left: 4px solid var(--vert-vif);
        }

        .alert-danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
            color: #b91c1c;
            border-left: 4px solid #ef4444;
        }

        .alert-warning {
            background: linear-gradient(135deg, rgba(225, 179, 35, 0.15) 0%, rgba(225, 179, 35, 0.1) 100%);
            color: #92750d;
            border-left: 4px solid var(--jaune-moutarde);
        }

        /* ==========================================
           DECORATIVE ELEMENTS
        ========================================== */
        .col-md-4 .dashboard-section .mb-4:first-child::after {
            content: '';
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            bottom: -10px;
            border: 2px dashed rgba(71, 108, 26, 0.15);
            border-radius: 50%;
            animation: rotate-border 20s linear infinite;
        }

        @keyframes rotate-border {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* ==========================================
           RESPONSIVE
        ========================================== */
        @media (max-width: 768px) {
            .main-content > .d-flex.justify-content-between:first-of-type {
                padding: 20px;
                flex-direction: column;
                gap: 15px;
                align-items: flex-start !important;
            }

            .main-content > .d-flex.justify-content-between:first-of-type h1 {
                font-size: 1.4rem;
            }

            .dashboard-section {
                padding: 24px;
            }

            .col-md-4 .dashboard-section .rounded-circle {
                width: 140px !important;
                height: 140px !important;
            }

            .col-md-4 .dashboard-section h3 {
                font-size: 1.3rem;
            }

            .table-borderless th {
                font-size: 0.8rem;
                padding: 12px 10px 12px 0;
            }

            .table-borderless td {
                font-size: 0.9rem;
                padding: 12px 0;
            }

            .d-grid .btn-primary.btn-lg {
                padding: 14px 20px;
                font-size: 0.9rem;
            }
        }

        /* ==========================================
           HOVER EFFECTS
        ========================================== */
        .dashboard-section {
            transition: all 0.3s ease;
        }

        .dashboard-section:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        /* ==========================================
           CUSTOM SCROLLBAR
        ========================================== */
        .main-content::-webkit-scrollbar { width: 8px; }
        .main-content::-webkit-scrollbar-track { background: #f1f1f1; }
        .main-content::-webkit-scrollbar-thumb {
            background: var(--vert-olive-fonce);
            border-radius: 4px;
        }
        .main-content::-webkit-scrollbar-thumb:hover {
            background: var(--vert-foret);
        }

        /* ==========================================
           STAT INFO ICONS
        ========================================== */
        .table-borderless td::before {
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            margin-right: 8px;
            color: var(--vert-olive-fonce);
            opacity: 0.6;
        }

        .table-borderless tr:nth-child(5) td::before {
            content: '\f073';
        }

        .table-borderless tr:nth-child(6) td::before {
            content: '\f017';
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {% include 'components/_sidebar_admin.html.twig' %}
        
        <div class="main-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="mb-0">
                    <i class="fas fa-user-cog me-2"></i>Mon profil
                </h1>
                <a href="{{ path('admin_profile_edit') }}" class="btn btn-primary">
                    <i class="fas fa-edit me-2"></i>Modifier
                </a>
            </div>
            
            {% include 'components/_flash_messages.html.twig' %}
            
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="dashboard-section text-center">
                        <div class="mb-4">
                            {% if utilisateur.photo %}
                                <img src="{{ asset(utilisateur.photo) }}" 
                                     alt="{{ utilisateur.nomComplet }}" 
                                     class="rounded-circle">
                            {% else %}
                                <i class="fas fa-user-circle fa-10x"></i>
                            {% endif %}
                        </div>
                        
                        <h3 class="mb-2">{{ utilisateur.nomComplet }}</h3>
                        <p class="text-muted mb-3">{{ utilisateur.email }}</p>
                        
                        <span class="badge bg-danger mb-3">
                            <i class="fas fa-user-shield"></i>Administrateur
                        </span>
                        
                        <div class="mt-4">
                            {% if utilisateur.estEnLigne %}
                                <span class="badge bg-success">
                                    <i class="fas fa-circle me-1"></i>En ligne
                                </span>
                            {% else %}
                                <span class="badge bg-secondary">
                                    <i class="far fa-circle me-1"></i>Hors ligne
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <div class="col-md-8 mb-4">
                    <div class="dashboard-section">
                        <h5 class="section-title">
                            <i class="fas fa-info-circle"></i>
                            Informations personnelles
                        </h5>
                        
                        <table class="table table-borderless">
                            <tr>
                                <th width="30%">Nom:</th>
                                <td><strong>{{ utilisateur.nom }}</strong></td>
                            </tr>
                            <tr>
                                <th>Prénom:</th>
                                <td><strong>{{ utilisateur.prenom }}</strong></td>
                            </tr>
                            <tr>
                                <th>Email:</th>
                                <td>{{ utilisateur.email }}</td>
                            </tr>
                            <tr>
                                <th>Téléphone:</th>
                                <td>{{ utilisateur.tel ?? 'Non renseigné' }}</td>
                            </tr>
                            <tr>
                                <th>Date d'inscription:</th>
                                <td>{{ utilisateur.dateInscrit|date('d/m/Y à H:i') }}</td>
                            </tr>
                            <tr>
                                <th>Dernière connexion:</th>
                                <td>{{ utilisateur.derniereConnexion|date('d/m/Y à H:i') }}</td>
                            </tr>
                        </table>
                        
                        <hr class="my-4">
                        
                        <div class="d-grid gap-2">
                            <a href="{{ path('admin_profile_edit') }}" class="btn btn-primary btn-lg">
                                <i class="fas fa-edit"></i>Modifier mes informations
                            </a>
                            <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i>Retour au tableau de bord
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile sidebar toggle
            const toggleBtn = document.getElementById('mobileSidebarToggle');
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    document.getElementById('sidebar').classList.toggle('show');
                });
            }

            // Profile image hover effect
            const profileImg = document.querySelector('.rounded-circle');
            if (profileImg) {
                profileImg.addEventListener('mouseenter', function() {
                    this.style.transform = 'scale(1.05) rotate(2deg)';
                });
                profileImg.addEventListener('mouseleave', function() {
                    this.style.transform = 'scale(1) rotate(0deg)';
                });
            }

            // Animate table rows on scroll
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateX(0)';
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.table-borderless tr').forEach((row, index) => {
                row.style.opacity = '0';
                row.style.transform = 'translateX(-20px)';
                row.style.transition = `all 0.4s ease ${index * 0.1}s`;
                observer.observe(row);
            });

            // Button ripple effect
            document.querySelectorAll('.btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const ripple = document.createElement('span');
                    const rect = this.getBoundingClientRect();
                    ripple.style.cssText = `
                        position: absolute;
                        background: rgba(255,255,255,0.3);
                        border-radius: 50%;
                        width: 100px;
                        height: 100px;
                        left: ${e.clientX - rect.left - 50}px;
                        top: ${e.clientY - rect.top - 50}px;
                        transform: scale(0);
                        animation: ripple 0.6s ease-out;
                        pointer-events: none;
                    `;
                    this.style.position = 'relative';
                    this.style.overflow = 'hidden';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });
        });
    </script>
    <style>
        @keyframes ripple {
            to { transform: scale(4); opacity: 0; }
        }
    </style>
{% endblock %}