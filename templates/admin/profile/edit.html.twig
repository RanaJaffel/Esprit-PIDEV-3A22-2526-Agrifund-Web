{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --gris: #848A86;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --jaune-fonce: #c9a020;
            --vert-clair: #B2D944;
            --olive: #9A951F;
            --vert-olive-fonce: #476C1A;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
        }

        /* ==========================================
           LAYOUT
        ========================================== */
        .dashboard-container { display: flex; min-height: 100vh; }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 0;
            background: transparent;
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 991.98px) {
            .main-content { margin-left: 0; }
        }

        /* ==========================================
           HEADER
        ========================================== */
        .main-content > .d-flex.justify-content-between:first-of-type {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 50%, var(--vert-tres-fonce) 100%);
            padding: 28px 35px;
            margin: 0 0 30px 0;
            position: relative;
            overflow: hidden;
        }

        .main-content > .d-flex.justify-content-between:first-of-type::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 10 L35 25 L50 25 L38 35 L42 50 L30 40 L18 50 L22 35 L10 25 L25 25 Z' fill='%23B2D944' fill-opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .main-content > .d-flex.justify-content-between:first-of-type::after {
            content: '';
            position: absolute;
            top: -50%; right: -10%;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(178, 217, 68, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .main-content > .d-flex.justify-content-between:first-of-type h1 {
            color: white !important;
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .main-content > .d-flex.justify-content-between:first-of-type h1 i {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            box-shadow: 0 8px 20px rgba(71, 108, 26, 0.35);
            margin-right: 0 !important;
        }

        /* Header Cancel Button */
        .main-content > .d-flex.justify-content-between:first-of-type .btn-secondary {
            background: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
            color: white !important;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .main-content > .d-flex.justify-content-between:first-of-type .btn-secondary:hover {
            background: rgba(239, 68, 68, 0.8) !important;
            border-color: rgba(239, 68, 68, 0.8) !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.3);
        }

        /* ==========================================
           CONTENT AREA
        ========================================== */
        .main-content > .row {
            margin-left: 35px;
            margin-right: 35px;
        }

        @media (max-width: 768px) {
            .main-content > .row {
                margin-left: 20px;
                margin-right: 20px;
            }
        }

        /* ==========================================
           DASHBOARD SECTION
        ========================================== */
        .dashboard-section {
            background: white;
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.6s ease-out forwards;
            opacity: 0;
        }

        .dashboard-section::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair), var(--jaune-moutarde), var(--vert-vif));
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Watermark */
        .dashboard-section::after {
            content: '\f4ff';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute;
            bottom: 30px;
            right: 40px;
            font-size: 8rem;
            color: var(--vert-olive-fonce);
            opacity: 0.02;
            pointer-events: none;
        }

        /* ==========================================
           SECTION TITLES
        ========================================== */
        .section-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--vert-tres-fonce);
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(71, 108, 26, 0.1);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
            box-shadow: 0 4px 15px rgba(71, 108, 26, 0.25);
        }

        /* ==========================================
           FORM STYLING
        ========================================== */
        .form-label {
            font-weight: 600;
            color: var(--vert-tres-fonce);
            font-size: 0.9rem;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-control,
        .form-select {
            border: 2px solid #e8ecef;
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: #fafbfc;
            color: var(--vert-tres-fonce);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--vert-olive-fonce);
            box-shadow: 0 0 0 4px rgba(71, 108, 26, 0.12);
            background: white;
            outline: none;
        }

        .form-control::placeholder {
            color: #adb5bd;
        }

        .form-control:hover,
        .form-select:hover {
            border-color: var(--vert-clair);
        }

        /* Input file styling */
        input[type="file"].form-control {
            padding: 12px 18px;
            cursor: pointer;
        }

        input[type="file"].form-control::-webkit-file-upload-button {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            margin-right: 15px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        input[type="file"].form-control::-webkit-file-upload-button:hover {
            background: linear-gradient(135deg, var(--vert-foret) 0%, var(--vert-tres-fonce) 100%);
        }

        /* Form validation states */
        .form-control.is-invalid {
            border-color: #ef4444;
            background-image: none;
        }

        .form-control.is-invalid:focus {
            border-color: #ef4444;
            box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.12);
        }

        .invalid-feedback {
            color: #ef4444;
            font-size: 0.85rem;
            margin-top: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .invalid-feedback::before {
            content: '\f071';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            font-size: 0.75rem;
        }

        /* ==========================================
           HR DIVIDER
        ========================================== */
        hr.my-4 {
            border: none;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--vert-clair), var(--vert-olive-fonce), var(--vert-clair), transparent);
            margin: 35px 0;
            opacity: 0.3;
        }

        /* ==========================================
           PHOTO PREVIEW
        ========================================== */
        .photo-preview-container {
            margin-top: 20px;
            padding: 20px;
            background: linear-gradient(135deg, #f8faf5 0%, #f0f4e8 100%);
            border-radius: 16px;
            border: 2px dashed rgba(71, 108, 26, 0.2);
            display: inline-block;
            position: relative;
            transition: all 0.3s ease;
        }

        .photo-preview-container:hover {
            border-color: rgba(71, 108, 26, 0.4);
            background: linear-gradient(135deg, #f5f8f2 0%, #ebf0e3 100%);
        }

        .photo-preview-container p {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--vert-olive-fonce);
            margin-bottom: 12px;
        }

        .current-photo-preview {
            max-width: 180px;
            border-radius: 16px !important;
            border: 4px solid var(--vert-vif) !important;
            box-shadow: 0 8px 30px rgba(8, 150, 71, 0.2);
            transition: all 0.4s ease;
        }

        .current-photo-preview:hover {
            transform: scale(1.05) rotate(2deg);
            box-shadow: 0 12px 40px rgba(8, 150, 71, 0.3);
            border-color: var(--vert-clair) !important;
        }

        /* ==========================================
           ALERT INFO
        ========================================== */
        .alert-info {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(79, 70, 229, 0.08) 100%);
            border: none;
            border-left: 4px solid #6366f1;
            border-radius: 14px;
            padding: 18px 24px;
            color: #4338ca;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .alert-info i {
            font-size: 1.2rem;
            color: #6366f1;
        }

        /* ==========================================
           ACTION BUTTONS
        ========================================== */
        .d-grid.gap-2 {
            gap: 15px !important;
            margin-top: 10px;
        }

        .d-grid .btn-primary.btn-lg {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%) !important;
            border: none !important;
            border-radius: 14px;
            padding: 18px 32px;
            font-weight: 700;
            font-size: 1.05rem;
            box-shadow: 0 8px 30px rgba(71, 108, 26, 0.3);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            position: relative;
            overflow: hidden;
            letter-spacing: 0.3px;
        }

        .d-grid .btn-primary.btn-lg::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
            transition: left 0.5s ease;
        }

        .d-grid .btn-primary.btn-lg:hover::before {
            left: 100%;
        }

        .d-grid .btn-primary.btn-lg:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 40px rgba(71, 108, 26, 0.4);
        }

        .d-grid .btn-primary.btn-lg:active {
            transform: translateY(-2px) scale(0.99);
        }

        .d-grid .btn-primary.btn-lg i {
            font-size: 1.15rem;
        }

        .d-grid .btn-outline-secondary {
            border: 2px solid var(--gris) !important;
            color: var(--gris) !important;
            background: transparent !important;
            border-radius: 14px;
            padding: 16px 28px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .d-grid .btn-outline-secondary:hover {
            background: var(--gris) !important;
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(132, 138, 134, 0.25);
        }

        /* ==========================================
           FLASH MESSAGES
        ========================================== */
        .alert {
            border-radius: 14px;
            border: none;
            padding: 16px 24px;
            margin: 0 35px 20px 35px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .alert-success {
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.1) 0%, rgba(178, 217, 68, 0.1) 100%);
            color: var(--vert-fonce);
            border-left: 4px solid var(--vert-vif);
        }

        .alert-danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
            color: #b91c1c;
            border-left: 4px solid #ef4444;
        }

        .alert-warning {
            background: linear-gradient(135deg, rgba(225, 179, 35, 0.15) 0%, rgba(225, 179, 35, 0.1) 100%);
            color: #92750d;
            border-left: 4px solid var(--jaune-moutarde);
        }

        /* ==========================================
           FORM GROUPS ANIMATION
        ========================================== */
        .mb-3, .mb-4 {
            animation: fadeInField 0.5s ease-out forwards;
            opacity: 0;
        }

        .mb-4:nth-child(1) { animation-delay: 0.1s; }
        .mb-4:nth-child(2) { animation-delay: 0.3s; }
        .mb-4:nth-child(3) { animation-delay: 0.5s; }

        @keyframes fadeInField {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ==========================================
           INPUT GROUP ICONS
        ========================================== */
        .row .col-md-6:first-child .form-label::before {
            content: '\f007';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            color: var(--vert-olive-fonce);
            font-size: 0.8rem;
        }

        .row .col-md-6:last-child .form-label::before {
            content: '\f007';
            font-family: 'Font Awesome 5 Free';
            font-weight: 400;
            color: var(--vert-olive-fonce);
            font-size: 0.8rem;
        }

        /* ==========================================
           PASSWORD STRENGTH INDICATOR
        ========================================== */
        .password-strength {
            height: 4px;
            border-radius: 2px;
            margin-top: 8px;
            background: #e8ecef;
            overflow: hidden;
        }

        .password-strength-bar {
            height: 100%;
            width: 0;
            transition: all 0.3s ease;
            border-radius: 2px;
        }

        .password-strength-bar.weak {
            width: 33%;
            background: linear-gradient(90deg, #ef4444, #f87171);
        }

        .password-strength-bar.medium {
            width: 66%;
            background: linear-gradient(90deg, var(--jaune-moutarde), var(--jaune-fonce));
        }

        .password-strength-bar.strong {
            width: 100%;
            background: linear-gradient(90deg, var(--vert-vif), var(--vert-clair));
        }

        /* ==========================================
           RESPONSIVE
        ========================================== */
        @media (max-width: 768px) {
            .main-content > .d-flex.justify-content-between:first-of-type {
                padding: 20px;
                flex-direction: column;
                gap: 15px;
                align-items: flex-start !important;
            }

            .main-content > .d-flex.justify-content-between:first-of-type h1 {
                font-size: 1.4rem;
            }

            .dashboard-section {
                padding: 25px;
                border-radius: 18px;
            }

            .section-title {
                font-size: 1rem;
            }

            .section-title i {
                width: 35px;
                height: 35px;
                font-size: 0.9rem;
            }

            .form-control,
            .form-select {
                padding: 12px 15px;
            }

            .d-grid .btn-primary.btn-lg {
                padding: 15px 24px;
                font-size: 0.95rem;
            }

            .current-photo-preview {
                max-width: 140px;
            }
        }

        /* ==========================================
           CUSTOM SCROLLBAR
        ========================================== */
        .main-content::-webkit-scrollbar { width: 8px; }
        .main-content::-webkit-scrollbar-track { background: #f1f1f1; }
        .main-content::-webkit-scrollbar-thumb {
            background: var(--vert-olive-fonce);
            border-radius: 4px;
        }
        .main-content::-webkit-scrollbar-thumb:hover {
            background: var(--vert-foret);
        }

        /* ==========================================
           FOCUS WITHIN EFFECTS
        ========================================== */
        .mb-3:focus-within label {
            color: var(--vert-olive-fonce);
        }

        .mb-3:focus-within {
            position: relative;
        }

        .mb-3:focus-within::before {
            content: '';
            position: absolute;
            left: -15px;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(180deg, var(--vert-olive-fonce), var(--vert-clair));
            border-radius: 2px;
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from { transform: scaleY(0); }
            to { transform: scaleY(1); }
        }

        /* ==========================================
           DECORATIVE ELEMENTS
        ========================================== */
        .dashboard-section > form::before {
            content: '';
            position: absolute;
            top: 80px;
            right: -50px;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(178, 217, 68, 0.08) 0%, transparent 70%);
            pointer-events: none;
        }

        .dashboard-section > form::after {
            content: '';
            position: absolute;
            bottom: 100px;
            left: -80px;
            width: 250px;
            height: 250px;
            background: radial-gradient(circle, rgba(71, 108, 26, 0.05) 0%, transparent 70%);
            pointer-events: none;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {% include 'components/_sidebar_admin.html.twig' %}
        
        <div class="main-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="mb-0">
                    <i class="fas fa-user-edit me-2"></i>Modifier mon profil
                </h1>
                <a href="{{ path('admin_profile_show') }}" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Annuler
                </a>
            </div>
            
            {% include 'components/_flash_messages.html.twig' %}
            
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="dashboard-section">
                        {{ form_start(form) }}
                            <div class="mb-4">
                                <h5 class="section-title">
                                    <i class="fas fa-user"></i>
                                    Informations personnelles
                                </h5>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        {{ form_row(form.nom) }}
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        {{ form_row(form.prenom) }}
                                    </div>
                                </div>
                                
                                <div class="mb-3">
                                    {{ form_row(form.email) }}
                                </div>
                                
                                <div class="mb-3">
                                    {{ form_row(form.tel) }}
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <div class="mb-4">
                                <h5 class="section-title">
                                    <i class="fas fa-camera"></i>
                                    Photo de profil
                                </h5>
                                
                                <div class="mb-3">
                                    {{ form_row(form.photoFile) }}
                                    
                                    {% if utilisateur.photo %}
                                        <div class="photo-preview-container">
                                            <p><i class="fas fa-image me-2"></i>Photo actuelle:</p>
                                            <img src="{{ asset(utilisateur.photo) }}" 
                                                 alt="Photo actuelle" 
                                                 class="current-photo-preview">
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <div class="mb-4">
                                <h5 class="section-title">
                                    <i class="fas fa-lock"></i>
                                    Changer le mot de passe
                                </h5>
                                
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle"></i>
                                    Laissez ces champs vides si vous ne souhaitez pas changer votre mot de passe.
                                </div>
                                
                                <div class="mb-3">
                                    {{ form_row(form.plainPassword.first) }}
                                    <div class="password-strength">
                                        <div class="password-strength-bar" id="passwordStrength"></div>
                                    </div>
                                </div>
                                
                                <div class="mb-3">
                                    {{ form_row(form.plainPassword.second) }}
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-save"></i>Enregistrer les modifications
                                </button>
                                <a href="{{ path('admin_profile_show') }}" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Annuler et retourner
                                </a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile sidebar toggle
            const toggleBtn = document.getElementById('mobileSidebarToggle');
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    document.getElementById('sidebar').classList.toggle('show');
                });
            }

            // Preview image before upload
            const fileInput = document.querySelector('input[type="file"]');
            if (fileInput) {
                fileInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file && file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            let preview = document.querySelector('.current-photo-preview');
                            let container = document.querySelector('.photo-preview-container');
                            
                            if (preview) {
                                preview.src = e.target.result;
                                preview.style.animation = 'pulse 0.5s ease';
                            } else if (!container) {
                                const newPreview = document.createElement('div');
                                newPreview.className = 'photo-preview-container';
                                newPreview.innerHTML = `
                                    <p><i class="fas fa-image me-2"></i>Aperçu:</p>
                                    <img src="${e.target.result}" class="current-photo-preview">
                                `;
                                fileInput.parentElement.appendChild(newPreview);
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }

            // Password strength indicator
            const passwordInput = document.querySelector('input[type="password"]');
            const strengthBar = document.getElementById('passwordStrength');
            
            if (passwordInput && strengthBar) {
                passwordInput.addEventListener('input', function() {
                    const password = this.value;
                    let strength = 0;
                    
                    if (password.length >= 8) strength++;
                    if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
                    if (password.match(/[0-9]/)) strength++;
                    if (password.match(/[^a-zA-Z0-9]/)) strength++;
                    
                    strengthBar.className = 'password-strength-bar';
                    
                    if (password.length === 0) {
                        strengthBar.style.width = '0';
                    } else if (strength <= 1) {
                        strengthBar.classList.add('weak');
                    } else if (strength <= 2) {
                        strengthBar.classList.add('medium');
                    } else {
                        strengthBar.classList.add('strong');
                    }
                });
            }

            // Form input animations
            document.querySelectorAll('.form-control, .form-select').forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.style.transform = 'translateX(5px)';
                });
                
                input.addEventListener('blur', function() {
                    this.parentElement.style.transform = 'translateX(0)';
                });
            });

            // Button ripple effect
            document.querySelectorAll('.btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const ripple = document.createElement('span');
                    const rect = this.getBoundingClientRect();
                    ripple.style.cssText = `
                        position: absolute;
                        background: rgba(255,255,255,0.3);
                        border-radius: 50%;
                        width: 100px;
                        height: 100px;
                        left: ${e.clientX - rect.left - 50}px;
                        top: ${e.clientY - rect.top - 50}px;
                        transform: scale(0);
                        animation: ripple 0.6s ease-out;
                        pointer-events: none;
                    `;
                    this.style.position = 'relative';
                    this.style.overflow = 'hidden';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // Form validation visual feedback
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    const submitBtn = this.querySelector('button[type="submit"]');
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Enregistrement...';
                    submitBtn.disabled = true;
                });
            }
        });
    </script>
    <style>
        @keyframes ripple {
            to { transform: scale(4); opacity: 0; }
        }
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.02); }
        }
    </style>
{% endblock %}