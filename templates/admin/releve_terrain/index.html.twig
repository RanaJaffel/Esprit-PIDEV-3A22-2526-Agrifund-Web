{% extends 'base.html.twig' %}

{% block title %}Admin - Relevés terrain{% endblock %}

{% block body %}
<div class="container-fluid py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
      <h3 class="mb-1">Admin — Relevés Terrain</h3>
      <div class="text-muted">Supervision globale (tous projets)</div>
    </div>
  </div>

  {{ include('_partials/_flashes.html.twig') }}

  <div class="card shadow-sm border-0 mb-3">
    <div class="card-body">
      <form method="get" class="row g-2 align-items-end">
        <div class="col-12 col-md-3">
          <label class="form-label">ID Projet</label>
          <input type="number" class="form-control" name="projet" value="{{ idproject }}" placeholder="ex: 1">
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label">Type</label>
          <select class="form-select" name="type">
            <option value="">Tous</option>
            {% for t in types %}
              <option value="{{ t }}" {{ (t == typeMesure) ? 'selected' : '' }}>{{ t }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-12 col-md-6 text-md-end">
          <button class="btn btn-dark">Filtrer</button>
          <a class="btn btn-outline-secondary" href="{{ path('admin_releve_terrain') }}">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Projet</th>
            <th>Capteur</th>
            <th>Type</th>
            <th>Valeur</th>
            <th>Source</th>
            <th>Qualité</th>
            <th style="width:140px;">Action</th>
          </tr>
        </thead>
        <tbody>
        {% for m in mesures %}
          {% set source = m.sourceDonnee %}
          {% set sourceClass = (source == 'SIMULATEUR') ? 'info' : 'secondary' %}
          {% set q = m.qualite ?? 'OK' %}
          {% set qClass = (q == 'OK') ? 'success' : (q == 'SUSPECT' ? 'warning' : 'danger') %}

          <tr>
            <td class="text-nowrap">{{ m.dateHeure|date('d/m/Y H:i') }}</td>
            <td>#{{ m.idproject }}</td>
            <td>#{{ m.idCapteur }}</td>
            <td>{{ m.typeMesure }}</td>
            <td class="fw-semibold">{{ m.valeurMesuree }} {{ m.unite }}</td>
            <td><span class="badge bg-{{ sourceClass }}">{{ source }}</span></td>
            <td>
              <span class="badge bg-{{ qClass }}">{{ q }}</span>
              {% if m.note %}
                <div class="text-muted small">{{ m.note }}</div>
              {% endif %}
            </td>
            <td>
              <form method="post"
                    action="{{ path('admin_releve_terrain_delete', {id: m.idReleve}) }}"
                    onsubmit="return confirm('Supprimer ce relevé ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ m.idReleve) }}">
                <button class="btn btn-sm btn-outline-danger w-100">Supprimer</button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="8" class="text-center text-muted py-4">Aucune donnée.</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}