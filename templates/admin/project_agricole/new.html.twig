{% extends 'base.html.twig' %}
{% block title %}Admin — Nouveau Projet{% endblock %}

{% block content %}
<div class="page-header">
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="{{ path('admin_project_agricole_index') }}" class="text-white-50">Admin / Projets</a></li>
        <li class="breadcrumb-item active text-white">Nouveau</li>
    </ol></nav>
    <h2 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2"></i>Nouveau Projet <span class="badge bg-white text-success" style="font-size:.7em">ADMIN</span></h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        {# ── Status Info Notice ── #}
        <div class="d-flex align-items-center gap-2 mb-3 px-3 py-2"
             style="background:#E3F2FD;border-radius:10px;font-size:.88rem;color:#1565C0;">
            <i class="bi bi-info-circle-fill"></i>
            Le <strong>statut</strong> initial : <span style="background:#FFC107;color:#333;padding:0.2rem 0.6rem;border-radius:5px;font-weight:700;display:inline-block;margin:0 0.3rem;">🟡 En cours</span>
            <br><small style="display:inline-block;margin-top:0.3rem;">Le statut sera modifié automatiquement par les décisions financières.</small>
        </div>

        <div class="card card-agri">
            <div class="card-header" style="background:var(--green-pale); border-bottom:2px solid var(--green-light);">
                <h5 class="mb-0 fw-semibold" style="color:var(--green-dark)"><i class="bi bi-file-earmark-plus me-2"></i>Informations du Projet</h5>
            </div>
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    {% include 'project_agricole/_form.html.twig' %}
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-agri-primary"><i class="bi bi-check-circle me-1"></i> Créer</button>
                        <a href="{{ path('admin_project_agricole_index') }}" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
