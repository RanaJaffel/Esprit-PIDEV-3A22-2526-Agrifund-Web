{% extends 'base.html.twig' %}

{% block title %}Gestion des documents{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --gris: #848A86;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --jaune-fonce: #c9a020;
            --vert-clair: #B2D944;
            --olive: #9A951F;
            --vert-olive-fonce: #476C1A;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
        }

        /* ==========================================
           LAYOUT
        ========================================== */
        .dashboard-container { display: flex; min-height: 100vh; }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 0;
            background: transparent;
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 991.98px) {
            .main-content { margin-left: 0; }
        }

        /* ==========================================
           HEADER
        ========================================== */
        .main-content > .d-flex.justify-content-between:first-of-type {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 50%, var(--vert-tres-fonce) 100%);
            padding: 28px 35px;
            margin: 0 0 30px 0;
            position: relative;
            overflow: hidden;
        }

        .main-content > .d-flex.justify-content-between:first-of-type::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M15 10 L30 10 L30 40 L15 40 Z' fill='%23B2D944' fill-opacity='0.04' rx='2'/%3E%3Cpath d='M18 15 L27 15' stroke='%23B2D944' stroke-opacity='0.06' stroke-width='1'/%3E%3Cpath d='M18 20 L27 20' stroke='%23B2D944' stroke-opacity='0.06' stroke-width='1'/%3E%3Cpath d='M18 25 L27 25' stroke='%23B2D944' stroke-opacity='0.06' stroke-width='1'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .main-content > .d-flex.justify-content-between:first-of-type::after {
            content: '';
            position: absolute;
            top: -50%; right: -10%;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(178, 217, 68, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .main-content > .d-flex.justify-content-between:first-of-type h1 {
            color: white !important;
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .main-content > .d-flex.justify-content-between:first-of-type h1 i {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            box-shadow: 0 8px 20px rgba(71, 108, 26, 0.35);
            margin-right: 0 !important;
        }

        #mobileSidebarToggle {
            background: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            color: white !important;
            border-radius: 12px;
            width: 44px; height: 44px;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
        }

        #mobileSidebarToggle:hover {
            background: rgba(255, 255, 255, 0.25) !important;
            transform: scale(1.05);
        }

        /* ==========================================
           CONTENT AREA
        ========================================== */
        .main-content > *:not(.d-flex.justify-content-between):not(script):not(.modal) {
            margin-left: 35px;
            margin-right: 35px;
        }

        @media (max-width: 768px) {
            .main-content > *:not(.d-flex.justify-content-between):not(script):not(.modal) {
                margin-left: 20px;
                margin-right: 20px;
            }
        }

        /* ==========================================
           STAT CARDS
        ========================================== */
        .row.mb-4 { margin-bottom: 25px !important; }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(0, 0, 0, 0.04);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-align: center;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            transition: height 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        }

        .stat-card:hover::before { height: 6px; }

        .col-md-3:nth-child(1) .stat-card::before {
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-foret));
        }
        .col-md-3:nth-child(2) .stat-card::before {
            background: linear-gradient(90deg, var(--vert-vif), var(--vert-clair));
        }
        .col-md-3:nth-child(3) .stat-card::before {
            background: linear-gradient(90deg, var(--jaune-moutarde), #f0c040);
        }
        .col-md-3:nth-child(4) .stat-card::before {
            background: linear-gradient(90deg, #ef4444, #f87171);
        }

        /* Watermark icons */
        .stat-card::after {
            position: absolute;
            bottom: 10px; right: 15px;
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            font-size: 3.5rem;
            opacity: 0.05;
            transition: opacity 0.3s ease;
        }

        .stat-card:hover::after { opacity: 0.1; }

        .col-md-3:nth-child(1) .stat-card::after { content: '\f15b'; }
        .col-md-3:nth-child(2) .stat-card::after { content: '\f00c'; }
        .col-md-3:nth-child(3) .stat-card::after { content: '\f017'; }
        .col-md-3:nth-child(4) .stat-card::after { content: '\f05e'; }

        .stat-value {
            font-size: 2.8rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 10px;
            letter-spacing: -1px;
        }

        .stat-value.text-primary {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .stat-value.text-success {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .stat-value.text-warning {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, var(--jaune-fonce) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .stat-value.text-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--gris);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* ==========================================
           FILTER SECTION
        ========================================== */
        .dashboard-section.mb-4 {
            background: white;
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(0, 0, 0, 0.04);
            margin-bottom: 25px !important;
            position: relative;
            overflow: hidden;
        }

        .dashboard-section.mb-4::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair), var(--jaune-moutarde));
        }

        .dashboard-section.mb-4 .form-label {
            font-weight: 600;
            color: var(--vert-tres-fonce);
            font-size: 0.85rem;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .dashboard-section.mb-4 .form-label i {
            color: var(--vert-olive-fonce);
            font-size: 0.9rem;
        }

        .dashboard-section.mb-4 .form-control,
        .dashboard-section.mb-4 .form-select {
            border: 2px solid #e8ecef;
            border-radius: 12px;
            padding: 12px 18px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: #fafbfc;
        }

        .dashboard-section.mb-4 .form-control:focus,
        .dashboard-section.mb-4 .form-select:focus {
            border-color: var(--vert-olive-fonce);
            box-shadow: 0 0 0 4px rgba(71, 108, 26, 0.12);
            background: white;
        }

        .dashboard-section.mb-4 .form-control::placeholder { color: #adb5bd; }

        .dashboard-section.mb-4 .btn-primary {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            box-shadow: 0 6px 20px rgba(71, 108, 26, 0.25);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .dashboard-section.mb-4 .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(71, 108, 26, 0.35);
        }

        /* ==========================================
           TABLE SECTION
        ========================================== */
        .dashboard-section:not(.mb-4) {
            background: white;
            border-radius: 20px;
            padding: 0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(0, 0, 0, 0.04);
            overflow: hidden;
            animation: fadeInUp 0.6s ease-out forwards;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ==========================================
           TABLE
        ========================================== */
        .table-responsive { padding: 0; margin: 0; }

        .table-custom, .table {
            margin: 0;
            border-collapse: collapse;
            width: 100%;
        }

        .table-custom thead, .table thead {
            background: linear-gradient(90deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
        }

        .table-custom thead th, .table thead th {
            color: white !important;
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 16px 14px;
            border: none !important;
            position: relative;
            white-space: nowrap;
        }

        .table-custom thead th:not(:last-child)::after {
            content: '';
            position: absolute;
            right: 0; top: 50%;
            transform: translateY(-50%);
            width: 1px; height: 20px;
            background: rgba(255, 255, 255, 0.15);
        }

        .table-custom tbody tr, .table tbody tr {
            transition: all 0.3s ease;
            border-bottom: 1px solid rgba(0, 0, 0, 0.04);
        }

        .table-custom tbody tr:last-child { border-bottom: none; }

        .table-custom tbody tr:hover, .table tbody tr:hover {
            background: linear-gradient(90deg, rgba(71, 108, 26, 0.05) 0%, rgba(178, 217, 68, 0.03) 100%);
            transform: scale(1.002);
        }

        .table-custom tbody td, .table tbody td {
            padding: 16px 14px;
            vertical-align: middle;
            color: var(--vert-tres-fonce);
            font-size: 0.86rem;
            border: none !important;
        }

        .table tbody td strong {
            font-weight: 600;
            color: var(--vert-tres-fonce);
        }

        .table tbody td small {
            color: var(--gris);
        }

        /* ==========================================
           DOCUMENT ICON
        ========================================== */
        .table tbody td .fa-file-alt {
            color: var(--vert-olive-fonce);
            font-size: 1rem;
        }

        /* ==========================================
           BADGES
        ========================================== */
        .badge {
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 0.73rem;
            font-weight: 600;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .badge i { font-size: 0.6rem; }

        .badge.bg-success {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%) !important;
            color: white;
            box-shadow: 0 3px 10px rgba(8, 150, 71, 0.2);
        }
        .badge.bg-warning {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, var(--jaune-fonce) 100%) !important;
            color: white;
            box-shadow: 0 3px 10px rgba(225, 179, 35, 0.2);
        }
        .badge.bg-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
            color: white;
            box-shadow: 0 3px 10px rgba(239, 68, 68, 0.2);
        }
        .badge.bg-secondary {
            background: linear-gradient(135deg, var(--gris) 0%, #6b7280 100%) !important;
            color: white;
        }
        .badge.bg-info {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
            color: white;
            box-shadow: 0 3px 10px rgba(99, 102, 241, 0.2);
        }

        .badge-sm {
            padding: 4px 8px !important;
            font-size: 0.65rem !important;
            border-radius: 12px;
        }

        /* ==========================================
           ACTION BUTTONS
        ========================================== */
        .btn-group {
            display: flex;
            gap: 6px;
        }

        .btn-group .btn {
            border-radius: 10px !important;
            width: 36px; height: 36px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            font-size: 0.85rem;
            position: relative;
        }

        /* Tooltips */
        .btn-group .btn::before {
            content: attr(title);
            position: absolute;
            bottom: calc(100% + 8px);
            left: 50%;
            transform: translateX(-50%);
            background: var(--vert-tres-fonce);
            color: white;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 0.68rem;
            font-weight: 500;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            pointer-events: none;
            z-index: 50;
        }

        .btn-group .btn:hover::before {
            opacity: 1;
            visibility: visible;
            bottom: calc(100% + 12px);
        }

        .btn-group .btn-outline-primary {
            border: 2px solid var(--vert-olive-fonce);
            color: var(--vert-olive-fonce);
            background: transparent;
        }

        .btn-group .btn-outline-primary:hover {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
            border-color: var(--vert-olive-fonce);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(71, 108, 26, 0.3);
        }

        .btn-group .btn-outline-success {
            border: 2px solid var(--vert-vif);
            color: var(--vert-vif);
            background: transparent;
        }

        .btn-group .btn-outline-success:hover {
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            border-color: var(--vert-vif);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(8, 150, 71, 0.3);
        }

        .btn-group .btn-outline-danger {
            border: 2px solid #ef4444;
            color: #ef4444;
            background: transparent;
        }

        .btn-group .btn-outline-danger:hover {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            border-color: #ef4444;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(239, 68, 68, 0.3);
        }

        /* ==========================================
           EMPTY STATE
        ========================================== */
        .table tbody td[colspan="8"] {
            padding: 60px 20px;
        }

        .table tbody td[colspan="8"] i {
            color: var(--vert-clair);
            opacity: 0.35;
        }

        /* ==========================================
           PAGINATION
        ========================================== */
        .dashboard-section:not(.mb-4) > .d-flex.justify-content-center {
            padding: 25px;
            background: linear-gradient(90deg, rgba(71, 108, 26, 0.02) 0%, rgba(0, 0, 0, 0.02) 100%);
            border-top: 1px solid rgba(0, 0, 0, 0.04);
        }

        .pagination { gap: 8px; margin: 0; }

        .pagination .page-item .page-link {
            border: none;
            border-radius: 10px;
            padding: 10px 16px;
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--vert-tres-fonce);
            background: #f0f2f5;
            transition: all 0.3s ease;
        }

        .pagination .page-item .page-link:hover {
            background: var(--vert-clair);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(178, 217, 68, 0.3);
        }

        .pagination .page-item.active .page-link {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(71, 108, 26, 0.3);
        }

        .pagination .page-item.disabled .page-link {
            background: #f8f9fa;
            color: #adb5bd;
        }

        /* ==========================================
           MODALS
        ========================================== */
        .modal { z-index: 1060 !important; }
        .modal-backdrop { z-index: 1055 !important; }
        .modal-backdrop.show { opacity: 0.6; }
        .modal.show { z-index: 1100 !important; }

        .modal-dialog {
            z-index: 1101 !important;
            pointer-events: auto !important;
            margin: 1.75rem auto;
        }

        .modal-content {
            border: none;
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);
            pointer-events: auto !important;
        }

        .modal-header {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            padding: 22px 28px;
            border: none;
            position: relative;
            z-index: 1;
        }

        .modal-header .modal-title {
            font-weight: 700;
            font-size: 1.12rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .modal-header .modal-title::before {
            content: '\f1f8';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            width: 38px; height: 38px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
        }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
            opacity: 0.8;
            transition: all 0.3s ease;
            pointer-events: auto !important;
            cursor: pointer !important;
        }

        .modal-header .btn-close:hover {
            opacity: 1;
            transform: rotate(90deg);
        }

        .modal-body {
            padding: 30px 28px;
            background: white;
        }

        .modal-body p {
            margin-bottom: 15px;
            color: var(--vert-tres-fonce);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .modal-body p strong {
            color: var(--vert-olive-fonce);
            font-weight: 700;
        }

        .modal-body p.text-danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.08) 0%, rgba(220, 38, 38, 0.05) 100%);
            padding: 16px 20px;
            border-radius: 14px;
            border-left: 4px solid #ef4444;
            color: #b91c1c !important;
            margin-bottom: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .modal-body p.text-danger i { color: #ef4444; font-size: 1.2rem; }

        .modal-footer {
            padding: 22px 28px;
            border-top: 1px solid rgba(0, 0, 0, 0.06);
            background: #fafbfc;
            gap: 12px;
            display: flex;
            justify-content: flex-end;
            pointer-events: auto !important;
        }

        .modal-footer .btn {
            pointer-events: auto !important;
            cursor: pointer !important;
            position: relative;
            z-index: 10 !important;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .modal-footer .btn-secondary {
            background: #e5e7eb;
            border: none;
            color: var(--vert-tres-fonce);
        }

        .modal-footer .btn-secondary:hover {
            background: #d1d5db;
            transform: translateY(-2px);
        }

        .modal-footer .btn-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            border: none;
            color: white;
            box-shadow: 0 6px 20px rgba(239, 68, 68, 0.3);
        }

        .modal-footer .btn-danger:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(239, 68, 68, 0.4);
        }

        .modal-footer form {
            display: inline-flex;
            pointer-events: auto !important;
        }

        /* Modal animation */
        .modal.fade .modal-dialog {
            transform: scale(0.9) translateY(-50px);
            transition: transform 0.3s ease-out;
        }

        .modal.show .modal-dialog {
            transform: scale(1) translateY(0);
        }

        /* ==========================================
           FLASH MESSAGES
        ========================================== */
        .alert {
            border-radius: 14px;
            border: none;
            padding: 16px 24px;
            margin: 0 35px 20px 35px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .alert-success {
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.1) 0%, rgba(178, 217, 68, 0.1) 100%);
            color: var(--vert-fonce);
            border-left: 4px solid var(--vert-vif);
        }

        .alert-danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
            color: #b91c1c;
            border-left: 4px solid #ef4444;
        }

        .alert-warning {
            background: linear-gradient(135deg, rgba(225, 179, 35, 0.15) 0%, rgba(225, 179, 35, 0.1) 100%);
            color: #92750d;
            border-left: 4px solid var(--jaune-moutarde);
        }

        /* ==========================================
           RESPONSIVE
        ========================================== */
        @media (max-width: 768px) {
            .main-content > .d-flex.justify-content-between:first-of-type {
                padding: 20px;
                flex-direction: column;
                gap: 15px;
                align-items: flex-start !important;
            }

            .main-content > .d-flex.justify-content-between:first-of-type h1 {
                font-size: 1.4rem;
            }

            .stat-card { padding: 20px; margin-bottom: 15px; }
            .stat-value { font-size: 2.2rem; }
            .dashboard-section.mb-4 { padding: 20px; }

            .table-custom thead th, .table thead th {
                padding: 12px 8px;
                font-size: 0.68rem;
            }

            .table-custom tbody td, .table tbody td {
                padding: 12px 8px;
                font-size: 0.8rem;
            }

            .btn-group .btn { width: 32px; height: 32px; }

            .modal-dialog { margin: 1rem; }

            .modal-footer {
                flex-direction: column;
                gap: 10px;
            }

            .modal-footer .btn {
                width: 100%;
                justify-content: center;
            }
        }

        /* ==========================================
           ANIMATIONS
        ========================================== */
        .stat-card {
            animation: fadeInUp 0.5s ease-out forwards;
            opacity: 0;
        }

        .col-md-3:nth-child(1) .stat-card { animation-delay: 0.1s; }
        .col-md-3:nth-child(2) .stat-card { animation-delay: 0.15s; }
        .col-md-3:nth-child(3) .stat-card { animation-delay: 0.2s; }
        .col-md-3:nth-child(4) .stat-card { animation-delay: 0.25s; }

        .table tbody tr {
            opacity: 0;
            animation: fadeInRow 0.4s ease-out forwards;
        }

        .table tbody tr:nth-child(1) { animation-delay: 0.1s; }
        .table tbody tr:nth-child(2) { animation-delay: 0.15s; }
        .table tbody tr:nth-child(3) { animation-delay: 0.2s; }
        .table tbody tr:nth-child(4) { animation-delay: 0.25s; }
        .table tbody tr:nth-child(5) { animation-delay: 0.3s; }
        .table tbody tr:nth-child(6) { animation-delay: 0.35s; }
        .table tbody tr:nth-child(7) { animation-delay: 0.4s; }
        .table tbody tr:nth-child(8) { animation-delay: 0.45s; }
        .table tbody tr:nth-child(9) { animation-delay: 0.5s; }
        .table tbody tr:nth-child(10) { animation-delay: 0.55s; }

        @keyframes fadeInRow {
            from { opacity: 0; transform: translateX(-10px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .stat-value { transition: all 0.3s ease; }
        .stat-card:hover .stat-value { transform: scale(1.05); }

        /* ==========================================
           CUSTOM SCROLLBAR
        ========================================== */
        .main-content::-webkit-scrollbar { width: 8px; }
        .main-content::-webkit-scrollbar-track { background: #f1f1f1; }
        .main-content::-webkit-scrollbar-thumb {
            background: var(--vert-olive-fonce);
            border-radius: 4px;
        }
        .main-content::-webkit-scrollbar-thumb:hover {
            background: var(--vert-foret);
        }

        /* ==========================================
           DOCUMENT FILE SIZE
        ========================================== */
        .table tbody td:nth-child(4) {
            font-family: 'Courier New', monospace;
            font-weight: 600;
            font-size: 0.82rem;
            color: var(--gris);
        }

        /* ==========================================
           EXPIRATION BADGES EXTRA
        ========================================== */
        .badge:has(.fa-exclamation-triangle) {
            animation: pulse-badge 2s infinite;
        }

        @keyframes pulse-badge {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {% include 'components/_sidebar_admin.html.twig' %}
        
        <div class="main-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="mb-0">
                    <i class="fas fa-file-alt me-2"></i>Gestion des documents
                </h1>
                <button class="btn btn-outline-primary d-md-none" id="mobileSidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            
            {% include 'components/_flash_messages.html.twig' %}
            
            {# Statistiques #}
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-value text-primary">{{ statistics.total }}</div>
                        <div class="stat-label">Total</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-value text-success">{{ statistics.statuts.valide }}</div>
                        <div class="stat-label">Validés</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-value text-warning">{{ statistics.statuts.en_attente }}</div>
                        <div class="stat-label">En attente</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-value text-danger">{{ statistics.statuts.rejete }}</div>
                        <div class="stat-label">Rejetés</div>
                    </div>
                </div>
            </div>
            
            {# Filtres #}
            <div class="dashboard-section mb-4">
                <form method="get" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="fas fa-search me-1"></i>Rechercher
                        </label>
                        <input type="text" 
                               name="search" 
                               class="form-control" 
                               placeholder="Nom document, utilisateur..." 
                               value="{{ search }}">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">
                            <i class="fas fa-filter me-1"></i>Statut
                        </label>
                        <select name="statut" class="form-select">
                            <option value="">Tous</option>
                            <option value="valide" {{ statut == 'valide' ? 'selected' }}>Validés</option>
                            <option value="en_attente" {{ statut == 'en_attente' ? 'selected' }}>En attente</option>
                            <option value="rejete" {{ statut == 'rejete' ? 'selected' }}>Rejetés</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">
                            <i class="fas fa-tag me-1"></i>Type
                        </label>
                        <select name="type" class="form-select">
                            <option value="">Tous</option>
                            <option value="cni" {{ type == 'cni' ? 'selected' }}>CNI</option>
                            <option value="passeport" {{ type == 'passeport' ? 'selected' }}>Passeport</option>
                            <option value="certificat_bio" {{ type == 'certificat_bio' ? 'selected' }}>Certificat bio</option>
                            <option value="registre_commerce" {{ type == 'registre_commerce' ? 'selected' }}>Registre de commerce</option>
                            <option value="autre" {{ type == 'autre' ? 'selected' }}>Autre</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>Filtrer
                        </button>
                    </div>
                </form>
            </div>
            
            {# Liste des documents #}
            <div class="dashboard-section">
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Utilisateur</th>
                                <th>Document</th>
                                <th>Type</th>
                                <th>Taille</th>
                                <th>Date d'envoi</th>
                                <th>Expiration</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for document in pagination %}
                            <tr>
                                <td>
                                    <div>
                                        <strong>{{ document.utilisateur.nomComplet }}</strong>
                                        {% if document.utilisateur.agriculteur %}
                                            <span class="badge bg-success badge-sm">Agriculteur</span>
                                        {% elseif document.utilisateur.banque %}
                                            <span class="badge bg-warning badge-sm">Banque</span>
                                        {% endif %}
                                    </div>
                                    <small class="text-muted">{{ document.utilisateur.email }}</small>
                                </td>
                                <td>
                                    <i class="fas fa-file-alt me-1"></i>
                                    {{ document.nom }}
                                </td>
                                <td>
                                    <span class="badge bg-info">{{ document.typeDocument }}</span>
                                </td>
                                <td>
                                    {% if document.taille %}
                                        {{ (document.taille / 1024)|number_format(2) }} Ko
                                    {% else %}
                                        N/A
                                    {% endif %}
                                </td>
                                <td>{{ document.dateUpload|date('d/m/Y H:i') }}</td>
                                <td>
                                    {% if document.dateExpiration %}
                                        {% set now = date() %}
                                        {% set diff = date(document.dateExpiration).diff(now) %}
                                        {% if document.dateExpiration < now %}
                                            <span class="badge bg-danger">
                                                <i class="fas fa-exclamation-triangle me-1"></i>Expiré
                                            </span>
                                        {% elseif diff.days < 30 %}
                                            <span class="badge bg-warning">
                                                Dans {{ diff.days }} jours
                                            </span>
                                        {% else %}
                                            {{ document.dateExpiration|date('d/m/Y') }}
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-{{ document.statutBadgeClass }}">
                                        {% if document.statut == 'valide' %}
                                            <i class="fas fa-check me-1"></i>
                                        {% elseif document.statut == 'rejete' %}
                                            <i class="fas fa-times me-1"></i>
                                        {% else %}
                                            <i class="fas fa-clock me-1"></i>
                                        {% endif %}
                                        {{ document.statut }}
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('admin_documents_review', {id: document.id}) }}" 
                                           class="btn btn-sm btn-outline-primary"
                                           title="Examiner">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('admin_documents_download', {id: document.id}) }}" 
                                           class="btn btn-sm btn-outline-success"
                                           title="Télécharger"
                                           target="_blank">
                                            <i class="fas fa-download"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deleteModal{{ document.id }}"
                                                title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">
                                    <i class="fas fa-file-alt fa-3x mb-3 d-block"></i>
                                    Aucun document trouvé
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                {# Pagination #}
                <div class="d-flex justify-content-center mt-4">
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>
        </div>
    </div>

    {# ===== MODALS EN DEHORS DU CONTAINER ===== #}
    {% for document in pagination %}
    <div class="modal fade" id="deleteModal{{ document.id }}" tabindex="-1" aria-labelledby="deleteLabel{{ document.id }}" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteLabel{{ document.id }}">Confirmer la suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer le document <strong>{{ document.nom }}</strong> ?</p>
                    <p class="text-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Cette action est irréversible et supprimera définitivement le fichier.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Annuler
                    </button>
                    <form method="post" action="{{ path('admin_documents_delete', {id: document.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile sidebar toggle
            document.getElementById('mobileSidebarToggle')?.addEventListener('click', function() {
                document.getElementById('sidebar').classList.toggle('show');
            });

            // Fix modal z-index
            document.querySelectorAll('.modal').forEach(function(modal) {
                document.body.appendChild(modal);
                
                modal.addEventListener('shown.bs.modal', function() {
                    this.style.zIndex = '1100';
                    const backdrop = document.querySelector('.modal-backdrop');
                    if (backdrop) backdrop.style.zIndex = '1099';
                    
                    this.querySelectorAll('.btn, button, form').forEach(function(el) {
                        el.style.pointerEvents = 'auto';
                        el.style.cursor = 'pointer';
                    });
                });

                modal.addEventListener('hidden.bs.modal', function() {
                    document.querySelectorAll('.modal-backdrop').forEach(function(backdrop) {
                        if (!document.querySelector('.modal.show')) backdrop.remove();
                    });
                    document.body.classList.remove('modal-open');
                    document.body.style.removeProperty('padding-right');
                    document.body.style.removeProperty('overflow');
                });
            });

            // Counter animation
            function animateValue(el, start, end, duration) {
                let startTs = null;
                const step = (ts) => {
                    if (!startTs) startTs = ts;
                    const progress = Math.min((ts - startTs) / duration, 1);
                    el.textContent = Math.floor(progress * (end - start) + start);
                    if (progress < 1) window.requestAnimationFrame(step);
                };
                window.requestAnimationFrame(step);
            }

            document.querySelectorAll('.stat-value').forEach(function(el) {
                const val = parseInt(el.textContent);
                if (!isNaN(val) && val > 0) {
                    el.textContent = '0';
                    setTimeout(() => animateValue(el, 0, val, 1000), 500);
                }
            });

            // Stat card hover
            document.querySelectorAll('.stat-card').forEach(function(card) {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-8px) scale(1.02)';
                });
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0) scale(1)';
                });
            });
        });
    </script>
{% endblock %}