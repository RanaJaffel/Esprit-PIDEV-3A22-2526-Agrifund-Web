{% extends 'base.html.twig' %}
{% block title %}Admin — Nouvelle Ressource{% endblock %}

{% block content %}
<div class="page-header">
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="{{ path('admin_ressource_project_index') }}" class="text-white-50">Admin / Ressources</a></li>
        <li class="breadcrumb-item active text-white">Nouvelle</li>
    </ol></nav>
    <h2 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2"></i>Nouvelle Ressource <span class="badge bg-white text-success" style="font-size:.7em">ADMIN</span></h2>
</div>

<div class="row justify-content-center"><div class="col-lg-8">
    <div class="card card-agri">
        <div class="card-header" style="background:var(--green-pale);border-bottom:2px solid var(--green-light);">
            <h5 class="mb-0 fw-semibold" style="color:var(--green-dark)"><i class="bi bi-box-seam me-2"></i>Informations</h5>
        </div>
        <div class="card-body p-4">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                {% include 'ressource_project/_form.html.twig' %}
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-agri-primary"><i class="bi bi-check-circle me-1"></i> Créer</button>
                    <a href="{{ path('admin_ressource_project_index') }}" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div></div>
{% endblock %}
