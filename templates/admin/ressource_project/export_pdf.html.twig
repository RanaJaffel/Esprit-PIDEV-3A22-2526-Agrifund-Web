<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport — Ressources des Projets</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

        :root {
            --forest: #1a3d2b;
            --mint:   #52b788;
            --sage:   #d8f0e4;
            --earth:  #7f5539;
            --sand:   #fdf6ec;
            --ink:    #1c1c1c;
            --muted:  #6b7280;
            --line:   #e4e9e6;
            --gold:   #c9943a;
            --orange: #e65100;
            --blue:   #1565c0;
            --purple: #6a1b9a;
            --white:  #ffffff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'DM Sans', Arial, sans-serif;
            background: var(--white);
            color: var(--ink);
            font-size: 13px;
            line-height: 1.5;
        }

        /* ── A4 PAGE ────────────────────────────────── */
        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            background: var(--white);
            display: flex;
            flex-direction: column;
        }

        /* ── HEADER ─────────────────────────────────── */
        .header {
            background: var(--forest);
            padding: 20px 30px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        .header::after {
            content: '';
            position: absolute;
            width: 260px; height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
            top: -100px; right: -60px;
        }

        .header-left { display: flex; align-items: center; gap: 11px; }
        .brand-icon {
            width: 38px; height: 38px;
            background: var(--mint);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }
        .brand-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.55em;
            color: var(--white);
            font-weight: 700;
            line-height: 1;
        }
        .brand-sub {
            font-size: 0.8em;
            color: var(--mint);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-top: 3px;
        }

        .header-center h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.85em;
            color: var(--white);
            font-weight: 900;
            letter-spacing: -0.3px;
            text-align: center;
        }
        .header-center h1 span { color: var(--mint); }
        .header-center p {
            text-align: center;
            color: rgba(255,255,255,0.55);
            font-size: 0.9em;
            font-weight: 300;
            margin-top: 3px;
        }

        .header-right { text-align: right; }
        .doc-label {
            font-size: 0.72em;
            color: var(--mint);
            text-transform: uppercase;
            letter-spacing: 1.2px;
        }
        .doc-date {
            font-size: 0.9em;
            color: rgba(255,255,255,0.8);
            margin-top: 3px;
        }
        .doc-badge {
            display: inline-block;
            margin-top: 6px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.18);
            color: rgba(255,255,255,0.55);
            font-size: 0.68em;
            padding: 3px 10px;
            border-radius: 20px;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .accent-bar {
            height: 3px;
            background: linear-gradient(90deg, var(--mint) 0%, var(--gold) 55%, transparent 100%);
        }

        /* ── BODY ───────────────────────────────────── */
        .body {
            padding: 18px 30px;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        /* ── STATS ROW ──────────────────────────────── */
        .stats-row { display: flex; gap: 10px; }

        .stat-card {
            flex: 1;
            background: var(--sand);
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 12px 13px;
            position: relative;
            overflow: hidden;
        }
        .stat-card::before {
            content: '';
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 3px;
            border-radius: 8px 0 0 8px;
        }
        .stat-card.c-green::before  { background: var(--forest); }
        .stat-card.c-orange::before { background: var(--orange); }
        .stat-card.c-blue::before   { background: var(--blue); }
        .stat-card.c-purple::before { background: var(--purple); }
        .stat-card.c-earth::before  { background: var(--earth); }

        .stat-icon  { font-size: 1.25em; display: block; margin-bottom: 4px; }
        .stat-label {
            font-size: 0.72em;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: var(--muted);
            font-weight: 500;
            white-space: nowrap;
        }
        .stat-value {
            font-family: 'Playfair Display', serif;
            font-size: 1.75em;
            font-weight: 700;
            color: var(--forest);
            line-height: 1.1;
            margin-top: 3px;
        }
        .stat-value.sm { font-size: 1.2em; }
        .stat-unit {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.45em;
            color: var(--muted);
            font-weight: 400;
        }

        /* ── SECTION HEADING ────────────────────────── */
        .section-heading { display: flex; align-items: center; gap: 8px; }
        .sh-icon {
            width: 24px; height: 24px;
            background: var(--sage);
            border-radius: 5px;
            display: flex; align-items: center; justify-content: center;
            font-size: 12px;
            flex-shrink: 0;
        }
        .sh-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.15em;
            color: var(--forest);
            font-weight: 700;
        }
        .sh-line { flex: 1; height: 1px; background: var(--line); }

        /* ── TABLE ──────────────────────────────────── */
        .table-wrap {
            border: 1px solid var(--line);
            border-radius: 8px;
            overflow: hidden;
            flex: 1;
        }

        table { width: 100%; border-collapse: collapse; }

        thead tr { background: var(--forest); }
        thead th {
            padding: 10px 11px;
            text-align: left;
            font-size: 0.72em;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: rgba(255,255,255,0.78);
            font-weight: 600;
        }

        tbody tr { border-bottom: 1px solid var(--line); }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:nth-child(even) { background: #fafcfb; }

        tbody td {
            padding: 8px 11px;
            font-size: 0.92em;
            vertical-align: middle;
        }

        .td-id {
            font-family: 'Playfair Display', serif;
            font-size: 0.82em;
            color: var(--muted);
            font-weight: 700;
            white-space: nowrap;
        }
        .td-name        { font-weight: 600; color: var(--forest); }
        .td-project     { color: var(--muted); font-size: 0.85em; }
        .td-fournisseur { color: var(--muted); font-size: 0.85em; }
        .td-qty         { font-weight: 600; text-align: center; }
        .td-cout        { font-variant-numeric: tabular-nums; font-weight: 500; color: var(--earth); white-space: nowrap; }
        .td-total       { font-variant-numeric: tabular-nums; font-weight: 700; color: var(--forest); white-space: nowrap; }

        /* type badges */
        .type-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 0.75em;
            font-weight: 600;
            white-space: nowrap;
        }
        .type-equipement { background: #fff3e0; color: #e65100; border: 1px solid #ffcc80; }
        .type-materiaux  { background: #e3f2fd; color: #1565c0; border: 1px solid #90caf9; }
        .type-service    { background: #f3e5f5; color: #6a1b9a; border: 1px solid #ce93d8; }

        .dot { width: 5px; height: 5px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
        .dot-equipement { background: #e65100; }
        .dot-materiaux  { background: #1565c0; }
        .dot-service    { background: #6a1b9a; }

        /* statut badges */
        .statut-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 0.72em;
            font-weight: 600;
            white-space: nowrap;
        }
        .statut-ok    { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }
        .statut-prevu { background: #fff8e1; color: #f57f17; border: 1px solid #ffe082; }
        .statut-other { background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; }

        /* empty */
        .empty-row td {
            text-align: center;
            padding: 30px;
            color: var(--muted);
            font-size: 0.95em;
        }

        /* total row */
        .total-row td {
            background: var(--sage);
            font-weight: 700;
            color: var(--forest);
            padding: 9px 11px;
            font-size: 0.92em;
            border-top: 2px solid var(--mint);
        }

        /* ── FOOTER ─────────────────────────────────── */
        .footer {
            background: var(--forest);
            padding: 10px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .footer-left { font-size: 0.82em; color: rgba(255,255,255,0.6); }
        .footer-left strong { color: var(--mint); }
        .footer-right { font-size: 0.75em; color: rgba(255,255,255,0.4); text-align: right; }

        /* ── PRINT ──────────────────────────────────── */
        @page { size: A4 portrait; margin: 0; }
        @media print {
            body { background: white; }
            .page { width: 100%; min-height: 100vh; }
        }
    </style>
</head>
<body>
<div class="page">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <div class="brand-icon">🌿</div>
            <div>
                <div class="brand-name">AgriFund</div>
                <div class="brand-sub">Gestion de Projets</div>
            </div>
        </div>

        <div class="header-center">
            <h1>Rapport <span>Ressources</span></h1>
            <p>Équipements · Matériaux · Services</p>
        </div>

        <div class="header-right">
            <div class="doc-label">Généré le</div>
            <div class="doc-date">{{ "now"|date('d/m/Y à H:i') }}</div>
            <div class="doc-badge">Confidentiel</div>
        </div>
    </div>
    <div class="accent-bar"></div>

    <!-- BODY -->
    <div class="body">

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card c-green">
                <span class="stat-icon">📦</span>
                <div class="stat-label">Total Ressources</div>
                <div class="stat-value">{{ totalRessources }}</div>
            </div>
            <div class="stat-card c-orange">
                <span class="stat-icon">🚜</span>
                <div class="stat-label">Équipements</div>
                <div class="stat-value">{{ countEquipement }}</div>
            </div>
            <div class="stat-card c-blue">
                <span class="stat-icon">⚙️</span>
                <div class="stat-label">Matériaux</div>
                <div class="stat-value">{{ countMateriaux }}</div>
            </div>
            <div class="stat-card c-purple">
                <span class="stat-icon">🔧</span>
                <div class="stat-label">Services</div>
                <div class="stat-value">{{ countService }}</div>
            </div>
            <div class="stat-card c-earth">
                <span class="stat-icon">💰</span>
                <div class="stat-label">Coût Total</div>
                <div class="stat-value sm">{{ totalCout|number_format(2, ',', ' ') }}<span class="stat-unit"> TND</span></div>
            </div>
        </div>

        <!-- Table heading -->
        <div class="section-heading">
            <div class="sh-icon">📋</div>
            <div class="sh-title">Liste des Ressources</div>
            <div class="sh-line"></div>
        </div>

        <!-- Table -->
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Ressource</th>
                        <th>Type</th>
                        <th>Projet</th>
                        <th>Fournisseur</th>
                        <th>Qté</th>
                        <th>Coût Unit.</th>
                        <th>Coût Total</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% if ressources is empty %}
                    <tr class="empty-row">
                        <td colspan="9">📦 Aucune ressource disponible pour le moment.</td>
                    </tr>
                    {% else %}
                    {% for r in ressources %}
                    <tr>
                        <td class="td-id">#{{ r.idressource }}</td>
                        <td class="td-name">{{ r.nomressource }}</td>
                        <td>
                            {% if r.typeressource == 'equipement' %}
                                <span class="type-badge type-equipement"><span class="dot dot-equipement"></span>Équipement</span>
                            {% elseif r.typeressource == 'materiaux' %}
                                <span class="type-badge type-materiaux"><span class="dot dot-materiaux"></span>Matériaux</span>
                            {% else %}
                                <span class="type-badge type-service"><span class="dot dot-service"></span>Service</span>
                            {% endif %}
                        </td>
                        <td class="td-project">{{ r.project.nomproject }}</td>
                        <td class="td-fournisseur">{{ r.fournisseur ?? '—' }}</td>
                        <td class="td-qty">{{ r.quantite }}</td>
                        <td class="td-cout">{{ r.cout|number_format(2, ',', ' ') }}</td>
                        <td class="td-total">{{ (r.cout * r.quantite)|number_format(2, ',', ' ') }}</td>
                        <td>
                            {% if r.statut in ['achete', 'Disponible'] %}
                                <span class="statut-badge statut-ok">{{ r.statut }}</span>
                            {% elseif r.statut in ['prevu', 'En commande'] %}
                                <span class="statut-badge statut-prevu">{{ r.statut }}</span>
                            {% else %}
                                <span class="statut-badge statut-other">{{ r.statut }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}

                    <!-- Total row -->
                    <tr class="total-row">
                        <td colspan="7" style="text-align:right; letter-spacing:0.5px;">TOTAL GÉNÉRAL</td>
                        <td>{{ totalCout|number_format(2, ',', ' ') }} TND</td>
                        <td></td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>

    </div><!-- /body -->

    <!-- FOOTER -->
    <div class="footer">
        <div class="footer-left">
            Rapport généré par <strong>AgriFund</strong> &nbsp;·&nbsp; {{ totalRessources }} ressource(s) au total
        </div>
        <div class="footer-right">
            {{ "now"|date('d/m/Y \à H:i:s') }} &nbsp;·&nbsp; Document confidentiel
        </div>
    </div>

</div>
</body>
</html>
