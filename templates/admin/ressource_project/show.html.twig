{% extends 'base.html.twig' %}
{% block title %}Admin — {{ ressource.nomressource }}{% endblock %}

{% block content %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="{{ path('admin_ressource_project_index') }}" class="text-white-50">Admin / Ressources</a></li>
            <li class="breadcrumb-item active text-white">{{ ressource.nomressource }}</li>
        </ol></nav>
        <h2 class="fw-bold mb-0"><i class="bi bi-box-seam me-2"></i>{{ ressource.nomressource }} <span class="badge bg-white text-success" style="font-size:.7em">ADMIN</span></h2>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_ressource_project_edit', {id: ressource.idressource}) }}" class="btn btn-warning fw-semibold"><i class="bi bi-pencil me-1"></i> Modifier</a>
        <a href="{{ path('admin_ressource_project_index') }}" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i> Retour</a>
    </div>
</div>

<div class="row justify-content-center"><div class="col-lg-6">
    <div class="card card-agri">
        <div class="card-header" style="background:var(--green-pale);border-bottom:2px solid var(--green-light);">
            <h5 class="mb-0 fw-semibold" style="color:var(--green-dark)"><i class="bi bi-info-circle me-2"></i>Détails</h5>
        </div>
        <div class="card-body">
            <table class="table table-borderless mb-0">
                <tr><th class="text-muted w-40">ID</th><td>{{ ressource.idressource }}</td></tr>
                <tr><th class="text-muted">Nom</th><td class="fw-semibold">{{ ressource.nomressource }}</td></tr>
                <tr><th class="text-muted">Type</th><td><span class="badge bg-info">{{ ressource.typeressource }}</span></td></tr>
                <tr><th class="text-muted">Quantité</th><td>{{ ressource.quantite }}</td></tr>
                <tr><th class="text-muted">Coût Unitaire</th><td class="text-success fw-semibold">{{ ressource.cout|number_format(2, ',', ' ') }} TND</td></tr>
                <tr><th class="text-muted">Coût Total</th><td class="fw-bold" style="color:var(--green-dark)">{{ (ressource.cout * ressource.quantite)|number_format(2, ',', ' ') }} TND</td></tr>
                <tr><th class="text-muted">Fournisseur</th><td>{{ ressource.fournisseur ?? '—' }}</td></tr>
                <tr><th class="text-muted">Statut</th><td><span class="badge bg-secondary">{{ ressource.statut }}</span></td></tr>
                <tr><th class="text-muted">Date Ajout</th><td>{{ ressource.dateajout|date('d/m/Y') }}</td></tr>
                <tr><th class="text-muted">Projet</th><td>{{ ressource.project.nomproject }}</td></tr>
            </table>
        </div>
        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal">
                <i class="bi bi-trash me-1"></i> Supprimer
            </button>
        </div>
    </div>
</div></div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white"><h5 class="modal-title">Confirmer</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">Supprimer <strong>{{ ressource.nomressource }}</strong> ?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="POST" action="{{ path('admin_ressource_project_delete', {id: ressource.idressource}) }}" style="display:inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_ressource_' ~ ressource.idressource) }}">
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
