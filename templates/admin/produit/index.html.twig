{% extends 'base.html.twig' %}

{% block title %}Produits Financiers{% endblock %}

{% block page_intro %}
<div id="pageintro" class="hoc clear" style="background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); color: white; padding: 40px 0;"> 
    <article class="container">
        <div class="introtxt" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h2 class="heading" style="color: white; margin: 0 0 10px 0;">💼 Produits Financiers</h2>
                <p style="color: #F4C430; margin: 0; font-size: 1.05em;">Gérez les produits de financement agricole</p>
            </div>
            <a href="{{ path('admin_produit_new') }}" style="display: inline-block; padding: 12px 25px; background: #F4C430; color: #1B7E4C; text-decoration: none; border-radius: 6px; font-weight: bold; white-space: nowrap;">
                ➕ Nouveau Produit
            </a>
        </div>
    </article>
</div>
{% endblock %}

{% block content %}
<div class="wrapper row3">
    <main class="hoc container clear">
        {{ include('flash_messages.html.twig') }}

        {% if produits %}
        <!-- Stats Cards -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px;">
            <div style="background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); color: white; padding: 20px; border-radius: 8px; text-align: center;">
                <p style="margin: 0 0 8px 0; font-size: 0.9em; opacity: 0.9;">Total Produits</p>
                <p style="margin: 0; font-size: 2.5em; font-weight: bold;">{{ produits|length }}</p>
            </div>
            <div style="background: linear-gradient(135deg, #F4C430 0%, #D4A817 100%); color: #1B7E4C; padding: 20px; border-radius: 8px; text-align: center;">
                <p style="margin: 0 0 8px 0; font-size: 0.9em; opacity: 0.9;">Taux Moyen</p>
                <p style="margin: 0; font-size: 2.5em; font-weight: bold;">{% set tauxMoyen = produits|reduce((carry, prod) => carry + prod.tauxInteret, 0) / produits|length %}{{ tauxMoyen|number_format(2, ',', '.') }}%</p>
            </div>
        </div>

        <!-- Products Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 25px;">
        {% for produit in produits %}
            <div style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(27,126,76,0.1); transition: transform 0.3s, box-shadow 0.3s; hover-transform: translateY(-4px);">
                <!-- Header Band -->
                <div style="background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); color: white; padding: 20px;">
                    <h3 style="margin: 0 0 8px 0; font-size: 1.1em;">{{ produit.nomProduit }}</h3>
                    <p style="margin: 0; color: #F4C430; font-size: 0.9em; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">{{ produit.typeFinancement }}</p>
                </div>

                <!-- Content -->
                <div style="padding: 20px;">
                    <!-- Key Metrics -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
                        <div style="text-align: center; padding: 12px; background: #f0f7f4; border-radius: 6px;">
                            <p style="margin: 0 0 5px 0; color: #999; font-size: 0.8em; font-weight: bold; text-transform: uppercase;">Taux</p>
                            <p style="margin: 0; font-size: 1.5em; font-weight: bold; color: #1B7E4C;">{{ produit.tauxInteret }}%</p>
                        </div>
                        <div style="text-align: center; padding: 12px; background: #f0f7f4; border-radius: 6px;">
                            <p style="margin: 0 0 5px 0; color: #999; font-size: 0.8em; font-weight: bold; text-transform: uppercase;">Offres</p>
                            <p style="margin: 0; font-size: 1.5em; font-weight: bold; color: #1B7E4C;">{{ produit.offres|length }}</p>
                        </div>
                    </div>

                    <!-- Amounts -->
                    <div style="margin-bottom: 20px; padding: 12px; background: #f9f9f9; border-radius: 6px;">
                        <p style="margin: 0 0 8px 0; font-size: 0.8em; color: #999; font-weight: bold; text-transform: uppercase;">Montants</p>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #666; font-size: 0.9em;">{{ produit.montantMin|number_format(0, ',', ' ') }}</span>
                            <span style="color: #999; font-size: 0.8em;">→</span>
                            <span style="color: #1B7E4C; font-weight: bold;">{{ produit.montantMax|number_format(0, ',', ' ') }} DT</span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div style="display: flex; gap: 8px;">
                        <a href="{{ path('admin_produit_show', {'id': produit.id}) }}" style="flex: 1; padding: 10px; text-align: center; background: #e8f0ed; color: #1B7E4C; text-decoration: none; border-radius: 4px; font-weight: bold; font-size: 0.9em; border: 1px solid #1B7E4C; transition: background 0.2s;">👁️ Voir</a>
                        <a href="{{ path('admin_produit_edit', {'id': produit.id}) }}" style="flex: 1; padding: 10px; text-align: center; background: #1B7E4C; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; font-size: 0.9em; transition: background 0.2s;">✏️ Éditer</a>
                        <form method="post" action="{{ path('admin_produit_delete', {'id': produit.id}) }}" style="flex: 1;" onsubmit="return confirm('Supprimer ce produit ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                            <button type="submit" style="width: 100%; padding: 10px; background: #dc3545; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; font-size: 0.9em; border: none; cursor: pointer; transition: background 0.2s;">🗑️ Supprimer</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>

        {% else %}
        <!-- Empty State -->
        <div style="text-align: center; padding: 60px 20px; background: white; border-radius: 12px;">
            <p style="margin: 0 0 20px 0; font-size: 3em;">📋</p>
            <h3 style="margin: 0 0 10px 0; color: #333;">Aucun produit disponible</h3>
            <p style="margin: 0 0 20px 0; color: #999;">Créez votre premier produit de financement agricole</p>
            <a href="{{ path('admin_produit_new') }}" style="display: inline-block; padding: 12px 30px; background: #1B7E4C; color: white; text-decoration: none; border-radius: 6px; font-weight: bold;">
                ➕ Créer le Premier Produit
            </a>
        </div>
        {% endif %}
    </main>
</div>
}

.table thead {
    background: #1B7E4C;
    color: white;
}

.table th, .table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #E0E0E0;
}

.table tbody tr:hover {
    background: #f8f9fa;
}

.btn-sm {
    padding: 6px 12px;
    margin: 0 4px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    font-size: 0.85rem;
}

.btn-info {
    background: #2196F3;
    color: white;
}

.btn-warning {
    background: #F4C430;
    color: #333;
}

.btn-danger {
    background: #D32F2F;
    color: white;
}

.empty-state {
    text-align: center;
    padding: 40px;
    background: #f8f9fa;
    border-radius: 8px;
}
</style>
{% endblock %}
