{% extends 'base.html.twig' %}

{% block title %}Statistiques Produits | Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --jaune-moutarde: #E1B323;
            --vert-clair: #B2D944;
        }

        .dashboard-container { display: flex; min-height: 100vh; background: linear-gradient(135deg, #f8faf5, #e8f5e9); }
        .main-content { flex: 1; margin-left: 280px; padding: 0; }
        .section-header-custom { background: linear-gradient(135deg, var(--vert-fonce), var(--vert-foret), #133D03); padding: 28px 35px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .dashboard-section { background: rgba(255,255,255,0.95); border-radius: 20px; padding: 30px; box-shadow: 0 8px 32px rgba(8,150,71,0.08); margin: -20px 35px 30px 35px; border: 1px solid rgba(255,255,255,0.6); position: relative; z-index: 10; }

        .stat-big { background: white; border-radius: 20px; padding: 30px; box-shadow: 0 6px 20px rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.04); text-align: center; transition: all 0.3s; }
        .stat-big:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(8,150,71,0.12); }
        .stat-big .value { font-size: 3rem; font-weight: 800; color: var(--vert-fonce); line-height: 1; }
        .stat-big .label { color: #6c757d; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-top: 10px; }
        .stat-big .icon { font-size: 2rem; color: var(--vert-clair); margin-bottom: 15px; }

        .chart-card { background: white; border-radius: 20px; padding: 30px; box-shadow: 0 6px 20px rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.04); }
        .chart-title { font-weight: 800; font-size: 1.1rem; color: #2b3531; margin-bottom: 20px; }

        .bar-item { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; }
        .bar-label { width: 120px; font-weight: 600; font-size: 0.85rem; color: #495057; text-align: right; }
        .bar-container { flex: 1; height: 30px; background: #f0f7f4; border-radius: 15px; overflow: hidden; position: relative; }
        .bar-fill { height: 100%; border-radius: 15px; transition: width 1s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center; justify-content: flex-end; padding-right: 10px; color: white; font-weight: 700; font-size: 0.8rem; }
        .bar-fill.green { background: linear-gradient(135deg, var(--vert-clair), var(--vert-vif)); }
        .bar-fill.gold { background: linear-gradient(135deg, #ffecb3, var(--jaune-moutarde)); }
        .bar-fill.blue { background: linear-gradient(135deg, #bbdefb, #1976d2); }

        .top-list { list-style: none; padding: 0; margin: 0; }
        .top-item { display: flex; align-items: center; gap: 15px; padding: 15px; border-radius: 12px; transition: all 0.3s; margin-bottom: 8px; }
        .top-item:hover { background: #f0f7f4; }
        .top-rank { width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.9rem; }
        .top-rank.gold { background: linear-gradient(135deg, #fff8e1, #ffecb3); color: #f59e0b; }
        .top-rank.silver { background: linear-gradient(135deg, #f5f5f5, #e0e0e0); color: #757575; }
        .top-rank.bronze { background: linear-gradient(135deg, #fff3e0, #ffe0b2); color: #ef6c00; }
        .top-rank.normal { background: #f0f7f4; color: var(--vert-fonce); }

        @media (max-width: 991.98px) { .main-content { margin-left: 0; } .dashboard-section { margin: -10px 15px 20px 15px; } }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'components/_sidebar_admin.html.twig' %}

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center section-header-custom mb-4">
            <h1 class="mb-0 text-white">
                <i class="fas fa-chart-bar me-3" style="color: var(--vert-clair);"></i>Statistiques Produits
            </h1>
            <a href="{{ path('admin_produit_index') }}" class="btn btn-outline-light rounded-3 px-4">
                <i class="fas fa-arrow-left me-2"></i>Retour
            </a>
        </div>

        {# KPI Cards #}
        <div class="dashboard-section">
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="stat-big">
                        <div class="icon"><i class="fas fa-boxes"></i></div>
                        <div class="value">{{ dashboardStats.stats.totalProduits }}</div>
                        <div class="label">Total Produits</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-big">
                        <div class="icon"><i class="fas fa-percentage"></i></div>
                        <div class="value">{{ dashboardStats.stats.avgTaux }}%</div>
                        <div class="label">Taux Moyen</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-big">
                        <div class="icon"><i class="fas fa-arrow-down"></i></div>
                        <div class="value">{{ dashboardStats.stats.minTaux }}%</div>
                        <div class="label">Taux Minimum</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-big">
                        <div class="icon"><i class="fas fa-arrow-up"></i></div>
                        <div class="value">{{ dashboardStats.stats.maxTaux }}%</div>
                        <div class="label">Taux Maximum</div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                {# Distribution par type #}
                <div class="col-lg-6">
                    <div class="chart-card h-100">
                        <h5 class="chart-title"><i class="fas fa-chart-pie me-2" style="color: var(--vert-vif);"></i>Répartition par Type</h5>
                        {% set colors = ['green', 'gold', 'blue', 'green', 'gold'] %}
                        {% set maxCount = 1 %}
                        {% for item in dashboardStats.byType %}
                            {% if item.total > maxCount %}{% set maxCount = item.total %}{% endif %}
                        {% endfor %}
                        {% for item in dashboardStats.byType %}
                            <div class="bar-item">
                                <div class="bar-label">{{ item.typeFinancement }}</div>
                                <div class="bar-container">
                                    <div class="bar-fill {{ colors[loop.index0 % 3] }}" style="width: {{ (item.total / maxCount) * 100 }}%;">
                                        {{ item.total }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                        {% if dashboardStats.byType is empty %}
                            <p class="text-muted text-center py-3">Aucune donnée disponible</p>
                        {% endif %}
                    </div>
                </div>

                {# Distribution des taux #}
                <div class="col-lg-6">
                    <div class="chart-card h-100">
                        <h5 class="chart-title"><i class="fas fa-chart-bar me-2" style="color: var(--jaune-moutarde);"></i>Distribution des Taux d'Intérêt</h5>
                        {% set maxTaux = 1 %}
                        {% for label, count in dashboardStats.tauxDistribution %}
                            {% if count > maxTaux %}{% set maxTaux = count %}{% endif %}
                        {% endfor %}
                        {% set barColors = ['green', 'green', 'gold', 'gold', 'blue'] %}
                        {% for label, count in dashboardStats.tauxDistribution %}
                            <div class="bar-item">
                                <div class="bar-label">{{ label }}</div>
                                <div class="bar-container">
                                    <div class="bar-fill {{ barColors[loop.index0 % 5] }}" style="width: {{ maxTaux > 0 ? (count / maxTaux) * 100 : 0 }}%;">
                                        {{ count }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# Top Produits #}
            <div class="row g-4 mt-2">
                <div class="col-lg-6">
                    <div class="chart-card">
                        <h5 class="chart-title"><i class="fas fa-trophy me-2" style="color: var(--jaune-moutarde);"></i>Top Produits (par offres)</h5>
                        <ul class="top-list">
                            {% for produit in dashboardStats.topProduits %}
                                <li class="top-item">
                                    <span class="top-rank {{ loop.index == 1 ? 'gold' : (loop.index == 2 ? 'silver' : (loop.index == 3 ? 'bronze' : 'normal')) }}">
                                        #{{ loop.index }}
                                    </span>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold">{{ produit.nomProduit }}</div>
                                        <small class="text-muted">{{ produit.typeFinancement }} · {{ produit.tauxInteret }}%</small>
                                    </div>
                                    <span class="badge rounded-pill" style="background: #e8f5e9; color: var(--vert-vif); font-weight: 700;">
                                        {{ dashboardStats.topProduitsOffresCount[produit.id]|default(0) }} offre(s)
                                    </span>
                                </li>
                            {% endfor %}
                            {% if dashboardStats.topProduits is empty %}
                                <li class="text-muted text-center py-3">Aucun produit disponible</li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="chart-card h-100 d-flex flex-column justify-content-center align-items-center">
                        <h5 class="chart-title"><i class="fas fa-coins me-2" style="color: var(--vert-vif);"></i>Montants Moyens</h5>
                        <div class="row g-3 w-100">
                            <div class="col-12 text-center">
                                <div class="p-3 rounded-3" style="background: #f0f7f4;">
                                    <div style="font-size: 1.5rem; font-weight: 800; color: var(--vert-fonce);">
                                        {{ dashboardStats.stats.avgMontant|default(dashboardStats.stats.avgMontantMax)|number_format(0, ',', ' ') }}
                                    </div>
                                    <small class="text-muted fw-bold">DT — Montant Moyen</small>
                                </div>
                            </div>
                            <div class="col-12 text-center mt-2">
                                <div class="p-3 rounded-3" style="background: linear-gradient(135deg, #e8f5e9, #f1f8e9);">
                                    <div style="font-size: 2rem; font-weight: 800; color: var(--vert-vif);">
                                        {{ dashboardStats.stats.maxMontant|number_format(0, ',', ' ') }}
                                    </div>
                                    <small class="text-muted fw-bold">DT — Montant Maximum Global</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
