{% extends 'base.html.twig' %}

{% block title %}Create Financial Product{% endblock %}

{% block page_intro %}
<div id="pageintro" class="hoc clear"> 
    <article>
        <div class="introtxt">
            <h2 class="heading"><i class="fa fa-plus"></i> Create New Product</h2>
            <p>Add a new financial product to the platform</p>
        </div>
    </article>
</div>
{% endblock %}

{% block content %}
<div class="wrapper row3">
    <main class="hoc container clear">
        <div class="form-card">
            <h2>New Financial Product</h2>
            {{ form_start(form, {'attr': {'class': 'form'}}) }}
            
            <div class="form-group">
                {{ form_label(form.nomProduit) }}
                {{ form_widget(form.nomProduit) }}
                {{ form_errors(form.nomProduit) }}
            </div>

            <div class="form-group">
                {{ form_label(form.typeFinancement) }}
                {{ form_widget(form.typeFinancement) }}
                {{ form_errors(form.typeFinancement) }}
            </div>

            <div class="form-row">
                <div class="form-group">
                    {{ form_label(form.tauxInteret) }}
                    {{ form_widget(form.tauxInteret) }}
                    {{ form_errors(form.tauxInteret) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.montantMin) }}
                    {{ form_widget(form.montantMin) }}
                    {{ form_errors(form.montantMin) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.montantMax) }}
                    {{ form_widget(form.montantMax) }}
                    {{ form_errors(form.montantMax) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.reglesFinancieres) }}
                {{ form_widget(form.reglesFinancieres) }}
                {{ form_errors(form.reglesFinancieres) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save"></i> Create Product
                </button>
                <a href="{{ path('admin_produit_index') }}" class="btn btn-secondary">
                    Cancel
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </main>
</div>

<style>
.form-card {
    background: white;
    border-radius: 8px;
    padding: 30px;
    box-shadow: 0 2px 10px rgba(0,0,0,.05);
    max-width: 600px;
    margin: 0 auto;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: #333;
}

.form-control {
    width: 100%;
    padding: 10px;
    border: 2px solid #E0E0E0;
    border-radius: 4px;
    font-size: 1rem;
}

.form-control:focus {
    outline: none;
    border-color: #1B7E4C;
    box-shadow: 0 0 0 3px rgba(27,126,76,.1);
}

.form-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.form-actions {
    display: flex;
    gap: 10px;
    margin-top: 30px;
}

.btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    font-weight: 600;
}

.btn-primary {
    background: #1B7E4C;
    color: white;
}

.btn-primary:hover {
    background: #0D5C3F;
}

.btn-secondary {
    background: #E0E0E0;
    color: #333;
}
</style>
{% endblock %}
