{% extends 'base.html.twig' %}

{% block title %}Nouvelle conversation - Admin{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        .user-list-item {
            padding: 15px;
            border-bottom: 1px solid #e9ecef;
            text-decoration: none;
            color: inherit;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: background 0.2s;
        }
        .user-list-item:hover {
            background: rgba(8, 150, 71, 0.05);
            text-decoration: none;
        }
        .user-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }
        .user-avatar-placeholder {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .user-info { flex: 1; min-width: 0; }
        .user-name {
            font-weight: 600;
            color: var(--vert-fonce);
            margin-bottom: 3px;
        }
        .user-email {
            color: #6c757d;
            font-size: 0.875rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .user-extra {
            font-size: 0.8rem;
            color: #6c757d;
            margin-top: 2px;
        }
        .search-box {
            position: sticky;
            top: 0;
            background: white;
            z-index: 10;
            padding: 15px;
            border-bottom: 1px solid #e9ecef;
        }
        .users-list {
            max-height: 65vh;
            overflow-y: auto;
        }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'components/_sidebar_admin.html.twig' %}

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">
                <i class="fas fa-plus me-2"></i>Nouvelle conversation
            </h1>
            <a href="{{ path('admin_messagerie_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Retour
            </a>
        </div>

        {% include 'components/_flash_messages.html.twig' %}

        <div class="dashboard-section p-0">
            {% if available_users|length > 0 %}

                {# Barre de recherche #}
                <div class="search-box">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0"
                               id="searchUser"
                               placeholder="Rechercher un utilisateur..."
                               autocomplete="off">
                    </div>
                </div>

                {# Compteur #}
                <div class="px-3 py-2 border-bottom bg-light">
                    <small class="text-muted">
                        <span id="userCount">{{ available_users|length }}</span> utilisateur(s) disponible(s)
                    </small>
                </div>

                <div class="users-list" id="usersList">

                    {# Groupe Admins #}
                    {% set admins = available_users|filter(u => u.hasRole('ROLE_ADMIN')) %}
                    {% if admins|length > 0 %}
                        <div class="px-3 py-2 bg-light border-bottom user-group-header" data-group="admins">
                            <small class="fw-bold text-uppercase text-danger">
                                <i class="fas fa-user-shield me-1"></i>Administrateurs ({{ admins|length }})
                            </small>
                        </div>
                        {% for user in admins %}
                            <a href="{{ path('admin_messagerie_start', {userId: user.id}) }}"
                               class="user-list-item list-group-item list-group-item-action user-item"
                               data-name="{{ user.nomComplet|lower }}"
                               data-email="{{ user.email|lower }}">

                                <div>
                                    {% if user.photo %}
                                        <img src="{{ asset(user.photo) }}"
                                             alt="{{ user.nomComplet }}"
                                             class="user-avatar">
                                    {% else %}
                                        <div class="user-avatar-placeholder">
                                            <i class="fas fa-user-shield text-danger"></i>
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="user-info">
                                    <div class="user-name">{{ user.nomComplet }}</div>
                                    <div class="user-email">{{ user.email }}</div>
                                    {% if user.tel %}
                                        <div class="user-extra">
                                            <i class="fas fa-phone me-1"></i>{{ user.tel }}
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="flex-shrink-0">
                                    <span class="badge bg-danger">
                                        <i class="fas fa-user-shield me-1"></i>Admin
                                    </span>
                                </div>
                            </a>
                        {% endfor %}
                    {% endif %}

                    {# Groupe Agriculteurs #}
                    {% set agriculteurs = available_users|filter(u => u.agriculteur is not null) %}
                    {% if agriculteurs|length > 0 %}
                        <div class="px-3 py-2 bg-light border-bottom border-top user-group-header" data-group="agriculteurs">
                            <small class="fw-bold text-uppercase text-success">
                                <i class="fas fa-tractor me-1"></i>Agriculteurs ({{ agriculteurs|length }})
                            </small>
                        </div>
                        {% for user in agriculteurs %}
                            <a href="{{ path('admin_messagerie_start', {userId: user.id}) }}"
                               class="user-list-item list-group-item list-group-item-action user-item"
                               data-name="{{ user.nomComplet|lower }}"
                               data-email="{{ user.email|lower }}">

                                <div>
                                    {% if user.photo %}
                                        <img src="{{ asset(user.photo) }}"
                                             alt="{{ user.nomComplet }}"
                                             class="user-avatar">
                                    {% else %}
                                        <div class="user-avatar-placeholder">
                                            <i class="fas fa-tractor text-success"></i>
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="user-info">
                                    <div class="user-name">{{ user.nomComplet }}</div>
                                    <div class="user-email">{{ user.email }}</div>
                                    {% if user.agriculteur.typeCulture %}
                                        <div class="user-extra">
                                            <i class="fas fa-seedling me-1"></i>{{ user.agriculteur.typeCulture }}
                                        </div>
                                    {% endif %}
                                    {% if user.agriculteur.adresseferme %}
                                        <div class="user-extra">
                                            <i class="fas fa-map-marker-alt me-1"></i>{{ user.agriculteur.adresseferme }}
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="flex-shrink-0 text-end">
                                    <span class="badge bg-success mb-1 d-block">
                                        <i class="fas fa-tractor me-1"></i>Agriculteur
                                    </span>
                                    {% if user.agriculteur.statuscompte == 'actif' %}
                                        <span class="badge bg-success-subtle text-success" style="font-size:0.65rem;">
                                            <i class="fas fa-check-circle me-1"></i>Actif
                                        </span>
                                    {% elseif user.agriculteur.statuscompte == 'en_attente' %}
                                        <span class="badge bg-warning-subtle text-warning" style="font-size:0.65rem;">
                                            En attente
                                        </span>
                                    {% endif %}
                                </div>
                            </a>
                        {% endfor %}
                    {% endif %}

                    {# Groupe Banques #}
                    {% set banques = available_users|filter(u => u.banque is not null) %}
                    {% if banques|length > 0 %}
                        <div class="px-3 py-2 bg-light border-bottom border-top user-group-header" data-group="banques">
                            <small class="fw-bold text-uppercase text-warning">
                                <i class="fas fa-university me-1"></i>Banques ({{ banques|length }})
                            </small>
                        </div>
                        {% for user in banques %}
                            <a href="{{ path('admin_messagerie_start', {userId: user.id}) }}"
                               class="user-list-item list-group-item list-group-item-action user-item"
                               data-name="{{ user.nom|lower }}"
                               data-email="{{ user.email|lower }}">

                                <div>
                                    {% if user.banque.logo %}
                                        <img src="{{ asset(user.banque.logo) }}"
                                             alt="{{ user.nom }}"
                                             class="user-avatar">
                                    {% elseif user.photo %}
                                        <img src="{{ asset(user.photo) }}"
                                             alt="{{ user.nom }}"
                                             class="user-avatar">
                                    {% else %}
                                        <div class="user-avatar-placeholder">
                                            <i class="fas fa-university text-warning"></i>
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="user-info">
                                    <div class="user-name">{{ user.nom }}</div>
                                    <div class="user-email">{{ user.email }}</div>
                                    {% if user.banque.codebanque %}
                                        <div class="user-extra">
                                            <i class="fas fa-id-card me-1"></i>Code: {{ user.banque.codebanque }}
                                        </div>
                                    {% endif %}
                                    {% if user.banque.adresseAgence %}
                                        <div class="user-extra">
                                            <i class="fas fa-map-marker-alt me-1"></i>{{ user.banque.adresseAgence }}
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="flex-shrink-0 text-end">
                                    <span class="badge bg-warning text-dark mb-1 d-block">
                                        <i class="fas fa-university me-1"></i>Banque
                                    </span>
                                    {% if user.banque.statusCompte == 'actif' %}
                                        <span class="badge bg-success-subtle text-success" style="font-size:0.65rem;">
                                            <i class="fas fa-check-circle me-1"></i>Actif
                                        </span>
                                    {% endif %}
                                </div>
                            </a>
                        {% endfor %}
                    {% endif %}

                    {# Message aucun résultat de recherche #}
                    <div id="noResults" class="text-center text-muted py-5" style="display:none;">
                        <i class="fas fa-search fa-3x mb-3 d-block opacity-25"></i>
                        <p>Aucun utilisateur trouvé pour cette recherche.</p>
                    </div>

                </div>

            {% else %}
                <div class="text-center text-muted py-5">
                    <i class="fas fa-users fa-5x mb-3 d-block opacity-25"></i>
                    <h5>Aucun utilisateur disponible</h5>
                    <p>Il n'y a actuellement aucun utilisateur avec qui vous pouvez démarrer une conversation.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchUser');
            if (!searchInput) return;

            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                const items = document.querySelectorAll('.user-item');
                const groups = document.querySelectorAll('.user-group-header');
                const noResults = document.getElementById('noResults');
                const userCount = document.getElementById('userCount');

                let visibleCount = 0;

                items.forEach(function (item) {
                    const name = item.dataset.name || '';
                    const email = item.dataset.email || '';
                    const matches = name.includes(query) || email.includes(query);
                    item.style.display = matches ? '' : 'none';
                    if (matches) visibleCount++;
                });

                // Masquer les groupes vides
                groups.forEach(function (group) {
                    const groupName = group.dataset.group;
                    const groupItems = document.querySelectorAll(`.user-item[data-name]`);
                    // On cherche les items visibles après le header jusqu'au prochain header
                    let nextEl = group.nextElementSibling;
                    let hasVisible = false;
                    while (nextEl && !nextEl.classList.contains('user-group-header')) {
                        if (nextEl.classList.contains('user-item') && nextEl.style.display !== 'none') {
                            hasVisible = true;
                        }
                        nextEl = nextEl.nextElementSibling;
                    }
                    group.style.display = hasVisible ? '' : 'none';
                });

                userCount.textContent = visibleCount;
                noResults.style.display = visibleCount === 0 ? '' : 'none';
            });
        });
    </script>
{% endblock %}
