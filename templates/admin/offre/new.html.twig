{% extends 'base.html.twig' %}
{% import 'admin/_form_macros.html.twig' as form_ui %}

{% block title %}Nouvelle Offre Financière | Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/admin-forms.css') }}" rel="stylesheet">
{% endblock %}

{% block body_class %}admin-form-page{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'components/_sidebar_admin.html.twig' %}

    <div class="main-content">
        <div class="form-hero theme-teal">
            <a href="{{ path('admin_offre_index') }}" class="back-link"><i class="fas fa-arrow-left"></i> Retour aux offres</a>
            <h1><i class="fas fa-hand-holding-usd me-2" style="color: #B2D944;"></i> Nouvelle Offre Financière</h1>
            <p>Créez une offre attractive pour accompagner les agriculteurs.</p>
        </div>

        <div class="form-card">
            <div class="step-indicator">
                <div class="step active"><span class="step-num">1</span><span class="step-text">Identité</span></div>
                <div class="step active"><span class="step-num">2</span><span class="step-text">Conditions</span></div>
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="section-divider"><span><i class="fas fa-tag me-2"></i>Identité de l'Offre</span></div>
                {{ form_ui.field(form.nomOffre, "Nom de l'Offre", 'icon-teal', {icon: 'fa-bookmark', attr: {class: 'form-control', placeholder: 'Ex: Pack Jeune Agriculteur 2026'}}) }}

                <div class="row">
                    <div class="col-md-6">
                        {{ form_ui.field(form.produitFinancier, 'Produit Financier Associé', 'icon-indigo', {icon: 'fa-boxes', attr: {class: 'form-select'}}) }}
                    </div>
                    <div class="col-md-3">
                        {{ form_ui.field(form.prix, 'Prix Offre (TND)', 'icon-green', {icon: 'fa-money-bill-wave', attr: {class: 'form-control', min: '0.01', step: '0.01'}}) }}
                    </div>
                    <div class="col-md-3">
                        {{ form_ui.field(form.statut, 'Statut', 'icon-amber', {icon: 'fa-toggle-on', attr: {class: 'form-select'}}) }}
                    </div>
                </div>

                <div class="section-divider"><span><i class="fas fa-file-signature me-2"></i>Conditions de l'Offre</span></div>
                {{ form_ui.field(form.conditions, 'Conditions & Détails', 'icon-pink', {icon: 'fa-clipboard-list', attr: {class: 'form-control', rows: 6, placeholder: "Décrivez les conditions d'accès, les avantages, et les critères d'éligibilité..."}}) }}

                <button type="submit" class="btn-submit theme-teal">
                    <i class="fas fa-check-circle me-2"></i> Créer l'Offre Financière
                </button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
