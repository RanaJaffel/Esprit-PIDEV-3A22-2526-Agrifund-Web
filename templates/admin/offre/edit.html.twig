{% extends 'base.html.twig' %}
{% import 'admin/_form_macros.html.twig' as form_ui %}

{% block title %}Modifier {{ offre.nomOffre }} | Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/admin-forms.css') }}" rel="stylesheet">
{% endblock %}

{% block body_class %}admin-form-page{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'components/_sidebar_admin.html.twig' %}

    <div class="main-content">
        <div class="form-hero theme-slate">
            <a href="{{ path('admin_offre_index') }}" class="back-link"><i class="fas fa-arrow-left"></i> Retour aux offres</a>
            <h1><i class="fas fa-pen-fancy me-2" style="color: #E1B323;"></i> Modifier l'Offre</h1>
            <p>Mise à jour des informations de l'offre financière.</p>
        </div>

        <div class="form-card">
            <div class="edit-badge"><i class="fas fa-edit"></i> Édition : {{ offre.nomOffre }}</div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="section-divider"><span><i class="fas fa-tag me-2"></i>Identité de l'Offre</span></div>
                {{ form_ui.field(form.nomOffre, "Nom de l'Offre", 'icon-slate', {icon: 'fa-bookmark', attr: {class: 'form-control'}}) }}

                <div class="row">
                    <div class="col-md-7">
                        {{ form_ui.field(form.produitFinancier, 'Produit Financier', 'icon-indigo', {icon: 'fa-boxes', attr: {class: 'form-select'}}) }}
                    </div>
                    <div class="col-md-5">
                        {{ form_ui.field(form.statut, 'Statut', 'icon-amber', {icon: 'fa-toggle-on', attr: {class: 'form-select'}}) }}
                    </div>
                </div>

                <div class="section-divider"><span><i class="fas fa-file-signature me-2"></i>Conditions</span></div>
                {{ form_ui.field(form.conditions, 'Conditions & Détails', 'icon-pink', {icon: 'fa-clipboard-list', attr: {class: 'form-control', rows: 6}}) }}

                <button type="submit" class="btn-submit theme-slate">
                    <i class="fas fa-save me-2"></i> Mettre à jour l'Offre
                </button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
