{% extends 'base.html.twig' %}
{% block title %}Admin — Capteurs IoT{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('ui/capteur-admin-pro.css') }}">
{% endblock %}

{% block body %}
<div class="iot-page admin-skin capteur-admin-pro">
  <div class="container-fluid py-4">

    {# ===== HERO ===== #}
    <div class="iot-hero hero-admin reveal mb-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="hero-badge">
            <i class="fas fa-shield-halved"></i>
            <div>
              <div class="fw-bold">Admin IoT</div>
              <div class="small opacity-75">Control Center</div>
            </div>
          </div>

          <div>
            <h2 class="iot-hero-title mb-0">
              <i class="fas fa-satellite-dish me-2"></i>
              Administration — Capteurs IoT
            </h2>
            <div class="iot-hero-sub">
              Supervision globale, filtres instantanés, actions rapides.
            </div>
          </div>
        </div>

        {# ✅ ACTIONS DROITE (avec bouton IA) #}
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <span class="iot-pill">
            <span class="iot-dot"></span>
            <span class="fw-semibold">Live</span>
            <span class="opacity-75 small">Simulation</span>
          </span>

          {# ✅ BOUTON IA #}
          <form method="post" action="{{ path('admin_ai_scan') }}" class="m-0">
            <input type="hidden" name="_token" value="{{ csrf_token('ai_scan') }}">
            <button type="submit" class="btn btn-warning btn-iot"
                    onclick="return confirm('Lancer l’analyse IA sur les mesures récentes ?');">
              <i class="fas fa-brain me-2"></i> Lancer analyse IA
            </button>
          </form>

          <a href="{{ path('admin_dashboard') }}" class="btn btn-light btn-iot">
            <i class="fas fa-chart-line me-2"></i> Dashboard
          </a>
        </div>
      </div>
    </div>

    {# ===== FLASH ===== #}
    {% for message in app.flashes('success') %}
      <div class="alert alert-success alert-dismissible fade show reveal" role="alert">
        <strong>Succès :</strong> {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
      <div class="alert alert-danger alert-dismissible fade show reveal" role="alert">
        <strong>Erreur :</strong> {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endfor %}

    {# ===== KPI ===== #}
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-3 reveal">
        <div class="iot-card kpi-pro">
          <div class="iot-card-body">
            <div class="kpi-label"><i class="fas fa-microchip me-1"></i>Total capteurs</div>
            <div class="kpi-value" data-countup="{{ capteurs|length }}">0</div>
            <div class="kpi-sub">tous statuts</div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-3 reveal">
        <div class="iot-card kpi-pro">
          <div class="iot-card-body">
            <div class="kpi-label"><i class="fas fa-circle-check me-1"></i>Actifs</div>
            <div class="kpi-value text-success" data-countup="{{ nbActifs }}">0</div>
            <div class="kpi-sub">en fonctionnement</div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-3 reveal">
        <div class="iot-card kpi-pro">
          <div class="iot-card-body">
            <div class="kpi-label"><i class="fas fa-triangle-exclamation me-1"></i>Inactifs</div>
            <div class="kpi-value text-danger" data-countup="{{ nbInactifs }}">0</div>
            <div class="kpi-sub">à surveiller</div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-3 reveal">
        <div class="iot-card kpi-pro">
          <div class="iot-card-body">
            <div class="kpi-label"><i class="fas fa-seedling me-1"></i>Projets couverts</div>
            <div class="kpi-value text-primary" data-countup="{{ nbProjets }}">0</div>
            <div class="kpi-sub">avec capteurs</div>
          </div>
        </div>
      </div>
    </div>

    {# ===== TOOLBAR ===== #}
    <div class="iot-toolbar reveal p-3 mb-3">
      <div class="row g-2 align-items-center">
        <div class="col-12 col-lg-5">
          <div class="input-group">
            <span class="input-group-text bg-white border-0" style="border-radius:14px 0 0 14px;">
              <i class="fas fa-magnifying-glass"></i>
            </span>
            <input id="capteurSearch" class="form-control toolbar-input border-0"
                   placeholder="Rechercher (ID, type, localisation, modèle, projet...)">
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <select id="capteurFilterStatus" class="form-select toolbar-input">
            <option value="">Tous statuts</option>
            <option value="ACTIF">ACTIF</option>
            <option value="INACTIF">INACTIF</option>
            <option value="EN_PANNE">EN_PANNE</option>
          </select>
        </div>

        <div class="col-6 col-lg-3">
          <select id="capteurFilterType" class="form-select toolbar-input">
            <option value="">Tous types</option>
            <option value="TEMPERATURE">TEMPERATURE</option>
            <option value="HUMIDITE_SOL">HUMIDITE_SOL</option>
            <option value="PH_SOL">PH_SOL</option>
            <option value="PLUVIOMETRIE">PLUVIOMETRIE</option>
            <option value="LUMINOSITE">LUMINOSITE</option>
            <option value="VENT">VENT</option>
          </select>
        </div>

        <div class="col-12 col-lg-1 d-grid">
          <button id="capteurReset" class="btn btn-outline-dark btn-iot">Reset</button>
        </div>
      </div>
    </div>

    {# ===== COMMAND BOARD (remplace le tableau) ===== #}
    <div class="board-grid reveal">

      {# ===== COLONNE ACTIF ===== #}
      <section class="board-col">
        <div class="board-col-head">
          <div class="board-title">
            <span class="chip"><span class="dot active"></span> ACTIFS</span>
            <span class="badge bg-success">Live</span>
          </div>
          <div class="small text-muted">{{ nbActifs }} capteurs</div>
        </div>

        <div class="board-body">
          {% set any = false %}
          {% for capteur in capteurs %}
            {% if capteur.statut == 'ACTIF' %}
              {% set any = true %}

              <div class="sensor-card mb-3 reveal"
                   data-item="capteur"
                   data-status="{{ capteur.statut }}"
                   data-type="{{ capteur.typeCapteur }}"
                   data-blob="#{{ capteur.idCapteur }} {{ capteur.typeCapteur }} {{ capteur.localisation }} {{ capteur.modele }} {{ capteur.idproject }}">
                <div class="sensor-inner">
                  <div class="sensor-h">
                    <div class="sensor-left">
                      <div class="sensor-ic">
                        <i class="fas fa-satellite-dish"></i>
                      </div>
                      <div>
                        <p class="sensor-name">Capteur #{{ capteur.idCapteur }}</p>
                        <div class="sensor-sub">{{ capteur.typeCapteur }} · {{ capteur.localisation }}</div>
                      </div>
                    </div>

                    <div class="text-end">
                      <div class="signal" title="Signal">
                        <span class="on"></span><span class="on"></span><span class="on"></span><span class="on"></span>
                      </div>
                    </div>
                  </div>

                  <div class="sensor-meta">
                    <div class="meta-pill">
                      <span class="text-muted">Projet</span>
                      <span class="fw-semibold">#{{ capteur.idproject ?? '-' }}</span>
                    </div>
                    <div class="meta-pill">
                      <span class="text-muted">Modèle</span>
                      <span class="fw-semibold">{{ capteur.modele }}</span>
                    </div>
                    <div class="meta-pill">
                      <span class="text-muted">Installé</span>
                      <span class="fw-semibold">{{ capteur.dateInstallation ? capteur.dateInstallation|date('d/m/Y') : '-' }}</span>
                    </div>
                    <div class="meta-pill">
                      <span class="text-muted">Statut</span>
                      <span class="fw-semibold text-success">{{ capteur.statut }}</span>
                    </div>
                  </div>

                  <div class="sensor-actions">
                    <a href="{{ path('capteur_dashboard', {idproject: capteur.idproject}) }}"
                       class="btn btn-outline-dark btn-sm btn-iot w-100" title="Dashboard projet">
                      <i class="fas fa-chart-area me-1"></i> Dashboard
                    </a>

                    <a href="{{ path('admin_capteur_edit', {id: capteur.idCapteur}) }}"
                       class="btn btn-outline-warning btn-sm btn-iot" title="Modifier">
                      <i class="fas fa-pen"></i>
                    </a>

                    <form method="post"
                          action="{{ path('admin_capteur_delete', {id: capteur.idCapteur}) }}"
                          onsubmit="return confirm('Supprimer ce capteur ?');"
                          class="m-0">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ capteur.idCapteur) }}">
                      <button class="btn btn-outline-danger btn-sm btn-iot" title="Supprimer">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  </div>

                </div>
              </div>

            {% endif %}
          {% endfor %}

          {% if not any %}
            <div class="text-muted small p-2">Aucun capteur actif.</div>
          {% endif %}
        </div>
      </section>

      {# ===== COLONNE INACTIF ===== #}
      <section class="board-col">
        <div class="board-col-head">
          <div class="board-title">
            <span class="chip"><span class="dot bad"></span> INACTIFS</span>
            <span class="badge bg-secondary">Standby</span>
          </div>
          <div class="small text-muted">{{ nbInactifs }} capteurs</div>
        </div>

        <div class="board-body">
          {% set any = false %}
          {% for capteur in capteurs %}
            {% if capteur.statut == 'INACTIF' %}
              {% set any = true %}

              <div class="sensor-card mb-3 reveal"
                   data-item="capteur"
                   data-status="{{ capteur.statut }}"
                   data-type="{{ capteur.typeCapteur }}"
                   data-blob="#{{ capteur.idCapteur }} {{ capteur.typeCapteur }} {{ capteur.localisation }} {{ capteur.modele }} {{ capteur.idproject }}">
                <div class="sensor-inner">
                  <div class="sensor-h">
                    <div class="sensor-left">
                      <div class="sensor-ic">
                        <i class="fas fa-microchip"></i>
                      </div>
                      <div>
                        <p class="sensor-name">Capteur #{{ capteur.idCapteur }}</p>
                        <div class="sensor-sub">{{ capteur.typeCapteur }} · {{ capteur.localisation }}</div>
                      </div>
                    </div>
                    <span class="chip"><span class="dot bad"></span>{{ capteur.statut }}</span>
                  </div>

                  <div class="sensor-meta">
                    <div class="meta-pill"><span class="text-muted">Projet</span><span class="fw-semibold">#{{ capteur.idproject ?? '-' }}</span></div>
                    <div class="meta-pill"><span class="text-muted">Modèle</span><span class="fw-semibold">{{ capteur.modele }}</span></div>
                    <div class="meta-pill"><span class="text-muted">Installé</span><span class="fw-semibold">{{ capteur.dateInstallation ? capteur.dateInstallation|date('d/m/Y') : '-' }}</span></div>
                    <div class="meta-pill"><span class="text-muted">Statut</span><span class="fw-semibold">{{ capteur.statut }}</span></div>
                  </div>

                  <div class="sensor-actions">
                    <a href="{{ path('capteur_dashboard', {idproject: capteur.idproject}) }}"
                       class="btn btn-outline-dark btn-sm btn-iot w-100">
                      <i class="fas fa-chart-area me-1"></i> Dashboard
                    </a>
                    <a href="{{ path('admin_capteur_edit', {id: capteur.idCapteur}) }}"
                       class="btn btn-outline-warning btn-sm btn-iot">
                      <i class="fas fa-pen"></i>
                    </a>
                    <form method="post" action="{{ path('admin_capteur_delete', {id: capteur.idCapteur}) }}"
                          onsubmit="return confirm('Supprimer ce capteur ?');" class="m-0">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ capteur.idCapteur) }}">
                      <button class="btn btn-outline-danger btn-sm btn-iot"><i class="fas fa-trash"></i></button>
                    </form>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}

          {% if not any %}
            <div class="text-muted small p-2">Aucun capteur inactif.</div>
          {% endif %}
        </div>
      </section>

      {# ===== COLONNE PANNE ===== #}
      <section class="board-col">
        <div class="board-col-head">
          <div class="board-title">
            <span class="chip"><span class="dot bad"></span> EN PANNE</span>
            <span class="badge bg-danger">Alert</span>
          </div>
          <div class="small text-muted">priorité</div>
        </div>

        <div class="board-body">
          {% set any = false %}
          {% for capteur in capteurs %}
            {% if capteur.statut == 'EN_PANNE' %}
              {% set any = true %}
              <div class="sensor-card mb-3 reveal"
                   data-item="capteur"
                   data-status="{{ capteur.statut }}"
                   data-type="{{ capteur.typeCapteur }}"
                   data-blob="#{{ capteur.idCapteur }} {{ capteur.typeCapteur }} {{ capteur.localisation }} {{ capteur.modele }} {{ capteur.idproject }}">
                <div class="sensor-inner">
                  <div class="sensor-h">
                    <div class="sensor-left">
                      <div class="sensor-ic" style="background:linear-gradient(135deg,#ef4444,#b42318);">
                        <i class="fas fa-triangle-exclamation"></i>
                      </div>
                      <div>
                        <p class="sensor-name">Capteur #{{ capteur.idCapteur }}</p>
                        <div class="sensor-sub">{{ capteur.typeCapteur }} · {{ capteur.localisation }}</div>
                      </div>
                    </div>
                    <span class="chip"><span class="dot bad"></span>{{ capteur.statut }}</span>
                  </div>

                  <div class="sensor-meta">
                    <div class="meta-pill"><span class="text-muted">Projet</span><span class="fw-semibold">#{{ capteur.idproject ?? '-' }}</span></div>
                    <div class="meta-pill"><span class="text-muted">Modèle</span><span class="fw-semibold">{{ capteur.modele }}</span></div>
                    <div class="meta-pill"><span class="text-muted">Installé</span><span class="fw-semibold">{{ capteur.dateInstallation ? capteur.dateInstallation|date('d/m/Y') : '-' }}</span></div>
                    <div class="meta-pill"><span class="text-muted">Statut</span><span class="fw-semibold text-danger">{{ capteur.statut }}</span></div>
                  </div>

                  <div class="sensor-actions">
                    <a href="{{ path('admin_capteur_edit', {id: capteur.idCapteur}) }}"
                       class="btn btn-outline-warning btn-sm btn-iot w-100">
                      <i class="fas fa-wrench me-1"></i> Diagnostiquer
                    </a>
                    <form method="post" action="{{ path('admin_capteur_delete', {id: capteur.idCapteur}) }}"
                          onsubmit="return confirm('Supprimer ce capteur ?');" class="m-0">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ capteur.idCapteur) }}">
                      <button class="btn btn-outline-danger btn-sm btn-iot"><i class="fas fa-trash"></i></button>
                    </form>
                  </div>

                </div>
              </div>
            {% endif %}
          {% endfor %}

          {% if not any %}
            <div class="text-muted small p-2">Aucun capteur en panne.</div>
          {% endif %}
        </div>
      </section>

    </div>

  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script defer src="{{ asset('ui/capteur-admin-pro.js') }}"></script>
{% endblock %}