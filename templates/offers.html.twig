{# templates/offers.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Offres Spéciales - AgriFund{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --vert-vif: #089647;
        --vert-fonce: #076A39;
        --vert-tres-fonce: #133D03;
        --vert-clair: #B2D944;
        --jaune: #E1B323;
        --gris: #64748b;
    }

    body {
        background: linear-gradient(135deg, #f8faf5 0%, #fffbf2 100%);
    }

    .promo-header {
        background: linear-gradient(135deg, var(--vert-tres-fonce) 0%, #1a4a04 100%);
        color: white;
        padding: 130px 0 80px;
        text-align: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 50px;
    }

    .promo-header::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 5 L35 15 L30 25 L25 15 Z' fill='%23E1B323' fill-opacity='0.05'/%3E%3C/svg%3E");
    }

    .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

    .offer-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 30px;
        margin-bottom: 80px;
    }

    .offer-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        border: 1px solid rgba(0,0,0,0.05);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .offer-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(225, 179, 35, 0.15);
        border-color: var(--jaune);
    }

    .active-badge {
        position: absolute;
        top: 20px; right: 20px;
        background: #f0fdf4; color: var(--vert-vif);
        padding: 5px 12px; border-radius: 100px;
        font-size: 0.65rem; font-weight: 800; text-transform: uppercase;
        z-index: 10;
        box-shadow: 0 4px 10px rgba(8, 150, 71, 0.1);
    }

    .card-banner {
        height: 120px;
        background: linear-gradient(135deg, var(--jaune) 0%, #D4A817 100%);
        padding: 30px;
        display: flex;
        align-items: flex-end;
    }

    .offer-icon {
        width: 60px; height: 60px;
        background: white; border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: -60px;
        box-shadow: 0 8px 15px rgba(0,0,0,0.08);
        font-size: 1.6rem; color: var(--vert-fonce);
        position: relative; z-index: 5;
    }

    .card-content { padding: 50px 30px 30px; flex: 1; }
    .offer-title { font-size: 1.3rem; font-weight: 800; color: #1e293b; margin-bottom: 15px; }
    
    .product-ref {
        display: flex; align-items: center; gap: 8px;
        background: #f8fafc; padding: 10px 15px; border-radius: 12px;
        font-size: 0.8rem; color: var(--vert-vif); font-weight: 700;
        margin-bottom: 20px;
    }

    .offer-desc { font-size: 0.9rem; color: var(--gris); line-height: 1.6; margin-bottom: 20px; }

    .btn-apply {
        display: block; width: 100%; padding: 14px;
        background: var(--vert-tres-fonce); color: white;
        text-align: center; border-radius: 14px; text-decoration: none;
        font-weight: 700; transition: all 0.3s;
    }
    .btn-apply:hover { background: var(--vert-fonce); color: white; transform: scale(1.02); }

    .urgent-tag {
        display: inline-block; padding: 4px 10px; border-radius: 6px;
        background: #fff7ed; color: #c2410c; font-size: 0.7rem; font-weight: 700;
        margin-bottom: 10px;
    }
</style>
{% endblock %}

{% block content %}
    <header class="promo-header" data-translate-scope>
        <div class="container" style="position: relative; z-index: 2;">
            <span style="background: var(--jaune); color: var(--vert-tres-fonce); padding: 5px 15px; border-radius: 100px; font-weight: 800; font-size: 0.7rem; text-transform: uppercase;">Promotions Actuelles</span>
            <h1 style="font-size: 3rem; font-weight: 900; margin: 15px 0;">Offres Spéciales AgriFund</h1>
            <p style="font-size: 1.1rem; opacity: 0.9; max-width: 600px; margin: 0 auto;">Bénéficiez de conditions préférentielles pour vos investissements saisonniers.</p>
        </div>
    </header>

    {% include 'components/_translation_widget.html.twig' %}

    <div class="container" data-translate-scope>
        <div class="offer-grid">
            {% for o in offers %}
                <div class="offer-card">
                    <div class="active-badge">{{ o.statut }}</div>
                    <div class="card-banner">
                        <div class="offer-icon">
                            <i class="fas fa-gift"></i>
                        </div>
                    </div>
                    <div class="card-content">
                        <span class="urgent-tag"><i class="fas fa-clock me-1"></i> Offre à durée limitée</span>
                        <h3 class="offer-title">{{ o.nomOffre }}</h3>
                        
                        <div class="product-ref">
                            <i class="fas fa-tag"></i> {{ o.produitFinancier.nomProduit }}
                        </div>

                        <p class="offer-desc">{{ o.conditions|slice(0, 150) }}...</p>
                        
                        <a href="{{ path('agriculteur_offre_checkout', {id: o.id}) }}" class="btn-apply">PROFITER DE L'OFFRE</a>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <h4 class="text-muted">Aucune offre spéciale pour le moment.</h4>
                </div>
            {% endfor %}
        </div>

        <!-- Secondary CTA -->
        <div style="background: white; border-radius: 24px; padding: 60px; text-align: center; box-shadow: 0 4px 25px rgba(0,0,0,0.03); margin-bottom: 80px;">
            <h2 style="font-size: 2.2rem; font-weight: 800; color: var(--vert-tres-fonce); margin-bottom: 20px;">Vous ne trouvez pas votre bonheur ?</h2>
            <p style="color: var(--gris); font-size: 1.1rem; margin-bottom: 30px;">Nos conseillers peuvent vous proposer des solutions personnalisées adaptées à votre dossier.</p>
            <a href="{{ path('app_contact') }}" class="btn btn-outline-success px-5 py-3 rounded-4 fw-bold">Contactez un expert</a>
        </div>
    </div>
{% endblock %}
