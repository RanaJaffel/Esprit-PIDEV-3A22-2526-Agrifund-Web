{% extends 'base.html.twig' %}

{% block title %}Historique - Reconnaissance Faciale{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --gris: #848A86;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --vert-clair: #B2D944;
            --olive: #9A951F;
            --vert-olive-fonce: #476C1A;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
        }

        .dashboard-container { display: flex; min-height: 100vh; }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 0;
            background: transparent;
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 991.98px) {
            .main-content { margin-left: 0; }
        }

        /* ==========================================
           HEADER
        ========================================== */
        .page-header {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 50%, var(--vert-tres-fonce) 100%);
            padding: 28px 35px;
            margin: 0 0 30px 0;
            position: relative;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='30' cy='30' r='15' fill='none' stroke='%23B2D944' stroke-opacity='0.05' stroke-width='2'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .page-header h1 {
            color: white;
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .page-header h1 i {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            box-shadow: 0 8px 20px rgba(71, 108, 26, 0.35);
        }

        /* ==========================================
           CONTENT
        ========================================== */
        .content-wrapper {
            padding: 0 35px 35px 35px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.6s ease-out forwards;
            opacity: 0;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair));
        }

        .stat-card:nth-child(1) { animation-delay: 0.1s; }
        .stat-card:nth-child(2) { animation-delay: 0.2s; }
        .stat-card:nth-child(3) { animation-delay: 0.3s; }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 15px;
        }

        .stat-card.success .stat-icon {
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.15), rgba(8, 150, 71, 0.1));
            color: var(--vert-vif);
        }

        .stat-card.danger .stat-icon {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(239, 68, 68, 0.1));
            color: #ef4444;
        }

        .stat-card.info .stat-icon {
            background: linear-gradient(135deg, rgba(71, 108, 26, 0.15), rgba(71, 108, 26, 0.1));
            color: var(--vert-olive-fonce);
        }

        .stat-value {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--vert-tres-fonce);
            margin-bottom: 5px;
        }

        .stat-label {
            color: var(--gris);
            font-size: 0.95rem;
            font-weight: 500;
        }

        /* ==========================================
           HISTORY TABLE
        ========================================== */
        .history-section {
            background: white;
            border-radius: 20px;
            padding: 32px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.6s ease-out 0.4s forwards;
            opacity: 0;
        }

        .history-section::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair), var(--jaune-moutarde));
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--vert-tres-fonce);
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(71, 108, 26, 0.1);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--vert-clair) 0%, var(--vert-olive-fonce) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
            box-shadow: 0 4px 15px rgba(71, 108, 26, 0.25);
        }

        .table-responsive {
            overflow-x: auto;
        }

        .history-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        .history-table thead {
            background: linear-gradient(135deg, rgba(71, 108, 26, 0.05), rgba(178, 217, 68, 0.05));
        }

        .history-table th {
            padding: 16px;
            text-align: left;
            font-weight: 600;
            color: var(--vert-tres-fonce);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid rgba(71, 108, 26, 0.2);
        }

        .history-table tbody tr {
            border-bottom: 1px solid rgba(0, 0, 0, 0.04);
            transition: all 0.3s ease;
        }

        .history-table tbody tr:hover {
            background: linear-gradient(90deg, rgba(71, 108, 26, 0.03) 0%, rgba(178, 217, 68, 0.02) 100%);
            transform: translateX(5px);
        }

        .history-table tbody tr:last-child {
            border-bottom: none;
        }

        .history-table td {
            padding: 16px;
            color: var(--vert-tres-fonce);
            font-size: 0.95rem;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .status-badge.success {
            background: linear-gradient(135deg, rgba(8, 150, 71, 0.15), rgba(8, 150, 71, 0.1));
            color: var(--vert-fonce);
            border: 2px solid var(--vert-vif);
        }

        .status-badge.failed {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(239, 68, 68, 0.1));
            color: #dc2626;
            border: 2px solid #ef4444;
        }

        .confidence-bar-container {
            width: 120px;
            height: 8px;
            background: #e5e7eb;
            border-radius: 4px;
            overflow: hidden;
            position: relative;
        }

        .confidence-bar {
            height: 100%;
            border-radius: 4px;
            transition: width 0.5s ease;
        }

        .confidence-bar.high {
            background: linear-gradient(90deg, var(--vert-vif), var(--vert-clair));
        }

        .confidence-bar.medium {
            background: linear-gradient(90deg, var(--jaune-moutarde), var(--olive));
        }

        .confidence-bar.low {
            background: linear-gradient(90deg, #ef4444, #dc2626);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--gris);
        }

        .empty-state i {
            font-size: 4rem;
            color: rgba(71, 108, 26, 0.2);
            margin-bottom: 20px;
        }

        .empty-state h3 {
            color: var(--vert-tres-fonce);
            margin-bottom: 10px;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 28px;
            background: linear-gradient(135deg, var(--vert-olive-fonce), var(--vert-foret));
            color: white;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(71, 108, 26, 0.25);
            margin-top: 20px;
        }

        .btn-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(71, 108, 26, 0.35);
            color: white;
        }

        /* ==========================================
           RESPONSIVE
        ========================================== */
        @media (max-width: 768px) {
            .content-wrapper {
                padding: 0 20px 20px 20px;
            }

            .page-header {
                padding: 20px;
            }

            .page-header h1 {
                font-size: 1.4rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .history-table {
                font-size: 0.85rem;
            }

            .history-table th,
            .history-table td {
                padding: 12px 8px;
            }

            .confidence-bar-container {
                width: 80px;
            }
        }

        /* ==========================================
           ANIMATIONS
        ========================================== */
        .history-table tbody tr {
            animation: slideIn 0.5s ease-out forwards;
            opacity: 0;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {% if is_granted('ROLE_ADMIN') %}
            {% include 'components/_sidebar_admin.html.twig' %}
        {% elseif is_granted('ROLE_AGRICULTEUR') %}
            {% include 'components/_sidebar_agriculteur.html.twig' %}
        {% elseif is_granted('ROLE_BANQUE') %}
            {% include 'components/_sidebar_banque.html.twig' %}
        {% endif %}
        
        <div class="main-content">
            <div class="page-header">
                <h1>
                    <i class="fas fa-history"></i>
                    Historique - Reconnaissance Faciale
                </h1>
            </div>
            
            <div class="content-wrapper">
                {# ==========================================
                   STATISTIQUES
                ========================================== #}
                <div class="stats-grid">
                    <div class="stat-card success">
                        <div class="stat-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-value">{{ attempts|length }}</div>
                        <div class="stat-label">Tentatives totales</div>
                    </div>

                    <div class="stat-card danger">
                        <div class="stat-icon">
                            <i class="fas fa-times-circle"></i>
                        </div>
                        <div class="stat-value">
                            {{ attempts|filter(a => not a.success)|length }}
                        </div>
                        <div class="stat-label">Échecs</div>
                    </div>

                    <div class="stat-card info">
                        <div class="stat-icon">
                            <i class="fas fa-percentage"></i>
                        </div>
                        <div class="stat-value">{{ successRate|number_format(1) }}%</div>
                        <div class="stat-label">Taux de réussite</div>
                    </div>
                </div>

                {# ==========================================
                   TABLEAU D'HISTORIQUE
                ========================================== #}
                <div class="history-section">
                    <h2 class="section-title">
                        <i class="fas fa-list"></i>
                        Dernières tentatives
                    </h2>

                    {% if attempts is empty %}
                        <div class="empty-state">
                            <i class="fas fa-inbox"></i>
                            <h3>Aucune tentative enregistrée</h3>
                            <p>Vous n'avez pas encore utilisé la reconnaissance faciale.</p>
                            <a href="{{ path('face_setup') }}" class="btn-back">
                                <i class="fas fa-cog"></i>
                                Configurer la reconnaissance faciale
                            </a>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="history-table">
                                <thead>
                                    <tr>
                                        <th>Date & Heure</th>
                                        <th>Résultat</th>
                                        <th>Confiance</th>
                                        <th>Adresse IP</th>
                                        <th>Appareil</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for attempt in attempts %}
                                        <tr style="animation-delay: {{ loop.index * 0.1 }}s">
                                            <td>
                                                <strong>{{ attempt.createdAt|date('d/m/Y') }}</strong>
                                                <br>
                                                <small style="color: var(--gris);">
                                                    {{ attempt.createdAt|date('H:i:s') }}
                                                </small>
                                            </td>
                                            <td>
                                                {% if attempt.success %}
                                                    <span class="status-badge success">
                                                        <i class="fas fa-check-circle"></i>
                                                        Réussi
                                                    </span>
                                                {% else %}
                                                    <span class="status-badge failed">
                                                        <i class="fas fa-times-circle"></i>
                                                        Échoué
                                                    </span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if attempt.confidence %}
                                                    {% set confidencePercent = (attempt.confidence * 100)|round %}
                                                    <div style="display: flex; align-items: center; gap: 10px;">
                                                        <div class="confidence-bar-container">
                                                            <div class="confidence-bar {% if confidencePercent >= 80 %}high{% elseif confidencePercent >= 50 %}medium{% else %}low{% endif %}" 
                                                                 style="width: {{ confidencePercent }}%"></div>
                                                        </div>
                                                        <span style="font-weight: 600; font-size: 0.9rem;">
                                                            {{ confidencePercent }}%
                                                        </span>
                                                    </div>
                                                {% else %}
                                                    <span style="color: var(--gris);">N/A</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <code style="background: rgba(71, 108, 26, 0.1); padding: 4px 8px; border-radius: 6px; font-size: 0.85rem;">
                                                    {{ attempt.ipAddress ?? 'N/A' }}
                                                </code>
                                            </td>
                                            <td>
                                                {% if attempt.userAgent %}
                                                    {% if 'Mobile' in attempt.userAgent %}
                                                        <i class="fas fa-mobile-alt" style="color: var(--vert-olive-fonce);"></i>
                                                        Mobile
                                                    {% elseif 'Tablet' in attempt.userAgent %}
                                                        <i class="fas fa-tablet-alt" style="color: var(--vert-olive-fonce);"></i>
                                                        Tablette
                                                    {% else %}
                                                        <i class="fas fa-desktop" style="color: var(--vert-olive-fonce);"></i>
                                                        Ordinateur
                                                    {% endif %}
                                                {% else %}
                                                    <span style="color: var(--gris);">Inconnu</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <div style="text-align: center; margin-top: 30px;">
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin_profile') }}" class="btn-back">
                                    <i class="fas fa-arrow-left"></i>
                                    Retour au profil
                                </a>
                            {% elseif is_granted('ROLE_AGRICULTEUR') %}
                                <a href="{{ path('agriculteur_profile') }}" class="btn-back">
                                    <i class="fas fa-arrow-left"></i>
                                    Retour au profil
                                </a>
                            {% elseif is_granted('ROLE_BANQUE') %}
                                <a href="{{ path('banque_profile') }}" class="btn-back">
                                    <i class="fas fa-arrow-left"></i>
                                    Retour au profil
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-refresh every 30 seconds
            let autoRefreshEnabled = false;
            let refreshInterval;

            function toggleAutoRefresh() {
                autoRefreshEnabled = !autoRefreshEnabled;
                
                if (autoRefreshEnabled) {
                    refreshInterval = setInterval(() => {
                        window.location.reload();
                    }, 30000);
                    console.log('Auto-refresh activé (30s)');
                } else {
                    clearInterval(refreshInterval);
                    console.log('Auto-refresh désactivé');
                }
            }

            // Keyboard shortcut: Press 'R' to toggle auto-refresh
            document.addEventListener('keydown', function(e) {
                if (e.key === 'r' || e.key === 'R') {
                    if (!e.target.matches('input, textarea')) {
                        toggleAutoRefresh();
                    }
                }
            });

            // Animate confidence bars
            const confidenceBars = document.querySelectorAll('.confidence-bar');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const width = entry.target.style.width;
                        entry.target.style.width = '0%';
                        setTimeout(() => {
                            entry.target.style.width = width;
                        }, 100);
                    }
                });
            }, { threshold: 0.5 });

            confidenceBars.forEach(bar => observer.observe(bar));

            // Add tooltips for user agents
            const userAgentCells = document.querySelectorAll('.history-table tbody td:last-child');
            userAgentCells.forEach(cell => {
                const fullUserAgent = cell.getAttribute('data-user-agent');
                if (fullUserAgent) {
                    cell.title = fullUserAgent;
                }
            });
        });
    </script>
{% endblock %}