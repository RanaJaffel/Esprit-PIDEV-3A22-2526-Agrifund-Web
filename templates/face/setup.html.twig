{% extends 'base.html.twig' %}

{% block title %}Configuration de la reconnaissance faciale - AgriFund{% endblock %}

{% block stylesheets %}
<style>
    .face-setup-container {
        max-width: 900px;
        margin: 50px auto;
        padding: 20px;
    }

    .face-card {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .video-container {
        position: relative;
        background: #000;
        border-radius: 15px;
        overflow: hidden;
        margin: 30px 0;
    }

    #video {
        width: 100%;
        display: block;
    }

    .face-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 300px;
        height: 400px;
        border: 3px dashed #8bc34a;
        border-radius: 50%;
        pointer-events: none;
    }

    .status-badge {
        display: inline-block;
        padding: 8px 20px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .status-badge.active {
        background: #d4edda;
        color: #155724;
    }

    .status-badge.inactive {
        background: #f8d7da;
        color: #721c24;
    }

    .btn-face {
        padding: 15px 40px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 15px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-capture {
        background: linear-gradient(135deg, #3f9e4d, #2d7a3a);
        color: white;
    }

    .btn-capture:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(63, 158, 77, 0.3);
    }

    .btn-capture:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .preview-container {
        margin-top: 30px;
        text-align: center;
    }

    .preview-image {
        max-width: 300px;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
    }

    .instructions {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 15px;
        margin: 20px 0;
    }

    .instructions li {
        margin: 10px 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .stat-card {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        padding: 20px;
        border-radius: 15px;
        text-align: center;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: #3f9e4d;
    }

    .stat-label {
        color: #666;
        margin-top: 5px;
    }
</style>
{% endblock %}

{% block body %}
<div class="face-setup-container">
    <div class="face-card">
        <h1 class="mb-4">
            <i class="bi bi-person-bounding-box"></i>
            Reconnaissance Faciale
        </h1>

        <div class="mb-4">
            <strong>Statut actuel :</strong>
            {% if hasFaceEnrolled %}
                <span class="status-badge active">
                    <i class="bi bi-check-circle-fill"></i> Activé
                </span>
            {% else %}
                <span class="status-badge inactive">
                    <i class="bi bi-x-circle-fill"></i> Non configuré
                </span>
            {% endif %}
        </div>

        {% if not hasFaceEnrolled %}
            <div class="instructions">
                <h5><i class="bi bi-info-circle"></i> Instructions</h5>
                <ul>
                    <li>✅ Positionnez votre visage dans le cadre ovale</li>
                    <li>✅ Assurez-vous d'être dans un endroit bien éclairé</li>
                    <li>✅ Retirez lunettes de soleil et accessoires cachant le visage</li>
                    <li>✅ Regardez directement la caméra</li>
                    <li>✅ Restez immobile lors de la capture</li>
                </ul>
            </div>
        {% endif %}

        <div class="row">
            <div class="col-md-7">
                <div class="video-container">
                    <video id="video" autoplay playsinline></video>
                    <div class="face-overlay"></div>
                    <canvas id="canvas" style="display:none;"></canvas>
                </div>

                <div class="text-center">
                    <div id="status" class="alert alert-info mb-3">
                        <i class="bi bi-camera-video"></i>
                        Démarrage de la caméra...
                    </div>

                    <button id="captureBtn" class="btn btn-face btn-capture" disabled>
                        <i class="bi bi-camera-fill"></i>
                        {% if hasFaceEnrolled %}
                            Mettre à jour mon visage
                        {% else %}
                            Capturer mon visage
                        {% endif %}
                    </button>

                    {% if hasFaceEnrolled %}
                        <button id="deleteBtn" class="btn btn-danger btn-face ms-2">
                            <i class="bi bi-trash-fill"></i>
                            Supprimer les données
                        </button>
                    {% endif %}
                </div>
            </div>

            <div class="col-md-5">
                <div id="preview" class="preview-container"></div>

                {% if hasFaceEnrolled %}
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-value">{{ successRate|number_format(1) }}%</div>
                            <div class="stat-label">Taux de réussite</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-value">{{ recentAttempts|length }}</div>
                            <div class="stat-label">Tentatives récentes</div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <h6>Dernières tentatives</h6>
                        <div class="list-group">
                            {% for attempt in recentAttempts %}
                                <div class="list-group-item">
                                    {% if attempt.success %}
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    {% else %}
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                    {% endif %}
                                    {{ attempt.createdAt|date('d/m/Y H:i') }}
                                    {% if attempt.confidence %}
                                        <small class="text-muted">({{ attempt.confidencePercentage }})</small>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', async function() {
    const video = document.getElementById('video');
    const canvas = document.getElementById('canvas');
    const captureBtn = document.getElementById('captureBtn');
    const deleteBtn = document.getElementById('deleteBtn');
    const status = document.getElementById('status');
    const preview = document.getElementById('preview');
    
    let stream = null;

    // Démarrer la caméra
    try {
        stream = await navigator.mediaDevices.getUserMedia({ 
            video: { 
                width: { ideal: 1280 },
                height: { ideal: 720 },
                facingMode: 'user'
            } 
        });
        
        video.srcObject = stream;
        
        status.className = 'alert alert-success mb-3';
        status.innerHTML = '<i class="bi bi-check-circle-fill"></i> Caméra prête ! Positionnez votre visage dans le cadre.';
        captureBtn.disabled = false;
        
    } catch (err) {
        console.error('Erreur caméra:', err);
        status.className = 'alert alert-danger mb-3';
        status.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> Impossible d\'accéder à la caméra: ' + err.message;
    }

    // Capturer le visage
    captureBtn.addEventListener('click', async function() {
        captureBtn.disabled = true;
        status.className = 'alert alert-warning mb-3';
        status.innerHTML = '<i class="bi bi-hourglass-split"></i> Capture en cours...';
        
        // Capturer l'image
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(video, 0, 0);
        
        const imageBase64 = canvas.toDataURL('image/jpeg', 0.95);
        
        // Afficher l'aperçu
        preview.innerHTML = `
            <h6>Aperçu de la capture</h6>
            <img src="${imageBase64}" class="preview-image" alt="Aperçu">
        `;
        
        try {
            const response = await fetch('{{ path('face_enroll') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ image: imageBase64 })
            });
            
            const result = await response.json();
            
            if (result.success) {
                status.className = 'alert alert-success mb-3';
                status.innerHTML = '<i class="bi bi-check-circle-fill"></i> ✅ ' + (result.message || 'Visage enregistré avec succès !');
                
                // Rediriger après 2 secondes
                setTimeout(() => {
                    window.location.reload();
                }, 2000);
                
            } else {
                status.className = 'alert alert-danger mb-3';
                
                let errorMessage = result.error || 'Erreur inconnue';
                let icon = 'exclamation-triangle-fill';
                
                // Messages personnalisés selon le code d'erreur
                if (result.code === 'NO_FACE') {
                    errorMessage = 'Aucun visage détecté. Assurez-vous d\'être bien visible.';
                    icon = 'person-x-fill';
                } else if (result.code === 'MULTIPLE_FACES') {
                    errorMessage = 'Plusieurs visages détectés. Assurez-vous d\'être seul(e).';
                    icon = 'people-fill';
                } else if (result.code === 'FACE_TOO_SMALL') {
                    errorMessage = 'Visage trop petit. Rapprochez-vous de la caméra.';
                    icon = 'zoom-in';
                }
                
                status.innerHTML = `<i class="bi bi-${icon}"></i> ❌ ${errorMessage}`;
                captureBtn.disabled = false;
            }
            
        } catch (error) {
            console.error('Erreur:', error);
            status.className = 'alert alert-danger mb-3';
            status.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> ❌ Erreur réseau';
            captureBtn.disabled = false;
        }
    });

    // Supprimer les données
    if (deleteBtn) {
        deleteBtn.addEventListener('click', async function() {
            if (!confirm('Êtes-vous sûr de vouloir supprimer vos données faciales ?')) {
                return;
            }
            
            deleteBtn.disabled = true;
            
            try {
                const response = await fetch('{{ path('face_delete') }}', {
                    method: 'POST'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ Données supprimées avec succès');
                    window.location.reload();
                } else {
                    alert('❌ Erreur: ' + result.error);
                    deleteBtn.disabled = false;
                }
                
            } catch (error) {
                alert('❌ Erreur réseau');
                deleteBtn.disabled = false;
            }
        });
    }

    // Nettoyer lors de la fermeture
    window.addEventListener('beforeunload', function() {
        if (stream) {
            stream.getTracks().forEach(track => track.stop());
        }
    });
});
</script>
{% endblock %}