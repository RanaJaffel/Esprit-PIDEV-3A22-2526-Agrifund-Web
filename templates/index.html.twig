{% extends 'base.html.twig' %}

{% block title %}AgriFund - Agricultural Financial Management Platform{% endblock %}

{% block content %}
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    
    .hero-section {
        background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%);
        color: white;
        padding: 100px 20px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    
    .hero-section::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: rgba(255,255,255,.05);
        border-radius: 50%;
    }
    
    .hero-section h1 {
        font-size: 48px;
        font-weight: 800;
        margin-bottom: 20px;
        text-shadow: 2px 2px 4px rgba(0,0,0,.2);
        animation: fadeInDown 0.8s ease;
    }
    
    .hero-section p {
        font-size: 20px;
        margin-bottom: 40px;
        opacity: 0.95;
        animation: fadeInUp 0.8s ease 0.2s both;
    }
    
    .hero-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
        animation: fadeInUp 0.8s ease 0.4s both;
    }
    
    .btn {
        padding: 15px 40px;
        border: none;
        border-radius: 50px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }
    
    .btn-primary {
        background: white;
        color: #1B7E4C;
        box-shadow: 0 10px 30px rgba(0,0,0,.2);
    }
    
    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(0,0,0,.3);
    }
    
    .btn-secondary {
        background: rgba(255,255,255,.2);
        color: white;
        border: 2px solid white;
    }
    
    .btn-secondary:hover {
        background: white;
        color: #1B7E4C;
    }
    
    .features-section {
        padding: 80px 20px;
        background: #f8f9fa;
    }
    
    .features-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
    }
    
    .feature-card {
        background: white;
        padding: 40px 30px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,.08);
        transition: all 0.3s ease;
    }
    
    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(27,126,76,.15);
    }
    
    .feature-card i {
        font-size: 48px;
        color: #1B7E4C;
        margin-bottom: 20px;
    }
    
    .feature-card h3 {
        color: #1B7E4C;
        margin-bottom: 15px;
        font-size: 20px;
    }
    
    .feature-card p {
        color: #666;
        line-height: 1.6;
    }
    
    .cta-section {
        background: linear-gradient(135deg, #0D5C3F 0%, #1B7E4C 100%);
        color: white;
        padding: 80px 20px;
        text-align: center;
    }
    
    .cta-section h2 {
        font-size: 36px;
        margin-bottom: 20px;
    }
    
    .cta-section p {
        font-size: 18px;
        margin-bottom: 40px;
        opacity: 0.9;
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 30px;
        margin: 60px auto;
        max-width: 1000px;
    }
    
    .stat-box {
        background: rgba(255,255,255,.1);
        padding: 30px 20px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,.2);
    }
    
    .stat-number {
        font-size: 36px;
        font-weight: bold;
        margin-bottom: 10px;
    }
    
    .stat-label {
        opacity: 0.9;
    }
    
    @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @media (max-width: 768px) {
        .hero-section h1 { font-size: 32px; }
        .hero-section p { font-size: 16px; }
        .features-grid { grid-template-columns: 1fr; }
    }
</style>

<!-- Hero Section -->
<div class="hero-section">
    <h1>🌾 AgriFund</h1>
    <p>Complete Agricultural Financial Management Platform</p>
    
    <div class="hero-buttons">
        <a href="{{ path('app_products') }}" class="btn btn-primary">View Products</a>
        <a href="{{ path('app_offers') }}" class="btn btn-secondary">Explore Offers</a>
    </div>
</div>

<!-- Stats Section -->
<div style="background: white; padding: 60px 20px;">
    <div class="stats-grid">
        <div class="stat-box" style="background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); color: white; border: none;">
            <div class="stat-number">10+</div>
            <div class="stat-label">Financial Products</div>
        </div>
        <div class="stat-box" style="background: linear-gradient(135deg, #F4C430 0%, #E8B820 100%); color: #333; border: none;">
            <div class="stat-number">10+</div>
            <div class="stat-label">Active Offers</div>
        </div>
        <div class="stat-box" style="background: linear-gradient(135deg, #0D5C3F 0%, #1B7E4C 100%); color: white; border: none;">
            <div class="stat-number">100%</div>
            <div class="stat-label">Tunisian Focus</div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="features-section">
    <div style="text-align: center; margin-bottom: 60px;">
        <h2 style="color: #1B7E4C; font-size: 36px; margin-bottom: 20px;">Why Choose AgriFund?</h2>
        <p style="color: #666; font-size: 18px;">Complete solution for agricultural financing</p>
    </div>
    
    <div class="features-grid">
        <div class="feature-card">
            <i class="fa fa-cube"></i>
            <h3>Financial Products</h3>
            <p>Access various financial products including loans, credits, leasing, subsidies, and microfinance options tailored for agricultural sector.</p>
        </div>
        
        <div class="feature-card">
            <i class="fa fa-gift"></i>
            <h3>Special Offers</h3>
            <p>Benefit from exclusive seasonal offers and promotions designed to support farmers and agricultural entrepreneurs.</p>
        </div>
        
        <div class="feature-card">
            <i class="fa fa-shield"></i>
            <h3>Secure & Reliable</h3>
            <p>Enterprise-grade security with role-based access control and comprehensive audit trails for complete transparency.</p>
        </div>
        
        <div class="feature-card">
            <i class="fa fa-mobile"></i>
            <h3>Responsive Design</h3>
            <p>Access from any device - manage your financial portfolio on desktop, tablet, or mobile with full functionality.</p>
        </div>
        
        <div class="feature-card">
            <i class="fa fa-users"></i>
            <h3>Support Team</h3>
            <p>Dedicated support team ready to help with product selection, application process, and ongoing management.</p>
        </div>
        
        <div class="feature-card">
            <i class="fa fa-leaf"></i>
            <h3>Sustainable Growth</h3>
            <p>Supporting agricultural development through accessible financing solutions that promote sustainable farming practices.</p>
        </div>
    </div>
</div>

<!-- CTA Section -->
<div class="cta-section">
    <h2>Ready to Grow Your Agricultural Business?</h2>
    <p>Start exploring our financial products and special offers today</p>
    
    <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <a href="{{ path('app_products') }}" class="btn btn-primary">View All Products</a>
        <a href="{{ path('app_offers') }}" class="btn btn-secondary">Browse Offers</a>
        {% if not app.user %}<a href="{{ path('app_login') }}" class="btn btn-secondary">Admin Login</a>{% endif %}
    </div>
</div>

{% endblock %}
