{# templates/components/_sidebar_admin.html.twig #}

<aside class="admin-sidebar" id="sidebar">
    
    {# Background Effects #}
    <div class="sidebar-bg-effects">
        <div class="sidebar-glow"></div>
        <div class="sidebar-pattern"></div>
        <div class="sidebar-particles">
            <span></span><span></span><span></span>
            <span></span><span></span>
        </div>
    </div>

    {# Header #}
    <div class="sidebar-header">
        <div class="brand-logo">
            <div class="logo-icon">
                <i class="fas fa-seedling"></i>
                <div class="logo-pulse"></div>
            </div>
            <div class="logo-text">
                <span class="brand-name">AgriFund</span>
                <span class="brand-type">
                    <i class="fas fa-shield-alt"></i>
                    Admin Panel
                </span>
            </div>
        </div>
        <button class="sidebar-toggle-btn d-lg-none" id="sidebarClose">
            <i class="fas fa-times"></i>
        </button>
    </div>

    {# User Card #}
    <div class="sidebar-user-section">
        <div class="user-card">
            <div class="user-avatar-wrapper">
                <div class="user-avatar">
                    {% if app.user.photo %}
                        <img src="{{ asset(app.user.photo) }}" 
                             alt="{{ app.user.nomComplet }}">
                    {% else %}
                        <div class="avatar-placeholder">
                            {{ app.user.prenom|slice(0,1)|upper }}
                            {{ app.user.nom|slice(0,1)|upper }}
                        </div>
                    {% endif %}
                </div>
                <span class="user-status online">
                    <i class="fas fa-circle"></i>
                </span>
            </div>
            <div class="user-details">
                <h6 class="user-name">{{ app.user.nomComplet }}</h6>
                <span class="user-role admin">
                    <i class="fas fa-shield-alt"></i>
                    Administrateur
                </span>
            </div>
            <a href="{{ path('admin_profile_show') }}" 
               class="user-action-btn" title="Mon profil">
                <i class="fas fa-cog"></i>
            </a>
        </div>
    </div>

    {# Navigation #}
    <nav class="sidebar-nav">

        {# Principal #}
        <div class="nav-section">
            <span class="nav-section-title">
                <span class="section-line"></span>
                Principal
                <span class="section-line"></span>
            </span>
            <ul class="nav-menu">
                <li class="nav-item 
                    {{ app.request.get('_route') == 'admin_dashboard' 
                       ? 'active' : '' }}">
                    <a href="{{ path('admin_dashboard') }}" 
                       class="nav-link" data-tooltip="Tableau de bord">
                        <span class="nav-icon">
                            <i class="fas fa-chart-line"></i>
                        </span>
                        <span class="nav-text">Tableau de bord</span>
                        <span class="nav-indicator"></span>
                    </a>
                </li>
            </ul>
        </div>

        {# Gestion #}
        <div class="nav-section">
            <span class="nav-section-title">
                <span class="section-line"></span>
                Gestion
                <span class="section-line"></span>
            </span>
            <ul class="nav-menu">

                <li class="nav-item 
                    {{ app.request.get('_route') starts with 'admin_users' 
                       ? 'active' : '' }}">
                    <a href="{{ path('admin_users_index') }}" 
                       class="nav-link" data-tooltip="Utilisateurs">
                        <span class="nav-icon">
                            <i class="fas fa-users"></i>
                        </span>
                        <span class="nav-text">Utilisateurs</span>
                        <span class="nav-indicator"></span>
                    </a>
                </li>

                <li class="nav-item 
                    {{ app.request.get('_route') starts with 'admin_agriculteurs' 
                       ? 'active' : '' }}">
                    <a href="{{ path('admin_agriculteurs_index') }}" 
                       class="nav-link" data-tooltip="Agriculteurs">
                        <span class="nav-icon">
                            <i class="fas fa-tractor"></i>
                        </span>
                        <span class="nav-text">Agriculteurs</span>
                        <span class="nav-indicator"></span>
                    </a>
                </li>

                <li class="nav-item 
                    {{ app.request.get('_route') starts with 'admin_banques' 
                       ? 'active' : '' }}">
                    <a href="{{ path('admin_banques_index') }}" 
                       class="nav-link" data-tooltip="Banques">
                        <span class="nav-icon">
                            <i class="fas fa-university"></i>
                        </span>
                        <span class="nav-text">Banques</span>
                        <span class="nav-indicator"></span>
                    </a>
                </li>

                <li class="nav-item 
                    {{ app.request.get('_route') starts with 'admin_documents' 
                       ? 'active' : '' }}">
                    <a href="{{ path('admin_documents_index') }}" 
                       class="nav-link" data-tooltip="Documents">
                        <span class="nav-icon">
                            <i class="fas fa-file-alt"></i>
                        </span>
                        <span class="nav-text">Documents</span>
                        <span class="nav-indicator"></span>
                    </a>
                </li>

            </ul>
        </div>

        {# IoT & Surveillance #}
        <div class="nav-section">
            <span class="nav-section-title">
                <span class="section-line"></span>
                IoT & Surveillance
                <span class="section-line"></span>
            </span>
            <ul class="nav-menu">

                <li class="nav-item 
                    {{ app.request.get('_route') starts with 'admin_capteur' 
                       ? 'active' : '' }}">
                    <a href="{{ path('admin_capteur_index') }}" 
                       class="nav-link iot-link" data-tooltip="Capteurs IoT">
                        <span class="nav-icon iot-icon">
                            <i class="fas fa-satellite-dish"></i>
                            <span class="iot-pulse"></span>
                        </span>
                        <span class="nav-text">Capteurs IoT</span>
                        <span class="nav-badge iot-badge">
                            <i class="fas fa-circle fa-xs"></i> Live
                        </span>
                        <span class="nav-indicator"></span>
                    </a>
                </li>
                <li class="nav-item 
    {{ app.request.get('_route') starts with 'admin_releve_terrain'
       ? 'active' : '' }}">
    <a href="{{ path('admin_releve_terrain') }}"
       class="nav-link" data-tooltip="Relevés terrain">
        <span class="nav-icon">
            <i class="fas fa-wave-square"></i>
        </span>
        <span class="nav-text">Relevés terrain</span>

        {# badge optionnel "7j" (rétention) #}
        <span class="nav-badge iot-badge">
            7j
        </span>

        <span class="nav-indicator"></span>
    </a>
</li>

                <li class="nav-item 
    {{ app.request.get('_route') starts with 'admin_rapport_journalier'
       ? 'active' : '' }}">
    <a href="{{ path('admin_rapport_journalier') }}"
       class="nav-link" data-tooltip="Rapports journaliers">
        <span class="nav-icon">
            <i class="fas fa-chart-bar"></i>
        </span>
        <span class="nav-text">Rapports journaliers</span>
        <span class="nav-badge iot-badge">Daily</span>
        <span class="nav-indicator"></span>
    </a>
</li>
<li class="nav-item
    {{ app.request.get('_route') starts with 'admin_releve_hebdo'
       ? 'active' : '' }}">
    <a href="{{ path('admin_releve_hebdo') }}"
       class="nav-link" data-tooltip="Relevés hebdomadaires">
        <span class="nav-icon">
            <i class="fas fa-calendar-alt"></i>
        </span>
        <span class="nav-text">Relevés Hebdomadaires</span>
        <span class="nav-badge iot-badge">AI Ready</span>
        <div class="nav-indicator"></div>
    </a>
</li>

            </ul>
        </div>

        {# Communication #}
        <div class="nav-section">
            <span class="nav-section-title">
                <span class="section-line"></span>
                Communication
                <span class="section-line"></span>
            </span>
            <ul class="nav-menu">

                <li class="nav-item 
                    {{ app.request.get('_route') starts with 'admin_messagerie' 
                       ? 'active' : '' }}">
                    <a href="{{ path('admin_messagerie_index') }}" 
                       class="nav-link" data-tooltip="Messagerie">
                        <span class="nav-icon">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <span class="nav-text">Messagerie</span>
                        <span class="nav-badge notification" 
                              id="unread-messages-badge" 
                              style="display:none;">0</span>
                        <span class="nav-indicator"></span>
                    </a>
                </li>

            </ul>
        </div>

        {# Paramètres #}
        <div class="nav-section">
            <span class="nav-section-title">
                <span class="section-line"></span>
                Paramètres
                <span class="section-line"></span>
            </span>
            <ul class="nav-menu">

                <li class="nav-item 
                    {{ app.request.get('_route') starts with 'admin_profile' 
                       ? 'active' : '' }}">
                    <a href="{{ path('admin_profile_show') }}" 
                       class="nav-link" data-tooltip="Mon profil">
                        <span class="nav-icon">
                            <i class="fas fa-user-cog"></i>
                        </span>
                        <span class="nav-text">Mon profil</span>
                        <span class="nav-indicator"></span>
                    </a>
                </li>

            </ul>
        </div>

        <div class="nav-section">
            <span class="nav-section-title">Projets</span>
            <ul class="nav-menu">
                <li class="nav-item {{ app.request.get('_route') starts with 'admin_project_agricole' ? 'active' : '' }}">
                    <a href="{{ path('admin_project_agricole_index') }}" class="nav-link">
                        <span class="nav-icon">
                            <i class="fas fa-leaf"></i>
                        </span>
                        <span class="nav-text">Projets Agricoles</span>
                        <span class="nav-indicator"></span>
                    </a>
                </li>

                <li class="nav-item {{ app.request.get('_route') starts with 'admin_ressource_project' ? 'active' : '' }}">
                    <a href="{{ path('admin_ressource_project_index') }}" class="nav-link">
                        <span class="nav-icon">
                            <i class="fas fa-tools"></i>
                        </span>
                        <span class="nav-text">Ressources Projets</span>
                        <span class="nav-indicator"></span>
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    {# Footer #}
    <div class="sidebar-footer">
        <div class="system-status">
            <div class="status-dot online"></div>
            <span>Système opérationnel</span>
        </div>
        <a href="{{ path('app_logout') }}" class="logout-btn">
            <span class="logout-icon">
                <i class="fas fa-sign-out-alt"></i>
            </span>
            <span class="logout-text">Déconnexion</span>
            <i class="fas fa-arrow-right logout-arrow"></i>
        </a>
        <div class="sidebar-version">
            <i class="fas fa-leaf"></i>
            AgriFund Smart v2.0
        </div>
    </div>

</aside>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<style>
:root {
    --sidebar-width: 285px;
    --vert-vif: #089647;
    --vert-fonce: #076A39;
    --vert-foret: #095032;
    --vert-tres-fonce: #133D03;
    --jaune-moutarde: #E1B323;
    --vert-clair: #B2D944;
    --olive: #9A951F;
    --vert-olive-fonce: #476C1A;
    --gris: #848A86;
}

/* ============================================
   SIDEBAR BASE
============================================ */
.admin-sidebar {
    position: fixed;
    top: 0; left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    background: linear-gradient(
        180deg, 
        #0a1f0a 0%, 
        #0d2e0d 30%,
        #0f3d0f 60%,
        #0a2a0a 100%
    );
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    box-shadow: 4px 0 30px rgba(0,0,0,0.3);
}

/* Background Effects */
.sidebar-bg-effects {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
}

.sidebar-glow {
    position: absolute;
    top: -100px; left: -100px;
    width: 400px; height: 400px;
    background: radial-gradient(
        circle, 
        rgba(8,150,71,0.15) 0%, 
        transparent 70%
    );
    animation: glowFloat 8s ease-in-out infinite;
}

.sidebar-glow::after {
    content: '';
    position: absolute;
    bottom: -200px; right: -100px;
    width: 300px; height: 300px;
    background: radial-gradient(
        circle,
        rgba(178,217,68,0.08) 0%,
        transparent 70%
    );
    animation: glowFloat 12s ease-in-out infinite reverse;
}

@keyframes glowFloat {
    0%,100% { transform: translate(0,0) scale(1); }
    33% { transform: translate(30px,20px) scale(1.1); }
    66% { transform: translate(-20px,30px) scale(0.9); }
}

.sidebar-pattern {
    position: absolute;
    inset: 0;
    background-image: 
        radial-gradient(circle at 20% 30%, 
            rgba(178,217,68,0.03) 0%, transparent 50%),
        url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 2 L22 10 L20 18 L18 10 Z' fill='%23B2D944' fill-opacity='0.02'/%3E%3C/svg%3E");
    background-size: auto, 40px 40px;
}

.sidebar-particles span {
    position: absolute;
    width: 3px; height: 3px;
    background: var(--vert-clair);
    border-radius: 50%;
    opacity: 0.3;
    animation: particleFloat linear infinite;
}

.sidebar-particles span:nth-child(1) {
    left: 20%; top: 20%;
    animation-duration: 6s;
    animation-delay: 0s;
}
.sidebar-particles span:nth-child(2) {
    left: 60%; top: 40%;
    animation-duration: 8s;
    animation-delay: 1s;
    width: 2px; height: 2px;
}
.sidebar-particles span:nth-child(3) {
    left: 80%; top: 60%;
    animation-duration: 7s;
    animation-delay: 2s;
}
.sidebar-particles span:nth-child(4) {
    left: 30%; top: 70%;
    animation-duration: 9s;
    animation-delay: 0.5s;
    width: 4px; height: 4px;
}
.sidebar-particles span:nth-child(5) {
    left: 50%; top: 85%;
    animation-duration: 5s;
    animation-delay: 1.5s;
}

@keyframes particleFloat {
    0% { transform: translateY(0) scale(1); opacity: 0.3; }
    50% { opacity: 0.6; }
    100% { transform: translateY(-100px) scale(0); opacity: 0; }
}

/* ============================================
   HEADER
============================================ */
.sidebar-header {
    position: relative;
    z-index: 1;
    padding: 22px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: rgba(0,0,0,0.15);
}

.brand-logo {
    display: flex;
    align-items: center;
    gap: 14px;
}

.logo-icon {
    position: relative;
    width: 50px; height: 50px;
    background: linear-gradient(
        135deg, 
        var(--vert-clair) 0%, 
        var(--vert-vif) 50%,
        var(--vert-fonce) 100%
    );
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
        0 8px 25px rgba(8,150,71,0.4),
        0 0 0 1px rgba(178,217,68,0.2),
        inset 0 1px 0 rgba(255,255,255,0.2);
    transition: all 0.3s ease;
    cursor: pointer;
}

.logo-icon:hover {
    transform: rotate(-8deg) scale(1.08);
    box-shadow: 
        0 12px 35px rgba(8,150,71,0.5),
        0 0 0 2px rgba(178,217,68,0.4);
}

.logo-icon i {
    font-size: 1.5rem;
    color: white;
    z-index: 1;
}

.logo-pulse {
    position: absolute;
    inset: -4px;
    border-radius: 18px;
    border: 2px solid var(--vert-clair);
    opacity: 0;
    animation: logoPulse 3s ease-in-out infinite;
}

@keyframes logoPulse {
    0%,100% { opacity: 0; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(1.05); }
}

.logo-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.brand-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: white;
    letter-spacing: 0.5px;
    line-height: 1;
}

.brand-type {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.68rem;
    color: var(--jaune-moutarde);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    font-weight: 600;
}

.brand-type i {
    font-size: 0.6rem;
}

.sidebar-toggle-btn {
    width: 36px; height: 36px;
    border: none;
    background: rgba(255,255,255,0.08);
    border-radius: 10px;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.sidebar-toggle-btn:hover {
    background: rgba(255,255,255,0.15);
    transform: rotate(90deg);
}

/* ============================================
   USER SECTION
============================================ */
.sidebar-user-section {
    position: relative;
    z-index: 1;
    padding: 16px 20px;
}

.user-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: rgba(255,255,255,0.05);
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.07);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    cursor: pointer;
}

.user-card:hover {
    background: rgba(255,255,255,0.09);
    border-color: rgba(178,217,68,0.2);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.2);
}

.user-avatar-wrapper {
    position: relative;
    flex-shrink: 0;
}

.user-avatar {
    width: 46px; height: 46px;
    border-radius: 13px;
    overflow: hidden;
    background: linear-gradient(
        135deg, 
        var(--jaune-moutarde) 0%, 
        var(--olive) 100%
    );
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
        0 4px 15px rgba(0,0,0,0.25),
        0 0 0 2px rgba(225,179,35,0.3);
}

.user-avatar img {
    width: 100%; height: 100%;
    object-fit: cover;
}

.avatar-placeholder {
    font-size: 1rem;
    font-weight: 700;
    color: white;
}

.user-status {
    position: absolute;
    bottom: -2px; right: -2px;
    width: 13px; height: 13px;
    border-radius: 50%;
    border: 2.5px solid #0d2e0d;
    display: flex;
    align-items: center;
    justify-content: center;
}

.user-status.online {
    background: var(--vert-clair);
    box-shadow: 0 0 8px rgba(178,217,68,0.6);
}

.user-status i {
    font-size: 0.4rem;
    color: white;
}

.user-details {
    flex: 1;
    min-width: 0;
}

.user-name {
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0 0 4px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.user-role {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 20px;
}

.user-role.admin {
    background: rgba(225,179,35,0.15);
    color: var(--jaune-moutarde);
    border: 1px solid rgba(225,179,35,0.2);
}

.user-action-btn {
    width: 32px; height: 32px;
    border-radius: 9px;
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    flex-shrink: 0;
    font-size: 0.85rem;
}

.user-action-btn:hover {
    background: var(--jaune-moutarde);
    color: white;
    transform: rotate(90deg);
    box-shadow: 0 4px 15px rgba(225,179,35,0.3);
}

/* ============================================
   NAVIGATION
============================================ */
.sidebar-nav {
    position: relative;
    z-index: 1;
    flex: 1;
    overflow-y: auto;
    padding: 8px 0 16px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
}

.sidebar-nav::-webkit-scrollbar {
    width: 3px;
}
.sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
}
.sidebar-nav::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.1);
    border-radius: 2px;
}

.nav-section {
    padding: 0 14px;
    margin-bottom: 6px;
}

.nav-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.25);
    font-weight: 700;
    padding: 14px 10px 8px;
}

.section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
        90deg, 
        transparent, 
        rgba(255,255,255,0.1), 
        transparent
    );
}

.nav-menu {
    list-style: none;
    margin: 0;
    padding: 0;
}

.nav-item {
    margin-bottom: 3px;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border-radius: 13px;
    text-decoration: none !important;
    color: rgba(255,255,255,0.6);
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    position: relative;
    overflow: hidden;
}

.nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg, 
        rgba(8,150,71,0.15), 
        rgba(178,217,68,0.05)
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 13px;
}

.nav-link:hover {
    color: white !important;
    background: rgba(255,255,255,0.06);
    transform: translateX(5px);
}

.nav-link:hover::before {
    opacity: 1;
}

.nav-item.active .nav-link {
    color: white !important;
    background: linear-gradient(
        90deg, 
        rgba(8,150,71,0.25), 
        rgba(178,217,68,0.08)
    );
    border: 1px solid rgba(178,217,68,0.15);
}

.nav-item.active .nav-link::before {
    opacity: 1;
}

.nav-icon {
    position: relative;
    width: 38px; height: 38px;
    border-radius: 11px;
    background: rgba(255,255,255,0.07);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    flex-shrink: 0;
}

.nav-link:hover .nav-icon {
    background: rgba(255,255,255,0.12);
    transform: scale(1.1);
}

