{# templates/components/_sidebar_agriculteur.html.twig #}
<aside class="client-sidebar" id="sidebar">
    <!-- Sidebar Background Effects -->
    <div class="sidebar-bg-effects">
        <div class="sidebar-glow"></div>
        <div class="sidebar-pattern"></div>
    </div>

    <!-- Sidebar Header -->
    <div class="sidebar-header">
        <div class="brand-logo">
            <div class="logo-icon">
                <i class="fas fa-leaf"></i>
            </div>
            <div class="logo-text">
                <span class="brand-name">AgriFund</span>
                <span class="brand-type">Client Portal</span>
            </div>
        </div>
        <button class="d-lg-none border-0 bg-transparent text-white fs-4" id="sidebarToggle">
            <i class="fas fa-bars"></i>
        </button>
    </div>

    <!-- User Section (Glassmorphism) -->
    <div class="sidebar-user-section">
        <div class="user-card-glass">
            <div class="user-avatar-wrapper">
                <img src="{{ app.user.photo ? asset(app.user.photo) : 'https://ui-avatars.com/api/?name=' ~ app.user.nomComplet ~ '&background=b2d944&color=fff' }}" class="user-avatar" alt="User">
                <span class="status-indicator online"></span>
            </div>
            <div class="user-info">
                <span class="name">{{ app.user.nomComplet|default('Agriculteur') }}</span>
                <span class="role"><i class="fas fa-check-circle me-1"></i>Vérifié</span>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav">
        <div class="nav-group">
            <span class="nav-group-title">Menu Principal</span>
            <ul class="nav-list">
                <li class="nav-item">
                    <a href="{{ path('agriculteur_dashboard') }}" class="nav-link {{ app.request.get('_route') == 'agriculteur_dashboard' ? 'active' : '' }}">
                        <i class="fas fa-th-large"></i>
                        <span>Tableau de Bord</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('agriculteur_produits') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_produit' ? 'active' : '' }}">
                        <i class="fas fa-shopping-basket"></i>
                        <span>Marketplace</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('agriculteur_offres') }}" class="nav-link {{ app.request.get('_route') == 'agriculteur_offres' ? 'active' : '' }}">
                        <i class="fas fa-percentage"></i>
                        <span>Offres Spéciales</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="nav-group">
            <span class="nav-group-title">Mon Dossier</span>
            <ul class="nav-list">
                <li class="nav-item">
                    <a href="{{ path('agriculteur_documents_index') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_documents' ? 'active' : '' }}">
                        <i class="fas fa-folder-open"></i>
                        <span>Mes Documents</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('agriculteur_messagerie_index') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_messagerie' ? 'active' : '' }}">
                        <i class="fas fa-comment-dots"></i>
                        <span>Messagerie</span>
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Footer -->
    <div class="sidebar-footer">
        <a href="{{ path('app_logout') }}" class="logout-link">
            <i class="fas fa-sign-out-alt"></i>
            <span>Déconnexion</span>
        </a>
    </div>
</aside>

<style>
    .client-sidebar {
        width: var(--sidebar-width);
        height: 100vh;
        background: var(--sidebar-gradient);
        position: fixed;
        left: 0;
        top: 0;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        color: white;
        overflow: hidden;
    }

    .sidebar-bg-effects { position: absolute; inset: 0; pointer-events: none; }
    .sidebar-glow {
        position: absolute;
        top: -50%; left: -50%; width: 200%; height: 200%;
        background: radial-gradient(circle at 30% 20%, rgba(178, 217, 68, 0.1) 0%, transparent 60%);
        animation: glowPulse 20s ease-in-out infinite alternate;
    }
    @keyframes glowPulse { from { transform: rotate(0deg); } to { transform: rotate(180deg); } }
    
    .sidebar-pattern {
        position: absolute; inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 5 L35 15 L30 25 L25 15 Z' fill='%23B2D944' fill-opacity='0.03'/%3E%3C/svg%3E");
    }

    .sidebar-header {
        padding: 30px 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        z-index: 2;
    }

    .brand-logo { display: flex; align-items: center; gap: 15px; }
    .logo-icon {
        width: 45px; height: 45px;
        background: linear-gradient(135deg, var(--vert-clair), var(--vert-vif));
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }
    .brand-name { font-size: 1.4rem; font-weight: 800; }
    .brand-type { display: block; font-size: 0.65rem; color: var(--vert-clair); text-transform: uppercase; letter-spacing: 2px; }

    .sidebar-user-section { padding: 0 20px 25px; position: relative; z-index: 2; }
    .user-card-glass {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 15px;
        display: flex; align-items: center; gap: 12px;
        transition: transform 0.3s ease;
    }
    .user-card-glass:hover { transform: translateY(-3px); background: rgba(255, 255, 255, 0.12); }
    
    .user-avatar-wrapper { position: relative; }
    .user-avatar { width: 45px; height: 45px; border-radius: 12px; object-fit: cover; }
    .status-indicator {
        position: absolute; bottom: -2px; right: -2px;
        width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--vert-foret);
    }
    .status-indicator.online { background: var(--vert-clair); box-shadow: 0 0 10px var(--vert-clair); }

    .user-info .name { display: block; font-weight: 700; font-size: 0.9rem; margin-bottom: 2px; }
    .user-info .role { font-size: 0.7rem; color: var(--vert-clair); font-weight: 600; text-transform: uppercase; }

    .sidebar-nav { flex: 1; overflow-y: auto; padding: 0 10px; position: relative; z-index: 2; }
    .nav-group-title {
        display: block; padding: 15px 15px 8px;
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.4;
    }
    .nav-list { list-style: none; padding: 0; margin: 0; }
    .nav-link {
        display: flex; align-items: center; gap: 15px;
        padding: 12px 15px; border-radius: 15px;
        color: rgba(255, 255, 255, 0.7); font-weight: 500;
        text-decoration: none; transition: var(--transition-smooth);
    }
    .nav-link i { font-size: 1.1rem; width: 24px; text-align: center; }
    .nav-link:hover { background: rgba(255, 255, 255, 0.08); color: white; transform: translateX(5px); }
    .nav-link.active {
        background: linear-gradient(90deg, rgba(178, 217, 68, 0.2), transparent);
        border-left: 3px solid var(--vert-clair);
        color: white;
    }

    .sidebar-footer { padding: 25px; border-top: 1px solid rgba(255, 255, 255, 0.05); position: relative; z-index: 2; }
    .logout-link {
        display: flex; align-items: center; gap: 12px;
        color: #fca5a5; text-decoration: none; font-weight: 600;
        padding: 12px; border-radius: 12px; transition: var(--transition-smooth);
    }
    .logout-link:hover { background: rgba(239, 68, 68, 0.1); color: #f87171; }
</style>