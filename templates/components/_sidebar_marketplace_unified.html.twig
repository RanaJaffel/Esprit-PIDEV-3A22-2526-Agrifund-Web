{% set navRole = role|default(null) %}
{% if navRole is null %}
    {% if is_granted('ROLE_ADMIN') %}
        {% set navRole = 'admin' %}
    {% elseif is_granted('ROLE_BANQUE') %}
        {% set navRole = 'banque' %}
    {% else %}
        {% set navRole = 'agriculteur' %}
    {% endif %}
{% endif %}

{% set displayName = app.user ? (app.user.nomComplet|default(app.user.nom|default('Utilisateur'))) : 'Utilisateur' %}
{% set avatarFallback = 'https://ui-avatars.com/api/?name=' ~ (displayName|url_encode) ~ '&background=b2d944&color=fff' %}
{% set avatarSrc = avatarFallback %}

{% if app.user %}
    {% if navRole == 'banque' and app.user.banque and app.user.banque.logo %}
        {% set avatarSrc = asset(app.user.banque.logo) %}
    {% elseif app.user.photo %}
        {% set avatarSrc = asset(app.user.photo) %}
    {% endif %}
{% endif %}

<aside class="market-sidebar client-sidebar {{ navRole }}-sidebar" id="sidebar">
    <div class="sidebar-bg-effects">
        <div class="sidebar-glow"></div>
        <div class="sidebar-pattern"></div>
    </div>

    <div class="sidebar-header">
        <div class="brand-logo">
            <div class="logo-icon">
                {% if navRole == 'admin' %}
                    <i class="fas fa-shield-alt"></i>
                {% elseif navRole == 'banque' %}
                    <i class="fas fa-university"></i>
                {% else %}
                    <i class="fas fa-leaf"></i>
                {% endif %}
            </div>
            <div class="logo-text">
                <span class="brand-name">AgriFund</span>
                <span class="brand-type">
                    {% if navRole == 'admin' %}ADMIN PORTAL{% elseif navRole == 'banque' %}BANQUE PORTAL{% else %}CLIENT PORTAL{% endif %}
                </span>
            </div>
        </div>

        <button class="d-lg-none border-0 bg-transparent text-white fs-4" id="sidebarClose" type="button" aria-label="Fermer menu">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="sidebar-user-section">
        <div class="user-card-glass">
            <div class="user-avatar-wrapper">
                <img src="{{ avatarSrc }}" class="user-avatar" alt="Utilisateur" onerror="this.onerror=null;this.src='{{ avatarFallback }}';">
                <span class="status-indicator online"></span>
            </div>
            <div class="user-info">
                <span class="name">{{ displayName }}</span>
                <span class="role-label">
                    {% if navRole == 'admin' %}Administrateur{% elseif navRole == 'banque' %}Banque{% else %}Agriculteur{% endif %}
                </span>
                <span class="role">
                    <i class="fas fa-check-circle me-1"></i>VERIFIE
                </span>
            </div>
        </div>
    </div>

    <nav class="sidebar-nav">
        {% if navRole == 'admin' %}
            <div class="nav-group">
                <span class="nav-group-title">Principal</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('admin_dashboard') }}" class="nav-link {{ app.request.get('_route') == 'admin_dashboard' ? 'active' : '' }}"><i class="fas fa-th-large"></i><span>Tableau de Bord</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_pages') }}" class="nav-link {{ app.request.get('_route') == 'admin_pages' ? 'active' : '' }}"><i class="fas fa-table-cells-large"></i><span>Toutes les Pages</span></a></li>
                </ul>
            </div>

            <div class="nav-group">
                <span class="nav-group-title">Gestion</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('admin_users_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_users' ? 'active' : '' }}"><i class="fas fa-users"></i><span>Utilisateurs</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_agriculteurs_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_agriculteurs' ? 'active' : '' }}"><i class="fas fa-tractor"></i><span>Agriculteurs</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_banques_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_banques' ? 'active' : '' }}"><i class="fas fa-university"></i><span>Banques</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_documents_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_documents' ? 'active' : '' }}"><i class="fas fa-file-alt"></i><span>Documents</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_decision_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_decision' ? 'active' : '' }}"><i class="fas fa-folder-open"></i><span>Dossiers</span></a></li>
                </ul>
            </div>

            <div class="nav-group">
                <span class="nav-group-title">Finance</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('admin_produit_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_produit' ? 'active' : '' }}"><i class="fas fa-boxes"></i><span>Produits Financiers</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_offre_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_offre' ? 'active' : '' }}"><i class="fas fa-hand-holding-usd"></i><span>Offres Financières</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_payment_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_payment' ? 'active' : '' }}"><i class="fas fa-file-invoice-dollar"></i><span>Validation Paiements</span></a></li>
                </ul>
            </div>

            <div class="nav-group">
                <span class="nav-group-title">IoT & Terrain</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('admin_terrain_projects') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_terrain' ? 'active' : '' }}"><i class="fas fa-map-marked-alt"></i><span>Projets Terrain</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_project_agricole_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_project_agricole' ? 'active' : '' }}"><i class="fas fa-seedling"></i><span>Projects Agricoles</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_ressource_project_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_ressource_project' ? 'active' : '' }}"><i class="fas fa-box-open"></i><span>Ressources Project</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_capteur_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_capteur' ? 'active' : '' }}"><i class="fas fa-satellite-dish"></i><span>Capteurs</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_releve_terrain') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_releve_terrain' ? 'active' : '' }}"><i class="fas fa-wave-square"></i><span>Releves Terrain</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_rapport_journalier') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_rapport_journalier' ? 'active' : '' }}"><i class="fas fa-chart-column"></i><span>Rapports Jour</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_releve_hebdo') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_releve_hebdo' ? 'active' : '' }}"><i class="fas fa-calendar-week"></i><span>Releves Hebdo</span></a></li>
                </ul>
            </div>

            <div class="nav-group">
                <span class="nav-group-title">Communication</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('admin_messagerie_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_messagerie' ? 'active' : '' }}"><i class="fas fa-comment-dots"></i><span>Messagerie</span><span class="nav-badge notification" id="unread-messages-badge" style="display:none;">0</span></a></li>
                    <li class="nav-item"><a href="{{ path('admin_profile_show') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_profile' ? 'active' : '' }}"><i class="fas fa-user-cog"></i><span>Mon Profil</span></a></li>
                </ul>
            </div>
        {% elseif navRole == 'banque' %}
            <div class="nav-group">
                <span class="nav-group-title">Principal</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('banque_dashboard') }}" class="nav-link {{ app.request.get('_route') == 'banque_dashboard' ? 'active' : '' }}"><i class="fas fa-th-large"></i><span>Tableau de Bord</span></a></li>
                </ul>
            </div>

            <div class="nav-group">
                <span class="nav-group-title">Gestion</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('banque_evaluation_index') }}" class="nav-link {{ app.request.get('_route') starts with 'banque_evaluation' ? 'active' : '' }}"><i class="fas fa-shield-halved"></i><span>Evaluations</span></a></li>
                </ul>
            </div>

            <div class="nav-group">
                <span class="nav-group-title">Communication</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('banque_messagerie_index') }}" class="nav-link {{ app.request.get('_route') starts with 'banque_messagerie' ? 'active' : '' }}"><i class="fas fa-comment-dots"></i><span>Messagerie</span><span class="nav-badge notification" id="unread-messages-badge" style="display:none;">0</span></a></li>
                    <li class="nav-item"><a href="{{ path('banque_profile_show') }}" class="nav-link {{ app.request.get('_route') starts with 'banque_profile' ? 'active' : '' }}"><i class="fas fa-user-cog"></i><span>Mon Profil</span></a></li>
                </ul>
            </div>
        {% else %}
            <div class="nav-group">
                <span class="nav-group-title">Menu Principal</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('agriculteur_dashboard') }}" class="nav-link {{ app.request.get('_route') == 'agriculteur_dashboard' ? 'active' : '' }}"><i class="fas fa-th-large"></i><span>Tableau de Bord</span></a></li>
                    <li class="nav-item"><a href="{{ path('agriculteur_produits') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_produit' ? 'active' : '' }}"><i class="fas fa-shopping-basket"></i><span>Marketplace</span></a></li>
                    <li class="nav-item"><a href="{{ path('agriculteur_offres') }}" class="nav-link {{ app.request.get('_route') == 'agriculteur_offres' ? 'active' : '' }}"><i class="fas fa-percentage"></i><span>Offres Speciales</span></a></li>
                    <li class="nav-item"><a href="{{ path('agriculteur_produit_simulateur') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_produit_simulateur' ? 'active' : '' }}"><i class="fas fa-calculator"></i><span>Simulateur</span></a></li>
                </ul>
            </div>

            <div class="nav-group">
                <span class="nav-group-title">Mon Dossier</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('agriculteur_messagerie_index') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_messagerie' ? 'active' : '' }}"><i class="fas fa-comment-dots"></i><span>Messagerie</span><span class="nav-badge notification" id="unread-messages-badge" style="display:none;">0</span></a></li>
                    <li class="nav-item"><a href="{{ path('agriculteur_profile_show') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_profile' ? 'active' : '' }}"><i class="fas fa-user-cog"></i><span>Mon Profil</span></a></li>
                </ul>
            </div>

            <div class="nav-group">
                <span class="nav-group-title">Projets & Terrain</span>
                <ul class="nav-list">
                    <li class="nav-item"><a href="{{ path('agriculteur_project_agricole_index') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_project_agricole' ? 'active' : '' }}"><i class="fas fa-seedling"></i><span>Projects Agricoles</span></a></li>
                    <li class="nav-item"><a href="{{ path('agriculteur_ressource_project_index') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_ressource_project' ? 'active' : '' }}"><i class="fas fa-box-open"></i><span>Ressources Projet</span></a></li>
                    <li class="nav-item"><a href="{{ path('capteur_index') }}" class="nav-link {{ app.request.get('_route') starts with 'capteur_' ? 'active' : '' }}"><i class="fas fa-satellite-dish"></i><span>Capteurs</span></a></li>
                    <li class="nav-item"><a href="{{ path('agriculteur_releve_terrain_home') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_releve_terrain' ? 'active' : '' }}"><i class="fas fa-wave-square"></i><span>Releves Terrain</span></a></li>
                    <li class="nav-item"><a href="{{ path('agriculteur_releve_hebdo_home') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_releve_hebdo' ? 'active' : '' }}"><i class="fas fa-calendar-week"></i><span>Releves Hebdo</span></a></li>
                    <li class="nav-item"><a href="{{ path('agriculteur_rapport_journalier_home') }}" class="nav-link {{ app.request.get('_route') starts with 'agriculteur_rapport_journalier' ? 'active' : '' }}"><i class="fas fa-chart-column"></i><span>Rapports Jour</span></a></li>
