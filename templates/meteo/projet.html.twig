{% extends 'base.html.twig' %}
{% block title %}Météo — Projet #{{ idproject }}{% endblock %}

{% block body %}
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h3 class="mb-0">Météo — Projet #{{ idproject }}</h3>
      <div class="text-muted small">Coordonnées: {{ lat }}, {{ lon }}</div>
    </div>
    <a class="btn btn-outline-dark" href="{{ path('capteur_dashboard', {idproject: idproject}) }}">Retour dashboard</a>
  </div>

  <div class="row mt-3 g-3">
    <div class="col-md-5">
      <div class="card">
        <div class="card-header fw-bold">Actuelle</div>
        <div class="card-body">
          <div class="fs-2">{{ current.main.temp }}°C</div>
          <div class="text-muted">
            {{ current.weather[0].description|capitalize }}
          </div>
          <hr>
          <div>Humidité: <strong>{{ current.main.humidity }}%</strong></div>
          <div>Vent: <strong>{{ current.wind.speed }} m/s</strong></div>
          <div>Pression: <strong>{{ current.main.pressure }} hPa</strong></div>
        </div>
      </div>
    </div>

    <div class="col-md-7">
      <div class="card">
        <div class="card-header fw-bold">Prévisions (par 3h)</div>
        <div class="card-body" style="max-height: 420px; overflow:auto;">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Date</th>
                <th>Temp</th>
                <th>Desc</th>
                <th>Hum</th>
              </tr>
            </thead>
            <tbody>
              {% for item in forecast.list|slice(0, 12) %}
                <tr>
                  <td>{{ item.dt_txt }}</td>
                  <td>{{ item.main.temp }}°C</td>
                  <td>{{ item.weather[0].description }}</td>
                  <td>{{ item.main.humidity }}%</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
          <div class="text-muted small">Affichage: 12 prochaines tranches (≈36h)</div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}