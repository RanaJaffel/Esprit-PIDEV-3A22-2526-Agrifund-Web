{% extends 'base.html.twig' %}
{% block title %}Analyse Historique — Projet #{{ idproject }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">

  {# HERO #}
  <div class="card shadow-sm mb-4 p-4 bg-success text-white">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h2><i class="fas fa-chart-line me-2"></i>
          Analyse Historique — Projet #{{ idproject }}
        </h2>
        <small>Tendances & prédictions IA</small>
      </div>

      <div>
        <a class="btn btn-light me-2"
           href="{{ path('app_dashboard', {idproject: idproject}) }}">
          Dashboard
        </a>

        <a class="btn btn-danger"
           href="{{ path('historique_export_pdf', {idproject: idproject}) }}">
          Export PDF
        </a>
      </div>
    </div>
  </div>

  {# KPI #}
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card p-3 text-center shadow-sm">
        <h6>Température Moyenne</h6>
        <h3>{{ analysis.stats.avg_temp|default(0)|round(1) }}°C</h3>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card p-3 text-center shadow-sm">
        <h6>Humidité Moyenne</h6>
        <h3>{{ analysis.stats.avg_hum|default(0)|round(1) }}%</h3>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card p-3 text-center shadow-sm">
        <h6>Semaines analysées</h6>
        <h3>{{ analysis.stats.total_weeks|default(0) }}</h3>
      </div>
    </div>
  </div>

  {# GRAPH #}
  <div class="card shadow-sm mb-4 p-4">
    <h5>Tendance sur 8 semaines</h5>
    <canvas id="chartTendance"></canvas>
  </div>

  {# COMPARISON #}
  {% if analysis.comparison is defined and analysis.comparison.error is not defined %}
  <div class="card shadow-sm mb-4 p-4">
    <h5>Comparaison 2 semaines</h5>

    <div class="row">
      <div class="col-md-6">
        <strong>Semaine actuelle</strong>
        <p>{{ analysis.comparison.current.nb_mesures|default(0) }} mesures</p>
        🌡 {{ analysis.comparison.current.temperature|default(0) }}°C<br>
        💧 {{ analysis.comparison.current.humidite|default(0) }}%
      </div>

      <div class="col-md-6">
        <strong>Semaine précédente</strong>
        <p>{{ analysis.comparison.previous.nb_mesures|default(0) }} mesures</p>
        🌡 {{ analysis.comparison.previous.temperature|default(0) }}°C<br>
        💧 {{ analysis.comparison.previous.humidite|default(0) }}%
      </div>
    </div>

    <hr>

    <h6>Analyse IA</h6>
    <p>{{ analysis.comparison.analyse|default('Analyse non disponible') }}</p>
  </div>
  {% endif %}

  {# PREDICTION #}
  {% if analysis.prediction.available %}
  <div class="card shadow-sm p-4">
    <h5>Prédiction Semaine Prochaine</h5>

    <div class="row text-center">
      <div class="col-md-6">
        <h4>{{ analysis.prediction.temperature|default(0) }}°C</h4>
        <small>Température prévue</small>
      </div>

      <div class="col-md-6">
        <h4>{{ analysis.prediction.humidite|default(0) }}%</h4>
        <small>Humidité prévue</small>
      </div>
    </div>
  </div>
  {% endif %}

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const chartData = {{ analysis.chartData|json_encode|raw }};
if(chartData && chartData.labels){
    new Chart(document.getElementById('chartTendance'), {
        type: 'line',
        data: chartData,
        options: { responsive: true }
    });
}
</script>
{% endblock %}