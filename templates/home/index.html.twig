{# templates/home/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}AgriFund - L'avenir de l'agriculture tunisienne{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --vert-vif: #089647;
    }

    body.index-page {
        overflow-x: hidden;
        position: relative;
    }

    /* Premium Glows */
    .glow-1 {
        position: fixed; top: -10%; left: -10%; width: 50%; height: 50%;
        background: radial-gradient(circle, rgba(8, 150, 71, 0.08) 0%, transparent 70%);
        z-index: -1; animation: float 15s infinite alternate;
    }
    .glow-2 {
        position: fixed; bottom: -10%; right: -10%; width: 60%; height: 60%;
        background: radial-gradient(circle, rgba(178, 217, 68, 0.05) 0%, transparent 70%);
        z-index: -1; animation: float 18s infinite alternate-reverse;
    }

    @keyframes float {
        0% { transform: translate(0, 0); }
        100% { transform: translate(5%, 5%); }
    }

    .marketing-hero {
        min-height: 95vh;
        background: linear-gradient(rgba(19, 61, 3, 0.6), rgba(19, 61, 3, 0.3)), url("{{ asset('img/hero_nature.png') }}");
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        color: white;
        padding: 100px 0;
        position: relative;
        clip-path: ellipse(150% 100% at 50% 0%);
    }

    .hero-content { max-width: 850px; }
    .hero-label {
        display: inline-block;
        background: rgba(225, 179, 35, 0.9);
        color: #133D03;
        padding: 10px 25px;
        border-radius: 100px;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.8rem;
        margin-bottom: 30px;
        letter-spacing: 2px;
        backdrop-filter: blur(5px);
    }

    .hero-title {
        font-family: 'Marcellus', serif;
        font-size: 5rem;
        line-height: 1;
        font-weight: 400;
        margin-bottom: 35px;
        letter-spacing: -2px;
    }

    .hero-desc {
        font-size: 1.4rem;
        opacity: 0.9;
        margin-bottom: 50px;
        line-height: 1.6;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-btns {
        display: flex;
        gap: 25px;
    }

    .btn-nature {
        background: var(--vert-vif);
        color: white;
        padding: 20px 45px;
        border-radius: 100px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: none;
        font-size: 1.1rem;
        box-shadow: 0 10px 30px rgba(8, 150, 71, 0.3);
    }

    .btn-nature:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 40px rgba(8, 150, 71, 0.4);
        color: white;
    }

    .btn-outline-white {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        color: white;
        padding: 20px 45px;
        border-radius: 100px;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.3);
        transition: all 0.4s;
        font-size: 1.1rem;
    }

    .btn-outline-white:hover {
        background: white;
        color: var(--vert-vif);
        transform: translateY(-8px);
    }

    /* Section Styles */
    .section-padding { padding: 120px 0; }
    
    .lifestyle-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 35px;
        margin-top: 70px;
    }

    .life-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        padding: 60px 45px;
        border-radius: 40px;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255, 255, 255, 0.8);
        text-align: center;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.03);
    }

    .life-card:hover {
        transform: translateY(-20px);
        background: white;
        box-shadow: 0 40px 80px rgba(8, 150, 71, 0.1);
        border-color: var(--vert-vif);
    }

    .icon-circle {
        width: 90px; height: 90px;
        background: linear-gradient(135deg, #f1f8e9 0%, #e8f5e9 100%);
        color: var(--vert-vif);
        border-radius: 30px;
        display: flex; align-items: center; justify-content: center;
        font-size: 2.5rem;
        margin: 0 auto 35px;
        transform: rotate(-5deg);
        transition: all 0.4s;
    }

    .life-card:hover .icon-circle {
        transform: rotate(0deg) scale(1.1);
        background: var(--vert-vif);
        color: white;
    }

    .card-title { font-family: 'Marcellus', serif; font-size: 1.8rem; margin-bottom: 20px; color: #133D03; }
    .card-text { color: #64748b; line-height: 1.8; font-size: 1rem; }

    .stats-bar {
        background: linear-gradient(135deg, #133D03 0%, #076A39 100%);
        color: white;
        padding: 70px 0;
        border-radius: 50px;
        margin-top: -100px;
        position: relative;
        z-index: 10;
        display: flex;
        justify-content: space-around;
        text-align: center;
        box-shadow: 0 30px 60px rgba(19, 61, 3, 0.2);
    }

    .stat-box h4 { font-size: 4rem; font-weight: 400; font-family: 'Marcellus', serif; margin-bottom: 5px; color: var(--harvest-gold); }
    .stat-box p { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.7; font-weight: 700; }

    @media (max-width: 992px) {
        .hero-title { font-size: 3.5rem; }
        .lifestyle-grid { grid-template-columns: 1fr; }
        .stats-bar { flex-direction: column; gap: 50px; padding: 50px; border-radius: 30px; }
    }
</style>
{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}

    <div class="glow-1"></div>
    <div class="glow-2"></div>

    <main>
        <section class="marketing-hero">
            <div class="container text-center">
                <div class="hero-content mx-auto" data-aos="zoom-out" data-aos-duration="1200">
                    <span class="hero-label">Excellence Agricole</span>
                    <h1 class="hero-title">Façonnez demain, aujourd'hui.</h1>
                    <p class="hero-desc">L'écosystème financier le plus avancé de Tunisie dédié exclusivement à ceux qui cultivent notre terre.</p>
                    <div class="hero-btns justify-content-center">
                        <a href="{{ path('app_register_agriculteur') }}" class="btn-nature">Rejoindre l'élite</a>
                        <a href="#discover" class="btn-outline-white">Explorer l'impact</a>
                    </div>
                </div>
            </div>
        </section>

        <div class="container">
            <div class="stats-bar">
                <div class="stat-box" data-aos="fade-up">
                    <h4>8.5k</h4>
                    <p>Agriculteurs</p>
                </div>
                <div class="stat-box" data-aos="fade-up" data-aos-delay="100">
                    <h4>120M</h4>
                    <p>Investis</p>
                </div>
                <div class="stat-box" data-aos="fade-up" data-aos-delay="200">
                    <h4>100%</h4>
                    <p>Digitalisé</p>
                </div>
                <div class="stat-box" data-aos="fade-up" data-aos-delay="300">
                    <h4>98%</h4>
                    <p>Satisfaction</p>
                </div>
            </div>
        </div>

        <section id="discover" class="section-padding">
            <div class="container">
                <div class="text-center" data-aos="fade-up">
                    <h6 class="text-uppercase fw-bold mb-3" style="letter-spacing: 3px; color: var(--vert-vif);">Notre Héritage</h6>
                    <h2 style="font-family: 'Marcellus', serif; font-size: 3.5rem; margin-bottom: 25px; color: #133D03;">Cultiver la prospérité</h2>
                    <p class="text-muted mx-auto" style="max-width: 750px; font-size: 1.1rem; line-height: 1.8;">Nous fusionnons tradition millénaire et haute finance pour offrir une expérience sans précédent aux bâtisseurs de la Tunisie.</p>
                </div>

                <div class="lifestyle-grid">
                    <div class="life-card" data-aos="fade-up" data-aos-delay="100">
                        <div class="icon-circle">
                            <i class="fas fa-leaf"></i>
                        </div>
                        <h3 class="card-title">Éthique</h3>
                        <p class="card-text">Un financement qui respecte la terre et les hommes, avec une transparence absolue sur chaque transaction.</p>
                    </div>
                    <div class="life-card" data-aos="fade-up" data-aos-delay="200">
                        <div class="icon-circle">
                            <i class="fas fa-bolt"></i>
                        </div>
                        <h3 class="card-title">Vitesse</h3>
                        <p class="card-text">Nous savons que la nature n'attend pas. Des réponses en moins de 48h pour vos besoins saisonniers.</p>
                    </div>
                    <div class="life-card" data-aos="fade-up" data-aos-delay="300">
                        <div class="icon-circle">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h3 class="card-title">Sérénité</h3>
                        <p class="card-text">Une protection robuste contre les aléas et un accompagnement sur mesure par nos experts agricoles.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Product Preview Section -->
        <section class="section-padding" style="background: rgba(13, 40, 24, 0.02); border-radius: 80px 80px 0 0;">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-5" data-aos="fade-right">
                        <h2 style="font-family: 'Marcellus', serif; font-size: 3rem; margin-bottom: 35px; color: #133D03;">Solutions Sur Mesure</h2>
                        <p class="lead text-muted mb-5" style="line-height: 1.8;">Qu'il s'agisse de moderniser votre parc matériel ou d'étendre vos terres, nos experts façonnent le crédit parfait pour votre ambition.</p>
                        
                        <div class="d-flex align-items-center mb-4">
                            <div class="me-4 text-success"><i class="fas fa-university fa-2x"></i></div>
                            <div>
                                <h5 class="fw-bold mb-1">Partenariat Institutionnel</h5>
                                <p class="text-muted small mb-0">Accès aux fonds de garantie nationaux.</p>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-center mb-5">
                            <div class="me-4 text-success"><i class="fas fa-chart-pie fa-2x"></i></div>
                            <div>
                                <h5 class="fw-bold mb-1">Gestion Prédictive</h5>
                                <p class="text-muted small mb-0">Outils d'aide à la décision intégrés.</p>
                            </div>
                        </div>

                        <a href="{{ path('app_products') }}" class="btn-nature">Voir le catalogue</a>
                    </div>
                    <div class="col-lg-6 offset-lg-1" data-aos="zoom-in" data-aos-delay="200">
                        <div class="position-relative">
                            <div style="position: absolute; top: -30px; left: -30px; width: 200px; height: 200px; background: var(--harvest-gold); border-radius: 50%; filter: blur(80px); opacity: 0.2; z-index: -1;"></div>
                            <img src="{{ asset('img/hero_nature.png') }}" alt="Nature" class="img-fluid rounded-5 shadow-2xl" style="border: 10px solid white;">
                            <div class="bg-white p-5 rounded-4 shadow-lg position-absolute bottom-0 start-0 m-4" style="max-width: 320px; border-left: 8px solid var(--vert-vif);">
                                <h4 class="fw-bold mb-2">98%</h4>
                                <p class="mb-0 text-muted">des agriculteurs AgriFund recommandent nos services à leurs confrères.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    {% include 'partials/_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
<script>
    window.addEventListener('scroll', function() {
        const nav = document.querySelector('.navbar');
        const header = document.querySelector('#header');
        if (header && window.scrollY > 50) {
            header.classList.add('scrolled');
        } else if (header) {
            header.classList.remove('scrolled');
        }
    });
</script>
{% endblock %}