{% extends 'base.html.twig' %}

{% block title %}AgriFund - Plateforme de Financement Agricole{% endblock %}

{% block body_class %}index-page{% endblock %}

{% block stylesheets %}
<style>
    /* Custom styles for AgriFund */
    .hero .carousel-container h2 {
        font-size: 3rem;
        font-weight: 700;
    }

    .btn-get-started {
        background: linear-gradient(135deg, #3f9e4d 0%, #2d7a3a 100%);
        color: white;
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        margin-top: 20px;
    }

    .btn-get-started:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(63, 158, 77, 0.4);
        color: white;
    }

    .btn-get-started-banque {
        background: linear-gradient(135deg, #d4a017 0%, #b8860b 100%);
        margin-left: 15px;
    }

    .btn-get-started-banque:hover {
        box-shadow: 0 10px 30px rgba(212, 160, 23, 0.4);
    }

    .stats-section {
        background: linear-gradient(135deg, #1a472a 0%, #2d5a3d 100%);
        padding: 60px 0;
    }

    .stat-item {
        text-align: center;
        color: white;
    }

    .stat-item .number {
        font-size: 3rem;
        font-weight: 700;
        color: #8bc34a;
    }

    .stat-item .label {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .cta-register {
        background: linear-gradient(135deg, #1a472a 0%, #0d2818 100%);
        padding: 80px 0;
    }

    .cta-register h2 {
        color: white;
        font-size: 2.5rem;
        margin-bottom: 20px;
    }

    .cta-register p {
        color: rgba(255, 255, 255, 0.8);
        font-size: 1.2rem;
        margin-bottom: 30px;
    }

    .cta-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-cta-agriculteur {
        padding: 16px 40px;
        background: linear-gradient(135deg, #8bc34a 0%, #689f38 100%);
        border: none;
        border-radius: 30px;
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s ease;
    }

    .btn-cta-agriculteur:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(139, 195, 74, 0.4);
        color: white;
    }

    .btn-cta-banque {
        padding: 16px 40px;
        background: linear-gradient(135deg, #d4a017 0%, #b8860b 100%);
        border: none;
        border-radius: 30px;
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s ease;
    }

    .btn-cta-banque:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(212, 160, 23, 0.4);
        color: white;
    }

    .service-item-agrifund {
        background: white;
        padding: 40px 30px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        height: 100%;
    }

    .service-item-agrifund:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
    }

    .service-icon-agrifund {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #3f9e4d 0%, #2d7a3a 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
    }

    .service-icon-agrifund i {
        font-size: 32px;
        color: white;
    }

    .service-item-agrifund h3 {
        font-size: 1.3rem;
        color: #1a472a;
        margin-bottom: 15px;
    }

    .service-item-agrifund p {
        color: #666;
        line-height: 1.6;
    }
</style>
{% endblock %}

