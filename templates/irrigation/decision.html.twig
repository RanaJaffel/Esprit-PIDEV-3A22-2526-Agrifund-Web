{% extends 'base.html.twig' %}
{% block title %}Irrigation IA — Projet #{{ idproject }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('ui/capteur-dashboard-pro.css') }}">
  <link rel="stylesheet" href="{{ asset('ui/iot-advanced.css') }}">
  <link rel="stylesheet" href="{{ asset('ui/irrigation-page.css') }}">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">

  <style>
    /* ============================================================
       IRRIGATION IA — PREMIUM DARK AGRI THEME
       ============================================================ */
    :root {
      --agri-bg:        #080f08;
      --agri-surface:   #0e1a0e;
      --agri-card:      #121e12;
      --agri-border:    rgba(74, 222, 128, 0.10);
      --agri-border-m:  rgba(74, 222, 128, 0.22);
      --green-neon:     #4ade80;
      --green-mid:      #22c55e;
      --green-deep:     #15803d;
      --cyan-accent:    #22d3ee;
      --amber-accent:   #fbbf24;
      --red-alert:      #f87171;
      --text-primary:   #e8f5e8;
      --text-secondary: #86a886;
      --text-muted:     #4d6b4d;
      --font-display:   'Syne', sans-serif;
      --font-body:      'DM Sans', sans-serif;
      --radius-xl:      20px;
      --radius-lg:      14px;
      --radius-md:      10px;
      --glow-green:     0 0 30px rgba(74, 222, 128, 0.15);
      --glow-strong:    0 0 60px rgba(74, 222, 128, 0.25);
      --shadow-card:    0 4px 32px rgba(0, 0, 0, 0.6), 0 1px 0 rgba(74, 222, 128, 0.06) inset;
    }

    /* ── Reset & Base ── */
    .irrig-wrapper * { box-sizing: border-box; margin: 0; padding: 0; }
    .irrig-wrapper {
      font-family: var(--font-body);
      background: var(--agri-bg);
      color: var(--text-primary);
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }

    /* ── Animated background ── */
    .irrig-wrapper::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 40% at 20% 10%, rgba(34,197,94,.07) 0%, transparent 60%),
        radial-gradient(ellipse 40% 50% at 80% 80%, rgba(34,211,238,.05) 0%, transparent 55%),
        radial-gradient(ellipse 30% 30% at 50% 50%, rgba(74,222,128,.03) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    /* subtle animated grid */
    .irrig-wrapper::after {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(74,222,128,.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(74,222,128,.025) 1px, transparent 1px);
      background-size: 48px 48px;
      pointer-events: none;
      z-index: 0;
      animation: gridPulse 8s ease-in-out infinite;
    }
    @keyframes gridPulse {
      0%,100% { opacity: .6; }
      50%      { opacity: 1; }
    }

    .irrig-inner {
      position: relative;
      z-index: 1;
      padding: 28px 32px 48px;
      max-width: 1440px;
      margin: 0 auto;
    }

    /* ── HERO ── */
    .irrig-hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 36px;
      padding: 32px 36px;
      background: linear-gradient(135deg, rgba(21,128,61,.35) 0%, rgba(15,26,15,.6) 100%);
      border: 1px solid var(--agri-border-m);
      border-radius: var(--radius-xl);
      backdrop-filter: blur(16px);
      box-shadow: var(--glow-green), var(--shadow-card);
      position: relative;
      overflow: hidden;
      animation: heroIn .7s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes heroIn {
      from { opacity: 0; transform: translateY(-20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .irrig-hero::before {
      content: '';
      position: absolute;
      right: -40px; top: -40px;
      width: 280px; height: 280px;
      background: radial-gradient(circle, rgba(74,222,128,.12), transparent 70%);
      pointer-events: none;
    }

    .hero-left { display: flex; align-items: center; gap: 20px; }

    .hero-icon {
      width: 64px; height: 64px;
      border-radius: 18px;
      background: linear-gradient(135deg, #15803d, #4ade80);
      display: flex; align-items: center; justify-content: center;
      font-size: 28px; color: #fff;
      box-shadow: 0 0 24px rgba(74,222,128,.4);
      flex-shrink: 0;
      animation: iconPulse 3s ease-in-out infinite;
    }
    @keyframes iconPulse {
      0%,100% { box-shadow: 0 0 24px rgba(74,222,128,.4); }
      50%      { box-shadow: 0 0 40px rgba(74,222,128,.7); }
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 800;
      color: var(--text-primary);
      letter-spacing: -.02em;
      line-height: 1.1;
    }
    .hero-title span { color: var(--green-neon); }
    .hero-sub {
      font-size: .85rem;
      color: var(--text-secondary);
      margin-top: 5px;
      font-weight: 300;
      letter-spacing: .02em;
    }

    .hero-badge {
      display: flex; align-items: center; gap: 7px;
      padding: 5px 14px;
      background: rgba(74,222,128,.1);
      border: 1px solid var(--agri-border-m);
      border-radius: 100px;
      font-size: .75rem;
      color: var(--green-neon);
      font-weight: 600;
      letter-spacing: .05em;
      text-transform: uppercase;
    }
    .hero-badge .pulse-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--green-neon);
      animation: dotBlink 1.4s ease-in-out infinite;
    }
    @keyframes dotBlink {
      0%,100% { opacity: 1; transform: scale(1); }
      50%      { opacity: .3; transform: scale(.7); }
    }

    .btn-back {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 20px;
      background: rgba(74,222,128,.08);
      border: 1px solid var(--agri-border-m);
      border-radius: var(--radius-md);
      color: var(--green-neon);
      font-family: var(--font-body);
      font-size: .85rem;
      font-weight: 500;
      text-decoration: none;
      transition: all .25s;
    }
    .btn-back:hover {
      background: rgba(74,222,128,.18);
      color: #fff;
      transform: translateX(-3px);
    }

    /* ── CARDS / PANELS ── */
    .irrig-card {
      background: var(--agri-card);
      border: 1px solid var(--agri-border);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-card);
      overflow: hidden;
      transition: border-color .3s, box-shadow .3s;
    }
    .irrig-card:hover {
      border-color: var(--agri-border-m);
      box-shadow: var(--glow-green), var(--shadow-card);
    }

    .card-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 24px 16px;
      border-bottom: 1px solid var(--agri-border);
    }
    .card-head-title {
      font-family: var(--font-display);
      font-size: .9rem;
      font-weight: 700;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: .08em;
      display: flex; align-items: center; gap: 8px;
    }
    .card-head-title i { color: var(--green-neon); font-size: 1rem; }
    .card-body { padding: 24px; }

    /* ── DECISION ZONE ── */
    .decision-zone {
      display: flex; gap: 20px; align-items: flex-start;
      padding: 24px;
      border-radius: var(--radius-lg);
      margin-bottom: 24px;
      border: 1px solid;
      position: relative;
      overflow: hidden;
    }
    .decision-zone::before {
      content: '';
      position: absolute; inset: 0;
      opacity: .06;
      background: currentColor;
    }

    .decision-zone.irriguer-urgent {
      border-color: rgba(248,113,113,.4);
      color: var(--red-alert);
      background: rgba(248,113,113,.05);
    }
    .decision-zone.irriguer {
      border-color: rgba(34,211,238,.35);
      color: var(--cyan-accent);
      background: rgba(34,211,238,.04);
    }
    .decision-zone.surveiller {
      border-color: rgba(251,191,36,.35);
      color: var(--amber-accent);
      background: rgba(251,191,36,.04);
    }
    .decision-zone.ne-pas-irriguer, .decision-zone.ok {
      border-color: rgba(74,222,128,.3);
      color: var(--green-neon);
      background: rgba(74,222,128,.04);
    }

    .decision-big-icon {
      font-size: 3rem;
      flex-shrink: 0;
      filter: drop-shadow(0 0 16px currentColor);
      animation: iconFloat 3s ease-in-out infinite;
    }
    @keyframes iconFloat {
      0%,100% { transform: translateY(0); }
      50%      { transform: translateY(-6px); }
    }

    .decision-label {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -.02em;
      line-height: 1.1;
      margin-bottom: 6px;
    }
    .decision-qty {
      font-size: 1rem;
      font-weight: 600;
      opacity: .9;
      margin-bottom: 10px;
    }
    .decision-expl {
      font-size: .85rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    /* ── METRICS GRID ── */
    .metrics-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin-bottom: 24px;
    }

    .metric-tile {
      background: var(--agri-surface);
      border: 1px solid var(--agri-border);
      border-radius: var(--radius-lg);
      padding: 16px 18px;
      display: flex; align-items: flex-start; gap: 14px;
      transition: border-color .25s;
    }
    .metric-tile:hover { border-color: var(--agri-border-m); }

    .metric-tile-icon {
      width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
    }
    .tile-green  { background: rgba(74,222,128,.12); color: var(--green-neon); }
    .tile-cyan   { background: rgba(34,211,238,.12); color: var(--cyan-accent); }
    .tile-amber  { background: rgba(251,191,36,.12); color: var(--amber-accent); }
    .tile-purple { background: rgba(167,139,250,.12); color: #a78bfa; }

    .metric-tile-label {
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: var(--text-muted);
      font-weight: 600;
      margin-bottom: 4px;
    }
    .metric-tile-value {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1;
    }
    .metric-tile-sub {
      font-size: .75rem;
      color: var(--text-secondary);
      margin-top: 3px;
    }

    .prog-bar {
      height: 4px;
      background: rgba(255,255,255,.06);
      border-radius: 100px;
      margin-top: 8px;
      overflow: hidden;
    }
    .prog-fill {
      height: 100%;
      border-radius: 100px;
      background: linear-gradient(90deg, var(--green-mid), var(--green-neon));
      box-shadow: 0 0 8px rgba(74,222,128,.5);
      transition: width 1s cubic-bezier(.16,1,.3,1);
    }

    /* ── DATA BOX ── */
    .data-box {
      background: var(--agri-surface);
      border: 1px solid var(--agri-border);
      border-radius: var(--radius-lg);
      padding: 18px 20px;
    }
    .data-box-title {
      font-size: .75rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--text-muted);
      font-weight: 700;
      margin-bottom: 14px;
      display: flex; align-items: center; gap: 7px;
    }
    .data-box-title i { color: var(--green-neon); }
    .data-items {
      display: flex; gap: 12px; flex-wrap: wrap;
    }
    .data-item-pill {
      display: flex; align-items: center; gap: 9px;
      padding: 8px 14px;
      background: var(--agri-card);
      border: 1px solid var(--agri-border);
      border-radius: 100px;
      font-size: .85rem;
    }
    .data-item-pill i { font-size: .85rem; }
    .data-item-pill .label { color: var(--text-muted); font-size: .75rem; }
    .data-item-pill .val { color: var(--text-primary); font-weight: 600; }

    /* ── RIGHT COLUMN PANELS ── */
    .rec-block {
      display: flex; align-items: center; gap: 12px;
      padding: 16px;
      border-radius: var(--radius-lg);
      margin-bottom: 16px;
      border: 1px solid var(--agri-border);
      background: var(--agri-surface);
    }
    .rec-block-icon {
      width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem;
    }
    .rec-label {
      font-size: .72rem; text-transform: uppercase; letter-spacing: .06em;
      color: var(--text-muted); font-weight: 700;
    }
    .rec-value {
      font-family: var(--font-display);
      font-size: 1rem; font-weight: 700;
      color: var(--text-primary);
    }
    .rec-detail {
      font-size: .8rem; color: var(--text-secondary); line-height: 1.5; margin-top: 4px;
    }

    /* weather pills */
    .weather-row {
      display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px;
    }
    .weather-pill {
      flex: 1; min-width: 80px;
      background: var(--agri-surface);
      border: 1px solid var(--agri-border);
      border-radius: var(--radius-lg);
      padding: 12px 10px;
      text-align: center;
      font-size: .75rem;
    }
    .weather-pill i { font-size: 1.4rem; display: block; margin-bottom: 6px; }
    .weather-pill .wp-val { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: var(--text-primary); }
    .weather-pill .wp-label { color: var(--text-muted); font-size: .68rem; text-transform: uppercase; letter-spacing: .05em; }

    .weather-alert-box {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px;
      background: rgba(34,211,238,.07);
      border: 1px solid rgba(34,211,238,.2);
      border-radius: var(--radius-md);
      font-size: .82rem; color: var(--cyan-accent);
    }

    /* tips list */
    .tips-list {
      list-style: none;
    }
    .tip-item {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 12px 20px;
      border-bottom: 1px solid var(--agri-border);
      font-size: .85rem;
      color: var(--text-secondary);
      line-height: 1.5;
      transition: background .2s;
    }
    .tip-item:last-child { border-bottom: none; }
    .tip-item:hover { background: rgba(74,222,128,.04); }
    .tip-item::before {
      content: '◆';
      color: var(--green-neon);
      font-size: .5rem;
      flex-shrink: 0;
      margin-top: 5px;
    }

    /* ── STAT CARDS ── */
    .stat-big {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 32px 24px; text-align: center;
      min-height: 200px;
      position: relative; overflow: hidden;
    }
    .stat-big::before {
      content: '';
      position: absolute; bottom: -20px; right: -20px;
      width: 120px; height: 120px;
      border-radius: 50%;
      opacity: .07;
      background: currentColor;
    }
    .stat-big-icon {
      font-size: 2.2rem;
      margin-bottom: 14px;
      animation: iconFloat 4s ease-in-out infinite;
    }
    .stat-big-label {
      font-size: .75rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--text-muted);
      font-weight: 700;
      margin-bottom: 8px;
    }
    .stat-big-num {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 5vw, 3rem);
      font-weight: 800;
      line-height: 1;
      margin-bottom: 6px;
    }
    .stat-big-sub {
      font-size: .78rem;
      color: var(--text-secondary);
    }
    .c-green  { color: var(--green-neon); }
    .c-cyan   { color: var(--cyan-accent); }
    .c-amber  { color: var(--amber-accent); }

    /* ── TABLE ── */
    .irrig-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: .85rem;
    }
    .irrig-table thead th {
      padding: 12px 16px;
      font-size: .7rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--text-muted);
      font-weight: 700;
      border-bottom: 1px solid var(--agri-border);
      background: var(--agri-surface);
      white-space: nowrap;
    }
    .irrig-table thead th:first-child { border-radius: var(--radius-md) 0 0 0; }
    .irrig-table thead th:last-child  { border-radius: 0 var(--radius-md) 0 0; }
    .irrig-table tbody tr {
      transition: background .2s;
    }
    .irrig-table tbody tr:hover td {
      background: rgba(74,222,128,.04);
    }
    .irrig-table tbody td {
      padding: 13px 16px;
      border-bottom: 1px solid var(--agri-border);
      color: var(--text-secondary);
      vertical-align: middle;
    }
    .irrig-table tbody td:first-child { color: var(--text-muted); font-size: .8rem; }

    .dec-badge {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 12px; border-radius: 100px;
      font-size: .72rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: .05em;
      border: 1px solid;
    }
    .dec-badge.irriguer-urgent { background: rgba(248,113,113,.12); color: var(--red-alert); border-color: rgba(248,113,113,.3); }
    .dec-badge.irriguer        { background: rgba(34,211,238,.1);   color: var(--cyan-accent); border-color: rgba(34,211,238,.25); }
    .dec-badge.surveiller      { background: rgba(251,191,36,.1);   color: var(--amber-accent); border-color: rgba(251,191,36,.25); }
    .dec-badge.ne-pas-irriguer, .dec-badge.ok {
      background: rgba(74,222,128,.1); color: var(--green-neon); border-color: rgba(74,222,128,.25);
    }

    .conf-bar { height: 6px; border-radius: 100px; background: rgba(255,255,255,.07); overflow: hidden; }
    .conf-fill {
      height: 100%; border-radius: 100px;
      background: linear-gradient(90deg, var(--green-deep), var(--green-neon));
    }

    .btn-detail {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 5px 12px; border-radius: 8px;
      background: rgba(74,222,128,.08);
      border: 1px solid var(--agri-border-m);
      color: var(--green-neon);
      font-size: .75rem; font-weight: 600; cursor: pointer;
      transition: all .2s; font-family: var(--font-body);
    }
    .btn-detail:hover {
      background: rgba(74,222,128,.18);
      color: #fff;
    }

    /* ── BADGE (confidence) ── */
    .conf-badge {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 3px 10px; border-radius: 100px;
      font-size: .72rem; font-weight: 700;
    }
    .conf-badge.hi  { background: rgba(74,222,128,.12); color: var(--green-neon); }
    .conf-badge.mid { background: rgba(251,191,36,.12); color: var(--amber-accent); }
    .conf-badge.lo  { background: rgba(248,113,113,.12); color: var(--red-alert); }

    /* ── MODAL ── */
    .irrig-modal .modal-content {
      background: var(--agri-card);
      border: 1px solid var(--agri-border-m);
      border-radius: var(--radius-xl);
      color: var(--text-primary);
      font-family: var(--font-body);
    }
    .irrig-modal .modal-header {
      border-bottom: 1px solid var(--agri-border);
      padding: 20px 24px;
    }
    .irrig-modal .modal-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      color: var(--green-neon);
    }
    .irrig-modal .btn-close { filter: invert(1); }
    .irrig-modal .modal-body { padding: 24px; }

    .modal-data-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid var(--agri-border);
    }
    .modal-data-row:last-child { border-bottom: none; }
    .modal-data-key { font-size: .78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .05em; }
    .modal-data-val { font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: var(--text-primary); }

    /* ── SECTION HEADING ── */
    .section-label {
      font-family: var(--font-display);
      font-size: .7rem;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: var(--text-muted);
      font-weight: 700;
      margin-bottom: 16px;
      display: flex; align-items: center; gap: 10px;
    }
    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--agri-border);
    }

    /* ── ANIMATION STAGGER ── */
    .fade-up {
      opacity: 0;
      transform: translateY(24px);
      animation: fadeUp .6s cubic-bezier(.16,1,.3,1) forwards;
    }
    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }
    .d1 { animation-delay: .1s; }
    .d2 { animation-delay: .2s; }
    .d3 { animation-delay: .3s; }
    .d4 { animation-delay: .4s; }
    .d5 { animation-delay: .5s; }
    .d6 { animation-delay: .6s; }

    /* ── SCROLLBAR ── */
    .irrig-wrapper ::-webkit-scrollbar { width: 6px; }
    .irrig-wrapper ::-webkit-scrollbar-track { background: var(--agri-bg); }
    .irrig-wrapper ::-webkit-scrollbar-thumb { background: var(--agri-border-m); border-radius: 3px; }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      .irrig-inner { padding: 16px 16px 48px; }
      .irrig-hero  { flex-direction: column; align-items: flex-start; }
      .metrics-row { grid-template-columns: 1fr; }
    }
  </style>
{% endblock %}

{% block body %}
<div class="irrig-wrapper">
  <div class="irrig-inner">

    {# ══════════ HERO ══════════ #}
    <div class="irrig-hero">
      <div class="hero-left">
        <div class="hero-icon"><i class="fas fa-droplet"></i></div>
        <div>
          <div class="hero-title">
            Irrigation Intelligente — <span>Projet #{{ idproject }}</span>
          </div>
          <div class="hero-sub">Analyse IA temps réel · Recommandations · Prévisions météo</div>
        </div>
      </div>

      <div class="d-flex align-items-center gap-3 flex-wrap">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          IA Active
        </div>
        <a class="btn-back" href="{{ path('app_dashboard', {idproject: idproject}) }}">
          <i class="fas fa-arrow-left"></i> Dashboard
        </a>
      </div>
    </div>

    {# ══════════ MAIN ROW ══════════ #}
    <div class="row g-4 mb-4">

      {# ─── LEFT: Analyse principale ─── #}
      <div class="col-12 col-lg-7 fade-up d1">
        <div class="irrig-card h-100">
          <div class="card-head">
            <div class="card-head-title">
              <i class="fas fa-brain"></i>
              Analyse IA en temps réel
            </div>
            <span class="conf-badge {{ analysis.analysis.confidence >= 0.8 ? 'hi' : (analysis.analysis.confidence >= 0.6 ? 'mid' : 'lo') }}">
              Confiance {{ (analysis.analysis.confidence * 100)|round }}%
            </span>
          </div>

          <div class="card-body">
            {# Decision zone #}
            {% set dec = analysis.analysis.decision|lower|replace({'_': '-'}) %}
            <div class="decision-zone {{ dec }} mb-4">
              <div class="decision-big-icon">
                {% if 'urgent' in dec %}
                  <i class="fas fa-circle-exclamation"></i>
                {% elseif 'irriguer' in dec %}
                  <i class="fas fa-droplet"></i>
                {% elseif 'surveiller' in dec %}
                  <i class="fas fa-eye"></i>
                {% else %}
                  <i class="fas fa-check-circle"></i>
                {% endif %}
              </div>
              <div>
                <div class="decision-label">{{ analysis.analysis.decision|replace({'_': ' '}) }}</div>
                <div class="decision-qty">{{ analysis.analysis.quantite }}</div>
                <div class="decision-expl">{{ analysis.analysis.explication }}</div>
              </div>
            </div>

            {# Metrics tiles #}
            <div class="metrics-row mb-4">
              <div class="metric-tile">
                <div class="metric-tile-icon tile-amber">
                  <i class="fas fa-gauge-high"></i>
                </div>
                <div>
                  <div class="metric-tile-label">Score d'urgence</div>
                  <div class="metric-tile-value">{{ analysis.analysis.urgence }}%</div>
                  <div class="prog-bar" style="width:100%;"><div class="prog-fill" style="width:{{ analysis.analysis.urgence }}%"></div></div>
                </div>
              </div>

              <div class="metric-tile">
                <div class="metric-tile-icon tile-cyan">
                  <i class="fas fa-water"></i>
                </div>
                <div>
                  <div class="metric-tile-label">Évapotranspiration ET₀</div>
                  <div class="metric-tile-value">{{ analysis.analysis.et0 }} <small style="font-size:.6em;opacity:.7">mm/j</small></div>
                  <div class="metric-tile-sub">Besoin: {{ analysis.analysis.besoin_eau }} mm</div>
                </div>
              </div>

              <div class="metric-tile">
                <div class="metric-tile-icon tile-green">
                  <i class="fas fa-brain"></i>
                </div>
                <div>
                  <div class="metric-tile-label">Confiance IA</div>
                  <div class="metric-tile-value">{{ (analysis.analysis.confidence * 100)|round }}%</div>
                  <div class="metric-tile-sub">
                    {% if analysis.analysis.confidence >= 0.8 %}
                      <span style="color:var(--green-neon)">Excellente</span>
                    {% elseif analysis.analysis.confidence >= 0.6 %}
                      <span style="color:var(--amber-accent)">Bonne</span>
                    {% else %}
                      <span style="color:var(--red-alert)">Faible</span>
                    {% endif %}
                  </div>
                </div>
              </div>

              <div class="metric-tile">
                <div class="metric-tile-icon tile-purple">
                  <i class="fas fa-leaf"></i>
                </div>
                <div>
                  <div class="metric-tile-label">Économie d'eau</div>
                  <div class="metric-tile-value">{{ analysis.waterSavings.liters }}<small style="font-size:.6em;opacity:.7">L</small></div>
                  <div class="metric-tile-sub">{{ analysis.waterSavings.message }}</div>
                </div>
              </div>
            </div>

            {# Données terrain #}
            <div class="data-box">
              <div class="data-box-title">
                <i class="fas fa-satellite-dish"></i>
                Données terrain actuelles
              </div>
              <div class="data-items">
                <div class="data-item-pill">
                  <i class="fas fa-temperature-high" style="color:var(--red-alert)"></i>
                  <span class="label">Temp.</span>
                  <span class="val">{{ currentData.temperature }}°C</span>
                </div>
                <div class="data-item-pill">
                  <i class="fas fa-droplet" style="color:var(--cyan-accent)"></i>
                  <span class="label">Humidité</span>
                  <span class="val">{{ currentData.humidite }}%</span>
                </div>
                <div class="data-item-pill">
                  <i class="fas fa-cloud-rain" style="color:#818cf8"></i>
                  <span class="label">Pluie</span>
                  <span class="val">{{ currentData.pluie }} mm</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {# ─── RIGHT column ─── #}
      <div class="col-12 col-lg-5">

        {# Recommandation #}
        <div class="irrig-card mb-4 fade-up d2">
          <div class="card-head">
            <div class="card-head-title">
              <i class="fas fa-lightbulb"></i> Recommandation
            </div>
            {% set act = analysis.recommendation.action %}
            <span class="dec-badge
              {{ act == 'IMMEDIATE' ? 'irriguer-urgent' :
                 (act == 'SCHEDULE' ? 'irriguer' :
                 (act == 'DELAY' ? 'surveiller' : 'ok')) }}">
              {{ act }}
            </span>
          </div>
          <div class="card-body d-flex flex-column gap-3">
            <div class="rec-block">
              <div class="rec-block-icon
                {{ act == 'IMMEDIATE' ? 'tile-amber' : (act == 'SCHEDULE' ? 'tile-green' : 'tile-cyan') }}">
                {% if act == 'IMMEDIATE' %}<i class="fas fa-bolt"></i>
                {% elseif act == 'SCHEDULE' %}<i class="fas fa-clock"></i>
                {% elseif act == 'DELAY' %}<i class="fas fa-pause"></i>
                {% else %}<i class="fas fa-times-circle"></i>{% endif %}
              </div>
              <div>
                <div class="rec-label">Action</div>
                <div class="rec-value">
                  {% if act == 'IMMEDIATE' %}Action immédiate
                  {% elseif act == 'SCHEDULE' %}Programmer
                  {% elseif act == 'DELAY' %}Reporter
                  {% else %}Annuler{% endif %}
                </div>
                <div class="rec-detail">{{ analysis.recommendation.reasoning }}</div>
              </div>
            </div>

            <div class="data-items">
              <div class="data-item-pill">
                <i class="fas fa-calendar-alt" style="color:var(--green-neon)"></i>
                <span class="label">Date</span>
                <span class="val">{{ analysis.recommendation.scheduled_date|date('d/m/Y H:i') }}</span>
              </div>
              <div class="data-item-pill">
                <i class="fas fa-droplet" style="color:var(--cyan-accent)"></i>
                <span class="label">Quantité</span>
                <span class="val">{{ analysis.recommendation.quantity }}</span>
              </div>
            </div>
          </div>
        </div>

        {# Météo #}
        <div class="irrig-card mb-4 fade-up d3">
          <div class="card-head">
            <div class="card-head-title">
              <i class="fas fa-cloud-sun"></i> Prévisions météo
            </div>
            <span class="conf-badge hi">{{ (analysis.weatherForecast.confidence * 100)|round }}%</span>
          </div>
          <div class="card-body">
            <div class="weather-row mb-3">
              <div class="weather-pill">
                <i class="fas fa-temperature-high" style="color:var(--red-alert)"></i>
                <div class="wp-val">{{ analysis.weatherForecast.temperature_forecast }}°C</div>
                <div class="wp-label">Temp</div>
              </div>
              <div class="weather-pill">
                <i class="fas fa-cloud-rain" style="color:#818cf8"></i>
                <div class="wp-val">{{ analysis.weatherForecast.rain_forecast }}mm</div>
                <div class="wp-label">Pluie</div>
              </div>
              <div class="weather-pill">
                <i class="fas fa-droplet" style="color:var(--cyan-accent)"></i>
                <div class="wp-val">{{ analysis.weatherForecast.humidity_forecast }}%</div>
                <div class="wp-label">Humidité</div>
              </div>
            </div>
            {% if analysis.weatherForecast.next_rain_date %}
              <div class="weather-alert-box">
                <i class="fas fa-umbrella"></i>
                Pluie prévue le {{ analysis.weatherForecast.next_rain_date|date('d/m/Y') }}
              </div>
            {% endif %}
          </div>
        </div>

        {# Conseils IA #}
        <div class="irrig-card fade-up d4">
          <div class="card-head">
            <div class="card-head-title">
              <i class="fas fa-star"></i> Conseils IA
            </div>
          </div>
          <ul class="tips-list mb-0">
            {% for tip in analysis.optimizationTips %}
              <li class="tip-item">{{ tip }}</li>
            {% endfor %}
          </ul>
        </div>

      </div>
    </div>

    {# ══════════ STATS ══════════ #}
    <div class="section-label">Statistiques 30 jours</div>

    <div class="row g-4 mb-4">
      <div class="col-12 col-md-4 fade-up d2">
        <div class="irrig-card">
          <div class="stat-big c-green" style="color:var(--green-neon)">
            <div class="stat-big-icon"><i class="fas fa-chart-pie"></i></div>
            <div class="stat-big-label">Économie totale</div>
            <div class="stat-big-num c-green">{{ totalWaterSavings }}L</div>
            <div class="stat-big-sub">{{ (totalWaterSavings / 1000)|round(1) }} m³ économisés</div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4 fade-up d3">
        <div class="irrig-card">
          <div class="stat-big" style="color:var(--cyan-accent)">
            <div class="stat-big-icon" style="color:var(--cyan-accent)"><i class="fas fa-robot"></i></div>
            <div class="stat-big-label">Décisions IA</div>
            {% set total = 0 %}
            {% for stat in stats %}{% set total = total + stat.total %}{% endfor %}
            <div class="stat-big-num c-cyan">{{ total }}</div>
            <div class="stat-big-sub">analyses automatiques</div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4 fade-up d4">
        <div class="col-12 col-md-4 fade-up d4">
  <div class="irrig-card">
    <div class="stat-big" style="color:var(--amber-accent)">
      <div class="stat-big-icon" style="color:var(--amber-accent)"><i class="fas fa-check-circle"></i></div>
      <div class="stat-big-label">Précision moyenne</div>
      
      {# ✅ PROTECTION DIVISION PAR ZÉRO #}
      {% if stats|length > 0 %}
        {% set avgConf = 0 %}
        {% for stat in stats %}{% set avgConf = avgConf + stat.avg_confidence %}{% endfor %}
        <div class="stat-big-num c-amber">{{ ((avgConf / stats|length) * 100)|round }}%</div>
        <div class="stat-big-sub">confiance IA</div>
      {% else %}
        <div class="stat-big-num c-amber" style="font-size:1.5rem;">—</div>
        <div class="stat-big-sub" style="color:var(--text-muted);">Aucune donnée</div>
      {% endif %}
      
    </div>
  </div>
</div>

    {# ══════════ HISTORIQUE ══════════ #}
    <div class="section-label">Historique des décisions</div>

    <div class="irrig-card fade-up d5">
      <div class="card-head">
        <div class="card-head-title">
          <i class="fas fa-history"></i> Dernières décisions
        </div>
        <a style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:rgba(74,222,128,.08);border:1px solid var(--agri-border-m);border-radius:8px;color:var(--green-neon);font-size:.78rem;font-weight:600;text-decoration:none;transition:all .2s;"
           onmouseover="this.style.background='rgba(74,222,128,.18)'"
           onmouseout="this.style.background='rgba(74,222,128,.08)'"
           href="{{ path('irrigation_historique', {idproject: idproject}) }}">
          <i class="fas fa-external-link-alt"></i> Voir tout
        </a>
      </div>
      <div style="overflow-x:auto;">
        <table class="irrig-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Décision</th>
              <th>Quantité</th>
              <th>Confiance</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {% for decision in historiqueDecisions %}
              <tr>
                <td>{{ decision.createdAt|date('d/m/Y H:i') }}</td>
                <td>
                  <span class="dec-badge {{ decision.decision|lower|replace({'_': '-'}) }}">
                    {{ decision.decision|replace({'_': ' '}) }}
                  </span>
                </td>
                <td style="color:var(--text-primary);font-weight:500;">{{ decision.quantite }}</td>
                <td style="min-width:120px;">
                  <div class="conf-bar mb-1">
                    <div class="conf-fill" style="width:{{ (decision.confidence * 100) }}%"></div>
                  </div>
                  <span style="font-size:.72rem;color:var(--text-muted);">{{ (decision.confidence * 100)|round }}%</span>
                </td>
                <td>
                  <button class="btn-detail" onclick="showDetails({{ decision.inputData|json_encode }})">
                    <i class="fas fa-eye"></i> Voir
                  </button>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

{# ══════════ MODAL ══════════ #}
<div class="modal fade irrig-modal" id="detailsModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-database me-2"></i>Détails de la décision</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="modalBody"></div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    function showDetails(data) {
      const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
      document.getElementById('modalBody').innerHTML = `
        <div class="modal-data-row">
          <span class="modal-data-key">🌡 Température</span>
          <span class="modal-data-val">${data.temperature ?? '—'}°C</span>
        </div>
        <div class="modal-data-row">
          <span class="modal-data-key">💧 Humidité sol</span>
          <span class="modal-data-val">${data.humidite ?? '—'}%</span>
        </div>
        <div class="modal-data-row">
          <span class="modal-data-key">🌧 Pluie</span>
          <span class="modal-data-val">${data.pluie ?? '—'} mm</span>
        </div>
      `;
      modal.show();
    }

    /* Animate progress bars on load */
    document.querySelectorAll('.prog-fill').forEach(el => {
      const w = el.style.width;
      el.style.width = '0';
      setTimeout(() => { el.style.width = w; }, 300);
    });
  </script>
{% endblock %}
