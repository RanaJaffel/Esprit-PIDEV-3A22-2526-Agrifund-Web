{% extends 'base.html.twig' %}
{% block title %}Irrigation IA — Projet #{{ idproject }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
/* ═══════════════════════════════════════
   IRRIGATION IA — PREMIUM LIGHT DESIGN
   ═══════════════════════════════════════ */

:root {
  --bg-page:   #f4f6f9;
  --bg-card:   #ffffff;
  --bg-soft:   #f0f2f5;

  --green-50:  #EAF3DE;
  --green-600: #3B6D11;
  --green-800: #27500A;
  --green-200: #C0DD97;
  --green-mid: #639922;

  --amber-50:  #FAEEDA;
  --amber-600: #854F0B;
  --amber-800: #633806;
  --amber-200: #FAC775;
  --amber-mid: #EF9F27;

  --red-50:    #FCEBEB;
  --red-600:   #A32D2D;
  --red-800:   #501313;
  --red-200:   #F7C1C1;
  --red-mid:   #E24B4A;

  --blue-50:   #E6F1FB;
  --blue-600:  #185FA5;
  --blue-800:  #0C447C;
  --blue-200:  #B5D4F4;

  --text-main:    #111827;
  --text-muted:   #6b7280;
  --text-faint:   #9ca3af;
  --border:       #e5e7eb;
  --border-light: #f0f2f5;

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body { background: var(--bg-page); }

.iw {
  font-family: 'DM Sans', sans-serif;
  color: var(--text-main);
  min-height: 100vh;
  background: var(--bg-page);
}

.iw-inner {
  max-width: 1320px;
  margin: auto;
  padding: 32px 24px;
}

/* ── HERO ── */
.hero {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 20px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid var(--border);
  box-shadow: 0 1px 4px rgba(0,0,0,.04);
  margin-bottom: 20px;
}
.hero-left { display: flex; align-items: center; gap: 14px; }
.hero-icon {
  width: 48px; height: 48px;
  background: var(--green-50);
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; flex-shrink: 0;
}
.hero-title { font-size: 18px; font-weight: 600; line-height: 1.2; }
.hero-title .accent { color: var(--green-600); }
.hero-sub { font-size: 12px; color: var(--text-muted); margin-top: 3px; }
.hero-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

/* ── BADGES / PILLS ── */
.badge {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 4px 12px; border-radius: 100px;
  font-size: 11px; font-weight: 500; border: 1px solid;
}
.badge-green { background: var(--green-50); color: var(--green-800); border-color: var(--green-200); }
.badge-amber { background: var(--amber-50); color: var(--amber-800); border-color: var(--amber-200); }
.badge-red   { background: var(--red-50);   color: var(--red-800);   border-color: var(--red-200);  }
.badge-blue  { background: var(--blue-50);  color: var(--blue-800);  border-color: var(--blue-200); }
.badge-gray  { background: var(--bg-soft);  color: var(--text-muted); border-color: var(--border);  }

.pulse-dot {
  display: inline-block; width: 6px; height: 6px;
  border-radius: 50%; background: var(--green-mid);
  animation: pulse 1.8s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.35;transform:scale(.65)} }

/* ── CARD ── */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  box-shadow: 0 1px 4px rgba(0,0,0,.04);
  overflow: hidden;
}
.card-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 18px;
  border-bottom: 1px solid var(--border-light);
}
.card-head-title {
  font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: .07em;
  color: var(--text-muted);
  display: flex; align-items: center; gap: 6px;
}
.card-body { padding: 18px; }

/* ── LAYOUT GRID ── */
.main-row {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 16px;
  margin-bottom: 20px;
}
.right-col { display: flex; flex-direction: column; gap: 14px; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.grid-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 20px; }

/* ── DECISION ZONE ── */
.decision-zone {
  border-radius: var(--radius-md);
  padding: 16px 18px;
  display: flex; align-items: flex-start; gap: 14px;
  margin-bottom: 16px;
}
.dz-green { background: var(--green-50); }
.dz-amber { background: var(--amber-50); }
.dz-red   { background: var(--red-50); }
.dz-icon  { font-size: 22px; line-height: 1; padding-top: 2px; }
.dz-label { font-size: 15px; font-weight: 600; }
.dz-green .dz-label { color: var(--green-800); }
.dz-amber .dz-label { color: var(--amber-800); }
.dz-red   .dz-label { color: var(--red-800); }
.dz-qty   { font-size: 12px; font-weight: 500; color: var(--text-muted); margin-top: 3px; }
.dz-expl  { font-size: 11px; color: var(--text-faint); margin-top: 5px; line-height: 1.45; }

/* ── METRIC TILES ── */
.metric-tile {
  background: var(--bg-soft);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
}
.mt-label { font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-faint); margin-bottom: 5px; }
.mt-value { font-size: 20px; font-weight: 600; line-height: 1; }
.mt-sub   { font-size: 10px; color: var(--text-muted); margin-top: 5px; }
.prog { height: 3px; background: var(--border); border-radius: 100px; margin-top: 8px; overflow: hidden; }
.prog-fill { height: 100%; border-radius: 100px; transition: width .8s ease; }
.prog-green  { background: var(--green-mid); }
.prog-amber  { background: var(--amber-mid); }
.prog-red    { background: var(--red-mid); }

/* ── DATA PILLS ── */
.pill-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
.data-pill {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: 100px;
  padding: 5px 12px;
  font-size: 11px;
  display: flex; align-items: center; gap: 6px;
}
.pill-label { color: var(--text-muted); }
.pill-val   { font-weight: 500; }

/* ── SECTION LABEL ── */
.section-label {
  font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: .07em;
  color: var(--text-muted);
  margin: 0 0 10px;
}

/* ── RECOMMENDATION ── */
.rec-row { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
.rec-icon {
  width: 36px; height: 36px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; flex-shrink: 0;
}
.ri-amber { background: var(--amber-50); }
.ri-green { background: var(--green-50); }
.ri-blue  { background: var(--blue-50); }
.ri-red   { background: var(--red-50); }
.rec-act-label { font-size: 10px; color: var(--text-faint); }
.rec-act-val   { font-size: 13px; font-weight: 500; }
.rec-detail    { font-size: 11px; color: var(--text-muted); margin-top: 3px; line-height: 1.45; }

/* ── WEATHER ── */
.weather-pill {
  background: var(--bg-soft);
  border-radius: var(--radius-sm);
  padding: 12px;
  text-align: center;
}
.wp-icon  { font-size: 18px; }
.wp-val   { font-size: 15px; font-weight: 600; margin: 5px 0 2px; }
.wp-label { font-size: 10px; color: var(--text-muted); }

.rain-alert {
  background: var(--blue-50);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  font-size: 11px;
  color: var(--blue-800);
  display: flex; align-items: center; gap: 8px;
  margin-top: 10px;
}

/* ── TIPS ── */
.tip-item {
  padding: 9px 18px;
  font-size: 12px;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border-light);
  display: flex; align-items: flex-start; gap: 8px;
  line-height: 1.45;
}
.tip-item:last-child { border-bottom: none; }
.tip-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--green-mid); margin-top: 5px; flex-shrink: 0; }

/* ── STAT BIG ── */
.stat-card { padding: 24px 18px; text-align: center; }
.stat-icon  { font-size: 22px; margin-bottom: 10px; }
.stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); margin-bottom: 8px; }
.stat-num   { font-size: 28px; font-weight: 600; line-height: 1; }
.stat-sub   { font-size: 10px; color: var(--text-faint); margin-top: 5px; }
.c-green  { color: var(--green-600); }
.c-blue   { color: var(--blue-600); }
.c-amber  { color: var(--amber-600); }

/* ── TABLE ── */
.table-wrap { overflow-x: auto; }
.irrig-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.irrig-table th {
  text-align: left; padding: 10px 16px;
  background: var(--bg-soft);
  color: var(--text-muted);
  font-size: 10px; text-transform: uppercase; letter-spacing: .06em; font-weight: 500;
}
.irrig-table td { padding: 12px 16px; border-bottom: 1px solid var(--border-light); }
.irrig-table tr:last-child td { border-bottom: none; }
.irrig-table td.date { color: var(--text-muted); }

.conf-bar-wrap { display: flex; align-items: center; gap: 8px; }
.conf-bar  { flex: 1; height: 3px; background: var(--border); border-radius: 100px; overflow: hidden; }
.conf-fill { height: 100%; border-radius: 100px; }
.conf-pct  { font-size: 10px; color: var(--text-muted); min-width: 30px; }

/* ── BUTTONS ── */
.btn-back {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  font-size: 12px;
  text-decoration: none;
  color: var(--text-main);
  display: inline-flex; align-items: center; gap: 6px;
}
.btn-back:hover { background: var(--border); }

.btn-sm {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 5px 11px;
  font-size: 11px;
  cursor: pointer;
  color: var(--text-main);
  text-decoration: none;
  display: inline-flex; align-items: center; gap: 5px;
}
.btn-sm:hover { background: var(--border-light); }

/* ── MODAL ── */
.irrig-modal .modal-content {
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  font-family: 'DM Sans', sans-serif;
}
.modal-data-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid var(--border-light);
  font-size: 13px;
}
.modal-data-row:last-child { border-bottom: none; }
.modal-data-key { color: var(--text-muted); }
.modal-data-val { font-weight: 500; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .main-row { grid-template-columns: 1fr; }
  .grid-stats { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .hero { flex-direction: column; align-items: flex-start; gap: 14px; }
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
}
  </style>
{% endblock %}

{% block body %}
<div class="iw">
  <div class="iw-inner">

    {# ══════════ HERO ══════════ #}
    <div class="hero">
      <div class="hero-left">
        <div class="hero-icon"><i class="fas fa-droplet"></i></div>
        <div>
          <div class="hero-title">
            Irrigation IA — <span class="accent">Projet #{{ idproject }}</span>
          </div>
          <div class="hero-sub">Analyse IA temps réel · Recommandations · Prévisions météo</div>
        </div>
      </div>
      <div class="hero-actions">
        <span class="badge badge-green">
          <span class="pulse-dot"></span> IA Active
        </span>
        <a class="btn-back" href="{{ path('app_dashboard', {idproject: idproject}) }}">
          <i class="fas fa-arrow-left"></i> Dashboard
        </a>
      </div>
    </div>

    {# ══════════ MAIN ROW ══════════ #}
    <div class="main-row">

      {# ─── LEFT: Analyse principale ─── #}
      <div class="card">
        <div class="card-head">
          <div class="card-head-title">
            <i class="fas fa-brain"></i> Analyse IA en temps réel
          </div>
          <span class="badge {{ analysis.analysis.confidence >= 0.8 ? 'badge-green' : (analysis.analysis.confidence >= 0.6 ? 'badge-amber' : 'badge-red') }}">
            <i class="fas fa-shield-alt"></i>
            Confiance {{ (analysis.analysis.confidence * 100)|round }}%
          </span>
        </div>
        <div class="card-body">

          {# Decision zone #}
          {% set dec = analysis.analysis.decision|lower|replace({'_': '-'}) %}
          {% set dz_class = 'urgent' in dec ? 'dz-red' : ('irriguer' in dec ? 'dz-green' : 'dz-amber') %}
          <div class="decision-zone {{ dz_class }}">
            <div class="dz-icon">
              {% if 'urgent' in dec %}<i class="fas fa-circle-exclamation"></i>
              {% elseif 'irriguer' in dec %}<i class="fas fa-droplet"></i>
              {% elseif 'surveiller' in dec %}<i class="fas fa-eye"></i>
              {% else %}<i class="fas fa-check-circle"></i>{% endif %}
            </div>
            <div>
              <div class="dz-label">{{ analysis.analysis.decision|replace({'_': ' '}) }}</div>
              <div class="dz-qty">{{ analysis.analysis.quantite }}</div>
              <div class="dz-expl">{{ analysis.analysis.explication }}</div>
            </div>
          </div>

          {# Metric tiles #}
          <div class="grid-2" style="gap:10px;margin-bottom:16px;">

            <div class="metric-tile">
              <div class="mt-label"><i class="fas fa-gauge-high"></i> Score d'urgence</div>
              <div class="mt-value {{ analysis.analysis.urgence >= 70 ? 'c-amber' : '' }}">
                {{ analysis.analysis.urgence }}%
              </div>
              <div class="prog">
                <div class="prog-fill {{ analysis.analysis.urgence >= 70 ? 'prog-amber' : 'prog-green' }}"
                     style="width:{{ analysis.analysis.urgence }}%"></div>
              </div>
            </div>

            <div class="metric-tile">
              <div class="mt-label"><i class="fas fa-water"></i> ET₀ Évapotranspiration</div>
              <div class="mt-value">
                {{ analysis.analysis.et0 }} <small style="font-size:11px;font-weight:400;color:var(--text-muted)">mm/j</small>
              </div>
              <div class="mt-sub">Besoin : {{ analysis.analysis.besoin_eau }} mm</div>
            </div>

            <div class="metric-tile">
              <div class="mt-label"><i class="fas fa-brain"></i> Confiance IA</div>
              <div class="mt-value c-green">{{ (analysis.analysis.confidence * 100)|round }}%</div>
              <div class="mt-sub">
                {% if analysis.analysis.confidence >= 0.8 %}
                  <span style="color:var(--green-mid)">Excellente</span>
                {% elseif analysis.analysis.confidence >= 0.6 %}
                  <span style="color:var(--amber-mid)">Bonne</span>
                {% else %}
                  <span style="color:var(--red-mid)">Faible</span>
                {% endif %}
              </div>
            </div>

            <div class="metric-tile">
              <div class="mt-label"><i class="fas fa-leaf"></i> Économie d'eau</div>
              <div class="mt-value c-blue">
                {{ analysis.waterSavings.liters }}<small style="font-size:11px;font-weight:400;color:var(--text-muted)"> L</small>
              </div>
              <div class="mt-sub">{{ analysis.waterSavings.message }}</div>
            </div>

          </div>

          {# Données terrain #}
          <div class="mt-label" style="margin-bottom:8px;">
            <i class="fas fa-satellite-dish"></i> Données terrain actuelles
          </div>
          <div class="pill-row">
            <div class="data-pill">
              <i class="fas fa-temperature-high" style="color:var(--red-mid)"></i>
              <span class="pill-label">Temp.</span>
              <span class="pill-val">{{ currentData.temperature }}°C</span>
            </div>
            <div class="data-pill">
              <i class="fas fa-droplet" style="color:#185FA5"></i>
              <span class="pill-label">Humidité</span>
              <span class="pill-val">{{ currentData.humidite }}%</span>
            </div>
            <div class="data-pill">
              <i class="fas fa-cloud-rain" style="color:var(--green-mid)"></i>
              <span class="pill-label">Pluie</span>
              <span class="pill-val">{{ currentData.pluie }} mm</span>
            </div>
          </div>

        </div>
      </div>

      {# ─── RIGHT column ─── #}
      <div class="right-col">

        {# Recommandation #}
        <div class="card">
          <div class="card-head">
            <div class="card-head-title"><i class="fas fa-lightbulb"></i> Recommandation</div>
            {% set act = analysis.recommendation.action %}
            <span class="badge {{ act == 'IMMEDIATE' ? 'badge-red' : (act == 'SCHEDULE' ? 'badge-amber' : 'badge-gray') }}">
              {{ act }}
            </span>
          </div>
          <div class="card-body">
            <div class="rec-row">
              <div class="rec-icon {{ act == 'IMMEDIATE' ? 'ri-red' : (act == 'SCHEDULE' ? 'ri-amber' : 'ri-blue') }}">
                {% if act == 'IMMEDIATE' %}<i class="fas fa-bolt" style="color:var(--red-600)"></i>
                {% elseif act == 'SCHEDULE' %}<i class="fas fa-clock" style="color:var(--amber-600)"></i>
                {% elseif act == 'DELAY' %}<i class="fas fa-pause" style="color:#185FA5"></i>
                {% else %}<i class="fas fa-times-circle" style="color:var(--text-muted)"></i>{% endif %}
              </div>
              <div>
                <div class="rec-act-label">Action recommandée</div>
                <div class="rec-act-val">
                  {% if act == 'IMMEDIATE' %}Action immédiate
                  {% elseif act == 'SCHEDULE' %}Programmer
                  {% elseif act == 'DELAY' %}Reporter
                  {% else %}Annuler{% endif %}
                </div>
                <div class="rec-detail">{{ analysis.recommendation.reasoning }}</div>
              </div>
            </div>
            <div class="pill-row" style="margin-top:0;">
              <div class="data-pill">
                <i class="fas fa-calendar-alt" style="color:var(--green-mid)"></i>
                <span class="pill-label">Date</span>
                <span class="pill-val">{{ analysis.recommendation.scheduled_date|date('d/m/Y H:i') }}</span>
              </div>
              <div class="data-pill">
                <i class="fas fa-droplet" style="color:#185FA5"></i>
                <span class="pill-label">Quantité</span>
                <span class="pill-val">{{ analysis.recommendation.quantity }}</span>
              </div>
            </div>
          </div>
        </div>

        {# Météo #}
        <div class="card">
          <div class="card-head">
            <div class="card-head-title"><i class="fas fa-cloud-sun"></i> Prévisions météo</div>
            <span class="badge badge-green">
              {{ (analysis.weatherForecast.confidence * 100)|round }}%
            </span>
          </div>
          <div class="card-body">
            <div class="grid-3" style="gap:8px;">
              <div class="weather-pill">
                <div class="wp-icon"><i class="fas fa-temperature-high" style="color:var(--red-mid)"></i></div>
                <div class="wp-val">{{ analysis.weatherForecast.temperature_forecast }}°C</div>
                <div class="wp-label">Température</div>
              </div>
              <div class="weather-pill">
                <div class="wp-icon"><i class="fas fa-cloud-rain" style="color:#185FA5"></i></div>
                <div class="wp-val">{{ analysis.weatherForecast.rain_forecast }} mm</div>
                <div class="wp-label">Précipitations</div>
              </div>
              <div class="weather-pill">
                <div class="wp-icon"><i class="fas fa-droplet" style="color:var(--green-mid)"></i></div>
                <div class="wp-val">{{ analysis.weatherForecast.humidity_forecast }}%</div>
                <div class="wp-label">Humidité</div>
              </div>
            </div>
            {% if analysis.weatherForecast.next_rain_date %}
              <div class="rain-alert">
                <i class="fas fa-umbrella"></i>
                <span>Pluie prévue le <strong>{{ analysis.weatherForecast.next_rain_date|date('d/m/Y') }}</strong></span>
              </div>
            {% endif %}
          </div>
        </div>

        {# Conseils IA #}
        <div class="card">
          <div class="card-head">
            <div class="card-head-title"><i class="fas fa-star"></i> Conseils IA</div>
          </div>
          {% for tip in analysis.optimizationTips %}
            <div class="tip-item">
              <div class="tip-dot"></div>
              <span>{{ tip }}</span>
            </div>
          {% endfor %}
        </div>

      </div>
    </div>

    {# ══════════ STATS ══════════ #}
    <div class="section-label">Statistiques 30 jours</div>

    <div class="grid-stats">
      <div class="card">
        <div class="stat-card">
          <div class="stat-icon"><i class="fas fa-chart-pie" style="color:var(--green-mid)"></i></div>
          <div class="stat-label">Économie totale</div>
          <div class="stat-num c-green count-up" data-target="{{ totalWaterSavings }}">{{ totalWaterSavings }} L</div>
          <div class="stat-sub">{{ (totalWaterSavings / 1000)|round(1) }} m³ économisés</div>
        </div>
      </div>

      <div class="card">
        <div class="stat-card">
          <div class="stat-icon"><i class="fas fa-robot" style="color:#185FA5"></i></div>
          <div class="stat-label">Décisions IA</div>
          {% set total = 0 %}
          {% for stat in stats %}{% set total = total + stat.total %}{% endfor %}
          <div class="stat-num c-blue count-up" data-target="{{ total }}">{{ total }}</div>
          <div class="stat-sub">analyses automatiques</div>
        </div>
      </div>

      <div class="card">
        <div class="stat-card">
          <div class="stat-icon"><i class="fas fa-check-circle" style="color:var(--amber-mid)"></i></div>
          <div class="stat-label">Précision moyenne</div>
          {% if stats|length > 0 %}
            {% set avgConf = 0 %}
            {% for stat in stats %}{% set avgConf = avgConf + stat.avg_confidence %}{% endfor %}
            <div class="stat-num c-amber count-up" data-target="{{ ((avgConf / stats|length) * 100)|round }}">
              {{ ((avgConf / stats|length) * 100)|round }}%
            </div>
            <div class="stat-sub">confiance IA</div>
          {% else %}
            <div class="stat-num" style="color:var(--text-faint);font-size:1.6rem">—</div>
            <div class="stat-sub">Aucune donnée</div>
          {% endif %}
        </div>
      </div>
    </div>

    {# ══════════ HISTORIQUE ══════════ #}
    <div class="section-label">Historique des décisions</div>

    <div class="card">
      <div class="card-head">
        <div class="card-head-title"><i class="fas fa-history"></i> Dernières décisions</div>
        <a class="btn-sm" href="{{ path('irrigation_historique', {idproject: idproject}) }}">
          <i class="fas fa-external-link-alt"></i> Voir tout
        </a>
      </div>
      <div class="table-wrap">
        <table class="irrig-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Décision</th>
              <th>Quantité</th>
              <th>Confiance</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for decision in historiqueDecisions %}
              {% set d = decision.decision|lower|replace({'_': '-'}) %}
              <tr>
                <td class="date">{{ decision.createdAt|date('d/m/Y H:i') }}</td>
                <td>
                  <span class="badge {{ 'urgent' in d ? 'badge-red' : ('irriguer' in d ? 'badge-green' : 'badge-amber') }}">
                    {{ decision.decision|replace({'_': ' '}) }}
                  </span>
                </td>
                <td style="font-weight:500;">{{ decision.quantite }}</td>
                <td style="min-width:130px;">
                  <div class="conf-bar-wrap">
                    <div class="conf-bar">
                      <div class="conf-fill {{ (decision.confidence * 100) >= 80 ? 'prog-green' : ((decision.confidence * 100) >= 60 ? 'prog-amber' : 'prog-red') }}"
                           style="width:{{ (decision.confidence * 100) }}%"></div>
                    </div>
                    <span class="conf-pct">{{ (decision.confidence * 100)|round }}%</span>
                  </div>
                </td>
                <td>
                  <button class="btn-sm" onclick="showDetails({{ decision.inputData|json_encode }})">
                    <i class="fas fa-eye"></i> Voir
                  </button>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

{# ══════════ MODAL ══════════ #}
<div class="modal fade irrig-modal" id="detailsModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-database me-2"></i>Détails de la décision</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="modalBody"></div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    /* ── MODAL ── */
    function showDetails(data) {
      const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
      document.getElementById('modalBody').innerHTML = `
        <div class="modal-data-row">
          <span class="modal-data-key">🌡 Température</span>
          <span class="modal-data-val">${data.temperature ?? '—'}°C</span>
        </div>
        <div class="modal-data-row">
          <span class="modal-data-key">💧 Humidité sol</span>
          <span class="modal-data-val">${data.humidite ?? '—'}%</span>
        </div>
        <div class="modal-data-row">
          <span class="modal-data-key">🌧 Pluie</span>
          <span class="modal-data-val">${data.pluie ?? '—'} mm</span>
        </div>
      `;
      modal.show();
    }

    /* ── PROGRESS BARS ANIMATE ── */
    document.querySelectorAll('.prog-fill').forEach(el => {
      const w = el.style.width;
      el.style.width = '0';
      setTimeout(() => { el.style.transition = 'width .8s ease'; el.style.width = w; }, 300);
    });

    /* ── COUNT-UP ── */
    document.querySelectorAll('.count-up').forEach(el => {
      const target = parseInt(el.dataset.target) || 0;
      if (!target) return;
      const suffix = el.textContent.includes('L') ? ' L' : (el.textContent.includes('%') ? '%' : '');
      const duration = 1400;
      const start = performance.now();
      function update(now) {
        const p = Math.min((now - start) / duration, 1);
        const ease = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.floor(target * ease) + suffix;
        if (p < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
    });

    /* ── FADE-UP on scroll ── */
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.style.opacity = '1';
          e.target.style.transform = 'translateY(0)';
        }
      });
    }, { threshold: 0.08 });

    document.querySelectorAll('.card, .hero').forEach((el, i) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(14px)';
      el.style.transition = `opacity .4s ease ${i * 0.05}s, transform .4s ease ${i * 0.05}s`;
      obs.observe(el);
    });
  </script>
{% endblock %}
