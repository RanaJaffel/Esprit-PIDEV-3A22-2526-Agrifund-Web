{% extends 'base.html.twig' %}
{% block title %}Nouvelle Évaluation{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --vert-tres-fonce: #133D03;
            --vert-clair: #B2D944;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
        }
        .dashboard-container { display: flex; min-height: 100vh; }
        .main-content { flex: 1; margin-left: 280px; padding: 0; background: transparent; transition: margin-left 0.4s; }
        @media (max-width: 991.98px) { .main-content { margin-left: 0; } }

        .page-header {
            background: linear-gradient(135deg, #0a3d1f 0%, #1a5c35 100%);
            padding: 28px 35px;
            position: relative;
            overflow: hidden;
        }
        .page-header::after {
            content: '📊';
            position: absolute;
            right: 30px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 60px;
            opacity: 0.1;
        }

        .form-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.08);
            overflow: hidden;
        }
        .form-card-header {
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
            padding: 20px 28px;
            border-bottom: 1px solid #bbf7d0;
        }
        .form-card-body { padding: 32px; }

        .field-group { margin-bottom: 24px; }
        .field-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 700;
            color: #0a3d1f;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }
        .field-input {
            width: 100%;
            border: 2px solid #e5e7eb;
            border-radius: 14px;
            padding: 14px 18px;
            font-size: 0.95rem;
            transition: all 0.3s;
            background: #fafafa;
            color: #374151;
        }
        .field-input:focus {
            border-color: #16a34a;
            background: white;
            box-shadow: 0 0 0 4px rgba(22,163,74,0.1);
            outline: none;
        }
        .field-hint { font-size: 0.75rem; color: #9ca3af; margin-top: 6px; }

        .alert {
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: none;
        }
        .alert-success { background: #f0fdf4; border: 1px solid #86efac; color: #166534; }
        .alert-error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
        .alert.show { display: block; }

        textarea.field-input {
            min-height: 150px;
            resize: vertical;
            font-family: inherit;
            line-height: 1.5;
        }

        .ia-filled {
            background: linear-gradient(135deg, #f0fdf4, #dcfce7) !important;
            border-color: #86efac !important;
            color: #166534 !important;
        }

        .btn-submit, .btn-auto-eval {
            border: none;
            border-radius: 14px;
            padding: 16px 32px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .btn-submit {
            background: linear-gradient(135deg, #16a34a, #22c55e);
            color: white;
            box-shadow: 0 4px 20px rgba(22,163,74,0.3);
        }
        .btn-auto-eval {
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            box-shadow: 0 4px 20px rgba(59,130,246,0.3);
        }
        .btn-auto-eval:disabled { opacity: 0.6; cursor: not-allowed; }

        /* ==================== BOUTON RETOUR ==================== */
        .btn-back {
            background: rgba(255,255,255,0.15);
            color: white;
            border: 2px solid rgba(255,255,255,0.35);
            border-radius: 12px;
            padding: 10px 20px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
        }
        .btn-back:hover {
            background: rgba(255,255,255,0.3);
            color: white;
            transform: translateY(-2px);
        }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'components/_sidebar_banque.html.twig' %}
    <div class="main-content">
        <div class="page-header">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="text-white fw-bold mb-1">➕ Nouvelle Évaluation de Risque</h2>
                    <p class="mb-0" style="color:rgba(255,255,255,0.65); font-size:0.85rem;">
                        Évaluation automatique par IA des données capteurs
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-light d-md-none" id="mobileSidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <a href="{{ path('banque_evaluation_index') }}" class="btn-back">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
        </div>

        <div class="py-4">
            <div class="row justify-content-center">
                <div class="col-xl-8 col-lg-10">
                    <div id="alert-success" class="alert alert-success"></div>
                    <div id="alert-error" class="alert alert-error"></div>

                    <div class="form-card">
                        <div class="form-card-header">
                            <div class="d-flex align-items-center gap-2">
                                <span>📋</span>
                                <span style="font-weight:700; color:#15803d;">Informations de l'évaluation</span>
                            </div>
                        </div>
                        <div class="form-card-body">
                            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'eval-form'}}) }}
                            
                            <!-- Le reste de ton formulaire reste IDENTIQUE -->
                            <div class="field-group">
                                <label class="field-label">🌱 Projet Agricole *</label>
                                {{ form_widget(form.projet, {'attr': {'class': 'field-input projet-select'}}) }}
                                <div class="field-hint">Sélectionnez un projet puis cliquez sur "Évaluation Automatique"</div>
                            </div>

                            <button type="button" id="btn-auto-eval" class="btn-auto-eval" disabled>
                                <span>🤖</span>
                                <span>Évaluation Automatique (IA)</span>
                            </button>

                            <div id="loading" class="loading">
                                <span class="spinner">🔄</span>
                                <span>Analyse des données capteurs en cours...</span>
                            </div>

                            <div class="row-fields">
                                <div class="field-group">
                                    <label class="field-label">🎯 Score Global</label>
                                    {{ form_widget(form.scoreGlobal, {'attr': {'class': 'field-input', 'readonly': 'readonly'}}) }}
                                </div>
                                <div class="field-group">
                                    <label class="field-label">⚠️ Niveau de Risque</label>
                                    {{ form_widget(form.niveauRisque, {'attr': {'class': 'field-input'}}) }}
                                </div>
                            </div>

                            <div class="row-fields">
                                <div class="field-group">
                                    <label class="field-label">📋 Fiabilité des Données</label>
                                    {{ form_widget(form.fiabiliteDonnees, {'attr': {'class': 'field-input'}}) }}
                                </div>
                                <div class="field-group">
                                    <label class="field-label">💡 Recommandation</label>
                                    {{ form_widget(form.recommandation, {'attr': {'class': 'field-input'}}) }}
                                </div>
                            </div>

                            <div class="field-group">
                                <label class="field-label">📅 Date d'Évaluation *</label>
                                {{ form_widget(form.dateEvaluation, {'attr': {'class': 'field-input'}}) }}
                            </div>

                            <div class="field-group">
                                <label class="field-label">🔍 Analyse Détaillée & Conseils</label>
                                {{ form_widget(form.facteurPrincipal, {'attr': {'class': 'field-input', 'rows': '10', 'readonly': 'readonly'}}) }}
                            </div>

                            <button type="submit" class="btn-submit">
                                <i class="fas fa-save"></i> Enregistrer l'évaluation
                            </button>

                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.getElementById('mobileSidebarToggle')?.addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('show');
        });

        const projetSelect = document.querySelector('.projet-select');
        const btnAutoEval = document.getElementById('btn-auto-eval');
        const loading = document.getElementById('loading');
        const alertSuccess = document.getElementById('alert-success');
        const alertError = document.getElementById('alert-error');
        const form = document.getElementById('eval-form');

        projetSelect.addEventListener('change', () => btnAutoEval.disabled = !projetSelect.value);

        btnAutoEval.addEventListener('click', async function() {
            const idProjet = projetSelect.value;
            if (!idProjet) return showAlert('error', 'Veuillez sélectionner un projet !');

            loading.classList.add('show');
            btnAutoEval.disabled = true;
            hideAlerts();

            try {
                const url = '{{ path("banque_evaluation_auto_evaluate", {"idProjet": "__ID__"}) }}'.replace('__ID__', idProjet);
                const response = await fetch(url);
                const data = await response.json();
                if (data.error) throw new Error(data.error);

                form.querySelector('[name*="scoreGlobal"]').value = data.scoreGlobal;
                form.querySelector('[name*="niveauRisque"]').value = data.niveauRisque;
                
                let fiabVal = 'moyenne';
                if (data.fiabiliteDonnees.includes('Élevée')) fiabVal = 'elevee';
                else if (data.fiabiliteDonnees.includes('Faible')) fiabVal = 'faible';
                form.querySelector('[name*="fiabiliteDonnees"]').value = fiabVal;

                form.querySelector('[name*="recommandation"]').value = data.recommandation;
                form.querySelector('[name*="facteurPrincipal"]').value = data.facteurPrincipal;

                showAlert('success', `✅ Évaluation générée ! Score: ${data.scoreGlobal}/100`);
            } catch (error) {
                showAlert('error', '❌ ' + error.message);
            } finally {
                loading.classList.remove('show');
                btnAutoEval.disabled = false;
            }
        });

        function showAlert(type, message) {
            const alert = type === 'success' ? alertSuccess : alertError;
            alert.textContent = message;
            alert.classList.add('show');
        }

        function hideAlerts() {
            alertSuccess.classList.remove('show');
            alertError.classList.remove('show');
        }
    </script>
{% endblock %}