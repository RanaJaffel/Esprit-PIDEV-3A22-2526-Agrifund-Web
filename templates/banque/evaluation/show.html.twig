{% extends 'base.html.twig' %}
{% block title %}Détail Évaluation #{{ evaluation.idEvaluation }}{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        .detail-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.08);
            overflow: hidden;
        }
        .detail-header {
            padding: 30px 35px;
            color: white;
            background: linear-gradient(135deg, #0a3d1f, #1a5c35);
        }
        .detail-header.faible { background: linear-gradient(135deg, #166534, #22c55e); }
        .detail-header.moyen { background: linear-gradient(135deg, #92400e, #f59e0b); }
        .detail-header.eleve { background: linear-gradient(135deg, #7f1d1d, #ef4444); }

        .score-circle {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.8rem;
            font-weight: 800;
            color: white;
            border: 12px solid rgba(255,255,255,0.3);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            margin: 0 auto 15px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            padding: 35px;
        }
        .info-item {
            background: #f8fafc;
            padding: 18px;
            border-radius: 14px;
        }
        .info-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 6px;
        }
        .info-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1e2937;
        }
        .facteur-box {
            background: #f0fdf4;
            border-left: 5px solid #22c55e;
            padding: 25px;
            border-radius: 14px;
            margin: 0 35px 35px;
        }
        @media (max-width: 768px) {
            .info-grid { grid-template-columns: 1fr; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'components/_sidebar_banque.html.twig' %}

    <div class="main-content">
        <div class="page-header">
            <div class="d-flex align-items-center justify-content-between">
                <h2 class="text-white fw-bold">📋 Détail de l'Évaluation #{{ evaluation.idEvaluation }}</h2>
                <a href="{{ path('banque_evaluation_index') }}" class="btn btn-outline-light">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
            </div>
        </div>

        <div class="py-4 px-4">
            <div class="detail-card">
                <!-- Header -->
                <div class="detail-header {{ evaluation.niveauRisqueNormalized }}">
                    <div class="text-center">
                        <div class="score-circle" style="background: {% if evaluation.scoreGlobal >= 70 %}#22c55e{% elseif evaluation.scoreGlobal >= 40 %}#f59e0b{% else %}#ef4444{% endif %};">
                            {{ evaluation.scoreGlobal }}
                        </div>
                        <h3 class="mb-1">Score Global</h3>
                        <span class="badge fs-5 px-4 py-2" style="background:rgba(255,255,255,0.25);">
                            {{ evaluation.niveauRisqueNormalized|capitalize }} Risque
                        </span>
                    </div>
                </div>

                <!-- Contenu -->
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Projet Agricole</div>
                        <div class="info-value">{{ evaluation.projet ? evaluation.projet.nomproject : 'N/A' }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Date d'Évaluation</div>
                        <div class="info-value">{{ evaluation.dateEvaluation|date('d/m/Y à H:i') }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Niveau de Risque</div>
                        <div class="info-value">{{ evaluation.niveauRisque }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Fiabilité des Données</div>
                        <div class="info-value">{{ evaluation.fiabiliteDonnees }}</div>
                    </div>
                </div>

                <!-- Recommandation -->
                <div class="px-5 pb-4">
                    <div class="info-label">💡 Recommandation IA</div>
                    <div class="info-value" style="font-size:1.05rem; line-height:1.6;">
                        {{ evaluation.recommandation|nl2br }}
                    </div>
                </div>

                <!-- Facteur Principal -->
                <div class="facteur-box">
                    <div class="info-label mb-3">🔍 Analyse Détaillée & Conseils</div>
                    <div style="white-space: pre-line; line-height:1.7;">
                        {{ evaluation.facteurPrincipal }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}