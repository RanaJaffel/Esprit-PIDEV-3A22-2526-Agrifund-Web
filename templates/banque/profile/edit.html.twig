{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('sidebar') }}
    {{ encore_entry_link_tags('banque') }}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --gris: #848A86;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --jaune-fonce: #c9a020;
            --vert-clair: #B2D944;
            --olive: #9A951F;
            --vert-olive-fonce: #476C1A;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
        }

        .dashboard-container { display: flex; min-height: 100vh; }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 0;
            background: transparent;
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 991.98px) {
            .main-content { margin-left: 0; }
        }

        /* ==========================================
           HEADER
        ========================================== */
        .main-content > .d-flex.justify-content-between:first-of-type {
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 50%, var(--vert-tres-fonce) 100%);
            padding: 28px 35px;
            margin: 0 0 30px 0;
            position: relative;
            overflow: hidden;
        }

        .main-content > .d-flex.justify-content-between:first-of-type::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='20' y='15' width='20' height='30' rx='3' fill='%23E1B323' fill-opacity='0.04'/%3E%3Cpath d='M25 25 L35 25 M25 30 L35 30 M25 35 L32 35' stroke='%23E1B323' stroke-opacity='0.05' stroke-width='1'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .main-content > .d-flex.justify-content-between:first-of-type::after {
            content: '';
            position: absolute;
            top: -50%; right: -10%;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(225, 179, 35, 0.1) 0%, transparent 70%);
            pointer-events: none;
            animation: floatGlow 8s ease-in-out infinite;
        }

        @keyframes floatGlow {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-20px, 20px) scale(1.1); }
        }

        .main-content > .d-flex.justify-content-between:first-of-type h1 {
            color: white !important;
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .main-content > .d-flex.justify-content-between:first-of-type h1 i {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, var(--olive) 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            box-shadow: 0 8px 20px rgba(225, 179, 35, 0.35);
            margin-right: 0 !important;
        }

        .main-content > .d-flex.justify-content-between:first-of-type .btn-secondary {
            background: rgba(255, 255, 255, 0.15) !important;
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
            color: white !important;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .main-content > .d-flex.justify-content-between:first-of-type .btn-secondary:hover {
            background: rgba(239, 68, 68, 0.8) !important;
            border-color: rgba(239, 68, 68, 0.8) !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.3);
        }

        /* ==========================================
           CONTENT AREA
        ========================================== */
        .main-content > .row {
            margin-left: 35px;
            margin-right: 35px;
        }

        @media (max-width: 768px) {
            .main-content > .row {
                margin-left: 20px;
                margin-right: 20px;
            }
        }

        /* ==========================================
           DASHBOARD SECTION
        ========================================== */
        .dashboard-section {
            background: white;
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.6s ease-out forwards;
            opacity: 0;
        }

        .dashboard-section::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair), var(--jaune-moutarde), var(--olive));
        }

        .dashboard-section::after {
            content: '\f19c';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute;
            bottom: 30px;
            right: 40px;
            font-size: 8rem;
            color: var(--jaune-moutarde);
            opacity: 0.03;
            pointer-events: none;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ==========================================
           SECTION TITLES
        ========================================== */
        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--vert-tres-fonce);
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(225, 179, 35, 0.15);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, var(--olive) 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 0.95rem;
            box-shadow: 0 4px 12px rgba(225, 179, 35, 0.25);
        }

        /* ==========================================
           FORM STYLING
        ========================================== */
        .form-label {
            font-weight: 600;
            color: var(--vert-tres-fonce);
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .form-control,
        .form-select {
            border: 2px solid #e8ecef;
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: #fafbfc;
            color: var(--vert-tres-fonce);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--jaune-moutarde);
            box-shadow: 0 0 0 4px rgba(225, 179, 35, 0.12);
            background: white;
            outline: none;
        }

        .form-control:hover,
        .form-select:hover {
            border-color: var(--jaune-fonce);
        }

        .form-control::placeholder {
            color: #a0aec0;
        }

        /* File Input */
        input[type="file"].form-control {
            padding: 14px 18px;
            cursor: pointer;
            background: linear-gradient(135deg, #fafbfc 0%, #f8f5e8 100%);
            border: 2px dashed rgba(225, 179, 35, 0.3);
            min-height: 80px;
        }

        input[type="file"].form-control:hover {
            border-color: var(--jaune-moutarde);
            background: linear-gradient(135deg, #fdf9e8 0%, #faf5dc 100%);
        }

        input[type="file"].form-control::-webkit-file-upload-button {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, var(--olive) 100%);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            margin-right: 15px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(225, 179, 35, 0.25);
        }

        input[type="file"].form-control::-webkit-file-upload-button:hover {
            background: linear-gradient(135deg, var(--olive) 0%, var(--jaune-fonce) 100%);
            transform: translateY(-2px);
        }

        /* ==========================================
           IMAGE PREVIEW
        ========================================== */
        .img-thumbnail {
            border: 4px solid var(--jaune-moutarde) !important;
            border-radius: 16px !important;
            padding: 5px;
            background: white;
            box-shadow: 0 8px 25px rgba(225, 179, 35, 0.2);
            transition: all 0.4s ease;
        }

        .img-thumbnail:hover {
            transform: scale(1.05) rotate(2deg);
            box-shadow: 0 12px 35px rgba(225, 179, 35, 0.3);
        }

        .current-image-box {
            padding: 15px;
            background: linear-gradient(135deg, #fdf9e8 0%, #f8f5dc 100%);
            border-radius: 12px;
            border: 2px dashed rgba(225, 179, 35, 0.2);
        }

        .current-image-box p {
            font-weight: 600;
            color: var(--jaune-fonce) !important;
            font-size: 0.85rem;
        }

        /* ==========================================
           HR DIVIDER
        ========================================== */
        hr.my-4 {
            border: none;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--jaune-moutarde), var(--vert-clair), var(--jaune-moutarde), transparent);
            margin: 35px 0;
            opacity: 0.3;
        }

        /* ==========================================
           ALERT INFO
        ========================================== */
        .alert-info {
            background: linear-gradient(135deg, rgba(225, 179, 35, 0.1) 0%, rgba(154, 149, 31, 0.08) 100%);
            border: none;
            border-left: 5px solid var(--jaune-moutarde);
            border-radius: 14px;
            padding: 18px 24px;
            color: var(--vert-tres-fonce);
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 25px;
        }

        .alert-info i {
            font-size: 1.2rem;
            color: var(--jaune-moutarde);
        }

        /* ==========================================
           ACTION BUTTONS
        ========================================== */
        .d-grid.gap-2 {
            gap: 15px !important;
            margin-top: 10px;
        }

        .d-grid .btn-warning.btn-lg {
            background: linear-gradient(135deg, var(--jaune-moutarde) 0%, var(--olive) 100%) !important;
            border: none !important;
            border-radius: 14px;
            padding: 18px 32px;
            font-weight: 700;
            font-size: 1.05rem;
            box-shadow: 0 8px 30px rgba(225, 179, 35, 0.3);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            position: relative;
            overflow: hidden;
            color: white !important;
        }

        .d-grid .btn-warning.btn-lg::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
            transition: left 0.5s ease;
        }

        .d-grid .btn-warning.btn-lg:hover::before {
            left: 100%;
        }

        .d-grid .btn-warning.btn-lg:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 40px rgba(225, 179, 35, 0.4);
        }

        .d-grid .btn-warning.btn-lg i {
            animation: savePulse 2s ease-in-out infinite;
        }

        @keyframes savePulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .d-grid .btn-outline-secondary {
            border: 2px solid var(--gris) !important;
            color: var(--gris) !important;
            background: transparent !important;
            border-radius: 14px;
            padding: 16px 28px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .d-grid .btn-outline-secondary:hover {
            background: var(--gris) !important;
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(132, 138, 134, 0.25);
        }

        /* ==========================================
           COLUMN DIVIDER
        ========================================== */
        .row > .col-md-6:first-child {
            border-right: 1px solid rgba(225, 179, 35, 0.12);
            padding-right: 30px;
        }

        .row > .col-md-6:last-child {
            padding-left: 30px;
        }

        @media (max-width: 768px) {
            .row > .col-md-6:first-child {
                border-right: none;
                border-bottom: 1px solid rgba(225, 179, 35, 0.12);
                padding-right: 15px;
                padding-bottom: 30px;
                margin-bottom: 30px;
            }

            .row > .col-md-6:last-child {
                padding-left: 15px;
            }

            .main-content > .d-flex.justify-content-between:first-of-type {
                padding: 20px;
                flex-direction: column;
                gap: 15px;
                align-items: flex-start !important;
            }

            .main-content > .d-flex.justify-content-between:first-of-type h1 {
                font-size: 1.4rem;
            }

            .dashboard-section {
                padding: 25px;
            }
        }

        /* ==========================================
           FORM FIELD ANIMATIONS
        ========================================== */
        .mb-3, .mb-4 {
            animation: fadeInField 0.5s ease-out forwards;
            opacity: 0;
        }

        .mb-3:nth-child(1) { animation-delay: 0.1s; }
        .mb-3:nth-child(2) { animation-delay: 0.15s; }
        .mb-3:nth-child(3) { animation-delay: 0.2s; }
        .mb-3:nth-child(4) { animation-delay: 0.25s; }
        .mb-4:nth-child(5) { animation-delay: 0.3s; }

        @keyframes fadeInField {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ==========================================
           FOCUS WITHIN EFFECTS
        ========================================== */
        .mb-3:focus-within label,
        .mb-4:focus-within label {
            color: var(--jaune-fonce);
        }

        /* ==========================================
           CUSTOM SCROLLBAR
        ========================================== */
        .main-content::-webkit-scrollbar { width: 8px; }
        .main-content::-webkit-scrollbar-track { background: #f1f1f1; }
        .main-content::-webkit-scrollbar-thumb {
            background: var(--vert-olive-fonce);
            border-radius: 4px;
        }
        .main-content::-webkit-scrollbar-thumb:hover {
            background: var(--vert-foret);
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {% include 'components/_sidebar_banque.html.twig' %}
        
        <div class="main-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="mb-0">
                    <i class="fas fa-user-edit me-2"></i>Modifier mon Profil
                </h1>
                <a href="{{ path('banque_profile_show') }}" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Annuler
                </a>
            </div>
            
            {% include 'components/_flash_messages.html.twig' %}
            
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="dashboard-section">
                        {{ form_start(form) }}
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-4">
                                        <h5 class="section-title">
                                            <i class="fas fa-building"></i>
                                            Informations Générales
                                        </h5>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.nom) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.prenom) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.email) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.tel) }}
                                        </div>
                                    </div>
                                    
                                    <div class="mb-4">
                                        <h5 class="section-title">
                                            <i class="fas fa-camera"></i>
                                            Photo de Profil
                                        </h5>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.photoFile) }}
                                            
                                            {% if utilisateur.photo %}
                                                <div class="mt-3 current-image-box">
                                                    <p class="text-muted mb-2">
                                                        <i class="fas fa-image me-1"></i>Photo actuelle:
                                                    </p>
                                                    <img src="{{ asset(utilisateur.photo) }}" 
                                                         alt="Photo actuelle" 
                                                         class="img-thumbnail"
                                                         style="max-width: 180px;">
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="mb-4">
                                        <h5 class="section-title">
                                            <i class="fas fa-university"></i>
                                            Informations Bancaires
                                        </h5>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.banque.addresseSiege) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.banque.adresseAgence) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.banque.representantLegal) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.banque.siteweb) }}
                                        </div>
                                        
                                        <div class="mb-3">
                                            {{ form_row(form.banque.logoFile) }}
                                            
                                            {% if banque.logo %}
                                                <div class="mt-3 current-image-box">
                                                    <p class="text-muted mb-2">
                                                        <i class="fas fa-image me-1"></i>Logo actuel:
                                                    </p>
                                                    <img src="{{ asset(banque.logo) }}" 
                                                         alt="Logo actuel" 
                                                         class="img-thumbnail"
                                                         style="max-width: 180px;">
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <div class="mb-4">
                                <h5 class="section-title">
                                    <i class="fas fa-lock"></i>
                                    Changer le Mot de Passe
                                </h5>
                                
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle"></i>
                                    <span>Laissez ces champs vides si vous ne souhaitez pas changer votre mot de passe.</span>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        {{ form_row(form.plainPassword.first) }}
                                    </div>
                                    
                                    <div class="col-md-6 mb-3">
                                        {{ form_row(form.plainPassword.second) }}
                                    </div>
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-warning btn-lg">
                                    <i class="fas fa-save"></i>Enregistrer les Modifications
                                </button>
                                <a href="{{ path('banque_profile_show') }}" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Annuler et retourner
                                </a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('sidebar') }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile sidebar toggle
            const mobileSidebarToggle = document.getElementById('mobileSidebarToggle');
            if (mobileSidebarToggle) {
                mobileSidebarToggle.addEventListener('click', function() {
                    const sidebar = document.getElementById('sidebar');
                    const overlay = document.getElementById('sidebarOverlay');
                    if (sidebar) {
                        sidebar.classList.add('show');
                        if (overlay) overlay.classList.add('active');
                        document.body.style.overflow = 'hidden';
                    }
                });
            }

            // Preview image before upload
            document.querySelectorAll('input[type="file"]').forEach(function(fileInput) {
                fileInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file && file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        const previewContainer = this.closest('.mb-3').querySelector('.current-image-box');
                        
                        reader.onload = function(e) {
                            if (previewContainer) {
                                const preview = previewContainer.querySelector('.img-thumbnail');
                                if (preview) {
                                    preview.src = e.target.result;
                                }
                            } else {
                                // Create new preview
                                const newPreview = document.createElement('div');
                                newPreview.className = 'mt-3 current-image-box';
                                newPreview.innerHTML = `
                                    <p class="text-muted mb-2">
                                        <i class="fas fa-image me-1"></i>Nouvelle image:
                                    </p>
                                    <img src="${e.target.result}" 
                                         alt="Nouvelle image" 
                                         class="img-thumbnail"
                                         style="max-width: 180px;">
                                `;
                                fileInput.closest('.mb-3').appendChild(newPreview);
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            });

            // Form input animations
            document.querySelectorAll('.form-control, .form-select').forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.style.transform = 'translateX(5px)';
                });
                
                input.addEventListener('blur', function() {
                    this.parentElement.style.transform = 'translateX(0)';
                });
            });

            // Button ripple effect
            document.querySelectorAll('.btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    if (this.type === 'submit') {
                        const ripple = document.createElement('span');
                        const rect = this.getBoundingClientRect();
                        ripple.style.cssText = `
                            position: absolute;
                            background: rgba(255,255,255,0.3);
                            border-radius: 50%;
                            width: 100px;
                            height: 100px;
                            left: ${e.clientX - rect.left - 50}px;
                            top: ${e.clientY - rect.top - 50}px;
                            transform: scale(0);
                            animation: ripple 0.6s ease-out;
                            pointer-events: none;
                        `;
                        this.style.position = 'relative';
                        this.style.overflow = 'hidden';
                        this.appendChild(ripple);
                        setTimeout(() => ripple.remove(), 600);
                    }
                });
            });

            // Form submission loading state
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    const submitBtn = this.querySelector('button[type="submit"]');
                    if (submitBtn && !submitBtn.disabled) {
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Enregistrement...';
                        submitBtn.disabled = true;
                        submitBtn.style.opacity = '0.8';
                    }
                });
            }
        });
    </script>
    <style>
        @keyframes ripple {
            to { transform: scale(4); opacity: 0; }
        }
    </style>
{% endblock %}