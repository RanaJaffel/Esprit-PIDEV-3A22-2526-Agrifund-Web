<!DOCTYPE html>
<html lang="{{ app.session.get('_locale', 'fr') }}"
      dir="{{ app.session.get('_locale', 'fr') == 'ar' ? 'rtl' : 'ltr' }}"
      data-theme="{{ app.session.get('theme', 'light') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AgriFund{% endblock %}</title>
    <meta name="description" content="Plateforme de financement agricole">

    {% set currentRoute = app.request.attributes.get('_route')|default('') %}
    {% set privateLayoutRoute =
        currentRoute starts with 'admin_'
        or currentRoute starts with 'agriculteur_'
        or currentRoute starts with 'banque_'
        or currentRoute starts with 'capteur_'
    %}

    <!-- Favicons -->
    <link href="{{ asset('assets/img/log.png') }}" rel="icon">
    <link href="{{ asset('assets/img/apple-touch-icon.png') }}" rel="apple-touch-icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Vendor CSS -->
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
    {% if not privateLayoutRoute %}
        <link href="{{ asset('assets/vendor/aos/aos.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/vendor/swiper/swiper-bundle.min.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/vendor/glightbox/css/glightbox.min.css') }}" rel="stylesheet">
    {% endif %}

    <!-- Main CSS -->
    <link href="{{ asset('assets/css/main.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('ui/agrifund-iot.css') }}">
    <link rel="stylesheet" href="{{ asset('ui/agrifund-iot-admin.css') }}">

    {% block stylesheets %}{% endblock %}

    <style>
        /* ════════════════════════════════════════
           THEME VARIABLES
        ════════════════════════════════════════ */
        :root,
        [data-theme="light"] {
            --bg-primary:    #f7f8f5;
            --bg-secondary:  #eeeee9;
            --text-primary:  #151614;
            --text-muted:    #6b7280;
            --border-color:  #e0e0d8;
            --card-bg:       #ffffff;
            --nav-bg:        rgba(255,255,255,0.96);
            --primary:       #2d7a47;
            --primary-dark:  #1a5c31;
            --primary-light: #ebf7f0;
            --primary-mid:   #c6e8d4;
            --accent:        #f0a500;
            --accent-light:  #fff8e8;
            --shadow-sm:     0 1px 4px rgba(0,0,0,0.05);
            --shadow-md:     0 6px 28px rgba(0,0,0,0.09);
            --shadow-lg:     0 16px 48px rgba(0,0,0,0.13);
            --shadow-green:  0 4px 18px rgba(45,122,71,0.22);
        }

        [data-theme="dark"] {
            --bg-primary:    #0d1410;
            --bg-secondary:  #141c17;
            --text-primary:  #e6ede8;
            --text-muted:    #7a9480;
            --border-color:  #243329;
            --card-bg:       #141c17;
            --nav-bg:        rgba(13,20,16,0.97);
            --primary:       #4caf70;
            --primary-dark:  #3d9960;
            --primary-light: #172a1e;
            --primary-mid:   #1e3d28;
            --accent:        #f0a500;
            --accent-light:  #2a2200;
            --shadow-sm:     0 1px 4px rgba(0,0,0,0.35);
            --shadow-md:     0 6px 28px rgba(0,0,0,0.45);
            --shadow-lg:     0 16px 48px rgba(0,0,0,0.6);
            --shadow-green:  0 4px 18px rgba(76,175,112,0.18);
        }

        /* ════════════════════════════════════════
           BASE
        ════════════════════════════════════════ */
        html { font-size: 16px; scroll-behavior: smooth; }

        body {
            font-family: 'DM Sans', sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            transition: background-color 0.35s ease, color 0.35s ease;
            min-height: 100vh;
        }

        /* Cards, modals, dropdowns */
        .card, .dropdown-menu, .modal-content, .offcanvas, .list-group-item {
            background-color: var(--card-bg) !important;
            color: var(--text-primary) !important;
            border-color: var(--border-color) !important;
        }

        /* Forms */
        input, textarea, select, .form-control, .form-select {
            background-color: var(--bg-secondary) !important;
            color: var(--text-primary) !important;
            border-color: var(--border-color) !important;
        }
        input::placeholder, textarea::placeholder { color: var(--text-muted) !important; }

        /* Tables */
        .table {
            background-color: var(--card-bg) !important;
            color: var(--text-primary) !important;
            border-color: var(--border-color) !important;
        }

        /* Typography */
        p, h1, h2, h3, h4, h5, h6, label, small { color: var(--text-primary); }
        .text-muted { color: var(--text-muted) !important; }
        a { color: var(--primary); }

        /* Preserve hero backgrounds */
        .hero, .swiper-slide, [style*="background-image"], .bg-image, section.hero {
            background-color: transparent !important;
        }

        /* ════════════════════════════════════════
           SKIP LINK
        ════════════════════════════════════════ */
        .skip-link {
            position: absolute;
            top: -80px;
            left: 1.5rem;
            background: var(--primary);
            color: #fff;
            padding: 12px 24px;
            border-radius: 0 0 10px 10px;
            font-weight: 600;
            font-size: 0.875rem;
            z-index: 99999;
            text-decoration: none;
            transition: top 0.25s ease;
            box-shadow: var(--shadow-green);
        }
        .skip-link:focus { top: 0; }

        /* ════════════════════════════════════════
           SCROLL PROGRESS BAR
        ════════════════════════════════════════ */
        #scroll-progress {
            position: fixed;
            top: 0; left: 0;
            height: 3px;
            width: 0%;
            background: linear-gradient(90deg, var(--primary), var(--accent), var(--primary));
            background-size: 200%;
            z-index: 99999;
            transition: width 0.1s linear;
            animation: shimmerBar 2.5s linear infinite;
        }
        @keyframes shimmerBar {
            0%   { background-position: 0% 0%; }
            100% { background-position: 200% 0%; }
        }

        /* ════════════════════════════════════════
           HEADER / NAVBAR  — single instance
        ════════════════════════════════════════ */
        #header {
            background: var(--nav-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.3s ease, background 0.3s ease;
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        #header.scrolled {
            box-shadow: var(--shadow-md);
        }

        /* ── Container ── */
        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            height: 76px;
            gap: 16px;
            max-width: 1440px;
            margin: 0 auto;
        }

        /* ══ LOGO ══ */
        .logo {
            display: flex;
            align-items: center;
            gap: 13px;
            text-decoration: none;
            flex-shrink: 0;
        }
        .logo-badge {
            position: relative;
            width: 46px;
            height: 46px;
            background: linear-gradient(145deg, var(--primary), var(--primary-dark));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-green);
            transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease;
            overflow: hidden;
        }
        .logo-badge::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 50%;
            background: rgba(255,255,255,0.12);
            border-radius: 14px 14px 0 0;
        }
        .logo-badge img {
            height: 28px;
            width: auto;
            position: relative;
            z-index: 1;
            filter: brightness(0) invert(1);
            transition: transform 0.35s ease;
        }
        .logo:hover .logo-badge {
            transform: scale(1.06) rotate(-3deg);
            box-shadow: 0 8px 24px rgba(45,122,71,0.35);
        }
        .logo:hover .logo-badge img {
            transform: scale(1.08);
        }
        /* Fallback when no image — tractor SVG inline */
        .logo-badge-svg {
            width: 26px;
            height: 26px;
            fill: #fff;
            position: relative;
            z-index: 1;
        }
        .logo-wordmark {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }
        .logo-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.01em;
        }
        .logo-tagline {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--primary);
            margin-top: 3px;
        }

        /* ══ NAV LINKS ══ */
        .navmenu {
            display: flex;
            align-items: center;
            flex: 1;
            padding: 0 12px;
        }
        .navmenu > ul {
            display: flex;
            align-items: center;
            gap: 2px;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .navmenu > ul > li > a {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 15px;
            color: var(--text-primary);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            border-radius: 11px;
            transition: all 0.22s ease;
            position: relative;
            white-space: nowrap;
        }

        /* Icon pill inside nav item */
        .nav-icon-pill {
            width: 26px;
            height: 26px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-light);
            border-radius: 7px;
            font-size: 0.8rem;
            color: var(--primary);
            flex-shrink: 0;
            transition: all 0.22s ease;
        }
        .navmenu > ul > li > a:hover {
            color: var(--primary);
            background: var(--primary-light);
        }
        .navmenu > ul > li > a:hover .nav-icon-pill {
            background: var(--primary);
            color: #fff;
            transform: scale(1.08) rotate(-4deg);
        }
        .navmenu > ul > li > a.active {
            color: var(--primary);
            background: var(--primary-light);
            font-weight: 600;
        }
        .navmenu > ul > li > a.active .nav-icon-pill {
            background: var(--primary);
            color: #fff;
        }
        /* Underline dot for active */
        .navmenu > ul > li > a.active::after {
            content: '';
            position: absolute;
            bottom: 5px;
            left: 50%;
            transform: translateX(-50%);
            width: 18px;
            height: 2.5px;
            background: var(--primary);
            border-radius: 3px;
        }

        /* ══ DROPDOWN ══ */
        .navmenu .dropdown { position: relative; }
        .toggle-dropdown {
            font-size: 0.6rem;
            margin-left: 1px;
            color: var(--text-muted);
            transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
        }
        .navmenu .dropdown:hover .toggle-dropdown {
            transform: rotate(180deg);
        }
        .navmenu .dropdown > ul {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            min-width: 270px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: var(--shadow-lg);
            padding: 10px;
            margin: 0;
            list-style: none;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px) scale(0.97);
            transition: all 0.28s cubic-bezier(0.4,0,0.2,1);
            z-index: 1001;
        }
        .navmenu .dropdown:hover > ul {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }
        .navmenu .dropdown > ul > li > a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 13px 14px;
            color: var(--text-primary);
            text-decoration: none;
            font-size: 0.875rem;
            border-radius: 13px;
            transition: all 0.2s ease;
        }
        .icon-wrap {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 1.1rem;
            flex-shrink: 0;
            transition: all 0.25s ease;
        }
        .dropdown-agriculteur .icon-wrap {
            background: var(--primary-light);
            color: var(--primary);
        }
        .dropdown-agriculteur:hover {
            background: var(--primary-light);
        }
        .dropdown-agriculteur:hover .icon-wrap {
            background: var(--primary);
            color: #fff;
            transform: scale(1.05) rotate(-5deg);
        }
        .dropdown-banque .icon-wrap {
            background: #e3f0fd;
            color: #2196f3;
        }
        .dropdown-banque:hover {
            background: #ebf5ff;
        }
        .dropdown-banque:hover .icon-wrap {
            background: #2196f3;
            color: #fff;
            transform: scale(1.05) rotate(-5deg);
        }
        [data-theme="dark"] .dropdown-banque .icon-wrap {
            background: rgba(33,150,243,0.15);
        }
        [data-theme="dark"] .dropdown-banque:hover {
            background: rgba(33,150,243,0.1);
        }
        .dropdown-text strong {
            display: block;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-primary);
        }
        .dropdown-desc {
            display: block;
            font-size: 0.73rem;
            color: var(--text-muted);
            margin-top: 2px;
        }
        .dropdown-divider-line {
            height: 1px;
            background: var(--border-color);
            margin: 6px 0;
        }

        /* ══ RIGHT SECTION ══ */
        .header-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        /* Language switcher */
        .lang-switcher {
            display: flex;
            align-items: center;
            gap: 2px;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 4px;
        }
        .lang-switcher a {
            font-size: 0.72rem;
            font-weight: 700;
            padding: 6px 11px;
            border-radius: 8px;
            text-decoration: none;
            color: var(--text-muted);
            letter-spacing: 0.05em;
            transition: all 0.2s ease;
            text-transform: uppercase;
        }
        .lang-switcher a:hover {
            color: var(--primary);
            background: var(--card-bg);
        }
        .lang-switcher a.active {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 2px 10px rgba(45,122,71,0.32);
        }

        /* Divider */
        .header-divider {
            width: 1px;
            height: 28px;
            background: var(--border-color);
            margin: 0 4px;
        }

        /* Login button */
        .btn-login {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 10px 22px;
            background: var(--primary);
            color: #fff !important;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.875rem;
            border-radius: 13px;
            transition: all 0.26s ease;
            box-shadow: var(--shadow-green);
            white-space: nowrap;
            position: relative;
            overflow: hidden;
        }
        .btn-login::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.18), transparent 60%);
            pointer-events: none;
        }
        .btn-login:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 26px rgba(45,122,71,0.42);
            color: #fff !important;
        }
        .btn-login i { transition: transform 0.25s ease; }
        .btn-login:hover i { transform: translateX(3px); }

        /* Mobile toggle */
        .mobile-nav-toggle {
            display: none;
            font-size: 24px;
            color: var(--text-primary);
            cursor: pointer;
            border: none;
            background: transparent;
            padding: 8px;
            border-radius: 10px;
            transition: all 0.2s ease;
            line-height: 1;
        }
        .mobile-nav-toggle:hover {
            color: var(--primary);
            background: var(--primary-light);
        }

        /* ════════════════════════════════════════
           ACCESSIBILITY TOOLBAR
        ════════════════════════════════════════ */
        .a11y-toolbar {
            position: fixed;
            top: 50%;
            right: 0;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 3px;
            z-index: 9998;
            padding: 8px 5px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-right: none;
            border-radius: 14px 0 0 14px;
            box-shadow: var(--shadow-lg);
        }
        .a11y-btn {
            width: 40px;
            height: 40px;
            border: none;
            background: transparent;
            color: var(--text-primary);
            border-radius: 9px;
            cursor: pointer;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            position: relative;
        }
        .a11y-btn:hover { background: var(--primary-light); color: var(--primary); }
        .a11y-btn:focus { outline: 2px solid var(--primary); outline-offset: 2px; }
        .a11y-btn.active { background: var(--primary-light); color: var(--primary); }
        .a11y-btn .a11y-label {
            position: absolute;
            right: calc(100% + 10px);
            top: 50%;
            transform: translateY(-50%);
            background: var(--text-primary);
            color: var(--bg-primary);
            font-size: 0.7rem;
            font-weight: 600;
            padding: 5px 10px;
            border-radius: 7px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.15s ease;
        }
        .a11y-btn .a11y-label::after {
            content: '';
            position: absolute;
            left: 100%;
            top: 50%;
            transform: translateY(-50%);
            border: 5px solid transparent;
            border-left-color: var(--text-primary);
        }
        .a11y-btn:hover .a11y-label { opacity: 1; }
        .a11y-separator {
            height: 1px;
            background: var(--border-color);
            margin: 2px 5px;
        }

        /* ════════════════════════════════════════
           HIGH CONTRAST
        ════════════════════════════════════════ */
        [data-contrast="high"] {
            --text-primary: #000000;
            --bg-primary:   #ffffff;
            --border-color: #000000;
            --text-muted:   #333333;
        }
        [data-contrast="high"][data-theme="dark"] {
            --text-primary: #ffffff;
            --bg-primary:   #000000;
            --border-color: #ffffff;
        }

        /* ════════════════════════════════════════
           RTL SUPPORT
        ════════════════════════════════════════ */
        [dir="rtl"] .a11y-toolbar {
            right: auto;
            left: 0;
            border-right: 1px solid var(--border-color);
            border-left: none;
            border-radius: 0 14px 14px 0;
        }
        [dir="rtl"] .a11y-btn .a11y-label {
            right: auto;
            left: calc(100% + 10px);
        }
        [dir="rtl"] .a11y-btn .a11y-label::after {
            left: auto;
            right: 100%;
            border-left-color: transparent;
            border-right-color: var(--text-primary);
        }
        [dir="rtl"] .navmenu > ul > li > a { flex-direction: row-reverse; }
        [dir="rtl"] .header-right { flex-direction: row-reverse; }
        [dir="rtl"] .navmenu .dropdown > ul { left: auto; right: 0; }

        /* ════════════════════════════════════════
           KEYBOARD FOCUS
        ════════════════════════════════════════ */
        .keyboard-nav *:focus {
            outline: 2px solid var(--primary) !important;
            outline-offset: 3px !important;
        }

        /* SR ONLY */
        .sr-only {
            position: absolute;
            width: 1px; height: 1px;
            padding: 0; margin: -1px;
            overflow: hidden;
            clip: rect(0,0,0,0);
            white-space: nowrap;
            border: 0;
        }

        /* ════════════════════════════════════════
           DARK MODE — NAVBAR TEXT OVERRIDE
        ════════════════════════════════════════ */
        [data-theme="dark"] #header {
            background: var(--nav-bg) !important;
        }
        [data-theme="dark"] #header .navmenu > ul > li > a {
            color: var(--text-primary) !important;
        }

        /* ════════════════════════════════════════
           RESPONSIVE
        ════════════════════════════════════════ */
        @media (max-width: 1199px) {
            .navmenu > ul { display: none; }
            .mobile-nav-toggle { display: flex; }
        }
        @media (max-width: 768px) {
            .header-inner { padding: 0 20px; height: 66px; }
            .header-divider, .btn-login { display: none; }
        }
        @media (max-width: 480px) {
            .lang-switcher { display: none; }
        }

        /* ════════════════════════════════════════
           MOBILE NAV OPEN STATE
        ════════════════════════════════════════ */
        .navmenu > ul.mobile-open {
            display: flex !important;
            flex-direction: column;
            position: absolute;
            top: 76px;
            left: 0;
            right: 0;
            background: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 20px 20px;
            box-shadow: var(--shadow-md);
            gap: 4px;
            z-index: 999;
            animation: slideDown 0.22s ease;
        }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-8px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .navmenu > ul.mobile-open > li > a {
            border-radius: 12px;
            padding: 12px 16px;
        }
        .navmenu > ul.mobile-open .dropdown > ul {
            position: static;
            opacity: 1;
            visibility: visible;
            transform: none;
            box-shadow: none;
            border: none;
            background: var(--bg-secondary);
            border-radius: 12px;
            margin-top: 4px;
            padding: 6px;
        }
    </style>
</head>

<body class="{% block body_class %}index-page{% endblock %}">

    <!-- Skip link -->
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>

    <!-- Scroll progress bar -->
    <div id="scroll-progress" aria-hidden="true"></div>

    <!-- Screen reader live region -->
    <div id="a11y-live" aria-live="polite" aria-atomic="true" class="sr-only"></div>

    {# ═══════════════════════════════════════════
       HEADER — rendered ONCE here in base.html.twig
       Child templates must NOT re-include a header.
       ═══════════════════════════════════════════ #}
    {% if not privateLayoutRoute %}
        {% include 'partials/_navbar.html.twig' %}
    {% endif %}

    {% if false %}
    <header id="header" role="banner">
        <div class="header-inner">

            {# ── Logo ── #}
            <a href="{{ path('app_home') }}" class="logo" aria-label="AgriFund — Accueil">
                <div class="logo-badge">
                    {# Try image first — if it fails to load the badge color still shows #}
                    <img src="{{ asset('assets/img/logo.png') }}"
                         alt=""
                         aria-hidden="true"
                         onerror="this.style.display='none'">
                    {# Inline SVG fallback (tractor icon) shown via CSS if image missing #}
                </div>
                <div class="logo-wordmark">
                    <span class="logo-name">AgriFund</span>
                    <span class="logo-tagline">Financement agricole</span>
                </div>
            </a>

            {# ── Navigation ── #}
            <nav id="navmenu" class="navmenu" role="navigation" aria-label="Navigation principale">
                <ul>

                    <li>
                        <a href="{{ path('app_home') }}"
                           class="{{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}"
                           {% if app.request.attributes.get('_route') == 'app_home' %}aria-current="page"{% endif %}>
                            <span class="nav-icon-pill" aria-hidden="true">
                                <i class="bi bi-house-door-fill"></i>
                            </span>
                            {{ 'home'|trans }}
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_about') }}"
                           class="{{ app.request.attributes.get('_route') == 'app_about' ? 'active' : '' }}"
                           {% if app.request.attributes.get('_route') == 'app_about' %}aria-current="page"{% endif %}>
                            <span class="nav-icon-pill" aria-hidden="true">
                                <i class="bi bi-info-circle-fill"></i>
                            </span>
                            {{ 'about'|trans }}
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_contact') }}"
                           class="{{ app.request.attributes.get('_route') == 'app_contact' ? 'active' : '' }}"
                           {% if app.request.attributes.get('_route') == 'app_contact' %}aria-current="page"{% endif %}>
                            <span class="nav-icon-pill" aria-hidden="true">
                                <i class="bi bi-envelope-fill"></i>
                            </span>
                            {{ 'contact'|trans }}
                        </a>
                    </li>

                    {# ── Dropdown S'inscrire ── #}
                    <li class="dropdown">
                        <a href="#" aria-haspopup="true" aria-expanded="false">
                            <span class="nav-icon-pill" aria-hidden="true">
                                <i class="bi bi-person-plus-fill"></i>
                            </span>
                            {{ 'register'|trans }}
                            <i class="bi bi-chevron-down toggle-dropdown" aria-hidden="true"></i>
                        </a>
                        <ul aria-label="{{ 'register'|trans }}">
                            <li>
                                <a href="{{ path('app_register_agriculteur') }}" class="dropdown-agriculteur">
                                    <span class="icon-wrap">
                                        <i class="bi bi-tree-fill" aria-hidden="true"></i>
                                    </span>
                                    <span class="dropdown-text">
                                        <strong>{{ 'farmer'|trans }}</strong>
                                        <span class="dropdown-desc">{{ 'ask_financing'|trans }}</span>
                                    </span>
                                </a>
                            </li>
                            <li class="dropdown-divider-line" role="separator"></li>
                            <li>
                                <a href="{{ path('app_register_banque') }}" class="dropdown-banque">
                                    <span class="icon-wrap">
                                        <i class="bi bi-bank2" aria-hidden="true"></i>
                                    </span>
                                    <span class="dropdown-text">
                                        <strong>{{ 'bank'|trans }}</strong>
                                        <span class="dropdown-desc">{{ 'offer_services'|trans }}</span>
                                    </span>
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul>
            </nav>

            {# ── Right: lang switcher + login ── #}
            <div class="header-right">

                <nav class="lang-switcher" role="navigation" aria-label="Langue / Language / اللغة">
                    <a href="{{ path('app_locale', {locale: 'fr'}) }}"
                       class="{{ app.session.get('_locale', 'fr') == 'fr' ? 'active' : '' }}"
                       lang="fr" hreflang="fr" aria-label="Français">FR</a>
                    <a href="{{ path('app_locale', {locale: 'en'}) }}"
                       class="{{ app.session.get('_locale', 'fr') == 'en' ? 'active' : '' }}"
                       lang="en" hreflang="en" aria-label="English">EN</a>
                    <a href="{{ path('app_locale', {locale: 'ar'}) }}"
                       class="{{ app.session.get('_locale', 'fr') == 'ar' ? 'active' : '' }}"
                       lang="ar" hreflang="ar" aria-label="العربية">AR</a>
                </nav>

                <div class="header-divider" aria-hidden="true"></div>

                <a href="{{ path('app_login') }}" class="btn-login">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                    {{ 'login'|trans }}
                </a>

                {# Mobile hamburger — visible only on small screens #}
                <button class="mobile-nav-toggle d-xl-none"
                        aria-label="Ouvrir le menu de navigation"
                        aria-expanded="false"
                        aria-controls="navmenu">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>

            </div>
        </div>
    </header>
    {% endif %}

    {# ═══════════════════════════════════════════
       ACCESSIBILITY TOOLBAR
       ═══════════════════════════════════════════ #}
    <aside class="a11y-toolbar" role="toolbar" aria-label="Outils d'accessibilité">

        <button class="a11y-btn" id="btn-theme" aria-label="Basculer mode sombre/clair">
            <span class="a11y-label" aria-hidden="true">Thème</span>
            <i class="bi bi-moon-stars" aria-hidden="true"></i>
        </button>

        <div class="a11y-separator" aria-hidden="true"></div>

        <button class="a11y-btn" id="btn-font-up" aria-label="Augmenter la taille du texte">
            <span class="a11y-label" aria-hidden="true">Texte +</span>
            <span aria-hidden="true" style="font-weight:700;font-size:12px;">A+</span>
        </button>

        <button class="a11y-btn" id="btn-font-down" aria-label="Réduire la taille du texte">
            <span class="a11y-label" aria-hidden="true">Texte −</span>
            <span aria-hidden="true" style="font-weight:700;font-size:10px;">A−</span>
        </button>

        <div class="a11y-separator" aria-hidden="true"></div>

        <button class="a11y-btn" id="btn-tts" aria-label="Lire la page à voix haute">
            <span class="a11y-label" aria-hidden="true">Lecture</span>
            <i class="bi bi-volume-up" aria-hidden="true"></i>
        </button>

        <button class="a11y-btn" id="btn-contrast" aria-label="Activer le contraste élevé" aria-pressed="false">
            <span class="a11y-label" aria-hidden="true">Contraste</span>
            <i class="bi bi-circle-half" aria-hidden="true"></i>
        </button>

    </aside>

    {# ═══════════════════════════════════════════
       MAIN CONTENT — child templates fill {% block body %}
       ═══════════════════════════════════════════ #}
    <main id="main-content" role="main" tabindex="-1">
        {% block body %}{% endblock %}
    </main>

    {# Scroll-to-top button #}
    <a href="#"
       id="scroll-top"
       class="scroll-top d-flex align-items-center justify-content-center"
       aria-label="Retour en haut de la page">
        <i class="bi bi-arrow-up-short" aria-hidden="true"></i>
    </a>

    {# Preloader — skip in child templates that define hide_preloader block #}
    {% if block('hide_preloader') is not defined %}
        <div id="preloader" role="status" aria-label="Chargement en cours"></div>
    {% endif %}

    {# ─── Vendor JS ─── #}
    <script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    {% if not privateLayoutRoute %}
        <script src="{{ asset('assets/vendor/php-email-form/validate.js') }}"></script>
        <script src="{{ asset('assets/vendor/aos/aos.js') }}"></script>
        <script src="{{ asset('assets/vendor/swiper/swiper-bundle.min.js') }}"></script>
        <script src="{{ asset('assets/vendor/glightbox/js/glightbox.min.js') }}"></script>
        <script src="{{ asset('assets/js/main.js') }}"></script>
    {% endif %}
    <script defer src="{{ asset('ui/agrifund-iot.js') }}"></script>

    {# ─── Preloader hide ─── #}
    <script>
        (function () {
            function hidePreloader() {
                var p = document.getElementById('preloader');
                if (!p) return;
                p.style.transition = 'opacity 0.3s ease';
                p.style.opacity = '0';
                setTimeout(function () { if (p.parentNode) p.parentNode.removeChild(p); }, 320);
            }
            if (document.readyState === 'complete') { hidePreloader(); }
            else { window.addEventListener('load', hidePreloader); }
            setTimeout(hidePreloader, 2000);
        })();
    </script>

    {# ─── Scroll progress + header scroll class ─── #}
    <script>
        (function () {
            var prog   = document.getElementById('scroll-progress');
            var header = document.getElementById('header');

            window.addEventListener('scroll', function () {
                var scrolled = (document.documentElement.scrollTop /
                    Math.max(1, document.documentElement.scrollHeight - document.documentElement.clientHeight)) * 100;
                if (prog) prog.style.width = scrolled + '%';
                if (header) header.classList.toggle('scrolled', window.scrollY > 50);
            }, { passive: true });
        })();
    </script>

    {# ─── Accessibility JS ─── #}
    <script>
    (function () {
        var root = document.documentElement;
        var live = document.getElementById('a11y-live');

        function announce(msg) {
            live.textContent = '';
            setTimeout(function () { live.textContent = msg; }, 60);
        }

        /* 1 ── THEME ─────────────────────────────── */
        var btnTheme   = document.getElementById('btn-theme');
        var savedTheme = localStorage.getItem('agrifund-theme') || root.getAttribute('data-theme') || 'light';
        applyTheme(savedTheme);

        btnTheme.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            applyTheme(next);
            localStorage.setItem('agrifund-theme', next);
            fetch('/theme/' + next, { credentials: 'same-origin' }).catch(function () {});
            announce(next === 'dark' ? 'Mode sombre activé' : 'Mode clair activé');
        });

        function applyTheme(theme) {
            root.setAttribute('data-theme', theme);
            var icon = btnTheme.querySelector('i');
            icon.className = (theme === 'dark') ? 'bi bi-sun' : 'bi bi-moon-stars';
            icon.setAttribute('aria-hidden', 'true');
            btnTheme.classList.toggle('active', theme === 'dark');
        }

        /* 2 ── FONT SIZE ──────────────────────────── */
        var fontSize = parseInt(localStorage.getItem('agrifund-font'), 10) || 16;
        applyFont(fontSize);

        document.getElementById('btn-font-up').addEventListener('click', function () {
            if (fontSize < 24) { fontSize += 2; applyFont(fontSize); announce('Taille du texte : ' + fontSize + 'px'); }
        });
        document.getElementById('btn-font-down').addEventListener('click', function () {
            if (fontSize > 12) { fontSize -= 2; applyFont(fontSize); announce('Taille du texte : ' + fontSize + 'px'); }
        });

        function applyFont(size) {
            root.style.fontSize = size + 'px';
            localStorage.setItem('agrifund-font', size);
        }

        /* 3 ── TEXT-TO-SPEECH ─────────────────────── */
        var btnTTS   = document.getElementById('btn-tts');
        var speaking = false;

        btnTTS.addEventListener('click', function () {
            if (!('speechSynthesis' in window)) { announce('Lecture vocale non supportée'); return; }

            if (speaking) {
                speechSynthesis.cancel();
                speaking = false;
                btnTTS.classList.remove('active');
                btnTTS.setAttribute('aria-label', 'Lire la page à voix haute');
                btnTTS.querySelector('i').className = 'bi bi-volume-up';
                announce('Lecture arrêtée');
                return;
            }

            var main    = document.getElementById('main-content');
            var text    = main ? main.innerText.trim() : document.body.innerText;
            var locale  = root.getAttribute('lang') || 'fr';
            var langMap = { fr: 'fr-FR', ar: 'ar-SA', en: 'en-US' };

            var utt   = new SpeechSynthesisUtterance(text);
            utt.lang  = langMap[locale] || 'fr-FR';
            utt.rate  = 0.9;
            utt.onend = function () {
                speaking = false;
                btnTTS.classList.remove('active');
                btnTTS.querySelector('i').className = 'bi bi-volume-up';
            };

            speechSynthesis.speak(utt);
            speaking = true;
            btnTTS.classList.add('active');
            btnTTS.setAttribute('aria-label', 'Arrêter la lecture');
            btnTTS.querySelector('i').className = 'bi bi-stop-circle';
            announce('Lecture en cours…');
        });

        /* 4 ── HIGH CONTRAST ─────────────────────── */
        var btnContrast = document.getElementById('btn-contrast');
        var hiContrast  = localStorage.getItem('agrifund-contrast') === 'high';
        applyContrast(hiContrast);

        btnContrast.addEventListener('click', function () {
            hiContrast = !hiContrast;
            applyContrast(hiContrast);
            localStorage.setItem('agrifund-contrast', hiContrast ? 'high' : 'normal');
            announce(hiContrast ? 'Contraste élevé activé' : 'Contraste normal');
        });

        function applyContrast(on) {
            root.setAttribute('data-contrast', on ? 'high' : 'normal');
            btnContrast.classList.toggle('active', on);
            btnContrast.setAttribute('aria-pressed', String(on));
        }

        /* 5 ── KEYBOARD FOCUS INDICATOR ─────────── */
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Tab') document.body.classList.add('keyboard-nav');
        });
        document.addEventListener('mousedown', function () {
            document.body.classList.remove('keyboard-nav');
        });

        /* 6 ── LANG SWITCHER: mark active from HTML lang attr ── */
        var currentLang = root.getAttribute('lang') || 'fr';
        document.querySelectorAll('.lang-switcher a').forEach(function (a) {
            if (a.getAttribute('lang') === currentLang) { a.classList.add('active'); }
        });

        /* 7 ── MOBILE NAV TOGGLE ─────────────────── */
        var mobileToggle = document.querySelector('.mobile-nav-toggle');
        var navUl        = document.querySelector('#navmenu > ul');

        if (mobileToggle && navUl) {
            mobileToggle.addEventListener('click', function () {
                var expanded = this.getAttribute('aria-expanded') === 'true';
                this.setAttribute('aria-expanded', String(!expanded));
                navUl.classList.toggle('mobile-open', !expanded);
                var icon = this.querySelector('i');
                icon.className = expanded ? 'bi bi-list' : 'bi bi-x-lg';
            });
        }

    })();
    </script>

    {% block javascripts %}{% endblock %}

</body>
</html>
