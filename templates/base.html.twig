<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AgriFund{% endblock %}</title>
    <meta name="description" content="Plateforme de financement agricole">

    <!-- Favicons -->
    <link href="{{ asset('img/log.png') }}" rel="icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&family=Marcellus:wght@400&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Vendor CSS Files (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/css/glightbox.min.css" rel="stylesheet">

<style>
    :root {
        /* AgriConnect Harmonized Tokens */
        --nature-green: #089647; /* Harmonized with Portal */
        --meadow-green: #0aab51;
        --harvest-gold: #E1B323; /* Same gold as Portal */
        --earth-cream: #FDFBF7;
        --deep-forest: #133D03; /* Harmonized with Portal */
        --soft-white: #FFFFFF;
        --vert-vif: #089647;
    }

    /* Marketing Design System - Public Pages */
    body.index-page {
        background-color: var(--earth-cream);
        color: var(--deep-forest);
    }

    .marketing-nav {
        transition: all 0.4s;
        padding: 20px 0;
    }

    .marketing-nav.scrolled {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 30px rgba(0,0,0,0.05);
        padding: 10px 0;
    }

    .marketing-logo {
        font-family: 'Marcellus', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--nature-green);
        text-decoration: none;
    }
</style>
    <!-- Main CSS File -->
    <link href="{{ asset('css/main.css') }}" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}index-page{% endblock %}">

    {% block body %}{% endblock %}

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center" data-controller="scroll-top" data-action="click->scroll-top#toTop" data-scroll-top-threshold-value="100"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader - Seulement pour les pages publiques -->
    {% if block('hide_preloader') is not defined %}
        <div id="preloader"></div>
    {% endif %}

    <!-- Vendor JS Files (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/js/glightbox.min.js"></script>

    {{ importmap('app') }}

    <!-- Main JS File -->
    <script src="{{ asset('js/main.js') }}" defer></script>

    <!-- Force hide preloader after 2 seconds -->
    <script>
        (function() {
            function hidePreloader() {
                var preloader = document.getElementById('preloader');
                if (preloader) {
                    preloader.style.transition = 'opacity 0.3s ease';
                    preloader.style.opacity = '0';
                    setTimeout(function() {
                        preloader.style.display = 'none';
                        preloader.remove();
                    }, 300);
                }
            }

            // Hide when DOM is ready
            if (document.readyState === 'complete') {
                hidePreloader();
            } else {
                window.addEventListener('load', hidePreloader);
            }

            // Fallback: force hide after 2 seconds max
            setTimeout(hidePreloader, 2000);
        })();
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>