{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
<style>

    /* ===== Animations ===== */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(25px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes pulseSoft {
        0%,100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    body {
        background: linear-gradient(120deg, #f8f9fa, #eef2f3);
    }

    .reset-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        animation: fadeIn 1s ease;
    }

    .reset-card {
        width: 100%;
        max-width: 500px;
        background: #ffffff;
        border-radius: 20px;
        padding: 40px;
        box-shadow:
            0 10px 40px rgba(0,0,0,0.08),
            0 2px 10px rgba(0,0,0,0.05);
        position: relative;
        animation: fadeUp 0.8s ease;
    }

    /* Accent bar */
    .reset-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        height: 6px;
        width: 100%;
        background: linear-gradient(90deg, #089647, #B2D944);
    }

    .reset-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .reset-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: linear-gradient(135deg, #089647, #076A39);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 26px;
        animation: pulseSoft 3s ease-in-out infinite;
        box-shadow: 0 8px 20px rgba(8,150,71,0.25);
    }

    .reset-header h2 {
        font-weight: 700;
        color: #133D03;
        margin-bottom: 8px;
    }

    .reset-header p {
        color: #848A86;
        font-size: 0.95rem;
    }

    /* Form styling */

    .form-control {
        border-radius: 12px;
        border: 1px solid #e3e6e8;
        padding: 12px 15px;
        background: #f9fafb;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #089647;
        box-shadow: 0 0 0 4px rgba(8,150,71,0.08);
        background: #fff;
    }

    .btn-reset {
        width: 100%;
        padding: 13px;
        border-radius: 12px;
        border: none;
        font-weight: 600;
        margin-top: 10px;
        background: linear-gradient(135deg, #089647, #076A39);
        color: white;
        transition: all 0.3s ease;
        box-shadow: 0 6px 20px rgba(8,150,71,0.25);
    }

    .btn-reset:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(8,150,71,0.35);
        background: linear-gradient(135deg, #076A39, #095032);
    }

    /* Alerts */

    .alert {
        border-radius: 12px;
        font-size: 0.9rem;
    }

    .alert-danger {
        background: #9A951F22;
        color: #133D03;
        border-left: 4px solid #9A951F;
    }

    .password-criteria {
        background: #f8f9fa;
        padding: 18px;
        border-radius: 14px;
        font-size: 0.85rem;
        margin-bottom: 20px;
    }

    .password-criteria ul {
        padding-left: 18px;
        margin-bottom: 0;
    }

    .password-criteria li {
        margin-bottom: 5px;
        transition: 0.3s;
    }

    .valid {
        color: #089647;
        font-weight: 600;
    }

    .invalid {
        color: #848A86;
    }

</style>

<div class="reset-wrapper">
    <div class="reset-card">

        <div class="reset-header">
            <div class="reset-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h2>Nouveau mot de passe</h2>
            <p>Choisissez un mot de passe sécurisé</p>
        </div>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                <i class="fas fa-times-circle me-2"></i>
                {{ message }}
            </div>
        {% endfor %}

        <div class="password-criteria">
            <strong>Critères :</strong>
            <ul>
                <li id="length" class="invalid">Minimum 6 caractères</li>
                <li id="letter" class="invalid">Au moins une lettre</li>
                <li id="number" class="invalid">Au moins un chiffre</li>
            </ul>
        </div>

        {{ form_start(form) }}
            {{ form_row(form.plainPassword.first, {
                'attr': {
                    'class': 'form-control password-input',
                    'placeholder': 'Nouveau mot de passe'
                }
            }) }}

            {{ form_row(form.plainPassword.second, {
                'attr': {
                    'class': 'form-control',
                    'placeholder': 'Confirmez le mot de passe'
                }
            }) }}

            <button type="submit" class="btn-reset">
                <i class="fas fa-check me-2"></i>
                Réinitialiser le mot de passe
            </button>
        {{ form_end(form) }}

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {

    const passwordInput = document.querySelector('.password-input');

    const length = document.getElementById('length');
    const letter = document.getElementById('letter');
    const number = document.getElementById('number');

    if(passwordInput) {
        passwordInput.addEventListener('input', function() {

            const value = this.value;

            const hasLength = value.length >= 6;
            const hasLetter = /[A-Za-z]/.test(value);
            const hasNumber = /\d/.test(value);

            length.className = hasLength ? 'valid' : 'invalid';
            letter.className = hasLetter ? 'valid' : 'invalid';
            number.className = hasNumber ? 'valid' : 'invalid';

        });
    }

});
</script>

{% endblock %}