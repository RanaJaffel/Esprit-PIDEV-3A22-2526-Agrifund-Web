{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<style>

    /* ======== ANIMATIONS ======== */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes floatSoft {
        0%,100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    /* ======== LAYOUT ======== */

    body {
        background: linear-gradient(120deg, #f8f9fa, #eef2f3);
    }

    .forgot-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        animation: fadeIn 1s ease;
    }

    /* ======== CARD ======== */

    .forgot-card {
        width: 100%;
        max-width: 480px;
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow:
            0 10px 40px rgba(0,0,0,0.08),
            0 2px 10px rgba(0,0,0,0.04);
        animation: fadeUp 0.8s ease;
        position: relative;
        overflow: hidden;
    }

    /* Accent border top */
    .forgot-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 6px;
        background: linear-gradient(90deg, #089647, #B2D944);
    }

    /* ======== HEADER ======== */

    .forgot-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .forgot-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: linear-gradient(135deg, #089647, #076A39);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 28px;
        animation: floatSoft 3s ease-in-out infinite;
        box-shadow: 0 8px 20px rgba(8,150,71,0.25);
    }

    .forgot-header h2 {
        font-weight: 700;
        color: #133D03;
        margin-bottom: 8px;
    }

    .forgot-header p {
        color: #848A86;
        font-size: 0.95rem;
    }

    /* ======== FORM ======== */

    .form-control {
        border-radius: 12px;
        border: 1px solid #e3e6e8;
        padding: 12px 15px;
        transition: all 0.3s ease;
        background: #f9fafb;
    }

    .form-control:focus {
        border-color: #089647;
        box-shadow: 0 0 0 4px rgba(8,150,71,0.08);
        background: white;
    }

    .btn-submit {
        width: 100%;
        margin-top: 15px;
        padding: 13px;
        border-radius: 12px;
        border: none;
        font-weight: 600;
        background: linear-gradient(135deg, #089647, #076A39);
        color: white;
        transition: all 0.3s ease;
        box-shadow: 0 6px 20px rgba(8,150,71,0.25);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(8,150,71,0.35);
        background: linear-gradient(135deg, #076A39, #095032);
    }

    /* ======== ALERTS ======== */

    .alert {
        border-radius: 12px;
        font-size: 0.9rem;
    }

    .alert-success {
        background: #B2D94433;
        color: #133D03;
        border-left: 4px solid #089647;
    }

    .alert-warning {
        background: #E1B32333;
        color: #133D03;
        border-left: 4px solid #E1B323;
    }

    .alert-danger {
        background: #9A951F33;
        color: #133D03;
        border-left: 4px solid #9A951F;
    }

    /* ======== FOOTER LINK ======== */

    .back-link {
        text-align: center;
        margin-top: 20px;
    }

    .back-link a {
        color: #089647;
        font-weight: 500;
        text-decoration: none;
        transition: 0.3s;
    }

    .back-link a:hover {
        color: #076A39;
        text-decoration: underline;
    }

    /* ======== INFO BOX ======== */

    .info-box {
        margin-top: 25px;
        padding: 18px;
        border-radius: 14px;
        background: #f8f9fa;
        font-size: 0.85rem;
        color: #6c757d;
    }

    .info-box ul {
        padding-left: 18px;
        margin-bottom: 0;
    }

</style>

<div class="forgot-wrapper">
    <div class="forgot-card">

        <div class="forgot-header">
            <div class="forgot-icon">
                <i class="fas fa-key"></i>
            </div>
            <h2>Mot de passe oublié</h2>
            <p>Entrez votre email pour recevoir un lien de réinitialisation</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('warning') %}
            <div class="alert alert-warning">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {{ form_start(form) }}
            {{ form_row(form.email, {
                'attr': {
                    'class': 'form-control',
                    'placeholder': 'exemple@email.com'
                }
            }) }}

            <button type="submit" class="btn-submit">
                <i class="fas fa-paper-plane me-2"></i>
                Envoyer le lien
            </button>
        {{ form_end(form) }}

        <div class="back-link">
            <a href="{{ path('app_login') }}">
                ← Retour à la connexion
            </a>
        </div>

        <div class="info-box">
            <ul>
                <li>Lien valide pendant 1 heure</li>
                <li>Vérifiez vos spams</li>
                <li>Un seul lien actif par compte</li>
            </ul>
        </div>

    </div>
</div>

{% endblock %}