{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-key"></i> Mot de passe oublié
                    </h4>
                </div>
                <div class="card-body">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle"></i> {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('warning') %}
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle"></i> {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-times-circle"></i> {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    <p class="text-muted">
                        Entrez votre adresse email pour recevoir un lien de réinitialisation de mot de passe.
                    </p>

                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_row(form.email, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'votre@email.com'
                                }
                            }) }}
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-paper-plane"></i> Envoyer le lien
                            </button>
                        </div>
                    {{ form_end(form) }}

                    <hr class="my-4">

                    <div class="text-center">
                        <a href="{{ path('app_login') }}" class="btn btn-link">
                            <i class="fas fa-arrow-left"></i> Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h6><i class="fas fa-info-circle"></i> Informations</h6>
                    <ul class="small text-muted mb-0">
                        <li>Le lien de réinitialisation est valide pendant 1 heure</li>
                        <li>Vérifiez votre dossier spam si vous ne recevez pas l'email</li>
                        <li>Un seul lien peut être actif à la fois par compte</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}