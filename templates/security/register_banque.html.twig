                            <div class="form-group">
                                <label for="{{ form.plainPassword.second.vars.id }}">
                                    <i class="fas fa-lock"></i> Confirmer
                                    <span class="required-star">*</span>
                                </label>
                                {{ form_widget(form.plainPassword.second, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Confirmez le mot de passe'
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="form-section">
                            <h5 class="section-title">
                                <i class="fas fa-university"></i>
                                Banque
                            </h5>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="{{ form.banque.codebanque.vars.id }}">
                                        <i class="fas fa-barcode"></i> Code
                                        <span class="required-star">*</span>
                                    </label>
                                    {{ form_widget(form.banque.codebanque, {
                                        'attr': {
                                            'class': 'form-control' ~ (form.banque.codebanque.vars.errors|length > 0 ? ' is-invalid' : ''),
                                            'placeholder': 'BNA, STB...',
