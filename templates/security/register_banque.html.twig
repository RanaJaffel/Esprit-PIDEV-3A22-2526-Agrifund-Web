                                <div class="form-group">
                                    <label for="{{ form.banque.representantLegal.vars.id }}">
                                        <i class="fas fa-user-tie"></i> Représentant
                                        <span class="required-star">*</span>
                                    </label>
                                    {{ form_widget(form.banque.representantLegal, {
                                        'attr': {
                                            'class': 'form-control' ~ (form.banque.representantLegal.vars.errors|length > 0 ? ' is-invalid' : ''),
                                            'placeholder': 'Nom complet'
                                        }
                                    }) }}
                                    {% if form.banque.representantLegal.vars.errors|length > 0 %}
                                        <div class="invalid-feedback">{{ form_errors(form.banque.representantLegal) }}</div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="{{ form.banque.addresseSiege.vars.id }}">
                                    <i class="fas fa-building"></i> Siège social
                                    <span class="required-star">*</span>
                                </label>
                                {{ form_widget(form.banque.addresseSiege, {
                                    'attr': {
                                        'class': 'form-control' ~ (form.banque.addresseSiege.vars.errors|length > 0 ? ' is-invalid' : ''),
                                        'placeholder': 'Adresse complète',
                                        'rows': 2
                                    }
                                }) }}
                                {% if form.banque.addresseSiege.vars.errors|length > 0 %}
                                    <div class="invalid-feedback">{{ form_errors(form.banque.addresseSiege) }}</div>
                                {% endif %}
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="{{ form.banque.adresseAgence.vars.id }}">
                                        <i class="fas fa-map-marker-alt"></i> Agence
                                        <span class="optional-tag">Optionnel</span>
                                    </label>
                                    {{ form_widget(form.banque.adresseAgence, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': 'Adresse agence',
                                            'rows': 1
                                        }
                                    }) }}
                                </div>

                                <div class="form-group">
                                    <label for="{{ form.banque.siteweb.vars.id }}">
                                        <i class="fas fa-globe"></i> Site web
                                        <span class="optional-tag">Optionnel</span>
                                    </label>
                                    {{ form_widget(form.banque.siteweb, {
                                        'attr': {
                                            'class': 'form-control' ~ (form.banque.siteweb.vars.errors|length > 0 ? ' is-invalid' : ''),
                                            'placeholder': 'https://...'
                                        }
                                    }) }}
                                    {% if form.banque.siteweb.vars.errors|length > 0 %}
                                        <div class="invalid-feedback">{{ form_errors(form.banque.siteweb) }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="terms-section">
                            <label class="terms-checkbox">
                                <div class="custom-checkbox">
                                    {{ form_widget(form.agreeTerms, {'attr': {'style': 'position:absolute;opacity:0;'}}) }}
                                    <span class="checkmark"></span>
                                </div>
                                <span class="terms-text">
                                    J'accepte les <a href="#">CGU</a>, la <a href="#">Politique de confidentialité</a> et les <a href="#">Règles de partenariat</a>
                                </span>
                            </label>
                            {% if form.agreeTerms.vars.errors|length > 0 %}
                                <div class="invalid-feedback" style="display: block; margin-top: 8px;">
                                    {{ form_errors(form.agreeTerms) }}
                                </div>
                            {% endif %}
                        </div>

                        <button type="submit" class="btn-submit">
                            <i class="fas fa-university"></i>
                            <span>Créer mon compte</span>
                        </button>

                    {{ form_end(form) }}

                    <div class="back-link">
                        <a href="{{ path('app_login') }}">
                            <i class="fas fa-arrow-left"></i>
                            Déjà partenaire ? Connexion
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% include 'partials/_footer.html.twig' %}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Ripple effect on button
            document.querySelector('.btn-submit').addEventListener('click', function(e) {
                const rect = this.getBoundingClientRect();
                const ripple = document.createElement('span');
                ripple.style.cssText = 'position:absolute;background:rgba(255,255,255,0.4);border-radius:50%;width:100px;height:100px;left:' + (e.clientX - rect.left - 50) + 'px;top:' + (e.clientY - rect.top - 50) + 'px;transform:scale(0);animation:ripple 0.6s ease-out;pointer-events:none;';
                this.appendChild(ripple);
                setTimeout(function() { ripple.remove(); }, 600);
            });
        });
    </script>
    <style>
        @keyframes ripple {
            to { transform: scale(4); opacity: 0; }
        }
    </style>
{% endblock %}