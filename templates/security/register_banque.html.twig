{# templates/registration/register_banque.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Inscription Banque - AgriFund{% endblock %}

{% block body_class %}register-banque-body{% endblock %}

{% block stylesheets %}
<style>
    /* Cacher le preloader de base.html.twig */
    #preloader {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
    }

    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    :root {
        --bank-gold: #E1B323;
        --bank-gold-dark: #c9a020;
        --bank-navy: #1a365d;
        --bank-navy-dark: #0f2744;
        --gris: #848A86;
        --error: #ef4444;
        --error-light: #fee2e2;
        --success: #089647;
        --success-light: #d4edda;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body.register-banque-body {
        font-family: 'Poppins', sans-serif;
        overflow-x: hidden;
    }

    /* ==========================================
       REGISTER UNIVERSE - CITY NIGHT THEME
    ========================================== */
    .register-universe {
        min-height: 100vh;
        background: linear-gradient(180deg, 
            #0a0f1a 0%, 
            #0f1929 15%,
            #1a2744 35%,
            #1a365d 55%,
            #2c5282 75%,
            #3182ce 100%
        );
        position: relative;
        overflow-x: hidden;
        padding-top: 80px;
        padding-bottom: 40px;
    }

    /* ==========================================
       STARS
    ========================================== */
    .stars-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 50%;
        pointer-events: none;
        z-index: 1;
    }

    .star {
        position: absolute;
        width: 2px;
        height: 2px;
        background: white;
        border-radius: 50%;
        animation: twinkle 3s infinite ease-in-out;
    }

    .star.bright {
        width: 3px;
        height: 3px;
        box-shadow: 0 0 6px white;
    }

    @keyframes twinkle {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 1; }
    }

    /* ==========================================
       MOON
    ========================================== */
    .moon {
        position: fixed;
        top: 80px;
        right: 12%;
        width: 60px;
        height: 60px;
        background: radial-gradient(circle at 30% 30%, #fffde7 0%, #e8e8e8 100%);
        border-radius: 50%;
        box-shadow: 0 0 40px rgba(255, 255, 255, 0.4);
        animation: moonGlow 5s ease-in-out infinite;
        z-index: 2;
    }

    @keyframes moonGlow {
        0%, 100% { box-shadow: 0 0 40px rgba(255, 255, 255, 0.4); }
        50% { box-shadow: 0 0 60px rgba(255, 255, 255, 0.6); }
    }

    /* ==========================================
       FLOATING COINS
    ========================================== */
    .coins-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 3;
    }

    .coin {
        position: absolute;
        font-size: 20px;
        animation: coinFloat 18s ease-in-out infinite;
        opacity: 0.5;
    }

    @keyframes coinFloat {
        0%, 100% { transform: translateY(0); opacity: 0; }
        10% { opacity: 0.5; }
        50% { transform: translateY(-150px); opacity: 0.7; }
        90% { opacity: 0.5; }
    }

    .coin:nth-child(1) { left: 8%; top: 75%; animation-delay: 0s; }
    .coin:nth-child(2) { left: 18%; top: 80%; animation-delay: -4s; font-size: 16px; }
    .coin:nth-child(3) { left: 80%; top: 75%; animation-delay: -2s; }
    .coin:nth-child(4) { left: 88%; top: 82%; animation-delay: -6s; font-size: 18px; }

    /* ==========================================
       CITY SKYLINE
    ========================================== */
    .city-container {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 220px;
        z-index: 1;
        pointer-events: none;
    }

    .buildings {
        position: absolute;
        bottom: 0;
        width: 100%;
        height: 180px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 6px;
        padding: 0 15px;
    }

    .building {
        background: linear-gradient(180deg, #1a365d 0%, #0f2744 100%);
        border-radius: 3px 3px 0 0;
        position: relative;
        animation: buildingRise 1.2s ease-out forwards;
        transform: translateY(100%);
    }

    @keyframes buildingRise {
        to { transform: translateY(0); }
    }

    .window {
        position: absolute;
        width: 5px;
        height: 6px;
        background: rgba(255, 223, 100, 0.8);
        border-radius: 1px;
        animation: windowFlicker 4s ease-in-out infinite;
    }

    .window.off {
        background: rgba(30, 50, 80, 0.8);
        animation: none;
    }

    @keyframes windowFlicker {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
    }

    .building.bank {
        width: 60px;
        height: 160px;
        background: linear-gradient(180deg, var(--bank-gold) 0%, var(--bank-gold-dark) 100%);
        z-index: 3;
        animation-delay: 0.4s;
    }

    .building.bank::after {
        content: '🏦';
        position: absolute;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 22px;
    }

    .building:nth-child(1) { width: 28px; height: 90px; animation-delay: 0.1s; }
    .building:nth-child(2) { width: 35px; height: 130px; animation-delay: 0.2s; }
    .building:nth-child(3) { width: 25px; height: 100px; animation-delay: 0.3s; }
    .building:nth-child(4) { width: 42px; height: 145px; animation-delay: 0.35s; }
    .building:nth-child(6) { width: 38px; height: 135px; animation-delay: 0.5s; }
    .building:nth-child(7) { width: 28px; height: 110px; animation-delay: 0.6s; }
    .building:nth-child(8) { width: 32px; height: 120px; animation-delay: 0.7s; }
    .building:nth-child(9) { width: 24px; height: 95px; animation-delay: 0.8s; }

    .street {
        position: absolute;
        bottom: 0;
        width: 100%;
        height: 45px;
        background: linear-gradient(180deg, #1a202c 0%, #0d1117 100%);
    }

    .street-line {
        position: absolute;
        bottom: 18px;
        left: 0;
        width: 100%;
        height: 3px;
        background: repeating-linear-gradient(90deg, var(--bank-gold) 0px, var(--bank-gold) 30px, transparent 30px, transparent 60px);
        animation: streetMove 2s linear infinite;
    }

    @keyframes streetMove {
        from { transform: translateX(0); }
        to { transform: translateX(60px); }
    }

    /* ==========================================
       MAIN CONTAINER
    ========================================== */
    .register-container {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 20px;
        position: relative;
        z-index: 10;
    }

    /* ==========================================
       GLASS CARD
    ========================================== */
    .register-glass {
        display: flex;
        max-width: 1100px;
        width: 100%;
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
        animation: cardAppear 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateY(40px);
    }

    @keyframes cardAppear {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ==========================================
       BRAND PANEL
    ========================================== */
    .brand-panel {
        flex: 0 0 380px;
        padding: 35px 30px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: linear-gradient(160deg, rgba(225, 179, 35, 0.1) 0%, rgba(26, 54, 93, 0.12) 100%);
        position: relative;
        overflow: hidden;
    }

    .brand-panel::before {
        content: '';
        position: absolute;
        top: -100%;
        left: -100%;
        width: 300%;
        height: 300%;
        background: radial-gradient(circle, rgba(225, 179, 35, 0.06) 0%, transparent 40%);
        animation: rotateBg 30s linear infinite;
    }

    @keyframes rotateBg {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .brand-content {
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .brand-logo {
        width: 90px;
        height: 90px;
        background: linear-gradient(135deg, var(--bank-gold) 0%, var(--bank-gold-dark) 100%);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        box-shadow: 0 15px 40px rgba(225, 179, 35, 0.35);
        animation: logoFloat 3s ease-in-out infinite;
    }

    @keyframes logoFloat {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    .brand-logo i {
        font-size: 42px;
        color: white;
    }

    .brand-title {
        color: white;
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .brand-subtitle {
        color: var(--bank-gold);
        font-size: 0.9rem;
        margin-bottom: 30px;
        line-height: 1.5;
    }

    /* Benefits */
    .benefits-list {
        text-align: left;
    }

    .benefit-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 12px;
        padding: 14px 16px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 14px;
        border: 1px solid rgba(225, 179, 35, 0.12);
        transition: all 0.3s ease;
        animation: benefitSlide 0.5s ease-out forwards;
        opacity: 0;
        transform: translateX(-20px);
    }

    .benefit-item:nth-child(1) { animation-delay: 0.4s; }
    .benefit-item:nth-child(2) { animation-delay: 0.5s; }
    .benefit-item:nth-child(3) { animation-delay: 0.6s; }
    .benefit-item:nth-child(4) { animation-delay: 0.7s; }

    @keyframes benefitSlide {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .benefit-item:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateX(5px);
    }

    .benefit-item i {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, var(--bank-gold) 0%, var(--bank-gold-dark) 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 14px;
        flex-shrink: 0;
    }

    .benefit-text {
        color: white;
    }

    .benefit-text strong {
        display: block;
        font-size: 0.85rem;
        margin-bottom: 2px;
    }

    .benefit-text span {
        font-size: 0.75rem;
        opacity: 0.7;
    }

    /* Stats */
    .stats-section {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        animation: statsAppear 0.6s ease-out 0.8s forwards;
        opacity: 0;
    }

    @keyframes statsAppear {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stat-item {
        text-align: center;
        padding: 12px 8px;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 10px;
    }

    .stat-number {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--bank-gold);
        display: block;
    }

    .stat-label {
        font-size: 0.65rem;
        color: rgba(255, 255, 255, 0.6);
        text-transform: uppercase;
    }

    /* ==========================================
       FORM PANEL - SANS SCROLL
    ========================================== */
    .form-panel {
        flex: 1;
        padding: 30px 35px;
        background: rgba(255, 255, 255, 0.97);
    }

    .form-header {
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        animation: formFadeIn 0.6s ease-out 0.2s forwards;
        opacity: 0;
    }

    @keyframes formFadeIn {
        to {
            opacity: 1;
        }
    }

    .form-header-content h2 {
        color: var(--bank-navy-dark);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-header-content h2 .emoji {
        font-size: 1.6rem;
    }

    .form-header-content p {
        color: var(--gris);
        font-size: 0.85rem;
    }

    .header-badge {
        background: linear-gradient(135deg, var(--bank-gold) 0%, var(--bank-gold-dark) 100%);
        color: white;
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* Alerts */
    .alert {
        padding: 12px 16px;
        border-radius: 12px;
        margin-bottom: 16px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 0.85rem;
    }

    .alert-danger {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        border-left: 4px solid var(--error);
        color: #991b1b;
    }

    .alert-success {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        border-left: 4px solid var(--success);
        color: #155724;
    }

    .alert ul {
        margin: 5px 0 0 0;
        padding-left: 18px;
    }

    .alert li { margin-bottom: 3px; font-size: 0.8rem; }

    /* Form Sections */
    .form-section {
        background: linear-gradient(135deg, #faf9f7 0%, #f5f3ef 100%);
        border-radius: 16px;
        padding: 18px 20px;
        margin-bottom: 16px;
        border: 1px solid rgba(225, 179, 35, 0.12);
        position: relative;
        overflow: hidden;
        animation: sectionFadeIn 0.5s ease-out forwards;
        opacity: 0;
    }

    .form-section:nth-child(1) { animation-delay: 0.3s; }
    .form-section:nth-child(2) { animation-delay: 0.4s; }
    .form-section:nth-child(3) { animation-delay: 0.5s; }

    @keyframes sectionFadeIn {
        to {
            opacity: 1;
        }
    }

    .form-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--bank-gold), var(--bank-gold-dark), var(--bank-navy));
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--bank-navy-dark);
        font-size: 0.95rem;
        font-weight: 700;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(225, 179, 35, 0.12);
    }

    .section-title i {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, var(--bank-gold) 0%, var(--bank-gold-dark) 100%);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 13px;
    }

    /* Form Groups */
    .form-group {
        margin-bottom: 14px;
    }

    .form-group:last-child {
        margin-bottom: 0;
    }

    .form-group label {
        display: flex;
        align-items: center;
        color: var(--bank-navy-dark);
        font-weight: 600;
        font-size: 0.82rem;
        margin-bottom: 6px;
    }

    .form-group label i {
        margin-right: 8px;
        color: var(--bank-gold);
        font-size: 0.9rem;
    }

    .required-star {
        color: var(--error);
        margin-left: 3px;
    }

    .optional-tag {
        font-size: 0.68rem;
        color: var(--gris);
        font-weight: normal;
        margin-left: 8px;
        padding: 2px 8px;
        background: rgba(225, 179, 35, 0.12);
        border-radius: 10px;
    }

    .form-control {
        width: 100%;
        padding: 11px 14px;
        font-size: 0.9rem;
        font-family: 'Poppins', sans-serif;
        border: 2px solid #e5e2dc;
        border-radius: 10px;
        background: white;
        transition: all 0.3s ease;
        color: var(--bank-navy-dark);
    }

    .form-control::placeholder {
        color: #adb5bd;
        font-size: 0.85rem;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--bank-gold);
        box-shadow: 0 0 0 3px rgba(225, 179, 35, 0.12);
    }

    .form-control.is-invalid {
        border-color: var(--error);
        background: #fffafa;
    }

    textarea.form-control {
        min-height: 50px;
        resize: vertical;
    }

    .invalid-feedback {
        display: block;
        color: var(--error);
        font-size: 0.75rem;
        margin-top: 5px;
        padding: 6px 10px;
        background: var(--error-light);
        border-radius: 6px;
        border-left: 2px solid var(--error);
    }

    .form-text {
        font-size: 0.7rem;
        color: var(--gris);
        margin-top: 3px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    /* Terms Section */
    .terms-section {
        background: linear-gradient(135deg, #faf9f7 0%, #f5f3ef 100%);
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 16px;
        border: 1px solid rgba(225, 179, 35, 0.12);
        animation: sectionFadeIn 0.5s ease-out 0.6s forwards;
        opacity: 0;
    }

    .terms-checkbox {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        cursor: pointer;
    }

    .custom-checkbox {
        position: relative;
        width: 20px;
        height: 20px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .custom-checkbox input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }

    .checkmark {
        position: absolute;
        top: 0;
        left: 0;
        width: 20px;
        height: 20px;
        background: white;
        border: 2px solid #d1d5db;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

    .custom-checkbox input:checked ~ .checkmark {
        background: linear-gradient(135deg, var(--bank-gold) 0%, var(--bank-gold-dark) 100%);
        border-color: var(--bank-gold);
    }

    .checkmark::after {
        content: '';
        position: absolute;
        display: none;
        left: 6px;
        top: 3px;
        width: 5px;
        height: 9px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .custom-checkbox input:checked ~ .checkmark::after {
        display: block;
    }

    .terms-text {
        font-size: 0.78rem;
        color: var(--gris);
        line-height: 1.5;
    }

    .terms-text a {
        color: var(--bank-gold);
        text-decoration: none;
        font-weight: 600;
    }

    .terms-text a:hover {
        text-decoration: underline;
    }

    /* Submit Button */
    .btn-submit {
        width: 100%;
        padding: 14px;
        font-size: 1rem;
        font-weight: 700;
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, var(--bank-gold) 0%, var(--bank-gold-dark) 100%);
        border: none;
        border-radius: 12px;
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s ease;
        animation: sectionFadeIn 0.5s ease-out 0.7s forwards;
        opacity: 0;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(225, 179, 35, 0.3);
    }

    .btn-submit::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
        transition: left 0.5s ease;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 35px rgba(225, 179, 35, 0.45);
    }

    .btn-submit:hover::before {
        left: 100%;
    }

    .btn-submit i {
        font-size: 1.1rem;
    }

    /* Back Link */
    .back-link {
        text-align: center;
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid #f0ece5;
        animation: sectionFadeIn 0.5s ease-out 0.8s forwards;
        opacity: 0;
    }

    .back-link a {
        color: var(--bank-gold);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.88rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 20px;
        background: rgba(225, 179, 35, 0.1);
        transition: all 0.3s ease;
    }

    .back-link a:hover {
        background: var(--bank-gold);
        color: white;
    }

    /* ==========================================
       RESPONSIVE
    ========================================== */
    @media (max-width: 1100px) {
        .register-glass {
            flex-direction: column;
            max-width: 550px;
        }

        .brand-panel {
            flex: none;
            padding: 30px 25px;
        }

        .benefits-list,
        .stats-section {
            display: none;
        }

        .form-panel {
            padding: 25px 20px;
        }
    }

    @media (max-width: 600px) {
        .register-container {
            padding: 15px;
        }

        .form-panel {
            padding: 20px 18px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-section {
            padding: 15px;
        }

        .form-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}

    <div class="register-universe">
        <!-- Stars -->
        <div class="stars-container">
            {% for i in 1..40 %}
                <div class="star {% if i % 5 == 0 %}bright{% endif %}" 
                     style="top: {{ random(2, 50) }}%; left: {{ random(0, 100) }}%; animation-delay: {{ random(0, 30) / 10 }}s;"></div>
            {% endfor %}
        </div>

        <!-- Moon -->
        <div class="moon"></div>

        <!-- Floating Coins -->
        <div class="coins-container">
            <div class="coin">🪙</div>
            <div class="coin">💰</div>
            <div class="coin">🪙</div>
            <div class="coin">💰</div>
        </div>

        <!-- City Skyline -->
        <div class="city-container">
            <div class="buildings">
                <div class="building">
                    {% for j in 1..6 %}
                        <div class="window {% if random(0, 1) == 0 %}off{% endif %}" style="top: {{ j * 12 }}px; left: {{ random(4, 18) }}px;"></div>
                    {% endfor %}
                </div>
                <div class="building">
                    {% for j in 1..9 %}
                        <div class="window {% if random(0, 1) == 0 %}off{% endif %}" style="top: {{ j * 12 }}px; left: {{ random(6, 24) }}px;"></div>
                    {% endfor %}
                </div>
                <div class="building">
                    {% for j in 1..7 %}
                        <div class="window {% if random(0, 1) == 0 %}off{% endif %}" style="top: {{ j * 12 }}px; left: {{ random(4, 16) }}px;"></div>
                    {% endfor %}
                </div>
                <div class="building">
                    {% for j in 1..10 %}
                        <div class="window {% if random(0, 1) == 0 %}off{% endif %}" style="top: {{ j * 12 }}px; left: {{ random(8, 30) }}px;"></div>
                    {% endfor %}
                </div>
                <div class="building bank"></div>
                <div class="building">
                    {% for j in 1..9 %}
                        <div class="window {% if random(0, 1) == 0 %}off{% endif %}" style="top: {{ j * 12 }}px; left: {{ random(6, 26) }}px;"></div>
                    {% endfor %}
                </div>
                <div class="building">
                    {% for j in 1..8 %}
                        <div class="window {% if random(0, 1) == 0 %}off{% endif %}" style="top: {{ j * 12 }}px; left: {{ random(4, 18) }}px;"></div>
                    {% endfor %}
                </div>
                <div class="building">
                    {% for j in 1..8 %}
                        <div class="window {% if random(0, 1) == 0 %}off{% endif %}" style="top: {{ j * 12 }}px; left: {{ random(5, 22) }}px;"></div>
                    {% endfor %}
                </div>
                <div class="building">
                    {% for j in 1..6 %}
                        <div class="window {% if random(0, 1) == 0 %}off{% endif %}" style="top: {{ j * 12 }}px; left: {{ random(4, 14) }}px;"></div>
                    {% endfor %}
                </div>
            </div>
            <div class="street">
                <div class="street-line"></div>
            </div>
        </div>

        <!-- Main Container -->
        <div class="register-container">
            <div class="register-glass">
                <!-- Brand Panel -->
                <div class="brand-panel d-none d-lg-flex flex-column">
                    <div class="brand-content">
                        <div class="brand-logo">
                            <i class="fas fa-university"></i>
                        </div>
                        <h1 class="brand-title">AgriFund</h1>
                        <p class="brand-subtitle">
                            Devenez partenaire financier de la communauté agricole
                        </p>

                        <div class="benefits-list">
                            <div class="benefit-item">
                                <i class="fas fa-handshake"></i>
                                <div class="benefit-text">
                                    <strong>Agriculteurs qualifiés</strong>
                                    <span>Profils vérifiés et fiables</span>
                                </div>
                            </div>
                            <div class="benefit-item">
                                <i class="fas fa-chart-bar"></i>
                                <div class="benefit-text">
                                    <strong>Analyse de risque</strong>
                                    <span>Données détaillées</span>
                                </div>
                            </div>
                            <div class="benefit-item">
                                <i class="fas fa-file-contract"></i>
                                <div class="benefit-text">
                                    <strong>Gestion optimisée</strong>
                                    <span>Suivi automatisé</span>
                                </div>
                            </div>
                            <div class="benefit-item">
                                <i class="fas fa-shield-alt"></i>
                                <div class="benefit-text">
                                    <strong>Plateforme sécurisée</strong>
                                    <span>Conformité garantie</span>
                                </div>
                            </div>
                        </div>

                        <div class="stats-section">
                            <div class="stat-item">
                                <span class="stat-number">5000+</span>
                                <span class="stat-label">Agriculteurs</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number">98%</span>
                                <span class="stat-label">Satisfaction</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number">24/7</span>
                                <span class="stat-label">Support</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Panel -->
                <div class="form-panel">
                    <div class="form-header">
                        <div class="form-header-content">
                            <h2><span class="emoji">🏦</span> Inscription Banque</h2>
                            <p>Rejoignez notre réseau de financement</p>
                        </div>
                        <div class="header-badge">
                            <i class="fas fa-crown"></i>
                            Premium
                        </div>
                    </div>

                    {% if form.vars.errors|length > 0 %}
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle"></i>
                            <div>
                                <strong>Erreurs :</strong>
                                <ul>
                                    {% for error in form.vars.errors %}
                                        <li>{{ error.message }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    {% endif %}

                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i>
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle"></i>
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'registerForm'}}) }}

                        <div class="form-section">
                            <h5 class="section-title">
                                <i class="fas fa-user-tie"></i>
                                Contact
                            </h5>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="{{ form.nom.vars.id }}">
                                        <i class="fas fa-user"></i> Nom
                                        <span class="required-star">*</span>
                                    </label>
                                    {{ form_widget(form.nom, {
                                        'attr': {
                                            'class': 'form-control' ~ (form.nom.vars.errors|length > 0 ? ' is-invalid' : ''),
                                            'placeholder': 'Nom du responsable'
                                        }
                                    }) }}
                                    {% if form.nom.vars.errors|length > 0 %}
                                        <div class="invalid-feedback">{{ form_errors(form.nom) }}</div>
                                    {% endif %}
                                </div>

                                <div class="form-group">
                                    <label for="{{ form.prenom.vars.id }}">
                                        <i class="fas fa-user"></i> Prénom
                                        <span class="required-star">*</span>
                                    </label>
                                    {{ form_widget(form.prenom, {
                                        'attr': {
                                            'class': 'form-control' ~ (form.prenom.vars.errors|length > 0 ? ' is-invalid' : ''),
                                            'placeholder': 'Prénom du responsable'
                                        }
                                    }) }}
                                    {% if form.prenom.vars.errors|length > 0 %}
                                        <div class="invalid-feedback">{{ form_errors(form.prenom) }}</div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="{{ form.email.vars.id }}">
                                    <i class="fas fa-envelope"></i> Email pro
                                    <span class="required-star">*</span>
                                </label>
                                {{ form_widget(form.email, {
                                    'attr': {
                                        'class': 'form-control' ~ (form.email.vars.errors|length > 0 ? ' is-invalid' : ''),
                                        'placeholder': 'contact@banque.com'
                                    }
                                }) }}
                                {% if form.email.vars.errors|length > 0 %}
                                    <div class="invalid-feedback">{{ form_errors(form.email) }}</div>
                                {% endif %}
                            </div>

                            <div class="form-group">
                                <label for="{{ form.tel.vars.id }}">
                                    <i class="fas fa-phone"></i> Téléphone
                                    <span class="required-star">*</span>
                                </label>
                                {{ form_widget(form.tel, {
                                    'attr': {
                                        'class': 'form-control' ~ (form.tel.vars.errors|length > 0 ? ' is-invalid' : ''),
                                        'placeholder': '71 XXX XXX'
                                    }
                                }) }}
                                {% if form.tel.vars.errors|length > 0 %}
                                    <div class="invalid-feedback">{{ form_errors(form.tel) }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="form-section">
