{# templates/security/verify_2fa.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Vérification à deux facteurs{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --vert-vif: #089647;
            --vert-fonce: #076A39;
            --vert-foret: #095032;
            --gris: #848A86;
            --vert-tres-fonce: #133D03;
            --jaune-moutarde: #E1B323;
            --vert-clair: #B2D944;
            --vert-olive-fonce: #476C1A;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f8faf5 0%, #e8f5e9 50%, #f1f8e9 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .verify-container {
            max-width: 500px;
            width: 100%;
            background: white;
            border-radius: 25px;
            padding: 50px 40px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
            animation: slideIn 0.5s ease-out;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .verify-container::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--vert-olive-fonce), var(--vert-clair), var(--jaune-moutarde));
        }

        .verify-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .verify-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--vert-vif) 0%, var(--vert-fonce) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            box-shadow: 0 10px 30px rgba(8, 150, 71, 0.3);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); box-shadow: 0 10px 30px rgba(8, 150, 71, 0.3); }
            50% { transform: scale(1.05); box-shadow: 0 15px 40px rgba(8, 150, 71, 0.4); }
        }

        .verify-icon i {
            font-size: 2.5rem;
            color: white;
        }

        .verify-header h1 {
            font-size: 1.8rem;
            color: var(--vert-tres-fonce);
            margin-bottom: 10px;
            font-weight: 700;
        }

        .verify-header p {
            color: var(--gris);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .user-info {
            background: linear-gradient(135deg, rgba(71, 108, 26, 0.05) 0%, rgba(178, 217, 68, 0.05) 100%);
            border-left: 4px solid var(--vert-vif);
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-info i {
            font-size: 1.5rem;
            color: var(--vert-vif);
        }

        .user-info-text strong {
            display: block;
            color: var(--vert-tres-fonce);
            font-size: 1.1rem;
            margin-bottom: 3px;
        }

        .user-info-text span {
            color: var(--gris);
            font-size: 0.9rem;
        }

        .alert {
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: shake 0.5s;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        .alert-danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
            border-left: 4px solid #ef4444;
            color: #b91c1c;
        }

        .alert i {
            font-size: 1.3rem;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: var(--vert-tres-fonce);
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

        .code-input-container {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 20px;
        }

        .code-input {
            width: 60px;
            height: 70px;
            font-size: 2rem;
            text-align: center;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-weight: bold;
            color: var(--vert-tres-fonce);
            transition: all 0.3s ease;
            font-family: 'Courier New', monospace;
        }

        .code-input:focus {
            outline: none;
            border-color: var(--vert-vif);
            box-shadow: 0 0 0 4px rgba(8, 150, 71, 0.1);
            transform: scale(1.05);
        }

        .hidden-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .btn-verify {
            width: 100%;
            background: linear-gradient(135deg, var(--vert-olive-fonce) 0%, var(--vert-foret) 100%);
            border: none;
            color: white;
            padding: 16px 28px;
            border-radius: 14px;
            font-size: 1.05rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(71, 108, 26, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-verify:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(71, 108, 26, 0.35);
        }

        .btn-verify:active {
            transform: translateY(-1px);
        }

        .btn-verify i {
            font-size: 1.1rem;
        }

        .resend-section {
            text-align: center;
            margin-top: 25px;
            padding-top: 25px;
            border-top: 1px solid #e0e0e0;
        }

        .resend-section p {
            color: var(--gris);
            font-size: 0.9rem;
            margin-bottom: 15px;
        }

        .btn-resend {
            background: transparent;
            border: 2px solid var(--vert-vif);
            color: var(--vert-vif);
            padding: 10px 24px;
            border-radius: 10px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .btn-resend:hover {
            background: var(--vert-vif);
            color: white;
            transform: translateY(-2px);
        }

        .security-notice {
            background: linear-gradient(135deg, rgba(225, 179, 35, 0.1) 0%, rgba(201, 160, 32, 0.1) 100%);
            border-left: 4px solid var(--jaune-moutarde);
            padding: 15px 20px;
            border-radius: 10px;
            margin-top: 25px;
            display: flex;
            gap: 12px;
        }

        .security-notice i {
            color: var(--jaune-moutarde);
            font-size: 1.2rem;
            margin-top: 2px;
        }

        .security-notice-text {
            flex: 1;
        }

        .security-notice-text strong {
            display: block;
            color: var(--vert-tres-fonce);
            margin-bottom: 5px;
            font-size: 0.95rem;
        }

        .security-notice-text p {
            color: var(--gris);
            font-size: 0.85rem;
            margin: 0;
            line-height: 1.5;
        }

        .timer {
            text-align: center;
            font-size: 0.9rem;
            color: var(--gris);
            margin-top: 15px;
        }

        .timer-value {
            font-weight: 700;
            color: var(--jaune-moutarde);
            font-size: 1.1rem;
        }

        @media (max-width: 576px) {
            .verify-container {
                padding: 40px 25px;
            }

            .code-input {
                width: 50px;
                height: 60px;
                font-size: 1.5rem;
            }

            .verify-header h1 {
                font-size: 1.5rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="verify-container">
        <div class="verify-header">
            <div class="verify-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h1>Vérification à deux facteurs</h1>
            <p>Pour votre sécurité, veuillez entrer le code de vérification envoyé à votre adresse email</p>
        </div>

        <div class="user-info">
            <i class="fas fa-user-circle"></i>
            <div class="user-info-text">
                <strong>{{ utilisateur.nomComplet }}</strong>
                <span>{{ utilisateur.email }}</span>
            </div>
        </div>

        {% if error %}
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i>
                <span>{{ error }}</span>
            </div>
        {% endif %}

        <form method="post" id="verify2FAForm">
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-key me-2"></i>Code de vérification
                </label>
                <div class="code-input-container">
                    <input type="text" class="code-input" maxlength="1" data-index="0" autocomplete="off">
                    <input type="text" class="code-input" maxlength="1" data-index="1" autocomplete="off">
                    <input type="text" class="code-input" maxlength="1" data-index="2" autocomplete="off">
                    <input type="text" class="code-input" maxlength="1" data-index="3" autocomplete="off">
                    <input type="text" class="code-input" maxlength="1" data-index="4" autocomplete="off">
                    <input type="text" class="code-input" maxlength="1" data-index="5" autocomplete="off">
                </div>
                <input type="hidden" name="code" id="hiddenCode" class="hidden-input">
            </div>

            <button type="submit" class="btn-verify">
                <i class="fas fa-check-circle"></i>
                Vérifier le code
            </button>
        </form>

        <div class="timer">
            Le code expire dans : <span class="timer-value" id="countdown">5:00</span>
        </div>

        <div class="resend-section">
            <p>Vous n'avez pas reçu le code ?</p>
            <a href="{{ path('app_login_2fa_resend') }}" class="btn-resend">
                <i class="fas fa-redo"></i>
                Renvoyer le code
            </a>
        </div>

        <div class="security-notice">
            <i class="fas fa-info-circle"></i>
            <div class="security-notice-text">
                <strong>Information de sécurité</strong>
                <p>Ne partagez jamais ce code avec qui que ce soit. Notre équipe ne vous demandera jamais votre code de vérification.</p>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('.code-input');
            const hiddenInput = document.getElementById('hiddenCode');
            const form = document.getElementById('verify2FAForm');

            // Focus sur le premier input
            inputs[0].focus();

            // Gestion de la saisie
            inputs.forEach((input, index) => {
                input.addEventListener('input', function(e) {
                    const value = this.value;

                    if (value.length === 1) {
                        // Passer au champ suivant
                        if (index < inputs.length - 1) {
                            inputs[index + 1].focus();
                        }
                    }

                    // Mettre à jour le champ caché
                    updateHiddenInput();

                    // Auto-submit si tous les champs sont remplis
                    if (isCodeComplete()) {
                        setTimeout(() => form.submit(), 300);
                    }
                });

                input.addEventListener('keydown', function(e) {
                    // Retour arrière
                    if (e.key === 'Backspace') {
                        if (this.value === '' && index > 0) {
                            inputs[index - 1].focus();
                            inputs[index - 1].value = '';
                        }
                        updateHiddenInput();
                    }

                    // Flèches gauche/droite
                    if (e.key === 'ArrowLeft' && index > 0) {
                        inputs[index - 1].focus();
                    }
                    if (e.key === 'ArrowRight' && index < inputs.length - 1) {
                        inputs[index + 1].focus();
                    }

                    // Accepter seulement les chiffres
                    if (!/[0-9]/.test(e.key) && e.key !== 'Backspace' && e.key !== 'ArrowLeft' && e.key !== 'ArrowRight' && e.key !== 'Tab') {
                        e.preventDefault();
                    }
                });

                // Paste
                input.addEventListener('paste', function(e) {
                    e.preventDefault();
                    const pastedData = e.clipboardData.getData('text');
                    const digits = pastedData.replace(/\D/g, '').slice(0, 6);
                    
                    digits.split('').forEach((digit, i) => {
                        if (inputs[i]) {
                            inputs[i].value = digit;
                        }
                    });

                    updateHiddenInput();

                    if (digits.length === 6) {
                        inputs[5].focus();
                        setTimeout(() => form.submit(), 300);
                    }
                });
            });

            function updateHiddenInput() {
                let code = '';
                inputs.forEach(input => {
                    code += input.value;
                });
                hiddenInput.value = code;
            }

            function isCodeComplete() {
                return Array.from(inputs).every(input => input.value.length === 1);
            }

            // Countdown timer
            let timeLeft = 300; // 5 minutes en secondes
            const countdownElement = document.getElementById('countdown');

            function updateCountdown() {
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                countdownElement.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                
                if (timeLeft === 0) {
                    countdownElement.style.color = '#ef4444';
                    countdownElement.textContent = 'Expiré';
                    inputs.forEach(input => input.disabled = true);
                } else if (timeLeft <= 60) {
                    countdownElement.style.color = '#ef4444';
                }
                
                timeLeft--;
            }

            updateCountdown();
            const timer = setInterval(() => {
                if (timeLeft < 0) {
                    clearInterval(timer);
                } else {
                    updateCountdown();
                }
            }, 1000);
        });
    </script>
{% endblock %}