<!DOCTYPE html>
<html lang="fr">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <style>
        @page { 
            margin: 80px 40px 100px 40px; 
        }
        body { 
            font-family: 'DejaVu Sans', sans-serif; 
            color: #333; 
            font-size: 10px; 
            margin: 0; 
            padding: 0; 
            background: #fff; 
        }
        
        /* Fixed Header Elements */
        .color-bar-top { 
            position: fixed;
            top: -100px;
            left: -40px;
            right: -40px;
            height: 10px; 
            background: #E1B323; 
        }
        .hero-section { 
            position: fixed;
            top: -90px;
            left: -40px;
            right: -40px;
            background: #076A39; 
            color: #fff; 
            padding: 20px 40px; 
        }
        .hero-table { width: 100%; border-collapse: collapse; }
        /* Compact Fixed Header */
        .fixed-header { 
            position: fixed;
            top: -80px;
            left: -40px;
            right: -40px;
            height: 60px;
            background: #076A39;
            color: #fff;
            padding: 10px 40px;
            border-bottom: 2px solid #E1B323;
        }
        .header-table { width: 100%; border-collapse: collapse; }
        .header-logo { font-size: 24px; font-weight: 900; color: #E1B323; width: 40px; }
        .header-title { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }

        /* Flow-based Hero section */
        .hero-section { 
            background: #fff9e6; 
            border: 1px solid #ffecb3;
            padding: 30px; 
            margin-top: -10px;
            margin-bottom: 20px;
            border-radius: 8px;
        }
        .hero-section h1 { color: #076A39; margin: 0; font-size: 22px; }
        .hero-section p { color: #856404; font-size: 10px; margin-top: 5px; }
        /* Data Table */
        .content-wrap { padding-bottom: 30px; }
        .main-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .main-table th { background: #095032; color: #fff; text-align: left; padding: 10px; font-size: 8px; text-transform: uppercase; }
        .main-table tr { page-break-inside: avoid; }
        .main-table tr:nth-child(even) { background: #fdfcf9; }
        
        .status-pill { padding: 2px 8px; border-radius: 4px; font-size: 7px; font-weight: 800; text-transform: uppercase; }
        .pill-active { background: #e8f5e9; color: #2e7d32; }
        .pill-pending { background: #fff3cd; color: #856404; }
        .pill-cancelled { background: #f8d7da; color: #721c24; }

        .stamp-box { width: 130px; height: 130px; border: 4px double #E1B323; border-radius: 50%; position: relative; text-align: center; display: inline-block; margin-top: 40px; }
        .stamp-inner { padding-top: 25px; }
        .stamp-txt-top { font-size: 7px; text-transform: uppercase; color: #856404; font-weight: 800; }
        .stamp-txt-mid { font-size: 14px; color: #076A39; font-weight: 900; margin: 4px 0; }
        .stamp-txt-bot { font-size: 6px; color: #856404; opacity: 0.7; }

        .signature-table { width: 100%; border-collapse: collapse; margin-top: 30px; }
        .sig-cell { width: 50%; text-align: center; }
        .sig-line { width: 180px; border-bottom: 1px solid #333; margin: 40px auto 10px auto; }
        .sig-label { font-size: 9px; font-weight: 700; }

        .footer { position: fixed; bottom: -90px; left: -40px; right: -40px; padding: 15px 40px; background: #fafafa; border-top: 1px solid #E1B323; }
        .watermark { position: fixed; top: 30%; left: 10%; font-size: 90px; color: #f0f0f0; transform: rotate(-45deg); z-index: -1; font-weight: 900; }
    </style>
</head>
<body>
    <div class="watermark">AGRIFUND</div>
    <div class="fixed-header">
        <table class="header-table">
            <tr>
                <td class="header-logo">AF</td>
                <td class="header-title">AgriFund - Offres Financières</td>
                <td style="text-align: right; font-size: 8px; opacity: 0.8;">
                    REF: OFR-{{ date|date('Ymd') }} | <span class="pagenum"></span>
                </td>
            </tr>
        </table>
    </div>

    <div class="hero-section">
        <table style="width: 100%;">
            <tr>
                <td>
                    <h1>Rapport des Offres Actives</h1>
                    <p>Performance et suivi des campagnes de financement</p>
                </td>
                <td style="text-align: right; font-size: 9px; color: #856404;">
                    Généré le {{ date|date('d/m/Y H:i') }}<br>
                    CONFIDENTIEL
                </td>
            </tr>
        </table>
    </div>
    
    <div class="stats-stripe">
        <table class="stats-table">
            <tr>
                <td class="stat-item"><div class="stat-val">{{ stats.total }}</div><div class="stat-lbl">Total Offres</div></td>
                <td class="stat-item"><div class="stat-val">{{ stats.active }}</div><div class="stat-lbl">Offres Actives</div></td>
                <td class="stat-item"><div class="stat-val">{{ stats.tauxActivation }}%</div><div class="stat-lbl">Taux d'Activation</div></td>
                <td class="stat-item"><div class="stat-val">{{ stats.enAttente }}</div><div class="stat-lbl">Dossiers en attente</div></td>
            </tr>
        </table>
    </div>

    <div style="margin: 15px 40px; padding: 8px; border: 1px dashed #E1B323; font-size: 8px; color: #856404; background: #fffdf4; text-align: center;">
        Certificat d'authenticité - AgriFund. ID Verrou: {{ date|date('U') }}-OFR
    </div>

    <div class="content-wrap">
        <table class="main-table">
            <thead>
                <tr>
                    <th>Nom de l'offre</th>
                    <th>Produit Support</th>
                    <th>Taux</th>
                    <th>Statut</th>
                    <th>Date de création</th>
                </tr>
            </thead>
            <tbody>
                {% for o in offres %}
                <tr>
                    <td style="font-weight: 700;">{{ o.nomOffre }}</td>
                    <td>{{ o.produitFinancier ? o.produitFinancier.nomProduit : 'N/A' }}</td>
                    <td style="font-weight: 700; color: #089647;">{{ o.produitFinancier ? o.produitFinancier.tauxInteret ~ '%' : '-' }}</td>
                    <td>
                        <span class="status-pill pill-{{ o.statut|lower|replace({' ': ''}) == 'active' ? 'active' : (o.statut|lower|replace({' ': ''}) == 'enattente' ? 'pending' : 'cancelled') }}">
                            {{ o.statut }}
                        </span>
                    </td>
                    <td style="font-size: 8px;">{{ date|date('d/m/Y') }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="footer">
        <div style="font-size: 8px; color: #888; text-align: center;">
            Document généré officiellement par le système AgriFund v4.6. Toute modification invalide le certificat.
        </div>
    </div>
</body>
</html>
