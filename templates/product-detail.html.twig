{% extends 'base.html.twig' %}

{% block title %}{{ product.nomProduit }} - AgriFund{% endblock %}

{% block page_intro %}
<div style="background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); color: white; padding: 60px 0; margin-bottom: 40px;">
<div data-translate-scope style="background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); color: white; padding: 120px 0 60px; margin-bottom: 40px;">
    <div class="hoc container clear">
        <div style="max-width: 900px;">
            <div style="display: flex; align-items: flex-start; gap: 30px;">
                <div style="flex: 1;">
                    <p style="color: #F4C430; font-size: 0.95em; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; margin: 0 0 10px 0;">{{ product.typeFinancement }}</p>
                    <h1 style="margin: 0 0 20px 0; font-size: 3em; font-weight: bold; line-height: 1.1;">{{ product.nomProduit }}</h1>
                    <p style="margin: 0; font-size: 1.1em; opacity: 0.95; max-width: 600px; line-height: 1.6;">Découvrez nos solutions de financement adapté à vos besoins agricoles</p>
                </div>
                <div style="text-align: center; background: rgba(255,255,255,0.1); padding: 30px 25px; border-radius: 8px; backdrop-filter: blur(10px);">
                    <p style="margin: 0 0 8px 0; color: #F4C430; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Taux d'Intérêt</p>
                    <p style="margin: 0; font-size: 2.8em; font-weight: bold; color: #fff;">{{ product.tauxInteret }}<small style="font-size: 0.4em;">%</small></p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="hoc container clear">
{% include 'components/_translation_widget.html.twig' %}
<div class="hoc container clear" data-translate-scope>
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px; margin-bottom: 60px;">
        <!-- Main Content -->
        <div>
            <!-- Quick Stats -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin-bottom: 40px;">
                <div style="padding: 25px; background: linear-gradient(135deg, #f0f7f4 0%, #e8eef0 100%); border-radius: 8px; border-left: 4px solid #1B7E4C;">
                    <p style="margin: 0 0 10px 0; color: #999; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Montant</p>
                    <p style="margin: 0; font-size: 2em; font-weight: bold; color: #1B7E4C;">{{ product.montant|number_format(0, ',', ' ') }}<span style="font-size: 0.5em;"> DT</span></p>
                </div>
                <div style="padding: 25px; background: linear-gradient(135deg, #f0f7f4 0%, #e8eef0 100%); border-radius: 8px; border-left: 4px solid #1B7E4C;">
                    <p style="margin: 0 0 10px 0; color: #999; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Prix Fixe Payable</p>
                    <p style="margin: 0; font-size: 2em; font-weight: bold; color: #1B7E4C;">{{ product.prixFixe|number_format(2, ',', ' ') }}<span style="font-size: 0.5em;"> DT</span></p>
                </div>
            </div>

            <!-- Conditions Section -->
            {% if product.reglesFinancieres %}
            <div style="background: white; padding: 40px; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.08); margin-bottom: 40px;">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 25px;">
                    <span style="font-size: 1.8em;">📋</span>
                    <h2 style="margin: 0; color: #1B7E4C; font-size: 1.5em;">Conditions & Règles</h2>
                </div>
                <div style="color: #333; line-height: 1.9; font-size: 1.02em;">
                    <p>{{ product.reglesFinancieres }}</p>
                </div>
            </div>
            {% endif %}

            <!-- Related Offers -->
            {% if product.offres|length > 0 %}
            <div style="margin-bottom: 40px;">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 25px;">
                    <span style="font-size: 1.8em;">🎁</span>
                    <h2 style="margin: 0; color: #1B7E4C; font-size: 1.5em;">Offres Actuelles</h2>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                {% for offre in product.offres %}
                    <div style="background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border-top: 3px solid #F4C430;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
                            <h4 style="margin: 0; color: #1B7E4C; font-size: 1.05em;">{{ offre.nomOffre }}</h4>
                            <span style="padding: 6px 12px; background: {% if offre.statut == 'Active' %}#1B7E4C{% elseif offre.statut == 'En attente' %}#FFA500{% else %}#999{% endif %}; color: white; border-radius: 20px; font-size: 0.75em; font-weight: bold; white-space: nowrap;">
                                {{ offre.statut }}
                            </span>
                        </div>
                        <p style="margin: 0 0 15px 0; color: #666; font-size: 0.95em; line-height: 1.6;">{{ offre.conditions }}</p>
                        <a href="{{ path('app_offer_detail', {'id': offre.id}) }}" style="display: inline-block; color: #1B7E4C; text-decoration: none; font-weight: bold; border-bottom: 2px solid #1B7E4C; padding-bottom: 3px;">
                            Voir l'offre →
                        </a>
                    </div>
                {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Sidebar -->
        <div>
            <!-- CTA Card -->
            <div style="background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); color: white; padding: 35px; border-radius: 12px; box-shadow: 0 8px 24px rgba(27,126,76,0.2); margin-bottom: 30px;">
                <div style="text-align: center;">
                    <p style="margin: 0 0 15px 0; font-size: 2.5em;">💰</p>
                    <h3 style="margin: 0 0 15px 0; color: #F4C430; font-size: 1.3em;">Prêts à Financer Votre Projet</h3>
                    <p style="margin: 0 0 25px 0; font-size: 0.95em; line-height: 1.6; opacity: 0.95;">
                        Jusqu'a {{ product.montant|number_format(0, ',', ' ') }} DT avec un taux de {{ product.tauxInteret }}%
                    </p>
                    <a href="{{ path('agriculteur_produit_postuler', {id: product.id}) }}" style="display: block; padding: 14px 24px; background: #F4C430; color: #1B7E4C; text-decoration: none; border-radius: 6px; font-weight: bold; text-align: center; margin-bottom: 12px; transition: transform 0.2s;">
                        🚀 Acheter ce produit
                    </a>
                    <a href="{{ path('app_product_detail_pdf', {id: product.id}) }}" style="display: block; padding: 14px 24px; background: #ffffff; color: #1B7E4C; text-decoration: none; border-radius: 6px; font-weight: bold; text-align: center; margin-bottom: 12px; border: 1px solid #F4C430;">
                        📄 Télécharger ma fiche PDF personnalisée
                    </a>
                    <a href="#" style="display: block; padding: 14px 24px; background: transparent; color: white; text-decoration: none; border: 2px solid white; border-radius: 6px; font-weight: bold; text-align: center; transition: background 0.2s;">
                        📞 Contacter Notre Équipe
                    </a>
                </div>
            </div>

            <!-- Info Cards -->
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <div style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                    <p style="margin: 0 0 8px 0; color: #1B7E4C; font-weight: bold; font-size: 0.9em; text-transform: uppercase;">✓ Avantages</p>
                    <p style="margin: 0; color: #666; font-size: 0.9em;">Processus rapide et simple, taux compétitif, accompagnement personnalisé</p>
                </div>
                <div style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                    <p style="margin: 0 0 8px 0; color: #1B7E4C; font-weight: bold; font-size: 0.9em; text-transform: uppercase;">⏱️ Délai</p>
                    <p style="margin: 0; color: #666; font-size: 0.9em;">Validation rapide de votre dossier en 48-72h</p>
                </div>
                <div style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                    <p style="margin: 0 0 8px 0; color: #1B7E4C; font-weight: bold; font-size: 0.9em; text-transform: uppercase;">🛡️ Garanties</p>
                    <p style="margin: 0; color: #666; font-size: 0.9em;">Options d'assurance disponibles pour sécuriser votre financement</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom CTA -->
    <div style="background: linear-gradient(135deg, #F4C430 0%, #D4A817 100%); color: #1B7E4C; padding: 40px; border-radius: 12px; text-align: center; margin-bottom: 40px;">
        <h2 style="margin: 0 0 15px 0; font-size: 1.8em;">Vous êtes Agriculteur ? Nous Pouvons Vous Aider!</h2>
        <p style="margin: 0 0 25px 0; font-size: 1.05em; max-width: 600px; margin-left: auto; margin-right: auto;">
            Obtenez un financement adapté à votre activité agricole en quelques clics
        </p>
        <a href="{{ path('app_products') }}" style="display: inline-block; padding: 12px 30px; background: #1B7E4C; color: white; text-decoration: none; border-radius: 6px; font-weight: bold;">
            Découvrir Autres Produits
        </a>
    </div>
</div>
{% endblock %}
