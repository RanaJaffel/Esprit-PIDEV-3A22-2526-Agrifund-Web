{% extends 'base.html.twig' %}

{% block title %}Connexion - AgriFund Admin{% endblock %}

{% block content %}
<div style="background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;">
    <div style="width: 100%; max-width: 420px;">
        <!-- Logo & Branding -->
        <div style="text-align: center; margin-bottom: 40px;">
            <div style="font-size: 3.5em; margin-bottom: 15px;">🌾</div>
            <h1 style="margin: 0 0 8px 0; font-size: 2.5em; font-weight: bold; color: white; letter-spacing: 2px;">AgriFund</h1>
            <p style="margin: 0; color: rgba(255,255,255,0.8); font-size: 1.05em;">Plateforme de Financement Agricole</p>
        </div>

        <!-- Login Card -->
        <div style="background: white; border-radius: 16px; padding: 40px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <!-- Header -->
            <h2 style="margin: 0 0 30px 0; text-align: center; color: #1B7E4C; font-size: 1.8em; font-weight: bold;">
                🔐 Connexion Sécurisée
            </h2>

            <!-- Error Message -->
            {% if error %}
            <div style="background: #fee; border: 2px solid #f99; border-radius: 8px; padding: 15px; margin-bottom: 20px; color: #c00;">
                <p style="margin: 0; font-weight: bold; font-size: 0.95em;">⚠️ Erreur de Connexion</p>
                <p style="margin: 5px 0 0 0; font-size: 0.9em;">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            </div>
            {% endif %}

            <!-- Login Form -->
            <form method="post" action="{{ path('app_login') }}" style="margin-bottom: 25px;">
                <!-- Email Field -->
                <div style="margin-bottom: 20px;">
                    <label for="inputEmail" style="display: block; font-weight: bold; color: #1B7E4C; margin-bottom: 8px; font-size: 0.95em;">
                        📧 Adresse Email
                    </label>
                    <input 
                        type="email" 
                        id="inputEmail"
                        name="_username" 
                        value="{{ last_username }}"
                        placeholder="Votre email"
                        style="width: 100%; padding: 12px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1em; box-sizing: border-box; transition: border-color 0.3s;"
                        required
                        autofocus
                    >
                </div>

                <!-- Password Field -->
                <div style="margin-bottom: 20px;">
                    <label for="inputPassword" style="display: block; font-weight: bold; color: #1B7E4C; margin-bottom: 8px; font-size: 0.95em;">
                        🔑 Mot de Passe
                    </label>
                    <input 
                        type="password" 
                        id="inputPassword"
                        name="_password" 
                        placeholder="Votre mot de passe"
                        style="width: 100%; padding: 12px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1em; box-sizing: border-box; transition: border-color 0.3s;"
                        required
                    >
                </div>

                <!-- Remember Me -->
                <div style="margin-bottom: 25px; display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="remember" name="remember_me" style="width: 18px; height: 18px; cursor: pointer;">
                    <label for="remember" style="margin: 0; color: #666; font-size: 0.95em; cursor: pointer;">
                        Se souvenir de moi
                    </label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <!-- Submit Button -->
                <button type="submit" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #1B7E4C 0%, #0D5C3F 100%); color: white; border: none; border-radius: 8px; font-size: 1.05em; font-weight: bold; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(27,126,76,0.3)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
                    ✓ Se Connecter
                </button>
            </form>

            <!-- Divider -->
            <div style="text-align: center; margin: 25px 0; color: #999;">
                <span style="font-size: 0.9em;">Identifiants de Test</span>
            </div>

            <!-- Test Credentials -->
            <div style="background: #f8f9fa; border-radius: 8px; padding: 15px; margin-bottom: 0;">
                <!-- Admin Credentials -->
                <div style="margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #e0e0e0;">
                    <p style="margin: 0 0 5px 0; font-weight: bold; color: #1B7E4C; font-size: 0.9em;">
                        👨‍💼 Admin
                    </p>
                    <p style="margin: 0 0 3px 0; font-size: 0.85em; color: #666;">
                        <code style="background: white; padding: 2px 6px; border-radius: 3px; font-family: monospace;">admin@agrifund.com</code>
                    </p>
                    <p style="margin: 0; font-size: 0.85em; color: #666;">
                        <code style="background: white; padding: 2px 6px; border-radius: 3px; font-family: monospace;">admin123</code>
                    </p>
                </div>

                <!-- Client Credentials -->
                <div>
                    <p style="margin: 0 0 5px 0; font-weight: bold; color: #F4C430; font-size: 0.9em;">
                        👤 Client
                    </p>
                    <p style="margin: 0 0 3px 0; font-size: 0.85em; color: #666;">
                        <code style="background: white; padding: 2px 6px; border-radius: 3px; font-family: monospace;">client@agrifund.com</code>
                    </p>
                    <p style="margin: 0; font-size: 0.85em; color: #666;">
                        <code style="background: white; padding: 2px 6px; border-radius: 3px; font-family: monospace;">client123</code>
                    </p>
                </div>
            </div>
        </div>

        <!-- Footer Info -->
        <div style="text-align: center; margin-top: 30px; color: rgba(255,255,255,0.7);">
            <p style="margin: 0; font-size: 0.9em;">
                🛡️ Connexion sécurisée • Données protégées
            </p>
        </div>
    </div>
</div>
{% endblock %}
